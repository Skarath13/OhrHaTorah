{
  "name": "ohrhatorah",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "preview:pages": "npm run build && wrangler pages dev dist",
    "astro": "astro",
    "db:create": "wrangler d1 create ohrhatorah-db",
    "db:migrate": "wrangler d1 execute ohrhatorah-db --remote --file=./schema.sql",
    "db:migrate:local": "wrangler d1 execute ohrhatorah-db --local --file=./schema.sql",
    "admin:seed": "tsx scripts/seed-admin.ts"
  },
  "dependencies": {
    "@astrojs/react": "^4.4.2",
    "@keystatic/astro": "^5.0.6",
    "@keystatic/core": "^0.5.50",
    "astro": "^5.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260526.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "tsx": "^4.22.3",
    "wrangler": "^4.95.0"
  }
}
