{
  "name": "ohrhatorah",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "test": "node --test src/lib/*.test.ts",
    "preview": "astro preview",
    "astro": "astro",
    "db:create": "wrangler d1 create ohrhatorah-db",
    "db:migrate": "wrangler d1 execute ohrhatorah-db --file=./schema.sql",
    "db:migrate:local": "wrangler d1 execute ohrhatorah-db --local --file=./schema.sql",
    "r2:create": "wrangler r2 bucket create ohrhatorah-images"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.13",
    "@tiptap/core": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "astro": "^5.18.2",
    "bcryptjs": "^2.4.3",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/three": "^0.180.0"
  }
}
