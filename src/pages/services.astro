---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout title="Shabbat Services - Ohr HaTorah" pageTitle="Shabbat Services" pageIcon="fas fa-star-of-david" description="Saturday Shabbat services at Ohr HaTorah with prayer, Torah, music, and discussion.">
    <p class="intro-text"><strong>Join us each Saturday for Shabbat prayer, Torah, music, and fellowship.</strong></p>

    <div class="service-schedule">
        <h3><i class="fas fa-moon"></i> Friday Evening</h3>
        <p class="schedule-note">Festive Shabbat meals in the home</p>

        <h3><i class="fas fa-sun"></i> Saturday Service Schedule</h3>

        <div class="timeline">
            <div class="timeline-item">
                <div class="time-badge blue">2:30 PM</div>
                <div class="timeline-content">
                    <strong>Messianic Music and Dance</strong>
                    <p>Hebrew and English songs with congregational music and dance.</p>
                </div>
            </div>

            <div class="timeline-item">
                <div class="time-badge gold">3:00 PM</div>
                <div class="timeline-content">
                    <strong>Traditional Mincha Service</strong>
                    <p>Hebrew prayer, Torah reading, and blessings, with guidance in English.</p>
                </div>
            </div>

            <div class="timeline-item">
                <div class="time-badge green">4:30 PM</div>
                <div class="timeline-content">
                    <strong>Interactive Scripture Discussion</strong>
                    <p>A group study of the Torah portion, Haftarah, and Brit Chadashah.</p>
                </div>
            </div>
        </div>

        <p class="future-note"><em><i class="fas fa-clock"></i> A morning Shacharit service is planned.</em></p>
    </div>

    <div class="info-section">
        <h3><i class="fas fa-heart"></i> What to Expect</h3>
        <p>Our Shabbat gathering brings together Jewish liturgy, Messianic music, Torah reading, and discussion. Hebrew prayers are accompanied by transliteration and English explanations.</p>
        <p><strong>Jewish and non-Jewish visitors are welcome.</strong> Participate at your own pace, and ask questions whenever you need help.</p>
    </div>

    <aside class="service-contact-strip" aria-labelledby="service-contact-title">
        <div class="service-contact-heading">
            <span class="service-contact-icon" aria-hidden="true">
                <!-- Tabler Icons: message-question, MIT License -->
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M8 9h8"></path><path d="M8 13h6"></path><path d="M14 18h-1l-5 3v-3h-2a3 3 0 0 1 -3 -3v-8a3 3 0 0 1 3 -3h12a3 3 0 0 1 3 3v4.5"></path><path d="M19 22v.01"></path><path d="M19 19a2.003 2.003 0 0 0 .914 -3.782a1.98 1.98 0 0 0 -2.414 .483"></path></svg>
            </span>
            <h4 id="service-contact-title">Questions about Shabbat services?</h4>
        </div>
        <div class="service-contact-actions">
            <a href="tel:+17144061513" aria-label="Call Ohr HaTorah at (714) 406-1513">
                <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4h4l2 5l-2.5 1.5a11 11 0 0 0 5 5l1.5 -2.5l5 2v4a2 2 0 0 1 -2 2a16 16 0 0 1 -15 -15a2 2 0 0 1 2 -2"></path></svg>
                <span>Call us</span>
            </a>
            <a href="mailto:OhrHaTorahOC@gmail.com" aria-label="Email Ohr HaTorah at OhrHaTorahOC@gmail.com">
                <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10"></path><path d="M3 7l9 6l9 -6"></path></svg>
                <span>Email us</span>
            </a>
        </div>
    </aside>
</PageLayout>

<style>
    .intro-text {
        text-align: center;
        font-size: 1.2rem;
        margin-bottom: 30px;
    }

    .service-schedule {
        margin-bottom: 30px;
    }

    .service-schedule h3 {
        color: var(--primary-blue);
        margin: 20px 0 15px 0;
    }

    .schedule-note {
        color: var(--text-secondary);
        font-style: italic;
        margin-bottom: 25px;
    }

    .timeline {
        display: flex;
        flex-direction: column;
        gap: 15px;
        margin: 20px 0;
    }

    .timeline-item {
        display: flex;
        align-items: flex-start;
        gap: 20px;
        background: var(--gray-100);
        padding: 20px;
        border-radius: 8px;
    }

    .time-badge {
        padding: 8px 15px;
        border-radius: 6px;
        color: white;
        font-weight: bold;
        white-space: nowrap;
        min-width: 0;
        text-align: center;
    }

    .time-badge.blue {
        background: var(--primary-blue);
    }

    .time-badge.gold {
        background: var(--gold-dark);
    }

    .time-badge.green {
        background: var(--accent-green);
    }

    .timeline-content strong {
        display: block;
        color: var(--text-primary);
        margin-bottom: 5px;
    }

    .timeline-content p {
        margin: 0;
        color: var(--text-secondary);
        font-size: 0.95rem;
    }

    .future-note {
        color: var(--text-secondary);
        margin-top: 20px;
        padding: 15px;
        background: var(--gray-100);
        border-radius: 8px;
        text-align: center;
    }

    .info-section {
        background: var(--gold-light);
        padding: 25px;
        border-radius: 8px;
        border-left: 4px solid var(--gold);
        margin-bottom: 30px;
    }

    .info-section h3 {
        color: var(--gold-dark);
        margin: 0 0 15px 0;
    }

    .info-section p {
        margin: 0 0 15px 0;
        line-height: 1.7;
        color: var(--text-secondary);
    }

    .info-section p:last-child {
        margin-bottom: 0;
    }

    .service-contact-strip {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: clamp(1.25rem, 4vw, 3rem);
        margin-top: clamp(2.25rem, 4vw, 3.25rem);
        padding: 1.4rem 0;
        border-top: 1px solid rgba(6, 26, 50, 0.2);
        border-bottom: 1px solid rgba(6, 26, 50, 0.2);
        align-items: center;
    }

    .service-contact-heading {
        display: flex;
        min-width: 0;
        align-items: center;
        gap: 0.9rem;
    }

    .service-contact-heading h4 {
        margin: 0;
        color: var(--primary-blue);
        font-family: var(--font-display);
        font-size: clamp(1.25rem, 2.3vw, 1.7rem);
        line-height: 1.15;
    }

    .service-contact-icon {
        display: inline-flex;
        width: 2.75rem;
        height: 2.75rem;
        flex: 0 0 auto;
        border: 1px solid rgba(209, 161, 45, 0.58);
        border-radius: 50%;
        align-items: center;
        justify-content: center;
        color: var(--primary-blue);
    }

    .service-contact-icon svg,
    .service-contact-actions svg {
        width: 1.25rem;
        height: 1.25rem;
    }

    .service-contact-actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: 0.65rem;
    }

    .service-contact-actions a {
        display: inline-flex;
        min-height: 46px;
        padding: 0.7rem 1rem;
        border: 1px solid rgba(6, 26, 50, 0.28);
        border-radius: 0.45rem;
        align-items: center;
        gap: 0.55rem;
        background: transparent;
        color: var(--primary-blue);
        font-family: var(--font-body);
        font-size: 0.92rem;
        font-weight: 700;
        text-decoration: none;
        transition: background-color 180ms ease, border-color 180ms ease, color 180ms ease;
    }

    .service-contact-actions a:first-child {
        border-color: var(--primary-blue);
        background: var(--primary-blue);
        color: #fff;
    }

    .service-contact-actions strong {
        color: inherit;
    }

    .service-contact-actions a:hover {
        border-color: var(--gold);
        background: var(--gold);
        color: var(--primary-blue);
    }

    @media (max-width: 767px) {
        .timeline-item {
            flex-direction: column;
            gap: 10px;
        }

        .time-badge {
            width: fit-content;
        }

        .service-contact-strip {
            grid-template-columns: 1fr;
            gap: 1.1rem;
            padding-block: 1.25rem;
        }

        .service-contact-actions {
            display: grid;
            grid-template-columns: 1fr 1fr;
        }

        .service-contact-actions a {
            justify-content: center;
        }
    }

    @media (max-width: 420px) {
        .service-contact-actions {
            grid-template-columns: 1fr;
        }
    }
</style>
