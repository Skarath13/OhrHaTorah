---
import PageLayout from '../layouts/PageLayout.astro';
import {
    IconBook,
    IconBookmark,
    IconBuilding,
    IconBuildingCommunity,
    IconBulb,
    IconExternalLink,
    IconJewishStar,
    IconNews,
    IconPlant2,
    IconPray,
    IconSchool,
    IconScript,
    IconTree,
    IconWorld,
} from '@tabler/icons-astro';
---

<PageLayout title="Messianic Jewish Resources - Ohr HaTorah" pageTitle="Messianic Jewish Resources for Beginners">
    <p class="intro-text"><strong>Explore the rich heritage of Messianic Judaism with these trusted resources and organizations.</strong></p>

    <!-- Major Organizations -->
    <div class="resource-section">
        <h3><IconBuilding aria-hidden="true" /> Major Organizations</h3>

        <div class="resource-card">
            <h4><IconBuildingCommunity aria-hidden="true" /> Union of Messianic Jewish Congregations (UMJC)</h4>
            <p>A network of more than 80 Messianic congregations worldwide that honor Yeshua as Messiah. It provides mutual support, leadership development, and practical guidance for congregations.</p>
            <a href="https://www.umjc.org/" target="_blank" rel="noopener noreferrer" class="resource-link">
                Visit UMJC <IconExternalLink aria-hidden="true" />
            </a>
        </div>

        <div class="resource-card">
            <h4><IconWorld aria-hidden="true" /> Jewish Voice Ministries</h4>
            <p>A Messianic Jewish ministry sharing the Gospel of Yeshua to Jewish people first and also to Gentiles. Offers educational resources and humanitarian aid worldwide.</p>
            <a href="https://www.jewishvoice.org/" target="_blank" rel="noopener noreferrer" class="resource-link">
                Visit Jewish Voice <IconExternalLink aria-hidden="true" />
            </a>
        </div>
    </div>

    <!-- Educational Resources -->
    <div class="resource-section">
        <h3><IconSchool aria-hidden="true" /> Educational Resources</h3>

        <div class="resource-card">
            <h4><IconPlant2 aria-hidden="true" /> First Fruits of Zion (FFOZ)</h4>
            <p>Specializes in teaching Scripture from its historical, linguistic, and cultural Jewish context. Offers Torah Club studies, books, and educational materials connecting Christians with Jewish foundations.</p>
            <a href="https://ffoz.org/" target="_blank" rel="noopener noreferrer" class="resource-link">
                Visit FFOZ <IconExternalLink aria-hidden="true" />
            </a>
        </div>

        <div class="resource-card">
            <h4><IconJewishStar aria-hidden="true" /> Chosen People Ministries</h4>
            <p>Founded in 1894, this ministry reaches Jewish people with the Gospel in 17 countries. Offers evangelism training, Passover presentations, and educational resources about Jewish evangelism.</p>
            <a href="https://chosenpeople.com/" target="_blank" rel="noopener noreferrer" class="resource-link">
                Visit Chosen People <IconExternalLink aria-hidden="true" />
            </a>
        </div>

        <div class="resource-card">
            <h4><IconPray aria-hidden="true" /> Jews for Jesus</h4>
            <p>Provides resources for Jewish holidays, Scripture study, interfaith couples, and lifecycle events. Known for creative evangelism and Jewish cultural education materials.</p>
            <a href="https://jewsforjesus.org/" target="_blank" rel="noopener noreferrer" class="resource-link">
                Visit Jews for Jesus <IconExternalLink aria-hidden="true" />
            </a>
        </div>
    </div>

    <!-- Publishers & Books -->
    <div class="resource-section">
        <h3><IconBook aria-hidden="true" /> Publishers & Essential Books</h3>

        <div class="resource-card">
            <h4><IconBookmark aria-hidden="true" /> Messianic Jewish Publishers</h4>
            <p>The only full-fledged Messianic Jewish publishing house. Publishers of the Complete Jewish Study Bible, Torah devotionals, and essential Messianic literature for beginners and scholars.</p>
            <a href="https://www.messianicjewish.net/" target="_blank" rel="noopener noreferrer" class="resource-link">
                Visit MJ Publishers <IconExternalLink aria-hidden="true" />
            </a>
        </div>

        <div class="resource-card">
            <h4><IconTree aria-hidden="true" /> Tree of Life Version Bible (TLV)</h4>
            <p>A distinctive Messianic Jewish translation highlighting the Jewish roots of faith. Created by Jewish believers and Christian scholars to restore the Jewish essence of Scripture.</p>
            <a href="https://tlvbiblesociety.org/" target="_blank" rel="noopener noreferrer" class="resource-link">
                Visit TLV Bible <IconExternalLink aria-hidden="true" />
            </a>
        </div>

        <div class="resource-card">
            <h4><IconNews aria-hidden="true" /> The Messianic Times</h4>
            <p>Leading international Messianic Jewish newspaper published six times yearly. Features news, articles, and perspectives from the worldwide Messianic community.</p>
            <a href="https://messianictimes.com/" target="_blank" rel="noopener noreferrer" class="resource-link">
                Visit Messianic Times <IconExternalLink aria-hidden="true" />
            </a>
        </div>

        <div class="resource-card">
            <h4><IconScript aria-hidden="true" /> Complete Jewish Study Bible</h4>
            <p>A study Bible with Jewish cultural context, commentary, and notes. It offers a useful starting point for understanding Scripture from a Messianic Jewish perspective.</p>
        </div>
    </div>

    <!-- Getting Started -->
    <div class="tips-section">
        <h3><IconBulb aria-hidden="true" /> Getting Started Tips</h3>
        <ul>
            <li>Begin with the <strong>Complete Jewish Study Bible</strong> for foundational understanding</li>
            <li>Explore <strong>FFOZ Torah Club</strong> for small group study</li>
            <li>Connect with local congregations through <strong>UMJC</strong></li>
            <li>Subscribe to <strong>The Messianic Times</strong> for community news and insights</li>
            <li>Attend conferences and events hosted by these organizations</li>
        </ul>
    </div>
</PageLayout>

<style>
    .intro-text {
        text-align: center;
        font-size: 1.1rem;
        margin-bottom: 30px;
    }

    .resource-section {
        margin-bottom: 35px;
    }

    .resource-section h3 {
        color: var(--primary-blue);
        border-bottom: 2px solid var(--primary-blue);
        padding-bottom: 10px;
        margin-bottom: 20px;
    }

    .resource-card {
        background: var(--gray-100);
        padding: 20px 25px;
        border-radius: 8px;
        margin-bottom: 15px;
    }

    .resource-card h4 {
        color: var(--primary-blue);
        margin: 0 0 12px 0;
        font-size: 1.1rem;
    }

    .resource-card h4 svg {
        width: 1.25rem;
        height: 1.25rem;
        margin-right: 8px;
        color: var(--gold-dark);
    }

    .resource-card p {
        margin: 0 0 15px 0;
        line-height: 1.7;
        color: var(--text-secondary);
    }

    .resource-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: var(--primary-blue);
        color: white;
        padding: 8px 16px;
        border-radius: 6px;
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 500;
        transition: background 0.3s ease;
    }

    .resource-link:hover {
        background: #004080;
    }

    .tips-section {
        background: var(--gold-light);
        padding: 25px;
        border-radius: 8px;
        border-left: 4px solid var(--gold);
    }

    .tips-section h3 {
        color: var(--gold-dark);
        margin: 0 0 15px 0;
    }

    .tips-section ul {
        margin: 0;
        padding-left: 20px;
    }

    .tips-section li {
        margin-bottom: 10px;
        line-height: 1.6;
        color: var(--text-secondary);
    }
</style>
