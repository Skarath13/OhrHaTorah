---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout title="Messianic Jewish Resources - Ohr HaTorah" pageTitle="Messianic Jewish Resources" pageIcon="fas fa-book-open" description="Organizations, books, and study resources for learning about Messianic Jewish faith and practice.">
    <p class="intro-text"><strong>These organizations and publications are useful places to continue learning.</strong></p>

    <!-- Major Organizations -->
    <div class="resource-section">
        <h3><i class="fas fa-building"></i> Major Organizations</h3>

        <div class="resource-card">
            <h4><i class="fas fa-synagogue"></i> Union of Messianic Jewish Congregations (UMJC)</h4>
            <p>A union of Messianic Jewish congregations committed to Yeshua, Jewish life, mutual support, and congregational leadership.</p>
            <a href="https://www.umjc.org/" target="_blank" rel="noopener noreferrer" class="resource-link">
                Visit UMJC <i class="fas fa-external-link-alt"></i>
            </a>
        </div>

        <div class="resource-card">
            <h4><i class="fas fa-globe"></i> Jewish Voice Ministries</h4>
            <p>A Messianic Jewish ministry offering teaching, outreach, and humanitarian programs.</p>
            <a href="https://www.jewishvoice.org/" target="_blank" rel="noopener noreferrer" class="resource-link">
                Visit Jewish Voice <i class="fas fa-external-link-alt"></i>
            </a>
        </div>
    </div>

    <!-- Educational Resources -->
    <div class="resource-section">
        <h3><i class="fas fa-graduation-cap"></i> Educational Resources</h3>

        <div class="resource-card">
            <h4><i class="fas fa-seedling"></i> First Fruits of Zion (FFOZ)</h4>
            <p>Teaching and study materials that explore Scripture in its historical, linguistic, and Jewish context.</p>
            <a href="https://ffoz.org/" target="_blank" rel="noopener noreferrer" class="resource-link">
                Visit FFOZ <i class="fas fa-external-link-alt"></i>
            </a>
        </div>

        <div class="resource-card">
            <h4><i class="fas fa-star-of-david"></i> Chosen People Ministries</h4>
            <p>Resources on Jewish evangelism, Passover, Scripture, and congregational learning.</p>
            <a href="https://chosenpeople.com/" target="_blank" rel="noopener noreferrer" class="resource-link">
                Visit Chosen People <i class="fas fa-external-link-alt"></i>
            </a>
        </div>

        <div class="resource-card">
            <h4><i class="fas fa-pray"></i> Jews for Jesus</h4>
            <p>Articles and resources on Jewish holidays, Scripture, interfaith families, and Jewish life.</p>
            <a href="https://jewsforjesus.org/" target="_blank" rel="noopener noreferrer" class="resource-link">
                Visit Jews for Jesus <i class="fas fa-external-link-alt"></i>
            </a>
        </div>
    </div>

    <!-- Publishers and books -->
    <div class="resource-section">
        <h3><i class="fas fa-book"></i> Publishers and books</h3>

        <div class="resource-card">
            <h4><i class="fas fa-bookmark"></i> Messianic Jewish Publishers</h4>
            <p>A publisher of Messianic Jewish Bibles, Torah studies, devotionals, and reference works.</p>
            <a href="https://www.messianicjewish.net/" target="_blank" rel="noopener noreferrer" class="resource-link">
                Visit MJ Publishers <i class="fas fa-external-link-alt"></i>
            </a>
        </div>

        <div class="resource-card">
            <h4><i class="fas fa-tree"></i> Tree of Life Version Bible (TLV)</h4>
            <p>A Bible translation shaped by Messianic Jewish language, tradition, and the Jewish context of Scripture.</p>
            <a href="https://tlvbiblesociety.org/" target="_blank" rel="noopener noreferrer" class="resource-link">
                Visit TLV Bible <i class="fas fa-external-link-alt"></i>
            </a>
        </div>

        <div class="resource-card">
            <h4><i class="fas fa-newspaper"></i> The Messianic Times</h4>
            <p>News, essays, and perspectives from Messianic Jewish communities.</p>
            <a href="https://messianictimes.com/" target="_blank" rel="noopener noreferrer" class="resource-link">
                Visit Messianic Times <i class="fas fa-external-link-alt"></i>
            </a>
        </div>

        <div class="resource-card">
            <h4><i class="fas fa-scroll"></i> Complete Jewish Study Bible</h4>
            <p>A study Bible with commentary and notes on the Jewish context of Scripture.</p>
        </div>
    </div>

    <!-- Getting Started -->
    <div class="tips-section">
        <h3><i class="fas fa-lightbulb"></i> Where to begin</h3>
        <ul>
            <li>Read the <strong>Complete Jewish Study Bible</strong> alongside your usual translation.</li>
            <li>Explore <strong>FFOZ Torah Club</strong> for structured study.</li>
            <li>Use the <strong>UMJC</strong> directory to find affiliated congregations.</li>
            <li>Read <strong>The Messianic Times</strong> for community news and perspectives.</li>
        </ul>
    </div>
</PageLayout>

<style>
    .intro-text {
        text-align: center;
        font-size: 1.1rem;
        margin-bottom: 30px;
    }

    .resource-section {
        margin-bottom: 35px;
    }

    .resource-section h3 {
        color: var(--primary-blue);
        border-bottom: 2px solid var(--primary-blue);
        padding-bottom: 10px;
        margin-bottom: 20px;
    }

    .resource-card {
        background: var(--gray-100);
        padding: 20px 25px;
        border-radius: 8px;
        margin-bottom: 15px;
    }

    .resource-card h4 {
        color: var(--primary-blue);
        margin: 0 0 12px 0;
        font-size: 1.1rem;
    }

    .resource-card h4 i {
        margin-right: 8px;
        color: var(--gold-dark);
    }

    .resource-card p {
        margin: 0 0 15px 0;
        line-height: 1.7;
        color: var(--text-secondary);
    }

    .resource-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: var(--primary-blue);
        color: white;
        padding: 8px 16px;
        border-radius: 6px;
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 500;
        transition: background 0.3s ease;
    }

    .resource-link:hover {
        background: #004080;
    }

    .tips-section {
        background: var(--gold-light);
        padding: 25px;
        border-radius: 8px;
        border-left: 4px solid var(--gold);
    }

    .tips-section h3 {
        color: var(--gold-dark);
        margin: 0 0 15px 0;
    }

    .tips-section ul {
        margin: 0;
        padding-left: 20px;
    }

    .tips-section li {
        margin-bottom: 10px;
        line-height: 1.6;
        color: var(--text-secondary);
    }
</style>
