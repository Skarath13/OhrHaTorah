---
import PageLayout from '../layouts/PageLayout.astro';
import ConstructionNotice from '../components/layout/ConstructionNotice.astro';
import { canViewAdminPreview } from '../lib/adminPreview';
const canPreview = canViewAdminPreview(Astro.locals.user);
Astro.response.headers.set('Cache-Control', 'private, no-store, max-age=0');
Astro.response.headers.append('Vary', 'Cookie');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
---

<PageLayout title="What to Expect - Kehilat Ohr HaTorah" pageTitle="What to Expect" pageIcon="fas fa-door-open" description="A practical guide to your first Shabbat service at Kehilat Ohr HaTorah.">
    {canPreview ? (<div data-admin-draft>
        <p class="editorial-note">Internal admin preview · This page is under construction.</p>

    <p class="intro-text"><strong>Your first visit should feel comfortable and unhurried. Here is what to expect.</strong></p>

    <!-- Service Flow -->
    <div class="section">
        <h3><i class="fas fa-clock"></i> Saturday Service Flow</h3>
        <div class="timeline">
            <div class="timeline-item">
                <div class="time-badge blue">2:30 PM</div>
                <div class="timeline-content">
                    <strong>Messianic Music and Dance</strong>
                    <p>We begin with music and Israeli dance. You are welcome to join or simply watch.</p>
                </div>
            </div>

            <div class="timeline-item">
                <div class="time-badge gold">3:00 PM</div>
                <div class="timeline-content">
                    <strong>Traditional Mincha Service</strong>
                    <p>The Mincha service includes Hebrew and English prayer, Torah reading, and blessings.</p>
                </div>
            </div>

            <div class="timeline-item">
                <div class="time-badge green">4:30 PM</div>
                <div class="timeline-content">
                    <strong>Kiddush, food, and discussion</strong>
                </div>
            </div>
        </div>
    </div>

    <!-- What You'll Experience -->
    <div class="section">
        <h3><i class="fas fa-star"></i> What You'll Experience</h3>
        <div class="experience-grid">
            <div class="experience-item">
                <h4 class="icon-heading"><i class="fas fa-language editorial-icon" aria-hidden="true"></i><span>Hebrew & English</span></h4>
                <p>Services blend Hebrew prayers with English explanations. Prayer books provided with transliteration.</p>
            </div>
            <div class="experience-item">
                <h4 class="icon-heading"><i class="fas fa-music editorial-icon" aria-hidden="true"></i><span>Joyful Music</span></h4>
                <p>Contemporary Israeli and Messianic songs with guitar, keyboard, vocals, and congregational dance.</p>
            </div>
            <div class="experience-item">
                <h4 class="icon-heading"><i class="fas fa-scroll editorial-icon" aria-hidden="true"></i><span>Torah Reading</span></h4>
                <p>Weekly Torah portion read in Hebrew with English translation and commentary.</p>
            </div>
            <div class="experience-item">
                <h4 class="icon-heading"><i class="fas fa-comments editorial-icon" aria-hidden="true"></i><span>Discussion Time</span></h4>
                <p>Interactive study where questions are welcomed and insights are shared together.</p>
            </div>
        </div>
    </div>

    <!-- Practical Information -->
    <div class="section practical-section">
        <h3><i class="fas fa-info-circle"></i> Practical Information</h3>
        <div class="practical-grid">
            <div class="practical-item">
                <h4><i class="fas fa-tshirt"></i> What to Wear</h4>
                <ul>
                    <li>Casual to semi-formal attire</li>
                    <li>Modest clothing preferred</li>
                    <li>Men may wear kippah (optional for visitors)</li>
                    <li>Comfortable shoes for dancing</li>
                </ul>
            </div>
            <div class="practical-item">
                <h4><i class="fas fa-book"></i> What's Provided</h4>
                <ul>
                    <li>Siddur (prayer book) with transliteration</li>
                    <li>Torah reading handouts</li>
                    <li>Visitor welcome packet</li>
                    <li>Explanation of customs and prayers</li>
                </ul>
            </div>
        </div>
    </div>

    <!-- First-Time Visitor Tips -->
    <div class="tips-section">
        <h3><i class="fas fa-lightbulb"></i> First-Time Visitor Tips</h3>
        <ul>
            <li><strong>Arrive 10 to 15 minutes early</strong> to get settled</li>
            <li><strong>No Hebrew is required.</strong> Transliteration and English explanations are provided</li>
            <li><strong>Participate at your own pace</strong></li>
            <li><strong>Stay after the service</strong> to meet the community</li>
            <li><strong>No advance notice is needed</strong></li>
        </ul>
    </div>


    </div>) : <ConstructionNotice />}
</PageLayout>

<style>
    .intro-text {
        text-align: center;
        font-size: 1.1rem;
        margin-bottom: 30px;
    }

    .section {
        margin-bottom: 35px;
    }

    .section h3 {
        color: var(--primary-blue);
        margin-bottom: 20px;
    }

    .timeline {
        display: flex;
        flex-direction: column;
        gap: 15px;
    }

    .timeline-item {
        display: flex;
        align-items: flex-start;
        gap: 20px;
        background: var(--gray-100);
        padding: 20px;
        border-radius: 8px;
    }

    .time-badge {
        padding: 8px 15px;
        border-radius: 6px;
        color: white;
        font-weight: bold;
        white-space: nowrap;
        min-width: 0;
        text-align: center;
    }

    .time-badge.blue { background: var(--primary-blue); }
    .time-badge.gold { background: var(--gold-dark); }
    .time-badge.green { background: var(--accent-green); }

    .timeline-content strong {
        display: block;
        color: var(--text-primary);
        margin-bottom: 5px;
    }

    .timeline-content p {
        margin: 0;
        color: var(--text-secondary);
        font-size: 1rem;
    }

    .experience-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 20px;
    }

    .experience-item {
        background: var(--gray-100);
        padding: 25px;
        border-radius: 8px;
        text-align: center;
    }

    .experience-item i {
        font-size: 1.35rem;
        color: var(--primary-blue);
        margin: 0;
    }

    .experience-item h4 {
        color: var(--primary-blue);
        margin: 0 0 10px 0;
    }

    .experience-item p {
        margin: 0;
        color: var(--text-secondary);
        font-size: 1rem;
        line-height: 1.6;
    }

    .practical-section h3 {
        color: var(--primary-blue);
    }

    .practical-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
    }

    .practical-item {
        background: var(--gray-100);
        padding: 20px;
        border-radius: 8px;
    }

    .practical-item h4 {
        color: var(--gold-dark);
        margin: 0 0 15px 0;
    }

    .practical-item ul {
        margin: 0;
        padding-left: 20px;
    }

    .practical-item li {
        margin-bottom: 8px;
        color: var(--text-secondary);
    }

    .tips-section {
        background: var(--gold-light);
        padding: 25px;
        border-radius: 8px;
        border-left: 4px solid var(--gold-dark);
        margin-bottom: 25px;
    }

    .tips-section h3 {
        color: var(--gold-dark);
        margin: 0 0 15px 0;
    }

    .tips-section ul {
        margin: 0;
        padding-left: 20px;
    }

    .tips-section li {
        margin-bottom: 10px;
        line-height: 1.6;
        color: var(--text-secondary);
    }

    .welcome-banner {
        background: linear-gradient(135deg, var(--primary-blue) 0%, #004080 100%);
        color: white;
        padding: 25px;
        border-radius: 8px;
        text-align: center;
    }

    .welcome-banner p {
        margin: 0;
        font-size: 1.1rem;
    }

    @media (max-width: 767px) {
        .timeline-item {
            flex-direction: column;
            gap: 10px;
        }

        .time-badge {
            width: fit-content;
        }
    }
</style>
