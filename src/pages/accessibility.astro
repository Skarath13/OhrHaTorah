---
import PageLayout from '../layouts/PageLayout.astro';
import Editable from '../components/content/Editable.astro';
import { congregationName } from '../data/congregationIdentity';
---

<PageLayout
    title={`Website Accessibility | ${congregationName}`}
    pageTitle="Website Accessibility"
    description={`${congregationName}'s commitment to an accessible and welcoming public website.`}
    stylesheets={['/styles/policies.css']}
>
    <div class="policy-page">
        <header class="policy-intro">

            <Editable field="accessibility.lede" as="p" class="policy-lede"><strong>{congregationName}</strong> values the dignity of every person. We want our public website to be understandable and usable by people with diverse abilities, devices, and ways of navigating.</Editable>
            <p class="policy-updated">Last updated <time datetime="2026-08-11">August 11, 2026</time></p>
            <nav class="policy-contents" aria-label="Website Accessibility sections">
                <a href="#commitment"><Editable field="accessibility.nav.commitment">Our commitment</Editable></a>
                <a href="#approach"><Editable field="accessibility.nav.approach">Our approach</Editable></a>
                <a href="#third-party-accessibility"><Editable field="accessibility.nav.third-party-accessibility">Third parties</Editable></a>
                <a href="#accessibility-feedback"><Editable field="accessibility.nav.accessibility-feedback">Feedback</Editable></a>
            </nav>
        </header>

        <section class="policy-section" id="commitment">
            <Editable field="accessibility.commitment.heading" as="h2">Our commitment</Editable>
            <div class="policy-copy">
                <Editable field="accessibility.commitment.p-1" as="p">We are working toward conformance with the <a href="https://www.w3.org/TR/WCAG22/" target="_blank" rel="noopener noreferrer">Web Content Accessibility Guidelines (WCAG) 2.2, Level AA</a> as a practical guide for improving access. This is an ongoing effort, not a claim that every page or third-party feature is free of barriers.</Editable>
            </div>
        </section>

        <section class="policy-section" id="approach">
            <Editable field="accessibility.approach.heading" as="h2">How we support access</Editable>
            <div class="policy-copy">
                <Editable field="accessibility.approach.p-1" as="p">Our current approach includes:</Editable>
                <ul class="policy-list">
                    <Editable field="accessibility.approach.li-1" as="li">semantic headings, landmarks, labels, and descriptive link text;</Editable>
                    <Editable field="accessibility.approach.li-2" as="li">keyboard-accessible navigation and visible focus treatment;</Editable>
                    <Editable field="accessibility.approach.li-3" as="li">responsive layouts that adapt across common phone, tablet, and desktop sizes;</Editable>
                    <Editable field="accessibility.approach.li-4" as="li">text and interface contrast considered in the site’s visual system;</Editable>
                    <Editable field="accessibility.approach.li-5" as="li">support for reduced-motion preferences where motion is used; and</Editable>
                    <Editable field="accessibility.approach.li-6" as="li">ongoing review of content structure, alternative text, form instructions, and error feedback.</Editable>
                </ul>
                <Editable field="accessibility.approach.p-2" as="p">Technology and needs change. We will continue to review the site and prioritize practical fixes when a barrier is identified.</Editable>
            </div>
        </section>

        <section class="policy-section" id="third-party-accessibility">
            <Editable field="accessibility.third-party-accessibility.heading" as="h2">Third-party content</Editable>
            <div class="policy-copy">
                <Editable field="accessibility.third-party-accessibility.p-1" as="p">Some maps, forms, calendar information, icons, and linked resources are supplied by third parties. We do not control every aspect of those services, but we welcome reports about a barrier and will look for a reasonable alternative when one is available.</Editable>
            </div>
        </section>

        <section class="policy-section policy-section-contact" id="accessibility-feedback">
            <Editable field="accessibility.accessibility-feedback.heading" as="h2">Request help or report a barrier</Editable>
            <div class="policy-copy">
                <Editable field="accessibility.accessibility-feedback.p-1" as="p">If you have difficulty using this website or need information in another reasonable format, please contact <strong>{congregationName}</strong>:</Editable>
                <ul class="policy-contact-list">
                    <li><Editable field="accessibility.accessibility-feedback.label-email">Email</Editable><a href="mailto:OhrHaTorahOC@gmail.com">OhrHaTorahOC@gmail.com</a></li>
                    <li><Editable field="accessibility.accessibility-feedback.label-phone">Phone</Editable><a href="tel:+17144061513">(714) 406-1513</a></li>
                    <li><Editable field="accessibility.accessibility-feedback.label-mail">Mail</Editable><address>360 E. 1st Street, #856, Tustin, CA 92780</address></li>
                </ul>
                <Editable field="accessibility.accessibility-feedback.p-2" as="p">It helps to include the page address, what you were trying to do, the barrier you encountered, and—if you are comfortable sharing it—the browser, device, or assistive technology you were using. We will make a good-faith effort to respond and provide a reasonable way to access the information.</Editable>
            </div>
        </section>
    </div>
</PageLayout>
