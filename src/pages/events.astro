---
import PageLayout from '../layouts/PageLayout.astro';
import {
    IconCalendarEvent,
    IconHelpCircle,
    IconMail,
    IconPhone,
} from '@tabler/icons-astro';
---

<PageLayout title="Special Events - Ohr HaTorah" pageTitle="Special Events & Community Gatherings">
    <p class="intro-text"><strong>Special event information and details will be posted as events are planned and scheduled.</strong></p>

    <div class="events-empty-state">
        <IconCalendarEvent aria-hidden="true" />
        <div>
            <h3>No special events are currently published.</h3>
            <p>Weekly Shabbat services continue every Saturday at 2:30 PM in Fountain Valley. Confirmed holiday observances and special gatherings will appear here when dates are available.</p>
            <a href="/#visit">Plan a Shabbat visit</a>
        </div>
    </div>

    <div class="contact-box">
        <h4><IconHelpCircle aria-hidden="true" /> For more information about upcoming special events:</h4>
        <div class="contact-links">
            <a href="tel:+17144061513"><IconPhone aria-hidden="true" /> (714) 406-1513</a>
            <a href="mailto:OhrHaTorahOC@gmail.com"><IconMail aria-hidden="true" /> OhrHaTorahOC@gmail.com</a>
        </div>
    </div>
</PageLayout>

<style>
    .intro-text {
        text-align: center;
        font-size: 1.1rem;
        margin-bottom: 15px;
    }

    .events-empty-state {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 24px;
        margin-bottom: 40px;
        padding: 32px;
        border-top: 2px solid var(--gold);
        background: var(--gray-100);
    }

    .events-empty-state > svg {
        width: 2.25rem;
        height: 2.25rem;
        color: var(--gold-dark);
    }

    .events-empty-state h3 {
        color: var(--primary-blue);
        margin: 0 0 12px;
    }

    .events-empty-state p {
        max-width: 44rem;
        margin: 0 0 18px;
        color: var(--text-secondary);
    }

    .events-empty-state a {
        color: var(--primary-blue);
        font-weight: 700;
        text-underline-offset: 4px;
    }

    .contact-box {
        background: linear-gradient(135deg, var(--primary-blue) 0%, #004080 100%);
        color: white;
        padding: 25px;
        border-radius: 8px;
        text-align: center;
    }

    .contact-box h4 {
        margin: 0 0 15px 0;
        color: white;
    }

    .contact-links {
        display: flex;
        justify-content: center;
        gap: 20px;
        flex-wrap: wrap;
    }

    .contact-links a {
        color: white;
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 8px;
        background: rgba(255, 255, 255, 0.1);
        padding: 10px 20px;
        border-radius: 6px;
        transition: background 0.3s ease;
    }

    .contact-links a:hover {
        background: rgba(255, 255, 255, 0.2);
    }

    @media (max-width: 600px) {
        .events-empty-state {
            grid-template-columns: 1fr;
            padding: 24px;
        }
    }
</style>
