---
import PageLayout from '../layouts/PageLayout.astro';
import ConstructionNotice from '../components/layout/ConstructionNotice.astro';
import { canViewAdminPreview } from '../lib/adminPreview';
const canPreview = canViewAdminPreview(Astro.locals.user);
Astro.response.headers.set('Cache-Control', 'private, no-store, max-age=0');
Astro.response.headers.append('Vary', 'Cookie');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
---

<PageLayout title="Special Events - Kehilat Ohr HaTorah" pageTitle="Special Events" pageIcon="fas fa-star" description="Holiday gatherings, learning, music, and community events at Kehilat Ohr HaTorah.">
    {canPreview ? (<div data-admin-draft>
        <p class="editorial-note">Internal admin preview · This page is under construction.</p>

    <p class="intro-text"><strong>Join us for holiday gatherings, learning, music, and community throughout the year.</strong></p>

    <p class="description">Dates and details are added to the congregation calendar as they are confirmed. Our gatherings may include:</p>

    <div class="events-grid">
        <div class="event-card">
            <h3 class="icon-heading"><i class="fas fa-utensils editorial-icon" aria-hidden="true"></i><span>Community Dinners</span></h3>
            <p>Fellowship meals and celebrations</p>
        </div>

        <div class="event-card">
            <h3 class="icon-heading"><i class="fas fa-microphone editorial-icon" aria-hidden="true"></i><span>Guest Speakers</span></h3>
            <p>Teaching from visiting rabbis and scholars</p>
        </div>

        <div class="event-card">
            <h3 class="icon-heading"><i class="fas fa-music editorial-icon" aria-hidden="true"></i><span>Concerts and Music</span></h3>
            <p>Messianic Jewish music and worship gatherings</p>
        </div>

        <div class="event-card">
            <h3 class="icon-heading"><i class="fas fa-chalkboard-teacher editorial-icon" aria-hidden="true"></i><span>Educational Workshops</span></h3>
            <p>Hebrew language and Jewish culture</p>
        </div>

        <div class="event-card">
            <h3 class="icon-heading"><i class="fas fa-handshake editorial-icon" aria-hidden="true"></i><span>Interfaith Dialogues</span></h3>
            <p>Building bridges in our community</p>
        </div>

        <div class="event-card">
            <h3 class="icon-heading"><i class="fas fa-child editorial-icon" aria-hidden="true"></i><span>Youth Activities</span></h3>
            <p>Special programs for children and teens</p>
        </div>

        <div class="event-card">
            <h3 class="icon-heading"><i class="fas fa-hands-helping editorial-icon" aria-hidden="true"></i><span>Volunteer Opportunities</span></h3>
            <p>Serving our local community</p>
        </div>
    </div>

    <div class="contact-box">
        <h4><i class="fas fa-question-circle"></i> Questions about upcoming events?</h4>
        <div class="contact-links">
            <a href="tel:+17144061513" aria-label="Call Kehilat Ohr HaTorah at (714) 406-1513"><i class="fas fa-phone"></i> Call us</a>
            <a href="mailto:OhrHaTorahOC@gmail.com" aria-label="Email Kehilat Ohr HaTorah at OhrHaTorahOC@gmail.com"><i class="fas fa-envelope"></i> Email us</a>
        </div>
    </div>

    </div>) : <ConstructionNotice />}
</PageLayout>

<style>
    .intro-text {
        text-align: center;
        font-size: 1.1rem;
        margin-bottom: 15px;
    }

    .description {
        text-align: center;
        color: var(--text-secondary);
        margin-bottom: 30px;
    }

    .events-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .event-card {
        background: var(--gray-100);
        padding: 25px;
        border-radius: 12px;
        text-align: left;
    }

    .event-card i {
        font-size: 1.35rem;
        color: var(--primary-blue);
        margin: 0;
    }

    .event-card h3 {
        color: var(--primary-blue);
        font-size: 1.1rem;
        margin: 0 0 8px 0;
    }

    .event-card p {
        margin: 0;
        color: var(--text-secondary);
        font-size: 1rem;
    }

    .info-box {
        background: var(--gold-light);
        padding: 20px;
        border-radius: 8px;
        border-left: 4px solid var(--gold);
        margin-bottom: 30px;
    }

    .info-box p {
        margin: 0;
        color: var(--text-secondary);
        line-height: 1.7;
    }

    .contact-box {
        background: linear-gradient(135deg, var(--primary-blue) 0%, #004080 100%);
        color: white;
        padding: 25px;
        border-radius: 8px;
        text-align: center;
    }

    .contact-box h4 {
        margin: 0 0 15px 0;
        color: white;
    }

    .contact-links {
        display: flex;
        justify-content: center;
        gap: 20px;
        flex-wrap: wrap;
    }

    .contact-links a {
        color: white;
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 8px;
        background: rgba(255, 255, 255, 0.1);
        padding: 10px 20px;
        border-radius: 6px;
        transition: background 0.3s ease;
    }

    .contact-links a:hover {
        background: rgba(255, 255, 255, 0.2);
    }
</style>
