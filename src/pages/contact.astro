        </section>
        <section class="editorial-section editorial-columns">
            <div><h2 class="icon-heading"><i class="fas fa-envelope editorial-icon" aria-hidden="true"></i><span>Email</span></h2><a class="text-link contact-address" href="mailto:OhrHaTorahOC@gmail.com">OhrHaTorahOC@gmail.com</a></div>
            <div><h2 class="icon-heading"><i class="fas fa-phone editorial-icon" aria-hidden="true"></i><span>Phone</span></h2><a class="text-link" href="tel:+17144061513">(714) 406-1513</a></div>
