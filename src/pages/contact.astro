---
import PageLayout from '../layouts/PageLayout.astro';
import Editable from '../components/content/Editable.astro';
---
<PageLayout title="Contact Kehilat Ohr HaTorah" pageTitle="Contact Us" description="Contact Kehilat Ohr HaTorah by email or phone, or find our service and mailing addresses.">
    <div class="editorial-page">
        <section class="editorial-lead">
            <div><Editable field="contact.lead-heading" as="h2">Get in touch</Editable><Editable field="contact.lead-text" as="p">Questions about services, visiting, or community life? Reach us by email or phone.</Editable></div>
            <aside class="editorial-side"><Editable field="contact.side-note" as="p">Receive the weekly congregation email and occasional important updates.</Editable><a class="text-link" href="#newsletter-form"><Editable field="contact.side-link">Request weekly emails</Editable> <i class="fas fa-arrow-down" aria-hidden="true"></i></a></aside>
        </section>
        <section class="editorial-section editorial-columns">
            <div><h2 class="icon-heading"><i class="fas fa-envelope editorial-icon" aria-hidden="true"></i><Editable field="contact.email-heading">Email</Editable></h2><a class="text-link contact-address" href="mailto:OhrHaTorahOC@gmail.com">OhrHaTorahOC@gmail.com</a></div>
            <div><h2 class="icon-heading"><i class="fas fa-phone editorial-icon" aria-hidden="true"></i><Editable field="contact.phone-heading">Phone</Editable></h2><a class="text-link" href="tel:+17144061513">(714) 406-1513</a></div>
        </section>
        <section class="editorial-section editorial-columns">
            <div><h2 class="icon-heading"><i class="fas fa-location-dot editorial-icon" aria-hidden="true"></i><Editable field="contact.location-heading">Service location</Editable></h2><address>10460 Slater Ave<br>Fountain Valley, CA 92708</address><Editable field="contact.service-time" as="p">Saturdays, beginning at 2:30 p.m.</Editable><a class="text-link" href="/#map"><Editable field="contact.map-link">Map and directions</Editable> <i class="fas fa-arrow-right" aria-hidden="true"></i></a></div>
            <div><h2 class="icon-heading"><i class="fas fa-envelopes-bulk editorial-icon" aria-hidden="true"></i><Editable field="contact.mailing-heading">Mailing address</Editable></h2><address>360 E. 1st Street, #856<br>Tustin, CA 92780</address></div>
        </section>
    </div>
</PageLayout>
