---
import PageLayout from '../layouts/PageLayout.astro';
import Editable from '../components/content/Editable.astro';
import ConstructionNotice from '../components/layout/ConstructionNotice.astro';
import { canViewAdminPreview } from '../lib/adminPreview';
const canPreview = canViewAdminPreview(Astro.locals.user);
Astro.response.headers.set('Cache-Control', 'private, no-store, max-age=0');
Astro.response.headers.append('Vary', 'Cookie');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
---

<PageLayout title="Frequently Asked Questions - Kehilat Ohr HaTorah" pageTitle="Frequently Asked Questions" pageIcon="fas fa-question-circle" description="Answers to common questions about Messianic Judaism and visiting Kehilat Ohr HaTorah.">
    {canPreview ? (<div data-admin-draft>
        <p class="editorial-note">Internal admin preview · This page is under construction.</p>

    <Editable field="faq.intro" as="p" class="faq-intro">Here are straightforward answers to the questions visitors ask most often.</Editable>

    <div class="faq-container">
        <div class="faq-item">
            <button class="faq-question" type="button" aria-expanded="false">
                <i class="fas fa-star-of-david faq-icon"></i>
                <Editable field="faq.q-messianic-judaism.question">What is Messianic Judaism?</Editable>
            </button>
            <div class="faq-answer" hidden>
                <Editable field="faq.q-messianic-judaism.answer" as="p">Messianic Judaism is a movement of Jewish people who believe that Yeshua (Jesus) is the promised Messiah of Israel, while maintaining Jewish identity, traditions, and observance of Torah.</Editable>
            </div>
        </div>

        <div class="faq-item">
            <button class="faq-question" type="button" aria-expanded="false">
                <i class="fas fa-users faq-icon"></i>
                <Editable field="faq.q-need-jewish.question">Do I need to be Jewish to attend?</Editable>
            </button>
            <div class="faq-answer" hidden>
                <Editable field="faq.q-need-jewish.answer" as="p">No. Jewish and non-Jewish people, interfaith couples, and families are welcome.</Editable>
            </div>
        </div>

        <div class="faq-item">
            <button class="faq-question" type="button" aria-expanded="false">
                <i class="fas fa-synagogue faq-icon"></i>
                <Editable field="faq.q-during-service.question">What should I expect during a service?</Editable>
            </button>
            <div class="faq-answer" hidden>
                <Editable field="faq.q-during-service.answer" as="p">Our services include Messianic music, Hebrew and English prayer, Torah reading, and teaching. We explain the liturgy and customs as we go.</Editable>
            </div>
        </div>

        <div class="faq-item">
            <button class="faq-question" type="button" aria-expanded="false">
                <i class="fas fa-menorah faq-icon"></i>
                <Editable field="faq.q-holidays.question">Do you follow Jewish holidays and traditions?</Editable>
            </button>
            <div class="faq-answer" hidden>
                <Editable field="faq.q-holidays.answer" as="p">Yes. We observe Shabbat and the Jewish holidays while recognizing Yeshua as our Messiah.</Editable>
            </div>
        </div>

        <div class="faq-item">
            <button class="faq-question" type="button" aria-expanded="false">
                <i class="fas fa-language faq-icon"></i>
                <Editable field="faq.q-hebrew-required.question">Is Hebrew required?</Editable>
            </button>
            <div class="faq-answer" hidden>
                <Editable field="faq.q-hebrew-required.answer" as="p">No. We pray and read in Hebrew and English, with transliteration and explanations for visitors.</Editable>
            </div>
        </div>

        <div class="faq-item">
            <button class="faq-question" type="button" aria-expanded="false">
                <i class="fas fa-scroll faq-icon"></i>
                <Editable field="faq.q-torah.question">What is the Torah?</Editable>
            </button>
            <div class="faq-answer" hidden>
                <Editable field="faq.q-torah.answer" as="p">The Torah is the first five books of the Bible (Genesis through Deuteronomy), containing God's instructions for living. We believe Torah remains relevant for believers today.</Editable>
            </div>
        </div>

        <div class="faq-item">
            <button class="faq-question" type="button" aria-expanded="false">
                <i class="fas fa-balance-scale faq-icon"></i>
                <Editable field="faq.q-vs-christianity.question">How is Messianic Judaism different from Christianity?</Editable>
            </button>
            <div class="faq-answer" hidden>
                <Editable field="faq.q-vs-christianity.answer" as="p">We believe Yeshua is the Messiah while remaining rooted in Jewish identity, worship, and practice.</Editable>
            </div>
        </div>

        <div class="faq-item">
            <button class="faq-question" type="button" aria-expanded="false">
                <i class="fas fa-tshirt faq-icon"></i>
                <Editable field="faq.q-what-to-wear.question">What should I wear to services?</Editable>
            </button>
            <div class="faq-answer" hidden>
                <Editable field="faq.q-what-to-wear.answer" as="p">Come in casual or semi-formal clothing. Men may wear a kippah, but visitors are not required to do so.</Editable>
            </div>
        </div>

        <div class="faq-item">
            <button class="faq-question" type="button" aria-expanded="false">
                <i class="fas fa-child faq-icon"></i>
                <Editable field="faq.q-children.question">Can children attend?</Editable>
            </button>
            <div class="faq-answer" hidden>
                <Editable field="faq.q-children.answer" as="p">Children are welcome. We are planning a Shabbat School as the congregation grows, and families are welcome in our services.</Editable>
            </div>
        </div>

        <div class="faq-item">
            <button class="faq-question" type="button" aria-expanded="false">
                <i class="fas fa-graduation-cap faq-icon"></i>
                <Editable field="faq.q-learn-more.question">How can I learn more?</Editable>
            </button>
            <div class="faq-answer" hidden>
                <Editable field="faq.q-learn-more.answer" as="p">Attend a Shabbat service, speak with Rabbi Charles, or contact us with your questions.</Editable>
            </div>
        </div>
    </div>

    </div>) : <ConstructionNotice icon="fas fa-question-circle" />}
</PageLayout>

<script>
    // FAQ Accordion functionality
    const faqItems = document.querySelectorAll<HTMLElement>('.faq-item');
    faqItems.forEach((item, index) => {
        const question = item.querySelector<HTMLButtonElement>('.faq-question');
        const answer = item.querySelector<HTMLElement>('.faq-answer');
        if (!question || !answer) return;

        answer.id = `faq-answer-${index + 1}`;
        question.setAttribute('aria-controls', answer.id);

        const setOpen = (open: boolean) => {
            item.classList.toggle('active', open);
            question.setAttribute('aria-expanded', String(open));
            answer.hidden = !open;
        };

        question.addEventListener('click', () => {
            const willOpen = !item.classList.contains('active');

            faqItems.forEach(otherItem => {
                if (otherItem === item) return;
                const otherQuestion = otherItem.querySelector<HTMLButtonElement>('.faq-question');
                const otherAnswer = otherItem.querySelector<HTMLElement>('.faq-answer');
                otherItem.classList.remove('active');
                otherQuestion?.setAttribute('aria-expanded', 'false');
                if (otherAnswer) otherAnswer.hidden = true;
            });

            setOpen(willOpen);
        });
    });
</script>

<style>
    .faq-intro {
        text-align: center;
        font-size: 1.1rem;
        color: var(--text-secondary);
        margin-bottom: 30px;
    }

    .faq-container {
        display: flex;
        flex-direction: column;
        gap: 15px;
    }

    .faq-item {
        border: 1px solid var(--gray-200);
        border-radius: 8px;
        overflow: hidden;
        transition: all 0.3s ease;
    }

    .faq-item:hover {
        border-color: var(--primary-blue);
    }

    .faq-question {
        display: flex;
        align-items: center;
        padding: 20px;
        cursor: pointer;
        background: var(--gray-100);
        transition: background 0.3s ease;
    }

    .faq-question:hover {
        background: var(--gray-200);
    }

    .faq-icon {
        color: var(--primary-blue);
        font-size: 1.2rem;
        margin-right: 15px;
        min-width: 25px;
        text-align: center;
    }

    .faq-question span {
        font-weight: 600;
        color: var(--text-primary);
        flex: 1;
    }

    .faq-question::after {
        width: 0.55rem;
        height: 0.55rem;
        border-right: 2px solid var(--text-secondary);
        border-bottom: 2px solid var(--text-secondary);
        content: '';
        transform: rotate(45deg);
        transition: transform 0.3s ease;
    }

    .faq-item.active .faq-question::after {
        transform: rotate(225deg);
    }

    .faq-answer {
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.3s ease;
    }

    .faq-item.active .faq-answer {
        max-height: 500px;
    }

    .faq-answer p {
        padding: 20px;
        margin: 0;
        background: white;
        color: var(--text-secondary);
        line-height: 1.6;
    }

    @media (max-width: 767px) {
        .faq-question {
            align-items: flex-start;
            padding: 16px;
        }

        .faq-answer p {
            padding: 16px;
        }
    }
</style>
