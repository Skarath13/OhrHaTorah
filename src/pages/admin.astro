---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout title="Admin - Ohr HaTorah" pageTitle="Admin Editor" pageIcon="fas fa-lock">
    <p class="intro-text">
        You are signed in to the Ohr HaTorah visual editor. Use the floating edit button on public pages to update content and images.
    </p>

    <div class="cta-section text-center">
        <h3><i class="fas fa-pen"></i> Continue Editing</h3>
        <p>Return to the homepage, then use the floating editor controls to make inline changes.</p>
        <a href="/" class="btn btn-blue">
            <i class="fas fa-home" aria-hidden="true"></i>
            Go to Homepage
        </a>
    </div>
</PageLayout>
