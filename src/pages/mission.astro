---
import IdentityRichText from '../components/IdentityRichText.astro';
import PageLayout from '../layouts/PageLayout.astro';
import Editable from '../components/content/Editable.astro';
import {
    coreCommitments,
    coreValueGroups,
    congregationName,
    officialIdentityStatement,
    visionAndPurposeParagraphs,
} from '../data/congregationIdentity';

const officialIdentityStatementRemainder = officialIdentityStatement.slice(congregationName.length);

// Identity copy has no ids for vision paragraphs and values, so editor keys come
// from the first words of the approved text (scoped by group id for values).
const identityKey = (text: string) =>
    text.toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim().split(' ').slice(0, 6).join('-');
---

<PageLayout
    title="Our Vision, Commitments & Values - Kehilat Ohr HaTorah"
    pageTitle="Our Identity"
    description="Our Vision, Commitments & Values: the public identity, purpose, commitments, affirmations, and values of Kehilat Ohr HaTorah."
    stylesheets={['/styles/mission.css?v=20260901-approved-copy-1']}
>
    <div class="identity-page">
        <section class="identity-introduction" aria-labelledby="identity-introduction-title">
            <div class="identity-introduction__copy">

                <Editable field="mission.intro-heading" as="h2" id="identity-introduction-title">Covenant faithfulness. Jewish community life. Messiah Yeshua.</Editable>
                <Editable field="mission.intro-statement" as="p" class="identity-statement"><strong>{congregationName}</strong>{officialIdentityStatementRemainder}</Editable>
            </div>

            <nav class="identity-navigation" aria-label="On this page">
                <a href="#vision-and-purpose">
                    <span class="identity-navigation__mark" aria-hidden="true"></span>
                    <span>
                        <Editable field="mission.nav-vision-and-purpose.title" as="strong">Vision and Purpose</Editable>
                        <Editable field="mission.nav-vision-and-purpose.subtitle" as="small">Three foundational statements</Editable>
                    </span>
                </a>
                <a href="#core-commitments">
                    <span class="identity-navigation__mark" aria-hidden="true"></span>
                    <span>
                        <Editable field="mission.nav-core-commitments.title" as="strong">Core Commitments</Editable>
                        <Editable field="mission.nav-core-commitments.subtitle" as="small">Commitments and affirmations</Editable>
                    </span>
                </a>
                <a href="#core-values">
                    <span class="identity-navigation__mark" aria-hidden="true"></span>
                    <span>
                        <Editable field="mission.nav-core-values.title" as="strong">Core Values</Editable>
                        <Editable field="mission.nav-core-values.subtitle" as="small">Three areas of shared life</Editable>
                    </span>
                </a>
            </nav>
        </section>

        <section id="vision-and-purpose" class="identity-section identity-vision" aria-labelledby="vision-and-purpose-title">
            <header class="identity-section-heading">
                <span class="identity-section-heading__mark" aria-hidden="true"></span>
                <div>

                    <Editable field="mission.vision-heading" as="h2" id="vision-and-purpose-title">Vision and Purpose</Editable>
                </div>
            </header>

            <div class="identity-vision__statements">
                {visionAndPurposeParagraphs.map((paragraph, index) => (
                    <article class={`identity-vision__statement${index === 2 ? ' identity-vision__statement--feature' : ''}`}>
                        <span class="identity-vision__mark" aria-hidden="true"></span>
                        <Editable field={`mission.vision-${identityKey(paragraph.text)}`} as="p"><IdentityRichText content={paragraph} /></Editable>
                    </article>
                ))}
            </div>

            <p class="identity-hebrew-seal" lang="he" dir="rtl">
                <span class="identity-hebrew-seal__mark" aria-hidden="true"></span>
                בָּרוּךְ הַבָּא בְּשֵׁם ה׳
                <span class="identity-hebrew-seal__mark" aria-hidden="true"></span>
            </p>
        </section>

        <section id="core-commitments" class="identity-section identity-commitments" aria-labelledby="core-commitments-title">
            <header class="identity-section-heading">
                <span class="identity-section-heading__mark" aria-hidden="true"></span>
                <div>

                    <Editable field="mission.commitments-heading" as="h2" id="core-commitments-title">Core Commitments and Affirmations</Editable>
                </div>
            </header>

            <ul class="identity-commitment-list">
                {coreCommitments.map((commitment) => (
                    <li id={commitment.id}>
                        <span class="identity-commitment-list__mark" aria-hidden="true"></span>
                        <Editable field={`mission.commitment-${commitment.id}`} as="p"><IdentityRichText content={commitment} /></Editable>
                    </li>
                ))}
            </ul>
        </section>

        <section id="core-values" class="identity-section identity-values" aria-labelledby="core-values-title">
            <header class="identity-section-heading">
                <span class="identity-section-heading__mark" aria-hidden="true"></span>
                <div>

                    <Editable field="mission.values-heading" as="h2" id="core-values-title">Core Values</Editable>
                </div>
            </header>

            <div class="identity-value-groups">
                {coreValueGroups.map((group) => (
                    <section id={group.id} class="identity-value-group" aria-labelledby={`${group.id}-title`}>
                        <header class="identity-value-group__heading">
                            <span class="identity-value-group__symbol" aria-hidden="true"></span>
                            <Editable field={`mission.group-${group.id}.heading`} as="h3" id={`${group.id}-title`}>{group.heading}</Editable>
                        </header>

                        <ul class="identity-value-list">
                            {group.values.map((value) => (
                                <li>
                                    <span class="identity-value-list__mark" aria-hidden="true"></span>
                                    <Editable field={`mission.value-${group.id}-${identityKey(value.text)}`} as="p"><IdentityRichText content={value} /></Editable>
                                </li>
                            ))}
                        </ul>
                    </section>
                ))}
            </div>
        </section>
    </div>
</PageLayout>
