---
import IdentityRichText from '../components/IdentityRichText.astro';
import PageLayout from '../layouts/PageLayout.astro';
import {
    coreCommitments,
    coreValueGroups,
    congregationName,
    officialIdentityStatement,
    visionAndPurposeParagraphs,
} from '../data/congregationIdentity';

const officialIdentityStatementRemainder = officialIdentityStatement.slice(congregationName.length);
---

<PageLayout
    title="Our Vision, Commitments & Values - Kehilat Ohr HaTorah"
    pageTitle="Our Identity"
    description="Our Vision, Commitments & Values: the public identity, purpose, commitments, affirmations, and values of Kehilat Ohr HaTorah."
    stylesheets={['/styles/mission.css']}
>
    <div class="identity-page">
        <section class="identity-introduction" aria-labelledby="identity-introduction-title">
            <div class="identity-introduction__copy">
                <p class="identity-eyebrow">Vision <span aria-hidden="true">•</span> Commitments <span aria-hidden="true">•</span> Values</p>
                <h2 id="identity-introduction-title">Covenant faithfulness. Jewish community life. Messiah Yeshua.</h2>
                <p class="identity-statement"><strong>{congregationName}</strong>{officialIdentityStatementRemainder}</p>
            </div>

            <nav class="identity-navigation" aria-label="On this page">
                <a href="#vision-and-purpose">
                    <span class="identity-navigation__number" aria-hidden="true">01</span>
                    <span>
                        <strong>Vision and Purpose</strong>
                        <small>Three foundational statements</small>
                    </span>
                </a>
                <a href="#core-commitments">
                    <span class="identity-navigation__number" aria-hidden="true">02</span>
                    <span>
                        <strong>Core Commitments</strong>
                        <small>Commitments and affirmations</small>
                    </span>
                </a>
                <a href="#core-values">
                    <span class="identity-navigation__number" aria-hidden="true">03</span>
                    <span>
                        <strong>Core Values</strong>
                        <small>Three areas of shared life</small>
                    </span>
                </a>
            </nav>
        </section>

        <section id="vision-and-purpose" class="identity-section identity-vision" aria-labelledby="vision-and-purpose-title">
            <header class="identity-section-heading">
                <span class="identity-section-heading__number" aria-hidden="true">01</span>
                <div>
                    <p class="identity-section-heading__eyebrow">Our foundation</p>
                    <h2 id="vision-and-purpose-title">Vision and Purpose</h2>
                </div>
            </header>

            <div class="identity-vision__statements">
                {visionAndPurposeParagraphs.map((paragraph, index) => (
                    <article class={`identity-vision__statement identity-vision__statement--${index + 1}`}>
                        <span class="identity-vision__marker" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                        <p><IdentityRichText content={paragraph} /></p>
                    </article>
                ))}
            </div>

            <p class="identity-hebrew-seal" lang="he" dir="rtl">
                <span aria-hidden="true">✦</span>
                בָּרוּךְ הַבָּא בְּשֵׁם ה׳
                <span aria-hidden="true">✦</span>
            </p>
        </section>

        <section id="core-commitments" class="identity-section identity-commitments" aria-labelledby="core-commitments-title">
            <header class="identity-section-heading">
                <span class="identity-section-heading__number" aria-hidden="true">02</span>
                <div>
                    <p class="identity-section-heading__eyebrow">What we commit to and affirm</p>
                    <h2 id="core-commitments-title">Core Commitments and Affirmations</h2>
                </div>
            </header>

            <ol class="identity-commitment-list">
                {coreCommitments.map((commitment, index) => (
                    <li id={commitment.id}>
                        <span class="identity-commitment-list__number" aria-hidden="true">
                            {String(index + 1).padStart(2, '0')}
                        </span>
                        <p><IdentityRichText content={commitment} /></p>
                    </li>
                ))}
            </ol>
        </section>

        <section id="core-values" class="identity-section identity-values" aria-labelledby="core-values-title">
            <header class="identity-section-heading">
                <span class="identity-section-heading__number" aria-hidden="true">03</span>
                <div>
                    <p class="identity-section-heading__eyebrow">How we live together</p>
                    <h2 id="core-values-title">Core Values</h2>
                </div>
            </header>

            <div class="identity-value-groups">
                {coreValueGroups.map((group, groupIndex) => (
                    <section id={group.id} class="identity-value-group" aria-labelledby={`${group.id}-title`}>
                        <header class="identity-value-group__heading">
                            <span class="identity-value-group__symbol" aria-hidden="true">✦</span>
                            <p>{String(groupIndex + 1).padStart(2, '0')}</p>
                            <h3 id={`${group.id}-title`}>{group.heading}</h3>
                            <span class="identity-value-group__count">{group.values.length} values</span>
                        </header>

                        <ul class="identity-value-list">
                            {group.values.map((value) => (
                                <li>
                                    <span aria-hidden="true">✦</span>
                                    <p><IdentityRichText content={value} /></p>
                                </li>
                            ))}
                        </ul>
                    </section>
                ))}
            </div>
        </section>
    </div>
</PageLayout>
