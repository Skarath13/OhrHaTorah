---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout title="Our Location - Kehilat Ohr HaTorah" pageTitle="Our Location" pageIcon="fas fa-map-marker-alt" description="Directions to Kehilat Ohr HaTorah's Saturday service location in Fountain Valley, California.">
    <p class="intro-text"><strong>We gather in Fountain Valley, in the heart of Orange County.</strong></p>

    <!-- Service Location -->
    <div class="location-card main-location">
        <h3><i class="fas fa-synagogue"></i> Shabbat service location</h3>
        <div class="location-grid">
            <div class="location-info">
                <h4><i class="fas fa-map-pin"></i> Address</h4>
                <p class="address">
                    <strong>10460 Slater Ave<br>
                    Fountain Valley, CA 92708</strong>
                </p>

                <h4><i class="fas fa-clock"></i> Service time</h4>
                <p>
                    <strong>Saturdays at 2:30 PM</strong><br>
                    <span class="note">Contemporary worship, traditional prayers, and Torah study</span>
                </p>
            </div>
            <div class="location-info">
                <h4><i class="fas fa-envelope"></i> Mailing Address</h4>
                <p>
                    360 E. 1st Street, #856<br>
                    Tustin, CA 92780
                </p>

                <h4><i class="fas fa-phone"></i> Contact</h4>
                <p>
                    <a href="tel:+17144061513">(714) 406-1513</a><br>
                    <a href="mailto:OhrHaTorahOC@gmail.com">OhrHaTorahOC@gmail.com</a>
                </p>
            </div>
        </div>
    </div>

    <!-- Map -->
    <div class="map-section">
        <h3><i class="fas fa-map"></i> Find Us</h3>
        <div class="map-container">
            <iframe
                src="https://maps.google.com/maps?q=Kehilat+OhrHaTorah+Messianic+Jewish+Synagogue,Fountain+Valley,CA&t=&z=15&ie=UTF8&iwloc=&output=embed"
                class="page-map-embed"
                title="Map to Kehilat Ohr HaTorah service location"
                width="100%"
                height="350"
                allowfullscreen=""
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade">
            </iframe>
        </div>
        <a href="https://www.google.com/maps/dir/?api=1&destination=Kehilat+OhrHaTorah+Messianic+Jewish+Synagogue,+10460+Slater+Ave,+Fountain+Valley,+CA+92708"
           target="_blank"
           rel="noopener noreferrer"
           class="directions-btn">
            <i class="fas fa-directions"></i> Get directions
        </a>
    </div>

    <!-- Directions -->
    <div class="directions-section">
        <h3><i class="fas fa-directions"></i> Getting Here</h3>
        <div class="directions-grid">
            <div class="direction-card">
                <i class="fas fa-parking"></i>
                <h4>Parking</h4>
                <p>Free parking is available in the lot beside our meeting space.</p>
            </div>
            <div class="direction-card">
                <i class="fas fa-car"></i>
                <h4>Driving</h4>
                <p>The service location is near the 405 and 22 freeways.</p>
            </div>
        </div>
    </div>

</PageLayout>

<style>
    .intro-text {
        text-align: center;
        font-size: 1.1rem;
        margin-bottom: 30px;
    }

    .location-card {
        background: var(--gray-100);
        padding: 30px;
        border-radius: 12px;
        margin-bottom: 30px;
    }

    .main-location {
        background: rgba(0, 102, 204, 0.05);
        border-left: 4px solid var(--primary-blue);
    }

    .location-card h3 {
        color: var(--primary-blue);
        margin: 0 0 20px 0;
    }

    .location-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 30px;
    }

    .location-info h4 {
        color: var(--gold-dark);
        margin: 0 0 10px 0;
        font-size: 1rem;
    }

    .location-info p {
        margin: 0 0 20px 0;
        line-height: 1.6;
        color: var(--text-secondary);
    }

    .location-info .address {
        font-size: 1.1rem;
    }

    .location-info .note {
        font-size: 0.9rem;
        color: var(--text-secondary);
    }

    .location-info a {
        color: var(--primary-blue);
        text-decoration: none;
    }

    .location-info a:hover {
        text-decoration: underline;
    }

    .map-section {
        margin-bottom: 30px;
    }

    .map-section h3 {
        color: var(--primary-blue);
        margin-bottom: 15px;
    }

    .map-container {
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 2px 15px rgba(0, 0, 0, 0.1);
    }

    .directions-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-top: 15px;
        padding: 12px 24px;
        background: var(--primary-blue);
        color: white;
        text-decoration: none;
        border-radius: 8px;
        font-weight: 600;
        transition: background 0.3s ease;
    }

    .directions-btn:hover {
        background: #004080;
    }

    .directions-section {
        margin-bottom: 30px;
    }

    .directions-section h3 {
        color: var(--primary-blue);
        margin-bottom: 20px;
    }

    .directions-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
    }

    .direction-card {
        background: var(--gray-100);
        padding: 25px;
        border-radius: 8px;
        text-align: center;
    }

    .direction-card i {
        font-size: 2rem;
        color: var(--primary-blue);
        margin-bottom: 15px;
    }

    .direction-card h4 {
        color: var(--primary-blue);
        margin: 0 0 10px 0;
    }

    .direction-card p {
        margin: 0;
        color: var(--text-secondary);
        font-size: 0.95rem;
        line-height: 1.6;
    }

    .welcome-banner {
        background: linear-gradient(135deg, var(--primary-blue) 0%, #004080 100%);
        color: white;
        padding: 25px;
        border-radius: 12px;
        text-align: center;
    }

    .welcome-banner p {
        margin: 0;
        font-size: 1.1rem;
    }
</style>
