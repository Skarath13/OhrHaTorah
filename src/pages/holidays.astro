---
import PageLayout from '../layouts/PageLayout.astro';
import Editable from '../components/content/Editable.astro';
import { congregationClock, getHolidayServiceProgramme, isUpcomingService } from '../lib/holidayServices';
import { getCongregationCalendarEvents, parseCalendarRange } from '../lib/calendar';
import { formatCalendarEventTime } from '../lib/calendarDisplay';
import type { CongregationEvent } from '../data/congregationEvents';
import { holidaySeasons, shabbatGuide } from '../data/holidayGuide';

Astro.response.headers.set('Cache-Control', 'no-store');
let services: readonly CongregationEvent[] = [];
let unavailable = false;
try { services = await getHolidayServiceProgramme(Astro.locals.runtime?.env?.DB); }
catch { unavailable = true; }
const dateLabel = (date: string) => new Intl.DateTimeFormat('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' }).format(new Date(date + 'T12:00:00Z'));
const serviceTime = (event: CongregationEvent) => {
    if (event.schedule.kind !== 'single') return '';
    const date = event.schedule.date;
    const next = new Date(date + 'T12:00:00Z'); next.setUTCDate(next.getUTCDate() + 1);
    const [entry] = getCongregationCalendarEvents(parseCalendarRange(date, next.toISOString().slice(0, 10)), [event]);
    return entry ? formatCalendarEventTime(entry) : '';
};
// Invitations follow the congregation's clock: each service leaves the page once it ends.
const clock = congregationClock();
const upcoming = services.filter(event => isUpcomingService(event, clock));
const seasonStarted = upcoming.length < services.length;
const kolNidre = upcoming.find(event => event.id === 'holiday-2026-kol-nidre');
// Editorial context follows the rabbi's September 2 email and holiday notes.
// Dates, titles, arrival instructions, and time qualifications remain CMS-owned.
const serviceIntroductions: Record<string, string> = {
    'holiday-2026-rosh-hashanah': 'Yom Teruah is the Day of Shofar Sounding. We enter the fall holy days with a call to repentance, taking responsibility for our choices and seeking renewed faithfulness to God and one another.',
    'holiday-2026-kol-nidre': 'Kol Nidre opens our observance of Yom Kippur. We gather in the evening to begin this time of prayer, repentance, and reflection as a congregation.',
    'holiday-2026-yom-kippur-mincha': 'On the Day of Atonement, we continue in prayer and reflection. Our prayers express both personal and shared responsibility, with hope for repentance and restoration through Messiah Yeshua.',
    'holiday-2026-neilah': 'Neilah brings the day’s prayers to a close. We gather for these concluding prayers as Yom Kippur draws toward its end.',
    'holiday-2026-break-fast': 'Following the concluding prayers, we mark the end of Yom Kippur with Havdalah and break the fast together.',
    'holiday-2026-sukkot': 'Sukkot, the Festival of Tabernacles, recalls Israel’s wilderness journey and God’s provision. We gather for the first day of the festival.',
    'holiday-2026-shemini-atzeret': 'Shemini Atzeret is the concluding assembly following Sukkot, and Simchat Torah celebrates rejoicing in the Torah. We observe them together in one congregational gathering.',
};
const guideEntries = holidaySeasons.flatMap(season => season.entries);
---
<PageLayout title="Jewish Holidays - Kehilat Ohr HaTorah" pageTitle="Jewish Holidays" description="Holiday services and the appointed times at Kehilat Ohr HaTorah, including Rosh HaShanah, Kol Nidre, Yom Kippur, and Sukkot." stylesheets={['/styles/holidays.css']}>
    <div class="editorial-page">
        <section class="editorial-lead">
            {upcoming.length ? (
                <div><Editable field="holidays.lead-fall-heading" as="h2">Fall High Holidays&nbsp;· 2026&nbsp;/&nbsp;5787</Editable>{!seasonStarted && <Editable field="holidays.lead-fall-invite" as="p">Join us for Rosh HaShanah, Kol Nidre and Yom Kippur, Sukkot, and our combined Shemini Atzeret and Simchat Torah gathering.</Editable>}<Editable field="holidays.lead-fall-text" as="p">This season calls us to repentance and covenant renewal. We remember that each person matters, that we are accountable to one another, and that God promises repentance and restoration for His people.</Editable><div class="editorial-actions"><a class="action-link" href="#holiday-services"><Editable field="holidays.lead-fall-schedule-link">See the service schedule</Editable> <i class="fas fa-arrow-down" aria-hidden="true"></i></a><a class="text-link" href="/#congregation-calendar"><Editable field="holidays.lead-calendar-link">Congregational Calendar</Editable> <i class="fas fa-arrow-right" aria-hidden="true"></i></a></div></div>
            ) : (
                <div><Editable field="holidays.lead-default-heading" as="h2">The appointed times</Editable><Editable field="holidays.lead-default-text" as="p">Torah calls Shabbat and the festivals the <em>moadim</em>, God’s appointed times (Leviticus 23:2). Through the year we keep them with prayer, Scripture, and shared meals, together with the wider Jewish community.</Editable><Editable field={unavailable ? 'holidays.service-unavailable' : 'holidays.service-pending'} as="p" class="holiday-service-note">{unavailable ? 'Service details are temporarily unavailable.' : 'Holiday service details will be posted here as they are confirmed.'}</Editable><div class="editorial-actions"><a class="action-link" href="#appointed-times"><Editable field="holidays.lead-default-explore-link">Explore the holidays</Editable> <i class="fas fa-arrow-down" aria-hidden="true"></i></a><a class="text-link" href="/#congregation-calendar"><Editable field="holidays.lead-calendar-link">Congregational Calendar</Editable> <i class="fas fa-arrow-right" aria-hidden="true"></i></a></div></div>
            )}
            <aside class="editorial-side"><Editable field="holidays.side-heading" as="h3">Join us in Fountain Valley</Editable><address>10460 Slater Ave<br>Fountain Valley, CA 92708</address><Editable field="holidays.side-timezone" as="p">All service times are Pacific time.</Editable><a class="text-link" href="/#map"><Editable field="holidays.side-map-link">Map and directions</Editable> <i class="fas fa-arrow-right" aria-hidden="true"></i></a></aside>
        </section>
        {kolNidre && kolNidre.schedule.kind === 'single' && (
            <section class="kol-nidre-feature" aria-labelledby="kol-nidre-title">
                <div><Editable field="holidays.kol-nidre-heading" as="h2" id="kol-nidre-title">Kol Nidre</Editable><Editable field="holidays.kol-nidre-text" as="p">Erev Yom Kippur begins with our Kol Nidre evening service. Join us as we enter the Day of Atonement together.</Editable></div>
                <div class="kol-nidre-details"><p>{dateLabel(kolNidre.schedule.date)}</p><strong>{serviceTime(kolNidre)}</strong><a href="/#map"><Editable field="holidays.kol-nidre-map-link">Join us in Fountain Valley</Editable> <i class="fas fa-arrow-right" aria-hidden="true"></i></a></div>
            </section>
        )}
        {upcoming.length > 0 && (
            <section id="holiday-services" class="editorial-section" aria-labelledby="holiday-services-title">
                <Editable field="holidays.schedule-heading" as="h2" id="holiday-services-title">Fall holiday service schedule</Editable>
                <ol class="holiday-programme">
                    {upcoming.map(event => event.schedule.kind === 'single' && (
                        <li>
                            <div class="holiday-programme-heading">
                                <h3>{event.title}</h3>
                                <div class="holiday-programme-date"><time datetime={event.schedule.date}>{dateLabel(event.schedule.date)}</time><strong>{serviceTime(event)}</strong></div>
                            </div>
                            <div class="holiday-programme-copy">
                                {serviceIntroductions[event.id] && <Editable field={`holidays.service.${event.id}.intro`} as="p">{serviceIntroductions[event.id]}</Editable>}
                                {event.description && <p class="holiday-service-note">{event.description}</p>}
                            </div>
                        </li>
                    ))}
                </ol>
            </section>
        )}
        <section id="appointed-times" class="holiday-guide" aria-labelledby="holiday-guide-title">
            <div class="holiday-guide-intro">
                <Editable field="holidays.guide-heading" as="h2" id="holiday-guide-title">Shabbat and the holidays</Editable>
                <Editable field="holidays.guide-intro" as="p">A short guide to each appointed time: what it remembers, how it is kept, and where it appears in the Tanakh and the Brit Chadashah (New Covenant).</Editable>
            </div>
            <article id={shabbatGuide.id} class="holiday-shabbat" aria-labelledby="holiday-shabbat-title">
                <Editable field="holidays.shabbat.hebrew" as="p" class="holiday-hebrew" lang="he" dir="rtl">{shabbatGuide.hebrew}</Editable>
                <div>
                    <Editable field="holidays.shabbat.title" as="h3" id="holiday-shabbat-title">{shabbatGuide.title}</Editable>
                    <Editable field="holidays.shabbat.when" as="p" class="holiday-when">{shabbatGuide.when}</Editable>
                    {shabbatGuide.about.map((text, index) => <Editable field={`holidays.shabbat.about-${index + 1}`} as="p">{text}</Editable>)}
                    {shabbatGuide.messiah && <Editable field="holidays.shabbat.messiah" as="p" class="holiday-messiah">{shabbatGuide.messiah}</Editable>}
                    <Editable field="holidays.shabbat.sources" as="p" class="holiday-sources">{shabbatGuide.sources}</Editable>
                    <a class="holiday-shabbat-link" href="/services"><Editable field="holidays.shabbat.services-link">Join us for Shabbat services</Editable> <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
                </div>
            </article>
            <nav class="holiday-year-ribbon" aria-label="The holidays in calendar order">
                <ol>
                    {guideEntries.map(entry => <li><a href={`#${entry.id}`}><Editable field={`holidays.ribbon.${entry.id}.day`} class="holiday-ribbon-month">{entry.day ?? entry.when}</Editable><Editable field={`holidays.ribbon.${entry.id}.title`}>{entry.title}</Editable></a></li>)}
                </ol>
            </nav>
            {holidaySeasons.map(season => (
                <section class="holiday-season" aria-labelledby={`season-${season.id}`}>
                    <div class="holiday-season-heading"><Editable field={`holidays.season.${season.id}.title`} as="h2" id={`season-${season.id}`}>{season.title}</Editable><Editable field={`holidays.season.${season.id}.months`} as="p">{season.months}</Editable></div>
                    {season.entries.map(entry => (
                        <article id={entry.id} class="holiday-entry" aria-labelledby={`${entry.id}-title`}>
                            <div class="holiday-entry-marker">
                                <Editable field={`holidays.entry.${entry.id}.hebrew`} as="p" class="holiday-hebrew" lang="he" dir="rtl">{entry.hebrew}</Editable>
                                <dl>
                                    <div><dt><Editable field="holidays.entry-label-hebrew-date">Hebrew date</Editable></dt><dd><Editable field={`holidays.entry.${entry.id}.when`}>{entry.when}</Editable></dd></div>
                                    <div><dt><Editable field="holidays.entry-label-usually">Usually</Editable></dt><dd><Editable field={`holidays.entry.${entry.id}.season`}>{entry.season}</Editable></dd></div>
                                    <div><dt><Editable field="holidays.entry-label-scripture">Scripture</Editable></dt><dd><Editable field={`holidays.entry.${entry.id}.sources`}>{entry.sources}</Editable></dd></div>
                                </dl>
                            </div>
                            <div class="holiday-entry-copy">
                                <Editable field={`holidays.entry.${entry.id}.title`} as="h3" id={`${entry.id}-title`}>{entry.title}</Editable>
                                {entry.about.map((text, index) => <Editable field={`holidays.entry.${entry.id}.about-${index + 1}`} as="p">{text}</Editable>)}
                                {entry.messiah && <aside class="holiday-messiah" aria-label={`${entry.title} in the Brit Chadashah`}><Editable field={`holidays.entry.${entry.id}.messiah`} as="p">{entry.messiah}</Editable></aside>}
                            </div>
                        </article>
                    ))}
                </section>
            ))}
        </section>
        <div class="editorial-note"><Editable field="holidays.note-text" as="p">Questions about joining us for a holiday?</Editable><a class="text-link" href="mailto:OhrHaTorahOC@gmail.com"><Editable field="holidays.note-email-link">Email the congregation</Editable> <i class="fas fa-arrow-right" aria-hidden="true"></i></a></div>
    </div>
</PageLayout>
