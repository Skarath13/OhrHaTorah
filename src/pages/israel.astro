---
import PageLayout from '../layouts/PageLayout.astro';
import { reliefOrganizations } from '../data/reliefOrganizations';
---
<PageLayout title="Stand with Israel - Kehilat Ohr HaTorah" pageTitle="Stand with Israel" description="Learn about humanitarian relief organizations serving Israel and Jewish communities affected by conflict and displacement.">
    <div class="editorial-page">
        <section class="editorial-lead">
            <div><h2>Supporting Jewish people in need</h2><p>We value community service, acts of lovingkindness, humanitarian efforts, and unwavering support for Jewish people in need, within and outside the State of Israel.</p><p>Learn about the organizations below and the people their work serves.</p></div>
            <aside class="editorial-side"><p>Our support for Israel is part of our shared congregational life and values.</p><a class="text-link" href="/mission#core-values">Read our Core Values <span aria-hidden="true">→</span></a></aside>
        </section>
        <section aria-label="Humanitarian relief organizations">
            {reliefOrganizations.map(org => (
                <article class="organization-row">
                    <h2 class="icon-heading"><i class={org.icon + ' editorial-icon'} aria-hidden="true"></i><span>{org.name}</span></h2>
                    <div>{org.paragraphs.map(paragraph => <p>{paragraph}</p>)}<a class="text-link" href={org.url} target="_blank" rel="noopener noreferrer">Visit {org.name} <span aria-hidden="true">↗</span></a></div>
                </article>
            ))}
        </section>
        <section class="editorial-section editorial-split"><h2>Pray for peace and healing</h2><p>We pray for the safety, healing, and dignity of everyone affected by war, violence, and displacement.</p></section>
    </div>
</PageLayout>
