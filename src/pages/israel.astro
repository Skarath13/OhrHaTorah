---
import PageLayout from '../layouts/PageLayout.astro';
import Editable from '../components/content/Editable.astro';
import { reliefOrganizations } from '../data/reliefOrganizations';
---
<PageLayout title="Stand with Israel - Kehilat Ohr HaTorah" pageTitle="Stand with Israel" description="Learn about humanitarian relief organizations serving Israel and Jewish communities affected by conflict and displacement.">
    <div class="editorial-page">
        <section class="editorial-lead">
            <div><Editable field="israel.lead-heading" as="h2">Supporting Jewish people in need</Editable><Editable field="israel.lead-p1" as="p">We value community service, acts of lovingkindness, humanitarian efforts, and unwavering support for Jewish people in need, within and outside the State of Israel.</Editable><Editable field="israel.lead-p2" as="p">Learn about the organizations below and the people their work serves.</Editable></div>
            <aside class="editorial-side"><Editable field="israel.side-note" as="p">Our support for Israel is part of our shared congregational life and values.</Editable><a class="text-link" href="/mission#core-values"><Editable field="israel.side-link">Read our Core Values</Editable> <i class="fas fa-arrow-right" aria-hidden="true"></i></a></aside>
        </section>
        <section aria-label="Humanitarian relief organizations">
            {reliefOrganizations.map(org => {
                const slug = org.name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
                return (
                <article class="organization-row">
                    <h2 class="icon-heading"><i class={org.icon + ' editorial-icon'} aria-hidden="true"></i><Editable field={`israel.${slug}.name`}>{org.name}</Editable></h2>
                    <div>{org.paragraphs.map((paragraph, i) => <Editable field={`israel.${slug}.p${i + 1}`} as="p">{paragraph}</Editable>)}<a class="text-link" href={org.url} target="_blank" rel="noopener noreferrer"><Editable field={`israel.${slug}.link-label`}>Visit {org.name}</Editable> <i class="fas fa-arrow-up-right-from-square" aria-hidden="true"></i><span class="visually-hidden"> (opens in a new tab)</span></a></div>
                </article>
                );
            })}
        </section>
        <section class="editorial-section editorial-split"><Editable field="israel.pray-heading" as="h2">Pray for peace and healing</Editable><Editable field="israel.pray-text" as="p">We pray for the safety, healing, and dignity of everyone affected by war, violence, and displacement.</Editable></section>
    </div>
</PageLayout>
