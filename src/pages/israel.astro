---
import PageLayout from '../layouts/PageLayout.astro';
import {
    IconExternalLink,
    IconFirstAidKit,
    IconHeart,
    IconHeartHandshake,
    IconMoodKid,
    IconPray,
    IconUsersGroup,
} from '@tabler/icons-astro';
---

<PageLayout title="Stand With Israel - Ohr HaTorah" pageTitle="Stand With Israel - Supporting Ministries">
    <p class="intro-text"><strong>Learn about organizations serving people in Israel through humanitarian aid and faith-based support.</strong></p>

    <div class="ministries-list">
        <!-- Hope for Israel -->
        <div class="ministry-card">
            <div class="ministry-header">
                <IconHeart aria-hidden="true" />
                <h3>Hope for Israel</h3>
            </div>
            <div class="ministry-details">
                <p>A discipleship and service-oriented ministry based in Israel. Its published work includes humanitarian relief, prayer resources, Bible teaching, and faith-based outreach.</p>
                <div class="ministry-activities">
                    <h4><IconHeartHandshake aria-hidden="true" /> Current Activities:</h4>
                    <ul>
                        <li>Humanitarian relief</li>
                        <li>Faith-based outreach</li>
                        <li>Prayer updates and Bible teaching</li>
                    </ul>
                </div>
                <a href="https://hope4israel.org/" target="_blank" rel="noopener noreferrer" class="ministry-link">
                    Visit Hope for Israel <IconExternalLink aria-hidden="true" />
                </a>
            </div>
        </div>

        <!-- Israel Relief Aid -->
        <div class="ministry-card">
            <div class="ministry-header">
                <IconFirstAidKit aria-hidden="true" />
                <h3>Israel Relief Aid</h3>
            </div>
            <div class="ministry-details">
                <p>A humanitarian ministry serving Israelis in need with material aid and faith-based support. Review its current programs and stewardship information directly on the organization’s website.</p>
                <div class="ministry-activities">
                    <h4><IconHeartHandshake aria-hidden="true" /> Ministry Focus:</h4>
                    <ul>
                        <li>Humanitarian aid for people facing poverty</li>
                        <li>Faith-based support</li>
                        <li>Distribution of relief supplies</li>
                    </ul>
                </div>
                <a href="https://israelrelief.org.il/" target="_blank" rel="noopener noreferrer" class="ministry-link">
                    Visit Israel Relief Aid <IconExternalLink aria-hidden="true" />
                </a>
            </div>
        </div>

        <!-- Chevra USA -->
        <div class="ministry-card">
            <div class="ministry-header">
                <IconUsersGroup aria-hidden="true" />
                <h3>Chevra USA - Humanitarian Relief Ministry</h3>
            </div>
            <div class="ministry-details">
                <p>Chevra means “friendship.” The ministry focuses on humanitarian support for displaced Jewish people, including refugees from Ukraine and communities in Eastern Europe.</p>
                <div class="ministry-activities">
                    <h4><IconHeartHandshake aria-hidden="true" /> Ministry Focus:</h4>
                    <ul>
                        <li>Food security and refugee aid</li>
                        <li>Immigration assistance to Israel</li>
                        <li>Humanitarian response in Eastern Europe</li>
                    </ul>
                </div>
                <p class="ministry-note"><em>Contact Ohr HaTorah for current program and giving information.</em></p>
            </div>
        </div>

        <!-- Shiloh Israel Children's Fund -->
        <div class="ministry-card">
            <div class="ministry-header">
                <IconMoodKid aria-hidden="true" />
                <h3>Shiloh Israel Children's Fund</h3>
            </div>
            <div class="ministry-details">
                <p>A specialized organization supporting Israeli children and families affected by terrorism and trauma.</p>
                <div class="ministry-activities">
                    <h4><IconHeartHandshake aria-hidden="true" /> Healing Programs:</h4>
                    <ul>
                        <li>Post-Trauma Emotional Therapy for PTSD</li>
                        <li>Art, music, and animal therapy</li>
                        <li>Movement therapy for healing</li>
                        <li>Specialized treatments for terror victims</li>
                    </ul>
                </div>
                <a href="https://www.shilohisraelchildren.org/" target="_blank" rel="noopener noreferrer" class="ministry-link">
                    Visit Shiloh Children's Fund <IconExternalLink aria-hidden="true" />
                </a>
            </div>
        </div>
    </div>

    <div class="heart-section">
        <h3><IconPray aria-hidden="true" /> Our Heart for Israel</h3>
        <p>Ohr HaTorah encourages prayer for everyone affected by conflict and careful review of each organization’s current programs, governance, and giving information before making a donation.</p>
        <p><strong>Contact us if you would like context on the congregation’s relationship with any organization listed here.</strong></p>
    </div>
</PageLayout>

<style>
    .intro-text {
        text-align: center;
        font-size: 1.1rem;
        margin-bottom: 30px;
    }

    .ministries-list {
        display: flex;
        flex-direction: column;
        gap: 25px;
        margin-bottom: 30px;
    }

    .ministry-card {
        background: var(--gray-100);
        border-radius: 12px;
        overflow: hidden;
    }

    .ministry-header {
        background: white;
        padding: 20px 25px;
        display: flex;
        align-items: center;
        gap: 15px;
        border-bottom: 1px solid var(--gray-200);
    }

    .ministry-header svg {
        width: 2rem;
        height: 2rem;
        flex: 0 0 auto;
    }

    .ministry-header h3 {
        margin: 0;
        color: var(--primary-blue);
        font-size: 1.2rem;
    }

    .ministry-details {
        padding: 25px;
    }

    .ministry-meta {
        color: var(--text-secondary);
        font-size: 0.9rem;
        margin: 0 0 15px 0;
    }

    .ministry-details > p {
        margin: 0 0 15px 0;
        line-height: 1.7;
        color: var(--text-secondary);
    }

    .ministry-activities {
        margin: 15px 0;
    }

    .ministry-activities h4 {
        color: var(--gold-dark);
        font-size: 0.95rem;
        margin: 0 0 10px 0;
    }

    .ministry-activities ul {
        margin: 0;
        padding-left: 20px;
    }

    .ministry-activities li {
        margin-bottom: 6px;
        color: var(--text-secondary);
        font-size: 0.95rem;
    }

    .ministry-note {
        color: var(--text-secondary);
        font-size: 0.9rem;
        margin: 15px 0 !important;
    }

    .ministry-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: var(--primary-blue);
        color: white;
        padding: 10px 20px;
        border-radius: 6px;
        text-decoration: none;
        font-weight: 500;
        transition: background 0.3s ease;
    }

    .ministry-link:hover {
        background: #004080;
    }

    .heart-section {
        background: rgba(0, 102, 204, 0.05);
        padding: 25px;
        border-radius: 8px;
        border-left: 4px solid var(--primary-blue);
    }

    .heart-section h3 {
        color: var(--primary-blue);
        margin: 0 0 15px 0;
    }

    .heart-section p {
        margin: 0 0 15px 0;
        line-height: 1.7;
        color: var(--text-secondary);
    }

    .heart-section p:last-child {
        margin-bottom: 0;
    }
</style>
