---
import PageLayout from '../layouts/PageLayout.astro';
import Editable from '../components/content/Editable.astro';
---
<PageLayout title="About Kehilat Ohr HaTorah" pageTitle="Welcome to Kehilat Ohr HaTorah" description="Meet our Messianic Jewish congregation in Fountain Valley and learn about prayer, Torah, music, and community life.">
    <div class="editorial-page">
        <section class="editorial-lead">
            <div><Editable field="about.lead-heading" as="h2">Congregation of the Light of the Torah</Editable><Editable field="about.lead-1" as="p">Our name, <strong>Kehilat Ohr HaTorah</strong>, speaks to our desire to read the Tanakh and Brit Chadashah as one story of God’s faithfulness and redemption.</Editable><Editable field="about.lead-2" as="p">Jewish and non-Jewish individuals, interfaith couples, and families are welcome to come, listen, ask questions, and grow with us.</Editable><div class="editorial-actions"><a class="action-link" href="/services"><Editable field="about.cta-services">Shabbat Services</Editable> <i class="fas fa-arrow-right" aria-hidden="true"></i></a><a class="text-link" href="/#map"><Editable field="about.cta-location">Our location</Editable> <i class="fas fa-arrow-right" aria-hidden="true"></i></a></div></div>
            <aside class="editorial-side"><Editable field="about.side-intro" as="p">Read our complete congregational identity and the commitments that shape our shared life.</Editable><ul class="editorial-link-list"><li><a href="/mission"><Editable field="about.link-identity">Our Identity</Editable> <i class="fas fa-arrow-right" aria-hidden="true"></i></a></li><li><a href="/mission#core-commitments"><Editable field="about.link-core-commitments">Core Commitments</Editable> <i class="fas fa-arrow-right" aria-hidden="true"></i></a></li><li><a href="/mission#core-values"><Editable field="about.link-core-values">Core Values</Editable> <i class="fas fa-arrow-right" aria-hidden="true"></i></a></li><li><a href="/umjc"><Editable field="about.link-umjc">Our UMJC membership</Editable> <i class="fas fa-arrow-right" aria-hidden="true"></i></a></li></ul></aside>
        </section>
        <section class="editorial-section editorial-split">
            <div><Editable field="about.split-heading" as="h2">A place to learn and participate</Editable></div>
            <div><Editable field="about.split-1" as="p">You may be exploring your Jewish heritage, seeking to understand Yeshua within a Jewish context, or looking for a congregation rooted in Torah, prayer, and community.</Editable><Editable field="about.split-2" as="p">Wherever you are beginning, you are welcome to join us.</Editable></div>
        </section>
        <section class="editorial-section">
            <Editable field="about.columns-heading" as="h2">Prayer, Scripture, music, and the appointed times</Editable>
            <div class="editorial-columns">
                <div><h3 class="icon-heading"><i class="fas fa-scroll editorial-icon" aria-hidden="true"></i><Editable field="about.prayer-title">Traditional Prayer</Editable></h3><Editable field="about.prayer-text" as="p">Hebrew and English liturgy.</Editable></div>
                <div><h3 class="icon-heading"><i class="fas fa-book-open editorial-icon" aria-hidden="true"></i><Editable field="about.scripture-title">Scripture Teaching</Editable></h3><Editable field="about.scripture-text" as="p">Study of the Tanakh (Hebrew Scriptures) and Brit Chadashah (New Covenant).</Editable></div>
                <div><h3 class="icon-heading"><i class="fas fa-music editorial-icon" aria-hidden="true"></i><Editable field="about.music-title">Traditional and Messianic Jewish Music</Editable></h3><Editable field="about.music-text" as="p">Music and congregational dance within our shared Jewish life.</Editable></div>
                <div><h3 class="icon-heading"><i class="fas fa-menorah editorial-icon" aria-hidden="true"></i><Editable field="about.times-title">The Appointed Times</Editable></h3><Editable field="about.times-text" as="p">Marking Shabbat and the Jewish holidays throughout the year.</Editable><a class="text-link" href="/holidays"><Editable field="about.link-holidays">Holiday services</Editable> <i class="fas fa-arrow-right" aria-hidden="true"></i></a></div>
            </div>
        </section>
    </div>
</PageLayout>
