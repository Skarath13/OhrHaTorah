    </main>

    <Footer />

    <script>
        const heroVideo = document.getElementById('home-hero-video') as HTMLVideoElement | null;
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

        if (heroVideo) {
            let heroIsVisible = true;
            // A visitor who pauses the hero keeps it paused for the rest of the visit (WCAG 2.2.2).
            const PAUSE_KEY = 'oht-hero-video-paused';
            const heroToggle = document.getElementById('home-hero-video-toggle') as HTMLButtonElement | null;
            // Phones get no pause control, so a pause chosen at a wider width does not apply there.
            const phoneHero = window.matchMedia('(max-width: 767px)');
            let userPaused = false;
            try { userPaused = window.sessionStorage.getItem(PAUSE_KEY) === '1'; } catch { userPaused = false; }
            let autoplayRetryTimer = 0;
            let autoplayRetryCount = 0;

            heroVideo.muted = true;
            heroVideo.defaultMuted = true;
            heroVideo.playsInline = true;

            const clearAutoplayRetry = () => {
                if (!autoplayRetryTimer) return;
                window.clearTimeout(autoplayRetryTimer);
                autoplayRetryTimer = 0;
            };

            const requestHeroPlayback = () => {
                clearAutoplayRetry();

                if (heroToggle) heroToggle.hidden = reducedMotion.matches || phoneHero.matches;
                const pausedByVisitor = userPaused && !phoneHero.matches;
                if (pausedByVisitor || reducedMotion.matches || document.hidden || !heroIsVisible) {
                    heroVideo.pause();
                    return;
                }

                heroVideo.muted = true;
                void heroVideo.play().then(() => {
                    autoplayRetryCount = 0;
                }).catch(() => {
                    if (autoplayRetryCount >= 3) return;
                    autoplayRetryCount += 1;
                    autoplayRetryTimer = window.setTimeout(requestHeroPlayback, 250 * autoplayRetryCount);
                });
            };

            const heroObserver = new IntersectionObserver(([entry]) => {
                heroIsVisible = entry?.isIntersecting ?? false;
                requestHeroPlayback();
            }, { threshold: 0.08 });

            const syncHeroToggle = () => {
                if (!heroToggle) return;
                heroToggle.setAttribute('aria-label', userPaused ? 'Play background video' : 'Pause background video');
                heroToggle.querySelector('i')?.setAttribute('class', userPaused ? 'fas fa-play' : 'fas fa-pause');
            };

            heroToggle?.addEventListener('click', () => {
                userPaused = !userPaused;
                try {
                    if (userPaused) window.sessionStorage.setItem(PAUSE_KEY, '1');
                    else window.sessionStorage.removeItem(PAUSE_KEY);
                } catch { /* storage unavailable: the choice lasts for this page only */ }
                syncHeroToggle();
                requestHeroPlayback();
            });
            syncHeroToggle();

            heroObserver.observe(heroVideo);
            reducedMotion.addEventListener('change', requestHeroPlayback);
            phoneHero.addEventListener('change', requestHeroPlayback);
            heroVideo.addEventListener('loadeddata', requestHeroPlayback);
            heroVideo.addEventListener('canplay', requestHeroPlayback);
            document.addEventListener('visibilitychange', requestHeroPlayback);
            window.addEventListener('pageshow', requestHeroPlayback);

            const retryAfterInteraction = () => {
                autoplayRetryCount = 0;
                requestHeroPlayback();
            };

            window.addEventListener('pointerdown', retryAfterInteraction, { once: true, passive: true });
            window.addEventListener('touchstart', retryAfterInteraction, { once: true, passive: true });
            window.addEventListener('keydown', retryAfterInteraction, { once: true });
            requestHeroPlayback();
        }

        const heroScrollHost = document.querySelector<HTMLElement>('[data-hero-scroll-host][data-hero-scroll="pending"]');
        if (heroScrollHost) {
            // Show the flat logo if three.js or WebGL fails or is too slow to start.
            const showFlatLogo = () => {
                if (heroScrollHost.dataset.heroScroll === 'pending') delete heroScrollHost.dataset.heroScroll;
            };
            const slowStart = window.setTimeout(showFlatLogo, 3000);
            void import('../lib/heroScroll.ts')
                .then(({ mountHeroScroll }) => {
                    if (heroScrollHost.dataset.heroScroll !== 'pending') return;
                    window.clearTimeout(slowStart);
                    return mountHeroScroll(heroScrollHost);
                })
                .catch(() => {
                    heroScrollHost.querySelector('.home-hero-logo-scroll')?.remove();
                    delete heroScrollHost.dataset.heroScroll;
                });
        }

        const homeMotionHeadings = Array.from(
            document.querySelectorAll<HTMLElement>('[data-home-motion-heading]'),
        );
        const homeScrollThread = document.querySelector<HTMLElement>('[data-home-scroll-thread]');
        let homeMotionObserver: IntersectionObserver | null = null;
        let homeScrollFrame = 0;
        let homeMotionEnabled = false;

        const updateHomeScrollThread = () => {
            homeScrollFrame = 0;
            if (!homeScrollThread) return;

            const homepage = document.querySelector<HTMLElement>('.home-redesign');
            if (!homepage) return;

            const start = homepage.offsetTop;
            const distance = Math.max(1, homepage.offsetHeight - window.innerHeight);
            const progress = Math.min(1, Math.max(0, (window.scrollY - start) / distance));

            homeScrollThread.style.setProperty('--home-scroll-progress', progress.toFixed(4));
        };

        const requestHomeScrollThreadUpdate = () => {
            if (homeScrollFrame) return;
            homeScrollFrame = window.requestAnimationFrame(updateHomeScrollThread);
        };

        const enableHomeMotion = () => {
            if (homeMotionEnabled || reducedMotion.matches || !('IntersectionObserver' in window)) return;

            homeMotionEnabled = true;
            document.documentElement.classList.add('home-motion-ready');
            homeScrollThread?.setAttribute('data-home-scroll-ready', '');

            homeMotionObserver = new IntersectionObserver((entries, observer) => {
                entries.forEach((entry) => {
                    if (!entry.isIntersecting) return;
                    (entry.target as HTMLElement).classList.add('is-home-revealed');
                    observer.unobserve(entry.target);
                });
            }, { rootMargin: '0px 0px -12% 0px', threshold: 0.12 });

            homeMotionHeadings.forEach((heading) => homeMotionObserver?.observe(heading));
            window.addEventListener('scroll', requestHomeScrollThreadUpdate, { passive: true });
            window.addEventListener('resize', requestHomeScrollThreadUpdate, { passive: true });
            requestHomeScrollThreadUpdate();
        };

        const disableHomeMotion = () => {
            if (!homeMotionEnabled) return;

            homeMotionEnabled = false;
            homeMotionObserver?.disconnect();
            homeMotionObserver = null;
            window.removeEventListener('scroll', requestHomeScrollThreadUpdate);
            window.removeEventListener('resize', requestHomeScrollThreadUpdate);
            if (homeScrollFrame) window.cancelAnimationFrame(homeScrollFrame);
            homeScrollFrame = 0;

            document.documentElement.classList.remove('home-motion-ready');
            homeMotionHeadings.forEach((heading) => heading.classList.remove('is-home-revealed'));
            homeScrollThread?.removeAttribute('data-home-scroll-ready');
            homeScrollThread?.style.removeProperty('--home-scroll-progress');
        };

        const syncHomeMotion = () => {
            if (reducedMotion.matches) {
                disableHomeMotion();
                return;
            }

            enableHomeMotion();
        };

        reducedMotion.addEventListener('change', syncHomeMotion);
        syncHomeMotion();
    </script>
</BaseLayout>
