                    </div>
                </div>
            </div>
        </section>

        <section class="home-section home-community" aria-labelledby="about-us-title-heading">
            <div class="home-shell">
                <div class="home-section-heading home-about-heading">
                    <div>
                        <h2 id="about-us-title-heading" data-editable="about-us-title">
                            <span data-editable="about-us-title-text">About Us</span>
                        </h2>
                    </div>
                    <p data-editable="intro-text-2">Ours is a home where Torah and our Messiah Yeshua come together. Come learn, pray, and grow with us in love, respect, and shared hope.</p>
                </div>

                <div class="home-about-grid">
                    <div class="home-about-story">
                        <div class="home-about-copy">
                        <p data-editable="about-us-text-1">Kehilat Ohr HaTorah is a growing Messianic synagogue in the heart of Orange County. We honor Jewish life and practice, and we joyfully follow Yeshua, the Messiah of Israel. Jewish and non-Jewish people, interfaith couples, and families are all welcome to worship, learn, and grow with us.</p>

                        <p data-editable="about-us-text-2">Our services join traditional and contemporary Jewish practice through prayer in Hebrew and English, Scripture teaching, music, and community. Whether you are asking your first questions or have walked this road for years, there is a place for you here.</p>
                        </div>

                        <details class="home-rabbi-story" open>
                            <summary data-editable="rabbi-card-title">Meet Our Rabbi</summary>
                            <p class="home-rabbi-bio" data-editable="rabbi-bio">{rabbi.bio}</p>
                        </details>

                        <div class="home-about-actions">
                            <details class="home-about-details">
                                <summary>More about our leadership and affiliation</summary>
                                <div>
                                    <p data-editable="about-us-text-3">Rabbi Charles (Chaim) Ott brings many years of Messianic leadership and graduate study in Jewish studies, New Testament studies, and public education. He teaches the Hebrew Scriptures and Brit Chadashah as one message of redemption through Yeshua our Messiah.</p>

                                    <p data-editable="about-us-text-4">Ohr HaTorah is affiliated with the <a href="https://www.umjc.org/vision" target="_blank" rel="noopener noreferrer">Union of Messianic Jewish Synagogues (UMJC)</a>, a movement committed to Yeshua the Messiah and to Jewish life rooted in Torah.</p>
                                </div>
                            </details>

                            <a class="home-text-link" href="/about">
                                <span>Learn More About Us</span>
                                <i class="fas fa-arrow-right" aria-hidden="true"></i>
                            </a>
                        </div>
                    </div>

                    <div class="home-about-visual">
                        <img class="home-about-atmosphere" src="/images/stock/olive-branches.webp" alt="Olive branches in sunlight" width="1800" height="1202" loading="lazy" decoding="async">
                        <figure class="home-rabbi-portrait">
                            <div class="home-rabbi-image-frame">
                                <img
                                    src="/images/optimized/rabbi-charles-ott.webp"
                                    alt={rabbi.name}
                                    width="640"
                                    height="640"
                                    loading="lazy"
                                    decoding="async"
                                >
                            </div>
                            <figcaption>
                                <p class="home-rabbi-name" data-editable="rabbi-name">{rabbi.name}</p>
                                <p class="home-rabbi-title" data-editable="rabbi-title">{rabbi.title}</p>
                            </figcaption>
                        </figure>
                    </div>
                </div>
            </div>
        </section>

        <aside class="home-torah-quote" aria-label="A reflection from Scripture">
            <div class="home-shell">
                <div class="home-torah-quote-icon" aria-hidden="true">
                    <!-- Tabler Icons: book-2, MIT License -->
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M19 4v16h-12a2 2 0 0 1 -2 -2v-12a2 2 0 0 1 2 -2h12"></path>
                        <path d="M19 16h-12a2 2 0 0 0 -2 2"></path>
                        <path d="M9 8h6"></path>
                    </svg>
                </div>
                <blockquote class="home-torah-quote-primary">
                    <p>“God’s Torah is a Tree of Life <span lang="he-Latn">[etz chaim]</span> for those who take hold of it, and happy are those who uphold it. Its ways are ways of pleasantness, and all its paths are peace.”</p>
                    <cite>Proverbs 3:17–18</cite>
                </blockquote>
                <blockquote class="home-torah-quote-secondary">
                    <p>“Turn us back to You, HASHEM, and we shall be restored. Renew our lives as in days of old.”</p>
                    <cite>Lamentations 5:21</cite>
                </blockquote>
            </div>
        </aside>

    </main>

    <Footer />

    <!-- Prayer Times Script - Using Hebcal Zmanim API -->
    <script>
        const HEBCAL_ZMANIM_ZIP = '92708'; // Fountain Valley, CA

        interface ZmanimTimes {
            sunrise: string;
            sunset: string;
            sofZmanShma: string;
            sofZmanTfilla: string;
            minchaGedola: string;
            minchaKetana: string;
            plagHaMincha: string;
            tzeit85deg: string;
            tzeit42min: string;
        }

        interface ZmanimResponse {
            date: string;
            location: {
                title: string;
                city: string;
                tzid: string;
            };
            times: ZmanimTimes;
        }

        const formatZmanTime = (isoDate: string): string => {
            const date = new Date(isoDate);
            return date.toLocaleTimeString('en-US', {
                hour: 'numeric',
                minute: '2-digit',
                hour12: true
            });
        };

        const loadPrayerTimes = async () => {
            const liveIndicator = document.getElementById('prayer-live-indicator');
            const lastUpdatedEl = document.getElementById('prayer-last-updated');

            try {
                const today = new Date();
                const dateStr = today.toISOString().split('T')[0];

                const response = await fetch(`https://www.hebcal.com/zmanim?cfg=json&zip=${HEBCAL_ZMANIM_ZIP}&date=${dateStr}`);
                if (!response.ok) throw new Error('API request failed');

                const data: ZmanimResponse = await response.json();

                if (data.times) {
                    const shacharitEl = document.getElementById('shacharit-time');
                    if (shacharitEl && data.times.sunrise) {
                        shacharitEl.textContent = formatZmanTime(data.times.sunrise);
                    }

                    const minchaEl = document.getElementById('mincha-time');
                    if (minchaEl && data.times.minchaGedola) {
                        minchaEl.textContent = formatZmanTime(data.times.minchaGedola);
                    }

                    const maarivEl = document.getElementById('maariv-time');
                    if (maarivEl && data.times.tzeit85deg) {
                        maarivEl.textContent = formatZmanTime(data.times.tzeit85deg);
                    }

                    if (liveIndicator) {
                        liveIndicator.classList.add('active');
                    }

                    const updatedTimeEl = document.getElementById('prayer-updated-time');
                    if (updatedTimeEl) {
                        const now = new Date();
                        const timeStr = now.toLocaleTimeString('en-US', {
                            hour: 'numeric',
                            minute: '2-digit',
                            hour12: true
                        });
                        updatedTimeEl.textContent = `Updated ${timeStr} via Hebcal`;
                    }
                }
            } catch (error) {
                console.error('Error loading prayer times:', error);

                if (lastUpdatedEl) {
                    lastUpdatedEl.textContent = 'Unable to load times';
                    lastUpdatedEl.style.color = '#e74c3c';
                }
            }
        };

        loadPrayerTimes();
        setInterval(loadPrayerTimes, 30 * 60 * 1000);

        const heroVideo = document.getElementById('home-hero-video') as HTMLVideoElement | null;
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

        const applyMotionPreference = () => {
            if (!heroVideo) return;
            if (reducedMotion.matches) {
                heroVideo.pause();
            } else {
                void heroVideo.play().catch(() => undefined);
            }
        };

        if (heroVideo) {
            reducedMotion.addEventListener('change', applyMotionPreference);
            applyMotionPreference();
        }

        const mobileDisclosures = document.querySelectorAll<HTMLDetailsElement>('.home-reading-details, .home-rabbi-story, .home-values-details');
        const mobileDisclosureViewport = window.matchMedia('(max-width: 767px)');
        const syncMobileDisclosures = () => {
            mobileDisclosures.forEach((details) => {
                details.open = !mobileDisclosureViewport.matches;
            });
        };

        mobileDisclosureViewport.addEventListener('change', syncMobileDisclosures);
        syncMobileDisclosures();
    </script>
</BaseLayout>
