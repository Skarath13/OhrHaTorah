---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Navigation from '../components/layout/Navigation.astro';
import Footer from '../components/layout/Footer.astro';
import ParashahCard from '../components/islands/ParashahCard.astro';
import CandleLighting from '../components/islands/CandleLighting.astro';
import LiveClock from '../components/islands/LiveClock.astro';
// Admin functionality moved to /admin/ routes
import { rabbi } from '../data/rabbi';
---

<BaseLayout stylesheets={["/styles/home.css"]}>
    <div class="home-site-chrome">
        <Header />
        <Navigation />
    </div>

    <main class="home-redesign">
        <section class="home-hero" aria-labelledby="home-hero-title">
            <div class="home-hero-media" aria-hidden="true">
                <video
                    id="home-hero-video"
                    autoplay
                    loop
                    muted
                    playsinline
                    preload="metadata"
                    poster="/media/hero/ohr-hatorah-hero-poster.webp"
                >
                    <source
                        src="/media/hero/ohr-hatorah-hero-mobile.webm"
                        media="(max-width: 767px)"
                        type="video/webm"
                    >
                    <source
                        src="/media/hero/ohr-hatorah-hero-mobile.mp4"
                        media="(max-width: 767px)"
                        type="video/mp4"
                    >
                    <source src="/media/hero/ohr-hatorah-hero-desktop.webm" type="video/webm">
                    <source src="/media/hero/ohr-hatorah-hero-desktop.mp4" type="video/mp4">
                </video>
            </div>
            <div class="home-hero-veil" aria-hidden="true"></div>

            <div class="home-shell home-hero-inner">
                <a class="home-hero-logo" href="/" aria-label="Kehilat Ohr HaTorah home">
                    <img src="/images/logo.png" alt="Kehilat Ohr HaTorah" width="612" height="408">
                </a>
                <h1 id="home-hero-title" data-editable="main-title">
                    <span data-editable="main-title-text">Shalom, and welcome to Kehilat Ohr HaTorah</span>
                </h1>
                <p class="home-hero-intro" data-editable="intro-text-1"><strong>Kehilat Ohr HaTorah</strong> is a warm Messianic Jewish congregation in Orange County, welcoming Jewish and non-Jewish people, couples, and families.</p>
                <div class="home-hero-actions" aria-label="Plan a visit">
                    <a class="home-button home-button-primary" href="#shabbat-activities-section">
                        <span>Plan Your Visit</span>
                        <i class="fas fa-arrow-right" aria-hidden="true"></i>
                    </a>
                    <a
                        class="home-button home-button-secondary"
                        href="https://www.google.com/maps/dir/?api=1&destination=Kehilat+OhrHaTorah+Messianic+Jewish+Synagogue,+10460+Slater+Ave,+Fountain+Valley,+CA+92708"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        <span>Get Directions</span>
                        <i class="fas fa-up-right-from-square" aria-hidden="true"></i>
                    </a>
                </div>
            </div>
        </section>

        <section class="home-section home-this-shabbat" aria-labelledby="this-shabbat-title">
            <div class="home-shell">
                <div class="home-section-heading">
                    <div>
                        <h2 id="this-shabbat-title">This Shabbat</h2>
                    </div>
                </div>

                <div class="home-shabbat-primary">
                    <article class="home-schedule-card" id="shabbat-activities-section">
                        <p class="home-section-kicker">Our Shabbat Gathering</p>
                        <h3>An afternoon of worship, Torah, and community</h3>
                        <div class="home-shabbat-timeline" data-editable="service-times">
                            <div class="home-timeline-row home-timeline-row-friday">
                                <div class="home-timeline-time"><span>Friday</span></div>
                                <div>
                                    <strong>Shabbat begins at home</strong>
                                    <p>Festive Shabbat meals in the home</p>
                                </div>
                            </div>
                            <div class="home-timeline-row">
                                <time datetime="14:30">2:30 PM</time>
                                <div><strong>Music and Dance</strong></div>
                            </div>
                            <div class="home-timeline-row">
                                <time datetime="15:00">3:00 PM</time>
                                <div><strong>Prayer and Torah</strong><p>Traditional prayers and Torah Service (Mincha)</p></div>
                            </div>
                            <div class="home-timeline-row">
                                <time datetime="16:30">4:30 PM</time>
                                <div><strong>Learn Together</strong><p>Discussion on the weekly readings</p></div>
                            </div>
                            <p class="home-timeline-note"><em>We plan soon to offer a morning service (Shacharit).</em></p>
                        </div>
                    </article>

                    <details class="home-reading-card home-reading-details" open>
                        <summary>Explore this week's Torah readings</summary>
                        <figure class="home-reading-image">
                            <img src="/images/stock/torah-study.webp" alt="A hand following the text in a Torah scroll" width="1800" height="1200" loading="lazy" decoding="async">
                            <figcaption>Torah for this week</figcaption>
                        </figure>
                        <ParashahCard />
                    </details>
                </div>

                <section class="home-shabbat-dashboard" aria-label="Live Shabbat details">
                    <div class="home-dashboard-heading">
                        <h3>Shabbat at a glance</h3>
                    </div>
                    <div class="home-dashboard-grid">
                        <aside class="home-prayer-card" aria-label="Prayer times">
                            <h3 data-editable="sidebar-prayer-header"><span data-editable="sidebar-prayer-title">Prayer Times</span></h3>
                            <div class="prayer-times">
                                <div class="prayer-row">
                                    <div class="prayer-name" data-editable="prayer-shacharit-name">Shacharit</div>
                                    <div class="prayer-time" id="shacharit-time">Loading...</div>
                                </div>
                                <div class="prayer-row">
                                    <div class="prayer-name" data-editable="prayer-mincha-name">Mincha</div>
                                    <div class="prayer-time" id="mincha-time">Loading...</div>
                                </div>
                                <div class="prayer-row">
                                    <div class="prayer-name" data-editable="prayer-maariv-name">Ma'ariv</div>
                                    <div class="prayer-time" id="maariv-time">Loading...</div>
                                </div>
                            </div>
                            <div class="prayer-last-updated" id="prayer-last-updated">
                                <span class="live-indicator" id="prayer-live-indicator" title="Live from Hebcal">
                                    <span class="live-dot"></span>
                                    <span class="live-text">LIVE</span>
                                </span>
                                <span class="updated-time" id="prayer-updated-time"></span>
                            </div>
                        </aside>
                        <div class="home-candle-card">
                            <CandleLighting />
                        </div>
                        <div class="home-clock-card">
                            <LiveClock />
                        </div>
                    </div>
                </section>
            </div>
        </section>

        <section class="home-section home-purpose" aria-labelledby="home-purpose-title">
            <div class="home-shell">
                <div class="home-section-heading">
                    <div>
                        <h2 id="home-purpose-title">Faith, Heritage, and Community</h2>
                    </div>
                </div>

                <div class="home-purpose-grid">
                    <article class="home-card home-mission-card">
                        <div class="home-card-heading">
                            <span class="home-purpose-icon" aria-hidden="true">
                                <!-- Tabler Icons: target-arrow, MIT License -->
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M11 12a1 1 0 1 0 2 0a1 1 0 1 0 -2 0"></path>
                                    <path d="M12 7a5 5 0 1 0 5 5"></path>
                                    <path d="M13 3.055a9 9 0 1 0 7.941 7.945"></path>
                                    <path d="M15 6v3h3l3 -3h-3v-3l-3 3"></path>
                                    <path d="M15 9l-3 3"></path>
                                </svg>
                            </span>
                            <div>
                                <h3 data-editable="sidebar-mission-header"><span data-editable="sidebar-mission-title">Our Mission</span></h3>
                            </div>
                        </div>
                        <p data-editable="mission-statement">We are building a welcoming community where Jewish and non-Jewish people can live the richness of Jewish life, embrace Yeshua as Israel's promised Messiah, and grow together in faith and understanding.</p>
                    </article>

                    <article class="home-card home-vision-card">
                        <div class="home-card-heading">
                            <span class="home-purpose-icon" aria-hidden="true">
                                <!-- Tabler Icons: telescope, MIT License -->
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M6 21l6 -5l6 5"></path>
                                    <path d="M12 13v8"></path>
                                    <path d="M3.294 13.678l.166 .281c.52 .88 1.624 1.265 2.605 .91l14.242 -5.165a1.023 1.023 0 0 0 .565 -1.456l-2.62 -4.705a1.087 1.087 0 0 0 -1.447 -.42l-.056 .032l-12.694 7.618c-1.02 .613 -1.357 1.897 -.76 2.905l-.001 0"></path>
                                    <path d="M14 5l3 5.5"></path>
                                </svg>
                            </span>
                            <div>
                                <h3 data-editable="sidebar-vision-header"><span data-editable="sidebar-vision-title">Our Vision</span></h3>
                            </div>
                        </div>
                        <p data-editable="vision-statement">We seek to be a light to the nations, a thriving Messianic Jewish community that bears witness to the unity of Scripture and to God's promises fulfilled through Yeshua.</p>
                    </article>

                    <article class="home-card home-values-card">
                        <div class="home-card-heading">
                            <div>
                                <h3 data-editable="sidebar-values-header"><span data-editable="sidebar-values-title">Core Values</span></h3>
                            </div>
                        </div>
                        <details class="home-values-details" open>
                            <summary>Explore our eight core values</summary>
                            <div class="home-values-grid">
                                <div class="home-value-item">
                                    <div><h4 data-editable="value-torah-title">Torah Faithfulness</h4><p data-editable="value-torah-desc">Living according to God's eternal instructions</p></div>
                                </div>
                                <div class="home-value-item">
                                    <div><h4 data-editable="value-identity-title">Jewish Identity</h4><p data-editable="value-identity-desc">Celebrating our rich Jewish heritage and traditions</p></div>
                                </div>
                                <div class="home-value-item">
                                    <div><h4 data-editable="value-messiah-title">Yeshua as Messiah</h4><p data-editable="value-messiah-desc">Embracing Jesus as Israel's promised Redeemer</p></div>
                                </div>
                                <div class="home-value-item">
                                    <div><h4 data-editable="value-community-title">Loving Community</h4><p data-editable="value-community-desc">Welcoming all who seek to grow in faith</p></div>
                                </div>
                                <div class="home-value-item">
                                    <div><h4 data-editable="value-study-title">Biblical Study</h4><p data-editable="value-study-desc">Commitment to deep Scripture learning and understanding</p></div>
                                </div>
                                <div class="home-value-item">
                                    <div><h4 data-editable="value-worship-title">Authentic Worship</h4><p data-editable="value-worship-desc">Heartfelt praise through Jewish liturgy and tradition</p></div>
                                </div>
                                <div class="home-value-item">
                                    <div><h4 data-editable="value-growth-title">Spiritual Growth</h4><p data-editable="value-growth-desc">Encouraging maturity in faith and character</p></div>
                                </div>
                                <div class="home-value-item">
                                    <div><h4 data-editable="value-compassion-title">Compassionate Service</h4><p data-editable="value-compassion-desc">Serving others with love and practical care</p></div>
                                </div>
                            </div>
                        </details>
                    </article>
                </div>
            </div>
        </section>

        <section class="home-section home-visit" aria-labelledby="visit-title">
            <div class="home-shell">
                <div class="home-section-heading">
                    <div>
                        <h2 id="visit-title">Plan Your Visit</h2>
                    </div>
                </div>

                <div class="home-visit-grid">
                    <figure class="home-visit-image">
                        <img src="/images/stock/mezuzah-light.webp" alt="A hand holding a mezuzah in warm light" width="1202" height="1800" loading="lazy" decoding="async">
                        <figcaption>A warm welcome begins at the door.</figcaption>
                    </figure>
                    <div class="home-arrival-panel">
                        <h3 data-editable="sidebar-welcome-header"><span data-editable="sidebar-welcome-title">Shalom Visitor!</span></h3>
                        <nav aria-label="Visitor information">
                            <ol class="home-arrival-steps">
                                <li>
                                    <a href="/services">
                                        <span class="home-arrival-icon" aria-hidden="true">
                                            <!-- Tabler Icons: calendar-time, MIT License -->
                                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M11.795 21h-6.795a2 2 0 0 1 -2 -2v-12a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v4"></path><path d="M14 18a4 4 0 1 0 8 0a4 4 0 1 0 -8 0"></path><path d="M15 3v4"></path><path d="M7 3v4"></path><path d="M3 11h16"></path><path d="M18 16.496v1.504l1 1"></path></svg>
                                        </span>
                                        <strong>Service times</strong>
                                        <i class="fas fa-arrow-right" aria-hidden="true"></i>
                                    </a>
                                </li>
                                <li>
                                    <a href="https://www.google.com/maps/dir/?api=1&destination=Kehilat+OhrHaTorah+Messianic+Jewish+Synagogue,+10460+Slater+Ave,+Fountain+Valley,+CA+92708" target="_blank" rel="noopener noreferrer">
                                        <span class="home-arrival-icon" aria-hidden="true">
                                            <!-- Tabler Icons: map-pin, MIT License -->
                                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11a3 3 0 1 0 6 0a3 3 0 0 0 -6 0"></path><path d="M17.657 16.657l-4.243 4.243a2 2 0 0 1 -2.827 0l-4.244 -4.243a8 8 0 1 1 11.314 0"></path></svg>
                                        </span>
                                        <strong>Directions</strong>
                                        <i class="fas fa-arrow-right" aria-hidden="true"></i>
                                    </a>
                                </li>
                                <li>
                                    <a href="/faq">
                                        <span class="home-arrival-icon" aria-hidden="true">
                                            <!-- Tabler Icons: message-question, MIT License -->
                                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M8 9h8"></path><path d="M8 13h6"></path><path d="M14 18h-1l-5 3v-3h-2a3 3 0 0 1 -3 -3v-8a3 3 0 0 1 3 -3h12a3 3 0 0 1 3 3v4.5"></path><path d="M19 22v.01"></path><path d="M19 19a2.003 2.003 0 0 0 .914 -3.782a1.98 1.98 0 0 0 -2.414 .483"></path></svg>
                                        </span>
                                        <strong>What to expect</strong>
                                        <i class="fas fa-arrow-right" aria-hidden="true"></i>
                                    </a>
                                </li>
                            </ol>
                        </nav>
                        <div class="home-service-address" data-editable="location-text">
                            <span>Service location</span>
                            <strong>10460 Slater Ave<br>Fountain Valley, CA 92708</strong>
                        </div>
                    </div>

                    <article class="home-map-card">
                        <div class="home-map-caption"><span>Orange County</span><strong>Find Our Service</strong></div>
                        <div class="map-container">
                            <iframe
                                src="https://maps.google.com/maps?q=Kehilat+OhrHaTorah+Messianic+Jewish+Synagogue,Fountain+Valley,CA&t=&z=15&ie=UTF8&iwloc=&output=embed"
                                class="home-map-iframe"
                                title="Map to Kehilat Ohr HaTorah Messianic Jewish Synagogue"
                                width="100%"
                                height="100%"
                                allowfullscreen=""
                                loading="lazy"
                                referrerpolicy="no-referrer-when-downgrade"
                            ></iframe>
                        </div>
                        <a
                            href="https://www.google.com/maps/dir/?api=1&destination=Kehilat+OhrHaTorah+Messianic+Jewish+Synagogue,+10460+Slater+Ave,+Fountain+Valley,+CA+92708"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="home-text-link"
                        >
                            <span>Open directions</span>
                            <i class="fas fa-up-right-from-square" aria-hidden="true"></i>
                        </a>
                    </article>

                    <div class="home-visit-utility" id="contact-us-section" data-editable="contact-info">
                        <div><span>Mail</span><p>360 E. 1st Street, #856<br>Tustin, CA 92780</p></div>
                        <div><span>Email</span><p><a href="mailto:OhrHaTorahOC@gmail.com">OhrHaTorahOC@gmail.com</a></p></div>
                        <div><span>Call</span><p><a href="tel:+17144061513">(714) 406-1513</a></p></div>
                    </div>
                </div>
            </div>
        </section>

        <section class="home-section home-calendar-section" aria-labelledby="congregation-calendar">
            <div class="home-shell">
                <div class="home-section-heading">
                    <div>
                        <h2 id="congregation-calendar">Congregation Calendar</h2>
                    </div>
                    <a
                        class="home-text-link"
                        href="https://calendar.google.com/calendar/embed?src=ohrhatorahoc%40gmail.com&ctz=America%2FLos_Angeles"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        <span>Open Full Calendar</span>
                        <i class="fas fa-up-right-from-square" aria-hidden="true"></i>
                    </a>
                </div>
                <div class="home-calendar-layout">
                    <figure class="home-calendar-image">
                        <img src="/images/stock/holiday-table.webp" alt="A menorah and flowers set for a Jewish holiday gathering" width="1202" height="1800" loading="lazy" decoding="async">
                        <figcaption>
                            <strong>Gather through the Jewish year.</strong>
                            <span>Shabbat, holidays, learning, and community.</span>
                        </figcaption>
                    </figure>
                    <div class="home-calendar-frame">
                        <iframe
                            src="https://calendar.google.com/calendar/embed?src=ohrhatorahoc%40gmail.com&ctz=America%2FLos_Angeles"
                            class="home-calendar-iframe"
                            title="Ohr HaTorah congregation calendar"
                            width="800"
                            height="520"
                            frameborder="0"
                            loading="lazy"
                            scrolling="no"
