                <div class="home-calendar-actions" aria-label="Calendar links">
                    <a href={GOOGLE_CALENDAR_URL} target="_blank" rel="noopener noreferrer" class="home-btn home-btn-primary">
                        <i class="fas fa-calendar-alt" aria-hidden="true"></i>
                        Open Google Calendar
