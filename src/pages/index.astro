---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import ParashahCard from '../components/islands/ParashahCard.astro';
import CandleLighting from '../components/islands/CandleLighting.astro';
import LiveClock from '../components/islands/LiveClock.astro';
import { rabbi } from '../data/rabbi';
import {
    IconArrowRight,
    IconBook2,
    IconCalendarEvent,
    IconCheck,
    IconChevronDown,
    IconClock,
    IconExternalLink,
    IconHeartHandshake,
    IconMail,
    IconMapPin,
    IconPhone,
    IconJewishStar,
    IconSun,
    IconUsers,
} from '@tabler/icons-astro';

const serviceAddress = '10460 Slater Ave, Fountain Valley, CA 92708';
const directionsUrl = 'https://www.google.com/maps/dir/?api=1&destination=Kehilat+OhrHaTorah+Messianic+Jewish+Synagogue,+10460+Slater+Ave,+Fountain+Valley,+CA+92708';
const calendarUrl = 'https://calendar.google.com/calendar/embed?src=ohrhatorahoc%40gmail.com&ctz=America%2FLos_Angeles';
---

<BaseLayout
    title="Ohr HaTorah Messianic Congregation | Orange County"
    description="Kehilat Ohr HaTorah is a welcoming Messianic Jewish synagogue in Fountain Valley, California, where Torah and the teachings of Yeshua come together as one."
    bodyClass="home-page"
    preloadImage="/images/generated/oht-watercolor-hero.webp"
>
    <Header />

    <main id="main-content" tabindex="-1">
        <section class="home-hero" aria-labelledby="home-hero-title">
            <div class="home-hero__copy">
                <p class="home-hero__datum">Fountain Valley · Saturdays at 2:30 PM</p>
                <h1 id="home-hero-title">
                    <span data-editable="main-title">Torah &amp; Messiah.</span>
                    <em data-editable="main-title-text">Together as one.</em>
                </h1>
                <p class="home-hero__lead" data-editable="intro-text-1">A welcoming Messianic Jewish synagogue where Jewish and non-Jewish families worship, learn Scripture, and grow together.</p>
                <p class="home-hero__support" data-editable="intro-text-2">Join us this Saturday at 2:30 PM.</p>
                <div class="home-hero__actions">
                    <a class="button button--gold" href="#visit">Plan your visit <IconArrowRight size={19} stroke={1.8} aria-hidden="true" /></a>
                    <a class="text-link text-link--light" href="/expect">What to expect</a>
                </div>
            </div>

            <figure class="home-hero__media" aria-hidden="true">
                <img src="/images/generated/oht-watercolor-hero.webp" alt="" width="1717" height="916" loading="eager" decoding="async" fetchpriority="high">
            </figure>
            <span class="home-hero__light" aria-hidden="true"></span>
        </section>

        <nav class="home-facts" aria-label="Essential visit information">
            <a href="#visit">
                <IconClock size={22} stroke={1.7} aria-hidden="true" />
                <span><small>This Shabbat</small><strong>Saturday · 2:30 PM</strong></span>
            </a>
            <a href={directionsUrl} target="_blank" rel="noopener noreferrer">
                <IconMapPin size={22} stroke={1.7} aria-hidden="true" />
                <span><small>Orange County</small><strong>Fountain Valley, CA</strong><span class="sr-only"> (opens in a new tab)</span></span>
            </a>
            <a href="/expect">
                <IconHeartHandshake size={22} stroke={1.7} aria-hidden="true" />
                <span><small>Your first visit</small><strong>Come as you are</strong></span>
            </a>
        </nav>

        <section class="home-visit" id="visit" aria-labelledby="visit-title" data-reveal>
            <div class="home-visit__intro">
                <h2 id="visit-title">Plan your visit.</h2>
                <p>Everything is explained, participation is always at your pace, and questions are welcome.</p>
                <div class="home-visit__actions">
                    <a class="button button--gold" href={directionsUrl} target="_blank" rel="noopener noreferrer">Get directions <IconExternalLink size={18} stroke={1.8} aria-hidden="true" /><span class="sr-only"> (opens in a new tab)</span></a>
                    <a class="text-link text-link--light" href="/contact">Ask a question</a>
                </div>
            </div>

            <div class="home-visit__details">
                <div class="home-service-schedule">
                    <p class="home-service-schedule__summary" data-editable="service-times">Saturday service · begins at 2:30 PM</p>
                    <p><span>2:30 PM</span><strong>Messianic Jewish music &amp; dance</strong></p>
                    <p><span>3:00 PM</span><strong>Traditional Mincha &amp; Torah service</strong></p>
                    <p><span>4:30 PM</span><strong>Discussion on the weekly readings</strong></p>
                </div>
                <div class="home-visit__address">
                    <IconMapPin size={21} stroke={1.7} aria-hidden="true" />
                    <p><strong>Service location</strong><span data-editable="location-text">{serviceAddress}</span></p>
                </div>
                <div class="home-visit__contact">
                    <p data-editable="contact-info">Questions are welcome.</p>
                    <a href="tel:+17144061513"><IconPhone size={19} stroke={1.7} aria-hidden="true" /> (714) 406-1513</a>
                    <a href="mailto:OhrHaTorahOC@gmail.com"><IconMail size={19} stroke={1.7} aria-hidden="true" /> OhrHaTorahOC@gmail.com</a>
                </div>
            </div>
        </section>

        <section class="home-welcome editorial-spread" aria-labelledby="home-welcome-title" data-reveal>
            <figure class="home-welcome__media">
                <img src="/images/generated/oht-community-gathering.webp" alt="Watercolor illustration of a multigenerational Jewish community gathering for Shabbat" width="1254" height="1254" loading="lazy" decoding="async">
                <figcaption>Watercolor illustration</figcaption>
            </figure>
            <div class="home-welcome__copy">
                <p class="home-welcome__promise"><span data-editable="sidebar-welcome-header">A place</span> <span data-editable="sidebar-welcome-title">to belong</span></p>
                <h2 id="home-welcome-title"><span data-editable="about-us-title">Rooted in Jewish life.</span> <span data-editable="about-us-title-text">Open to every sincere seeker.</span></h2>
                <p data-editable="about-us-text-1">We honor Jewish life and tradition while serving Yeshua, the Jewish Messiah.</p>
                <p data-editable="about-us-text-2">Services blend Hebrew and English prayer, Torah reading, teaching, music, and fellowship.</p>
                <ul class="home-welcome__assurances" aria-label="What visitors can expect">
                    <li><IconCheck size={19} stroke={1.8} aria-hidden="true" /> Come as you are</li>
                    <li><IconCheck size={19} stroke={1.8} aria-hidden="true" /> Everything is explained</li>
                    <li><IconCheck size={19} stroke={1.8} aria-hidden="true" /> Participate at your pace</li>
                </ul>
                <a class="text-link" href="/expect">Read what to expect <IconArrowRight size={18} stroke={1.8} aria-hidden="true" /></a>
            </div>
        </section>

        <section class="home-leadership" aria-labelledby="leader-title" data-reveal>
            <div class="home-leadership__inner">
                <figure class="home-leadership__portrait">
                    <picture>
                        <source srcset="/images/rabbi.avif" type="image/avif">
                        <source srcset="/images/rabbi.webp" type="image/webp">
                        <img src="/images/rabbi.jpg" alt={rabbi.name} width="800" height="800" loading="lazy" decoding="async">
                    </picture>
                </figure>
                <div class="home-leadership__copy">
                    <p class="home-leadership__intro" data-editable="rabbi-card-title">Meet our rabbi</p>
                    <h2 id="leader-title" data-editable="rabbi-name">{rabbi.name}</h2>
                    <strong data-editable="rabbi-title">{rabbi.title}</strong>
                    <p data-editable="rabbi-bio">{rabbi.bio}</p>
                    <div class="home-leadership__trust">
                        <p data-editable="about-us-text-3">Rabbi Charles (Chaim) Ott brings decades of Messianic leadership.</p>
                        <p data-editable="about-us-text-4">Ohr HaTorah is affiliated with the Union of Messianic Jewish Congregations.</p>
                    </div>
                    <a class="text-link" href={`mailto:${rabbi.email}`}>Connect with Rabbi Ott <IconArrowRight size={18} stroke={1.8} aria-hidden="true" /></a>
                </div>
            </div>
        </section>

        <section class="home-week" id="weekly-readings" aria-labelledby="week-title">
            <header class="home-week__mast">
                <img src="/images/generated/oht-study-still-life.webp" alt="" width="1536" height="1024" loading="eager" decoding="async" aria-hidden="true">
                <div>
                    <p class="chapter-mark">A living congregational almanac</p>
                    <h2 id="week-title">This week’s Jewish calendar.</h2>
                    <p>Hebrew date, weekly readings, candle lighting, and reference times for Fountain Valley.</p>
                </div>
            </header>

            <div class="home-almanac" aria-label="This week's Jewish calendar information" data-reveal>
                <div class="home-live__clock"><LiveClock /></div>
                <div class="home-live__parashah"><ParashahCard /></div>
                <div class="home-live__candles"><CandleLighting /></div>

                <details class="home-prayer-times">
                    <summary>
                        <span><span data-editable="sidebar-prayer-header">Daily</span> <span data-editable="sidebar-prayer-title">zmanim</span></span>
                        <span>Reference times <IconChevronDown size={18} stroke={1.8} aria-hidden="true" /></span>
                    </summary>
                    <div class="home-prayer-times__rows">
                        <p><span data-editable="prayer-shacharit-name">Sunrise / Netz</span><strong id="shacharit-time">Loading…</strong></p>
                        <p><span data-editable="prayer-mincha-name">Mincha Gedolah</span><strong id="mincha-time">Loading…</strong></p>
                        <p><span data-editable="prayer-maariv-name">Nightfall / Tzeit 85°</span><strong id="maariv-time">Loading…</strong></p>
                    </div>
                    <small id="prayer-last-updated" aria-live="polite">Live reference times for Fountain Valley</small>
                </details>
            </div>
        </section>

        <section class="home-calendar" id="congregation-calendar" aria-labelledby="calendar-title" data-reveal>
            <div class="home-calendar__copy">
                <h2 id="calendar-title">The calendar begins with Shabbat.</h2>
                <p>Our weekly service is the steady center of congregational life. Holiday observances, classes, and special gatherings are published in the full calendar.</p>
                <div class="home-calendar__actions">
                    <a class="button button--primary" href={calendarUrl} target="_blank" rel="noopener noreferrer">Open full calendar <IconExternalLink size={18} stroke={1.8} aria-hidden="true" /><span class="sr-only"> (opens in a new tab)</span></a>
                    <a class="text-link" href="/events">Special events</a>
                </div>
            </div>
            <div class="home-calendar__event">
                <IconCalendarEvent size={30} stroke={1.5} aria-hidden="true" />
                <p><span>Every Saturday</span><strong>Shabbat service</strong><small>2:30 PM · Fountain Valley</small></p>
                <a href="#visit" aria-label="Plan your Shabbat visit"><IconArrowRight size={22} stroke={1.7} aria-hidden="true" /></a>
            </div>
        </section>

        <section class="home-purpose" aria-labelledby="purpose-title">
            <div class="home-purpose__inner">
                <div class="home-purpose__statement" data-reveal>
                    <h2 id="purpose-title">Faith expressed in practice.</h2>
                    <div class="purpose-pair">
                        <article>
                            <h3><span data-editable="sidebar-mission-header">Our</span> <span data-editable="sidebar-mission-title">mission</span></h3>
                            <p data-editable="mission-statement">We welcome Jewish and non-Jewish people to explore Jewish faith and practice while embracing Yeshua as Israel’s Messiah.</p>
                        </article>
                        <article>
                            <h3><span data-editable="sidebar-vision-header">Our</span> <span data-editable="sidebar-vision-title">vision</span></h3>
                            <p data-editable="vision-statement">We seek to preserve Jewish heritage, bridge Jewish and Gentile believers, and bear faithful witness to God’s promises.</p>
                        </article>
                    </div>
                    <a class="text-link text-link--light" href="/mission">Read our mission and values <IconArrowRight size={18} stroke={1.8} aria-hidden="true" /></a>
                </div>

                <div class="home-purpose__values" data-reveal>
                    <h3><span data-editable="sidebar-values-header">Core</span> <span data-editable="sidebar-values-title">values</span></h3>
                    <ul class="values-featured">
                        <li><IconBook2 size={22} stroke={1.6} aria-hidden="true" /><div><h4 data-editable="value-torah-title">Torah Faithfulness</h4><p data-editable="value-torah-desc">Living according to God's eternal instructions.</p></div></li>
                        <li><IconSun size={22} stroke={1.6} aria-hidden="true" /><div><h4 data-editable="value-messiah-title">Yeshua as Messiah</h4><p data-editable="value-messiah-desc">Embracing Israel's promised Redeemer.</p></div></li>
                        <li><IconUsers size={22} stroke={1.6} aria-hidden="true" /><div><h4 data-editable="value-community-title">Loving Community</h4><p data-editable="value-community-desc">Welcoming all who seek to grow in faith.</p></div></li>
                    </ul>

                    <details class="values-more">
                        <summary>Explore all eight values <IconChevronDown size={18} stroke={1.8} aria-hidden="true" /></summary>
                        <ul>
                            <li><IconJewishStar size={21} stroke={1.6} aria-hidden="true" /><div><h4 data-editable="value-identity-title">Jewish Identity</h4><p data-editable="value-identity-desc">Celebrating Jewish heritage and traditions.</p></div></li>
                            <li><IconBook2 size={21} stroke={1.6} aria-hidden="true" /><div><h4 data-editable="value-study-title">Biblical Study</h4><p data-editable="value-study-desc">Deep learning across all of Scripture.</p></div></li>
                            <li><IconSun size={21} stroke={1.6} aria-hidden="true" /><div><h4 data-editable="value-worship-title">Authentic Worship</h4><p data-editable="value-worship-desc">Heartfelt praise through Jewish liturgy and song.</p></div></li>
                            <li><IconSun size={21} stroke={1.6} aria-hidden="true" /><div><h4 data-editable="value-growth-title">Spiritual Growth</h4><p data-editable="value-growth-desc">Maturity in faith, character, and practice.</p></div></li>
                            <li><IconHeartHandshake size={21} stroke={1.6} aria-hidden="true" /><div><h4 data-editable="value-compassion-title">Compassionate Service</h4><p data-editable="value-compassion-desc">Serving neighbors with practical love and care.</p></div></li>
                        </ul>
                    </details>
                </div>

                <div class="home-purpose__closing" data-reveal>
                    <h3 data-editable="community-card-title">Known, welcomed, and free to learn at your own pace.</h3>
                    <div>
                        <a class="button button--gold" href="#visit">Plan your visit <IconArrowRight size={19} stroke={1.8} aria-hidden="true" /></a>
                        <a class="text-link text-link--light" href="/expect">What to expect</a>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <Footer />

    <script>
        interface ZmanimResponse {
            times?: {
                sunrise?: string;
                minchaGedola?: string;
                tzeit85deg?: string;
            };
        }

        const formatPrayerTime = (isoDate: string) => new Date(isoDate).toLocaleTimeString('en-US', {
            hour: 'numeric',
            minute: '2-digit',
            hour12: true,
        });

        const loadPrayerTimes = async () => {
            const status = document.querySelector<HTMLElement>('#prayer-last-updated');
            try {
                const date = new Date().toLocaleDateString('en-CA', { timeZone: 'America/Los_Angeles' });
                const response = await fetch(`https://www.hebcal.com/zmanim?cfg=json&zip=92708&date=${date}`);
                if (!response.ok) throw new Error('Unable to fetch prayer times');
                const data = await response.json() as ZmanimResponse;
                const values = [
                    ['#shacharit-time', data.times?.sunrise],
                    ['#mincha-time', data.times?.minchaGedola],
                    ['#maariv-time', data.times?.tzeit85deg],
                ] as const;

                values.forEach(([selector, value]) => {
                    const element = document.querySelector<HTMLElement>(selector);
                    if (element && value) element.textContent = formatPrayerTime(value);
                });
                if (status) status.textContent = 'Reference times via Hebcal · Fountain Valley';
            } catch {
                if (status) status.textContent = 'Reference times are temporarily unavailable.';
            }
        };

        const revealElements = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduceMotion || !('IntersectionObserver' in window)) {
            revealElements.forEach(element => element.classList.add('is-visible'));
        } else {
            const observer = new IntersectionObserver(entries => {
                entries.forEach(entry => {
                    if (!entry.isIntersecting) return;
                    entry.target.classList.add('is-visible');
                    observer.unobserve(entry.target);
                });
            }, { threshold: 0.12 });
            revealElements.forEach(element => observer.observe(element));
        }

        void loadPrayerTimes();
    </script>
</BaseLayout>
