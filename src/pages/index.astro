                    <i class="fas fa-clock" aria-hidden="true"></i>
                    <span data-editable="sidebar-prayer-title">Prayer Times</span>
                    <div class="home-prayer-list">
                        <div>
                            <small data-editable="prayer-shacharit-name">Shacharit</small>
