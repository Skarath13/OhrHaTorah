                        <span class="live-indicator" id="prayer-live-indicator" title="Live from Hebcal">
                            <span class="live-dot"></span>
                            <span class="live-text">LIVE</span>
                        </span>
                        <span class="updated-time" id="prayer-updated-time"></span>
                    </div>
                </article>

                <div class="home-mini-card home-clock-card">
                    <LiveClock />
                </div>

                <ParashahCard />
                <CandleLighting />
            </div>
        </section>

        <section class="home-story-section" id="home-story" aria-labelledby="home-story-title">
