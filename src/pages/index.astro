<BaseLayout>
    <Header />
    <Navigation />

    <main class="home-redesign">
        <section class="home-hero-shell" aria-labelledby="home-title">
            <div class="home-hero-bottom-blur" aria-hidden="true"></div>

            <div class="home-hero-copy">
