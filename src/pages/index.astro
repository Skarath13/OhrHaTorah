---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Navigation from '../components/layout/Navigation.astro';
import MobileNavigation from '../components/layout/MobileNavigation.astro';
import Footer from '../components/layout/Footer.astro';
import SectionDivider from '../components/layout/SectionDivider.astro';
import ParashahCard from '../components/islands/ParashahCard.astro';
import CandleLighting from '../components/islands/CandleLighting.astro';
import LiveClock from '../components/islands/LiveClock.astro';
import CongregationCalendar from '../components/islands/CongregationCalendar.astro';
import CalendarManager from '../components/admin/CalendarManager.astro';
import DirectionsMap from '../components/maps/DirectionsMap.astro';
// Admin functionality moved to /admin/ routes
import { rabbi } from '../data/rabbi';
import Editable from '../components/content/Editable.astro';
import EditableImage from '../components/content/EditableImage.astro';
---

<BaseLayout stylesheets={["/styles/home.css?rev=20261028-hero-scroll-1"]}>
    <div class="home-site-chrome site-navigation-shell">
        <Header showLogo={false} showMobileMark={false} />
        <Navigation />
    </div>
    <MobileNavigation />

    <div class="home-scroll-thread" data-home-scroll-thread aria-hidden="true">
        <span class="home-scroll-thread__track"></span>
        <span class="home-scroll-thread__progress"></span>
        <span class="home-scroll-thread__marker"></span>
    </div>

    <main id="main-content" tabindex="-1" class="home-redesign">
        <section class="home-hero" aria-labelledby="home-hero-title">
            <div class="home-hero-media" aria-hidden="true">
                <video
                    id="home-hero-video"
                    autoplay
                    loop
                    muted
                    playsinline
                    preload="auto"
                    disablepictureinpicture
                >
                    <source
                        src="/api/hero-video/mobile-v3"
                        media="(max-width: 767px)"
                        type="video/mp4"
                    >
                    <source src="/media/hero/ohr-hatorah-hero-mobile-loop-v3.webm" media="(max-width: 767px)" type="video/webm">
                    <source src="/api/hero-video/desktop-v3" type="video/mp4">
                    <source src="/media/hero/ohr-hatorah-hero-desktop-loop-v3.webm" type="video/webm">
                </video>
            </div>

            <div class="home-shell home-hero-inner">
                <div class="home-hero-logo" data-hero-scroll-host>
                    <img src="/images/logo.png" alt="Kehilat Ohr HaTorah" width="612" height="408">
                    <script is:inline>
                        // Hide the flat logo before first paint only when the 3D unfurl can run,
                        // and only on the first home visit of a browser session.
                        (function (host) {
                            var seen = false;
                            try { seen = window.sessionStorage.getItem('oht-hero-scroll-seen') === '1'; } catch (error) { seen = false; }
                            if (!seen && !window.matchMedia('(prefers-reduced-motion: reduce)').matches && 'WebGL2RenderingContext' in window) {
                                host.dataset.heroScroll = 'pending';
                            }
                        })(document.currentScript.parentElement);
                    </script>
                </div>
                <div class="home-hero-copy">
                    <h1 id="home-hero-title">
                        <Editable field="main-title-text">Shalom, and welcome to Kehilat Ohr HaTorah</Editable>
                    </h1>
                    <Editable field="intro-text-1" as="p" class="home-hero-intro"><strong>Kehilat Ohr HaTorah</strong> is a Messianic Jewish synagogue in Orange County, California. We warmly welcome both Jewish and non-Jewish individuals, interfaith couples, and families.</Editable>
                    <div class="home-hero-actions" aria-label="Plan a visit">
                        <a class="home-button home-button-primary" href="#location">
                            <Editable field="home.hero-cta-visit" as="span">Plan Your Visit</Editable>
                            <i class="fas fa-arrow-right" aria-hidden="true"></i>
                        </a>
                        <a
                            class="home-button home-button-secondary"
                            href="https://www.google.com/maps/dir/?api=1&destination=Kehilat+OhrHaTorah+Messianic+Jewish+Synagogue,+10460+Slater+Ave,+Fountain+Valley,+CA+92708"
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            <Editable field="home.hero-cta-directions" as="span">Get Directions</Editable>
                            <i class="fas fa-up-right-from-square" aria-hidden="true"></i>
                        </a>
                    </div>
                </div>
            </div>
            <button class="home-hero-video-toggle" id="home-hero-video-toggle" type="button" aria-controls="home-hero-video" aria-label="Pause background video" hidden>
                <i class="fas fa-pause" aria-hidden="true"></i>
            </button>
        </section>

        <section class="home-section home-community" aria-labelledby="about-us-title-heading">
            <div class="home-shell">
                <div class="home-section-heading home-about-heading" data-home-motion-heading>
                    <div>
                        <h2 id="about-us-title-heading">
                            <Editable field="about-us-title-text">About Us</Editable>
                        </h2>
                    </div>
                    <Editable field="intro-text-2" as="p"><strong>Kehilat Ohr HaTorah:</strong> where Torah, tradition, Jewish life, and faith in Yeshua unite as one.</Editable>
                </div>

                <div class="home-about-grid">
                    <div class="home-about-copy">
                        <Editable field="about-us-text-1" as="p"><strong>Kehilat Ohr HaTorah</strong> is a newly formed UMJC-affiliated Messianic Jewish synagogue in Orange County, California. We warmly welcome both Jewish and non-Jewish individuals, interfaith couples, and families. Join with us in exploring the unmeasurable riches of Messiah Yeshua. Learn with us as we grow in our Torah covenant faithfulness and love for <span class="divine-name"><span class="divine-name__initial">H</span><span class="divine-name__small-caps">ashem</span></span> and His Word.</Editable>

                        <Editable field="about-us-text-2" as="p">Our Shabbat services – prayers, Torah readings, and music – utilize both Hebrew and English. Translations are always provided for spoken and written Hebrew. Teachings and homilies are mostly in English.</Editable>
                    </div>

                    <div class="home-about-aside">
                        <div class="home-about-visual">
                            <EditableImage field="home.image-olive-branches" class="home-about-atmosphere" src="/images/generated/olive-branches.webp" srcset="/images/generated/olive-branches-480.webp 480w, /images/generated/olive-branches-960.webp 960w, /images/generated/olive-branches.webp 1536w" sizes="(max-width: 760px) 100vw, 45vw" alt="Illustration of olive branches in warm sunlight" width="1536" height="1024" loading="lazy" decoding="async" />
                            <figure class="home-rabbi-portrait">
                                <div class="home-rabbi-image-frame">
                                    <EditableImage
                                        field="home.image-rabbi"
                                        src="/images/optimized/rabbi-charles-ott.webp"
                                        alt={rabbi.name}
                                        width="640"
                                        height="640"
                                        loading="lazy"
                                        decoding="async"
                                    />
                                </div>
                                <figcaption>
                                    <Editable field="rabbi-name" as="p" class="home-rabbi-name">{rabbi.name}</Editable>
                                    <Editable field="rabbi-title" as="p" class="home-rabbi-title">{rabbi.title}</Editable>
                                </figcaption>
                            </figure>
                        </div>

                        <section class="home-rabbi-story" aria-labelledby="home-rabbi-title">
                            <Editable field="rabbi-card-title" as="h3" id="home-rabbi-title">Meet Our Rabbi</Editable>
                            <Editable field="rabbi-bio" as="p" class="home-rabbi-bio">{rabbi.bio}</Editable>
                            <Editable field="rabbi-bio-extended" as="p" class="home-rabbi-bio">{rabbi.bioExtended}</Editable>
                        </section>
                    </div>

                    <section class="home-umjc-story" aria-labelledby="home-umjc-title">
                        <Editable field="home.umjc-title" as="h3" id="home-umjc-title">UMJC Affiliation</Editable>
                        <Editable field="home.umjc-text-1" as="p" class="home-rabbi-bio"><strong>Kehilat Ohr HaTorah</strong> is honored to be a member of the <a href="https://www.umjc.org/" target="_blank" rel="noopener noreferrer">UMJC (Union of Messianic Jewish Congregations)<span class="visually-hidden"> (opens in a new tab)</span></a>. We support and identify with its bylaws, practices, and <a href="https://www.umjc.org/statement-of-faith" target="_blank" rel="noopener noreferrer">Statement of Faith<span class="visually-hidden"> (opens in a new tab)</span></a>. We are strengthened by our bond with other like-minded congregations and leaders through conferences, joint activities, and leadership development.</Editable>
                        <Editable field="home.umjc-text-2" as="p" class="home-rabbi-bio">The UMJC has for more than 40 years built itself on the framework of <em>Messianic Judaism</em>. The essential addition of “Judaism” to the generic term “Messianic” reveals our commitment to covenant faithfulness with <span class="divine-name"><span class="divine-name__initial">H</span><span class="divine-name__small-caps">ashem</span></span> and a commitment to walk orderly (Acts 21:24) in a recognizable Jewish context.</Editable>
                        <div class="home-umjc-links">
                            <a class="home-text-link" href="https://www.umjc.org/" target="_blank" rel="noopener noreferrer">
                                <Editable field="home.umjc-link-visit" as="span">Visit the UMJC</Editable>
                                <i class="fas fa-up-right-from-square" aria-hidden="true"></i>
                                <span class="visually-hidden"> (opens in a new tab)</span>
                            </a>
                            <a class="home-text-link" href="https://www.umjc.org/statement-of-faith" target="_blank" rel="noopener noreferrer">
                                <Editable field="home.umjc-link-faith" as="span">UMJC Statement of Faith</Editable>
                                <i class="fas fa-up-right-from-square" aria-hidden="true"></i>
                                <span class="visually-hidden"> (opens in a new tab)</span>
                            </a>
                        </div>
                    </section>

                    <div class="home-about-actions">
                        <a class="home-text-link" href="/about">
                            <Editable field="home.about-link-learn" as="span">Learn more about us</Editable>
                            <i class="fas fa-arrow-right" aria-hidden="true"></i>
                        </a>
                        <a class="home-text-link" href="/umjc">
                            <Editable field="home.about-link-umjc" as="span">Our UMJC membership</Editable>
                            <i class="fas fa-arrow-right" aria-hidden="true"></i>
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <SectionDivider from="var(--home-cream-100)" to="var(--home-blue-950)" shape="sweep" />

        <section class="home-section home-purpose" aria-labelledby="home-purpose-title">
            <div class="home-shell">
                <div class="home-identity-intro">
                    <div class="home-identity-heading" data-home-motion-heading>
                        <Editable field="home.identity-title" as="h2" id="home-purpose-title">Our Identity</Editable>
                    </div>
                    <Editable field="home.identity-statement" as="p" class="home-identity-statement">Learn about the beliefs and commitments that shape our life as a Messianic Jewish congregation.</Editable>
                </div>

                <nav class="home-identity-links" aria-label="Read our identity">
                    <a href="/mission#vision-and-purpose"><Editable field="home.identity-link-vision" as="span">Vision and Purpose</Editable><span aria-hidden="true">→</span></a>
                    <a href="/mission#core-commitments"><Editable field="home.identity-link-commitments" as="span">Core Commitments and Affirmations</Editable><span aria-hidden="true">→</span></a>
                    <a href="/mission#core-values"><Editable field="home.identity-link-values" as="span">Core Values</Editable><span aria-hidden="true">→</span></a>
                </nav>
            </div>
        </section>

        <SectionDivider from="var(--home-blue-950)" to="var(--home-cream-50)" shape="sweep-reverse" />

        <section id="location" class="home-section home-visit" aria-labelledby="visit-title" tabindex="-1">
            <div class="home-shell">
                <div class="home-section-heading" data-home-motion-heading>
                    <div>
                        <Editable field="home.visit-title" as="h2" id="visit-title">Plan Your Visit</Editable>
                    </div>
                </div>

                <div class="home-visit-grid">
                    <figure class="home-visit-image">
                        <EditableImage field="home.image-mezuzah" src="/images/generated/mezuzah-light.webp" srcset="/images/generated/mezuzah-light-480.webp 480w, /images/generated/mezuzah-light-960.webp 960w, /images/generated/mezuzah-light.webp 1024w" sizes="(max-width: 760px) 100vw, 45vw" alt="Illustration of a mezuzah on a warmly lit doorway" width="1024" height="1536" loading="lazy" decoding="async" />
                    </figure>
                    <div class="home-arrival-panel">
                        <h3><Editable field="sidebar-welcome-title">Shalom, visitor</Editable></h3>
                        <Editable field="home.visit-intro" as="p">Join us on Saturdays, beginning at 2:30 p.m.</Editable>
                        <nav aria-label="Visitor information">
                            <ol class="home-arrival-steps">
                                <li>
                                    <a href="/services">
                                        <span class="home-arrival-icon" aria-hidden="true">
                                            <!-- Tabler Icons: calendar-time, MIT License -->
                                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M11.795 21h-6.795a2 2 0 0 1 -2 -2v-12a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v4"></path><path d="M14 18a4 4 0 1 0 8 0a4 4 0 1 0 -8 0"></path><path d="M15 3v4"></path><path d="M7 3v4"></path><path d="M3 11h16"></path><path d="M18 16.496v1.504l1 1"></path></svg>
                                        </span>
                                        <Editable field="home.visit-step-times" as="strong">Service times</Editable>
                                        <i class="fas fa-arrow-right" aria-hidden="true"></i>
                                    </a>
                                </li>
                                <li>
                                    <a href="https://www.google.com/maps/dir/?api=1&destination=Kehilat+OhrHaTorah+Messianic+Jewish+Synagogue,+10460+Slater+Ave,+Fountain+Valley,+CA+92708" target="_blank" rel="noopener noreferrer">
                                        <span class="home-arrival-icon" aria-hidden="true">
                                            <!-- Tabler Icons: map-pin, MIT License -->
                                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11a3 3 0 1 0 6 0a3 3 0 0 0 -6 0"></path><path d="M17.657 16.657l-4.243 4.243a2 2 0 0 1 -2.827 0l-4.244 -4.243a8 8 0 1 1 11.314 0"></path></svg>
                                        </span>
                                        <Editable field="home.visit-step-directions" as="strong">Directions</Editable>
                                        <i class="fas fa-arrow-right" aria-hidden="true"></i>
                                    </a>
                                </li>
                                <li>
                                    <a href="/faq">
                                        <span class="home-arrival-icon" aria-hidden="true">
                                            <!-- Tabler Icons: message-question, MIT License -->
                                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M8 9h8"></path><path d="M8 13h6"></path><path d="M14 18h-1l-5 3v-3h-2a3 3 0 0 1 -3 -3v-8a3 3 0 0 1 3 -3h12a3 3 0 0 1 3 3v4.5"></path><path d="M19 22v.01"></path><path d="M19 19a2.003 2.003 0 0 0 .914 -3.782a1.98 1.98 0 0 0 -2.414 .483"></path></svg>
                                        </span>
                                        <Editable field="home.visit-step-faq" as="strong">FAQs</Editable>
                                        <i class="fas fa-arrow-right" aria-hidden="true"></i>
                                    </a>
                                </li>
                            </ol>
                        </nav>
                        <div class="home-service-address">
                            <Editable field="home.visit-address-label" as="span">Service location</Editable>
                            <Editable field="home.visit-address" as="strong">10460 Slater Ave<br>Fountain Valley, CA 92708</Editable>
                        </div>
                        <Editable field="home.visit-note" as="p" class="home-arrival-note">Just off the 405 freeway at the Brookhurst exit. Look for our signs at the two street entrances to Coastal Community Fellowship. Free parking is available beside our meeting space.</Editable>
                    </div>

                    <article id="map" class="home-map-card" tabindex="-1" aria-label="Map and directions">
                        <div class="home-map-caption"><Editable field="home.map-caption" as="strong">Find Our Service</Editable></div>
                        <div class="map-container">
                            <DirectionsMap />
                        </div>
                        <a
                            href="https://www.google.com/maps/dir/?api=1&destination=Kehilat+OhrHaTorah+Messianic+Jewish+Synagogue,+10460+Slater+Ave,+Fountain+Valley,+CA+92708"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="home-text-link"
                        >
                            <Editable field="home.map-link" as="span">Open directions</Editable>
                            <i class="fas fa-up-right-from-square" aria-hidden="true"></i>
                        </a>
                    </article>

                    <div class="home-visit-utility" id="contact-us-section">
                        <div>
                            <span class="home-utility-icon-wrap"><svg class="home-utility-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 21v-6.5a3.5 3.5 0 0 0 -7 0v6.5h18v-6a4 4 0 0 0 -4 -4h-10.5"></path><path d="M12 11v-8h4l2 2l-2 2h-4"></path><path d="M6 15h1"></path></svg></span>
                            <div class="home-utility-copy"><Editable field="home.contact-mailbox-label" as="strong">Mailbox</Editable><Editable field="home.contact-mailbox-address" as="p">360 E. 1st Street, #856<br>Tustin, CA 92780</Editable></div>
                        </div>
                        <div>
                            <span class="home-utility-icon-wrap"><svg class="home-utility-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10"></path><path d="M3 7l9 6l9 -6"></path></svg></span>
                            <div class="home-utility-copy"><Editable field="home.contact-email-label" as="strong">Email</Editable><p><a href="mailto:OhrHaTorahOC@gmail.com">OhrHaTorahOC@gmail.com</a></p></div>
                        </div>
                        <div>
                            <span class="home-utility-icon-wrap"><svg class="home-utility-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h4l2 5l-2.5 1.5a11 11 0 0 0 5 5l1.5 -2.5l5 2v4a2 2 0 0 1 -2 2a16 16 0 0 1 -15 -15a2 2 0 0 1 2 -2"></path></svg></span>
                            <div class="home-utility-copy"><Editable field="home.contact-call-label" as="strong">Call</Editable><p><a href="tel:+17144061513">(714) 406-1513</a></p></div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <SectionDivider from="var(--home-cream-50)" to="var(--home-cream-100)" shape="crest" compact />

        <section class="home-section home-this-shabbat" aria-labelledby="this-shabbat-title">
            <div class="home-shell">
                <div class="home-section-heading" data-home-motion-heading>
                    <div>
                        <Editable field="home.shabbat-title" as="h2" id="this-shabbat-title">This Shabbat</Editable>
                    </div>
                </div>

                <div class="home-shabbat-primary">
                    <article class="home-schedule-card" id="shabbat-activities-section">

                        <Editable field="home.shabbat-service-title" as="h3">Afternoon Shabbat Service</Editable>
                        <div class="home-shabbat-timeline">
                            <div class="home-timeline-row">
                                <time datetime="14:30">2:30 p.m.</time>
                                <div><Editable field="home.shabbat-row-music" as="strong">Messianic Jewish Music and Dance</Editable></div>
                            </div>
                            <div class="home-timeline-row">
                                <time datetime="15:00">3:00 p.m.</time>
                                <div><Editable field="home.shabbat-row-prayers" as="strong">Traditional Prayers and Torah Service</Editable></div>
                            </div>
                            <div class="home-timeline-row">
                                <time datetime="16:30">4:30 p.m.</time>
                                <div><Editable field="home.shabbat-row-kiddush" as="strong">Kiddush, food, and discussion</Editable></div>
                            </div>
                            <Editable field="home.shabbat-note" as="p" class="home-timeline-note">We plan to transition to morning services (<em>Shacharit</em>).</Editable>
                        </div>
                        <figure class="home-schedule-image">
                            <EditableImage field="home.image-shabbat-guitar" src="/images/generated/shabbat-guitar.webp" srcset="/images/generated/shabbat-guitar-480.webp 480w, /images/generated/shabbat-guitar-960.webp 960w, /images/generated/shabbat-guitar.webp 1024w" sizes="(max-width: 767px) calc(100vw - 72px), (max-width: 900px) 80vw, 40vw" alt="Illustration of an acoustic guitar beside a wooden bench with navy linen in warm afternoon light" width="1024" height="1024" loading="lazy" decoding="async" />
                        </figure>
                    </article>

                    <section class="home-reading-card" aria-labelledby="weekly-readings-title">
                        <Editable field="home.readings-title" as="h3" class="home-reading-heading" id="weekly-readings-title">Explore this week's Torah readings</Editable>
                        <figure class="home-reading-image">
                            <EditableImage field="home.image-torah-study" src="/images/generated/torah-study.webp" srcset="/images/generated/torah-study-480.webp 480w, /images/generated/torah-study-960.webp 960w, /images/generated/torah-study.webp 1536w" sizes="(max-width: 760px) 100vw, 45vw" alt="Illustration of study books, a tallit, and a Torah reading pointer" width="1536" height="1024" loading="lazy" decoding="async" />
                            <figcaption><Editable field="home.readings-caption">Torah for this week</Editable></figcaption>
                        </figure>
                        <ParashahCard />
                        <aside class="home-torah-club" aria-labelledby="torah-club-title">
                            <Editable field="home.torah-club-title" as="h4" id="torah-club-title">Study with a Torah Club</Editable>
                            <Editable field="home.torah-club-text" as="p">Torah Club, from First Fruits of Zion, is a weekly small-group Bible study. Use their club finder to locate a club near you.</Editable>
                            <a class="home-text-link" href="https://ffoz.org/torahclub/clubfinder" target="_blank" rel="noopener noreferrer">
                                <Editable field="home.torah-club-link" as="span">Find a Torah Club</Editable>
                                <i class="fas fa-up-right-from-square" aria-hidden="true"></i>
                                <span class="visually-hidden"> (opens in a new tab)</span>
                            </a>
                        </aside>
                    </section>
                </div>

                <section class="home-shabbat-dashboard" aria-label="Live Shabbat details">
                    <div class="home-dashboard-heading" data-home-motion-heading>
                        <Editable field="home.glance-title" as="h3">Shabbat at a glance</Editable>
                    </div>
                    <div class="home-dashboard-grid">
                        <div class="home-candle-card">
                            <CandleLighting />
                        </div>
                        <div class="home-clock-card">
                            <LiveClock />
                        </div>
                    </div>
                </section>
            </div>
        </section>

        <SectionDivider from="var(--home-cream-100)" to="var(--home-blue-950)" shape="rise" />

        <aside class="home-torah-quote" aria-label="A reflection from Scripture">
            <div class="home-shell">
                <div class="home-torah-quote-icon" aria-hidden="true">
                    <!-- Tabler Icons: book-2, MIT License -->
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M19 4v16h-12a2 2 0 0 1 -2 -2v-12a2 2 0 0 1 2 -2h12"></path>
                        <path d="M19 16h-12a2 2 0 0 0 -2 2"></path>
                        <path d="M9 8h6"></path>
                    </svg>
                </div>
                <blockquote class="home-torah-quote-primary">
                    <Editable field="home.quote-primary" as="p">“God’s Torah <span class="home-verse-keep">is a Tree of Life</span> <span class="home-verse-keep" lang="he-Latn">[etz chaim]</span> <span class="home-verse-keep">for those who take hold of it</span>, <span class="home-verse-keep">and happy</span> <span class="home-verse-keep">are those who uphold it</span>. <span class="home-verse-keep">Its ways</span> <span class="home-verse-keep">are ways of pleasantness</span>, <span class="home-verse-keep">and all its paths are peace.</span>”</Editable>
                    <Editable field="home.quote-primary-cite" as="cite">Proverbs 3:17–18</Editable>
                </blockquote>
                <blockquote class="home-torah-quote-secondary">
                    <Editable field="home.quote-secondary" as="p">“Turn us back <span class="home-verse-keep">to You, <span class="divine-name"><span class="divine-name__initial">H</span><span class="divine-name__small-caps">ashem</span>,</span></span> <span class="home-verse-keep">and we shall be restored.</span> <span class="home-verse-keep">Renew our lives</span> <span class="home-verse-keep">as in days of old.</span>”</Editable>
                    <Editable field="home.quote-secondary-cite" as="cite">Lamentations 5:21</Editable>
