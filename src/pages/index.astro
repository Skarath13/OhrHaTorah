        <section id="congregation-calendar" class="home-section home-calendar-section" aria-labelledby="upcoming-dates">
            <div class="home-shell">
                <div class="home-section-heading" data-home-motion-heading>
                    <div>
                        <Editable field="home.calendar-title" as="h2" id="upcoming-dates">Congregational Calendar</Editable>
                    </div>
                </div>
                <div class="home-calendar-layout">
                    <figure class="home-calendar-image">
                        <EditableImage field="home.image-holiday-table" src="/images/generated/holiday-table.webp" srcset="/images/generated/holiday-table-480.webp 480w, /images/generated/holiday-table-960.webp 960w, /images/generated/holiday-table.webp 1024w" sizes="(max-width: 760px) 100vw, 45vw" alt="Illustration of a Shabbat table with two candles, challah, and a kiddush cup" width="1024" height="1536" loading="lazy" decoding="async" />
                        <figcaption>
                            <Editable field="home.calendar-caption-title" as="strong">Gather through the Jewish year.</Editable>
                            <Editable field="home.calendar-caption-text" as="span">Shabbat, holidays, learning, and community.</Editable>
