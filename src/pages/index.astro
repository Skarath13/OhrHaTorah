---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Navigation from '../components/layout/Navigation.astro';
import Footer from '../components/layout/Footer.astro';
import ParashahCard from '../components/islands/ParashahCard.astro';
import CandleLighting from '../components/islands/CandleLighting.astro';
import LiveClock from '../components/islands/LiveClock.astro';
import FeaturesSection from '../components/FeaturesSection.astro';
import { rabbi } from '../data/rabbi';

type IcsField = {
    value: string;
    params: string;
};

type IcsDate = {
    date: Date;
    isAllDay: boolean;
    parts: {
        year: number;
        month: number;
        day: number;
        hour: number;
        minute: number;
        second: number;
    };
    timeZone: string;
};

type CalendarEvent = {
    title: string;
    start: Date;
    end?: Date;
    location?: string;
    isAllDay: boolean;
    recurring: boolean;
};

const CALENDAR_TIME_ZONE = 'America/Los_Angeles';
const CALENDAR_ICS_URL = 'https://calendar.google.com/calendar/ical/ohrhatorahoc%40gmail.com/public/basic.ics';
const GOOGLE_CALENDAR_URL = 'https://calendar.google.com/calendar/u/0/r?cid=ohrhatorahoc%40gmail.com';
const WEEKDAY_CODES = ['SU', 'MO', 'TU', 'WE', 'TH', 'FR', 'SA'];

const decodeIcsText = (value: string) => value
    .replace(/\\n/g, '\n')
    .replace(/\\,/g, ',')
    .replace(/\\;/g, ';')
    .replace(/\\\\/g, '\\')
    .trim();

const unfoldIcs = (ics: string) => ics.replace(/\r?\n[ \t]/g, '');

const getIcsField = (block: string, name: string): IcsField | undefined => {
    const line = block.split(/\r?\n/).find((item) => item.startsWith(`${name}:`) || item.startsWith(`${name};`));
    if (!line) return undefined;

    const separatorIndex = line.indexOf(':');
    if (separatorIndex === -1) return undefined;

    return {
        params: line.slice(0, separatorIndex),
        value: decodeIcsText(line.slice(separatorIndex + 1))
    };
};

const getTimeZoneOffset = (date: Date, timeZone: string) => {
    const parts = new Intl.DateTimeFormat('en-US', {
        timeZone,
        year: 'numeric',
        month: '2-digit',
        day: '2-digit',
        hour: '2-digit',
        minute: '2-digit',
        second: '2-digit',
        hour12: false
    }).formatToParts(date);

    const partMap = Object.fromEntries(parts.map(({ type, value }) => [type, value]));
    const hour = partMap.hour === '24' ? 0 : Number(partMap.hour);
    const zonedAsUtc = Date.UTC(
        Number(partMap.year),
        Number(partMap.month) - 1,
        Number(partMap.day),
        hour,
        Number(partMap.minute),
        Number(partMap.second)
    );

    return zonedAsUtc - date.getTime();
};

const zonedDateToUtc = (parts: IcsDate['parts'], timeZone: string) => {
    const utcGuess = Date.UTC(parts.year, parts.month - 1, parts.day, parts.hour, parts.minute, parts.second);
    let utcTime = utcGuess;

    for (let index = 0; index < 2; index += 1) {
        utcTime = utcGuess - getTimeZoneOffset(new Date(utcTime), timeZone);
    }

    return new Date(utcTime);
};

const parseIcsDate = (field?: IcsField): IcsDate | undefined => {
    if (!field) return undefined;

    const timeZone = field.params.match(/TZID=([^;:]+)/)?.[1] ?? CALENDAR_TIME_ZONE;
    const [datePart, timePart = ''] = field.value.split('T');
    if (datePart.length < 8) return undefined;

    const parts = {
        year: Number(datePart.slice(0, 4)),
        month: Number(datePart.slice(4, 6)),
        day: Number(datePart.slice(6, 8)),
        hour: timePart ? Number(timePart.slice(0, 2)) : 12,
        minute: timePart ? Number(timePart.slice(2, 4)) : 0,
        second: timePart ? Number(timePart.slice(4, 6) || 0) : 0
    };

    const date = field.value.endsWith('Z')
        ? new Date(Date.UTC(parts.year, parts.month - 1, parts.day, parts.hour, parts.minute, parts.second))
        : zonedDateToUtc(parts, timeZone);

    return {
        date,
        isAllDay: !timePart,
        parts,
        timeZone
    };
};

const getLocalDateParts = (date: Date, timeZone: string) => {
    const parts = new Intl.DateTimeFormat('en-US', {
        timeZone,
        year: 'numeric',
        month: '2-digit',
        day: '2-digit'
    }).formatToParts(date);
    const partMap = Object.fromEntries(parts.map(({ type, value }) => [type, value]));

    return {
        year: Number(partMap.year),
        month: Number(partMap.month),
        day: Number(partMap.day)
    };
};

const addDaysToLocalDate = (parts: { year: number; month: number; day: number }, days: number) => {
    const date = new Date(Date.UTC(parts.year, parts.month - 1, parts.day + days, 12));

    return {
        year: date.getUTCFullYear(),
        month: date.getUTCMonth() + 1,
        day: date.getUTCDate()
    };
};

const getDayOfWeek = (parts: { year: number; month: number; day: number }) => (
    new Date(Date.UTC(parts.year, parts.month - 1, parts.day, 12)).getUTCDay()
);

const getRruleParts = (value = '') => Object.fromEntries(
    value.split(';').map((item) => {
        const [key, ruleValue = ''] = item.split('=');
        return [key, ruleValue];
    })
);

const expandWeeklyEvent = (
    title: string,
    start: IcsDate,
    end: IcsDate | undefined,
    location: string | undefined,
    rrule: string,
    now: Date
): CalendarEvent[] => {
    const rules = getRruleParts(rrule);
    if (rules.FREQ !== 'WEEKLY') return [];

    const interval = Math.max(Number(rules.INTERVAL ?? 1), 1);
    const targetDays = (rules.BYDAY ? rules.BYDAY.split(',') : [WEEKDAY_CODES[getDayOfWeek(start.parts)]])
        .map((day) => WEEKDAY_CODES.indexOf(day))
        .filter((day) => day >= 0);
    const duration = end ? Math.max(end.date.getTime() - start.date.getTime(), 0) : 60 * 60 * 1000;
    const today = getLocalDateParts(now, CALENDAR_TIME_ZONE);
    const todayDay = getDayOfWeek(today);
    const events: CalendarEvent[] = [];

    for (const targetDay of targetDays) {
        const daysUntil = (targetDay - todayDay + 7) % 7;

        for (let week = 0; week < 10; week += 1) {
            const candidateDate = addDaysToLocalDate(today, daysUntil + week * 7 * interval);
            const candidateStart = zonedDateToUtc({
                ...candidateDate,
                hour: start.parts.hour,
                minute: start.parts.minute,
                second: start.parts.second
            }, CALENDAR_TIME_ZONE);
            const candidateEnd = new Date(candidateStart.getTime() + duration);

            if (candidateStart < start.date || candidateEnd < now) continue;

            events.push({
                title,
                start: candidateStart,
                end: candidateEnd,
                location,
                isAllDay: start.isAllDay,
                recurring: true
            });
        }
    }

    return events;
};

const formatCalendarDate = (date: Date) => new Intl.DateTimeFormat('en-US', {
    weekday: 'short',
    month: 'short',
    day: 'numeric',
    timeZone: CALENDAR_TIME_ZONE
}).format(date);

const formatCalendarTime = (event: CalendarEvent) => {
    if (event.isAllDay) return 'All day';

    const formatter = new Intl.DateTimeFormat('en-US', {
        hour: 'numeric',
        minute: '2-digit',
        timeZone: CALENDAR_TIME_ZONE
    });

    return event.end ? `${formatter.format(event.start)} - ${formatter.format(event.end)}` : formatter.format(event.start);
};

const loadCalendarEvents = async (): Promise<CalendarEvent[]> => {
    try {
        const response = await fetch(CALENDAR_ICS_URL);
        if (!response.ok) return [];

        const ics = unfoldIcs(await response.text());
        const blocks = ics.match(/BEGIN:VEVENT[\s\S]*?END:VEVENT/g) ?? [];
        const now = new Date();

        return blocks.flatMap((block) => {
            if (getIcsField(block, 'STATUS')?.value === 'CANCELLED') return [];

            const title = getIcsField(block, 'SUMMARY')?.value ?? 'Congregation Event';
            const start = parseIcsDate(getIcsField(block, 'DTSTART'));
            if (!start) return [];

            const end = parseIcsDate(getIcsField(block, 'DTEND'));
            const location = getIcsField(block, 'LOCATION')?.value;
            const rrule = getIcsField(block, 'RRULE')?.value;

            if (rrule) {
                return expandWeeklyEvent(title, start, end, location, rrule, now);
            }

            if (end && end.date < now) return [];
            if (!end && start.date < now) return [];

            return [{
                title,
                start: start.date,
                end: end?.date,
                location,
                isAllDay: start.isAllDay,
                recurring: false
            }];
        })
            .sort((first, second) => first.start.getTime() - second.start.getTime())
            .slice(0, 6);
    } catch {
        return [];
    }
};

const upcomingCalendarEvents = await loadCalendarEvents();
