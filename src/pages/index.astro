---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Navigation from '../components/layout/Navigation.astro';
import Footer from '../components/layout/Footer.astro';
import EventCard from '../components/redesign/EventCard.astro';
import ServiceTimesCard from '../components/redesign/ServiceTimesCard.astro';
import WatercolorIcon from '../components/redesign/WatercolorIcon.astro';

const homepageEntry = await getEntry('homepage', 'home');
const navigationEntry = await getEntry('navigation', 'main');

if (!homepageEntry || !navigationEntry) {
  throw new Error('Homepage content is missing.');
}

const home = homepageEntry.data;
const navigation = navigationEntry.data;
const heroHeadingLines = home.hero.heading === 'Ancient Faith. Living Messiah. Southern California Community.'
  ? ['Ancient Faith.', 'Living Messiah.', 'Southern California', 'Community.']
  : [home.hero.heading];
const heroSubheadingBreakPhrase = 'Growing in love.';
const heroSubheadingBreakIndex = home.hero.subheading.indexOf(heroSubheadingBreakPhrase);
const heroSubheadingLines = heroSubheadingBreakIndex >= 0
  ? [
      home.hero.subheading.slice(0, heroSubheadingBreakIndex).trim(),
      home.hero.subheading.slice(heroSubheadingBreakIndex).trim(),
    ]
  : [home.hero.subheading];
const [visitStreet, ...visitCityParts] = home.visit.address.split(', ');
const visitCityLine = visitCityParts.join(', ');
---
<BaseLayout title={home.meta.title} description={home.meta.description} bodyClass="home-page">
  <Header brand={home.brand} />
  <Navigation items={navigation.primary} />

  <main>
    <section class="hero-shell" aria-labelledby="hero-heading">
      <div class="hero-art" aria-hidden="true">
        <picture>
          <source media="(max-width: 759px)" srcset="/images/redesign/watercolor-hero-mobile-3x4.webp">
          <img src={home.hero.image} alt="" loading="eager" decoding="async">
        </picture>
      </div>
      <div class="hero-copy">
        <h1 id="hero-heading" data-cms-key="home.hero.heading">
          {heroHeadingLines.map(line => <span>{line}</span>)}
        </h1>
        <p class="hero-subhead" data-cms-key="home.hero.subheading">
          {heroSubheadingLines.map((line, index) => (
            <>
              <span>{line}</span>
              {index < heroSubheadingLines.length - 1 && <br />}
            </>
          ))}
        </p>
        <div class="hero-actions">
          <a class="button button--primary" href={home.hero.primaryCta.href} data-cms-key="home.hero.primaryCta.href" data-cms-attr="href">
            <span class="button-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24"><rect x="4" y="5" width="16" height="15" rx="2"></rect><path d="M8 3v4M16 3v4M4 10h16"></path></svg>
            </span>
            <span data-cms-key="home.hero.primaryCta.label">{home.hero.primaryCta.label}</span>
            <span class="button-arrow" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"></path></svg>
            </span>
          </a>
          <a class="button button--ghost" href={home.hero.secondaryCta.href} data-cms-key="home.hero.secondaryCta.href" data-cms-attr="href">
            <span class="button-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><path d="m10 8 6 4-6 4V8Z"></path></svg>
            </span>
            <span data-cms-key="home.hero.secondaryCta.label">{home.hero.secondaryCta.label}</span>
            <span class="button-arrow" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"></path></svg>
            </span>
          </a>
        </div>
      </div>
    </section>

    <div class="home-stack">
      <ServiceTimesCard serviceTimes={home.serviceTimes} />

      <section class="gatherings-section" aria-labelledby="gatherings-heading">
        <div class="section-heading-row">
          <div class="section-kicker">
            <span class="line-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24"><rect x="4" y="5" width="16" height="15" rx="2"></rect><path d="M8 3v4M16 3v4M4 10h16"></path></svg>
            </span>
            <h2 id="gatherings-heading">Upcoming Gatherings</h2>
          </div>
          <a href="/events" class="text-link">View All</a>
        </div>
        <div class="event-strip">
          {home.gatherings.map((event, index) => <EventCard event={event} index={index} />)}
        </div>
      </section>

      <section class="welcome-panel" aria-labelledby="welcome-heading">
        <img src="/images/redesign/welcome-community.webp" alt="" loading="eager" decoding="async">
        <div class="welcome-panel__text">
          <p class="section-kicker">Welcome Home</p>
          <h2 id="welcome-heading" data-cms-key="home.welcome.title">{home.welcome.title}</h2>
          <p data-cms-key="home.welcome.body">{home.welcome.body}</p>
          <a class="script-link" href={home.welcome.cta.href} data-cms-key="home.welcome.cta.href" data-cms-attr="href">
            <span data-cms-key="home.welcome.cta.label">{home.welcome.cta.label}</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </section>

      <section class="values-grid" aria-label="Ohr HaTorah values">
        {home.values.map(value => (
          <article class="value-card">
            <WatercolorIcon name={value.icon} />
            <h3>{value.title}</h3>
            <p>{value.body}</p>
          </article>
        ))}
      </section>

      <section class="quote-band quote-band--tree" aria-label="Tree of Life Scripture quote">
        <div class="quote-band__copy">
          <strong class="quote-band__label" data-cms-key="home.quote.label">{home.quote.label}</strong>
          <p data-cms-key="home.quote.text">{home.quote.text}</p>
          <cite data-cms-key="home.quote.citation">{home.quote.citation}</cite>
        </div>
      </section>

      <section class="quote-band quote-band--restoration" aria-label="Restoration Scripture quote">
        <div class="quote-band__copy">
          <strong class="quote-band__label" data-cms-key="home.restorationQuote.label">{home.restorationQuote.label}</strong>
          <p data-cms-key="home.restorationQuote.text">{home.restorationQuote.text}</p>
          <cite data-cms-key="home.restorationQuote.citation">{home.restorationQuote.citation}</cite>
        </div>
      </section>

      <section class="visit-section" id="visit" aria-labelledby="visit-heading">
        <div class="visit-copy">
          <p class="section-kicker">Visit Us</p>
          <h2 id="visit-heading" data-cms-key="home.visit.title">{home.visit.title}</h2>
          <p data-cms-key="home.visit.body">{home.visit.body}</p>
          <a class="button button--primary" href={home.visit.cta.href} target="_blank" rel="noopener noreferrer" data-cms-key="home.visit.cta.href" data-cms-attr="href">
            <span class="button-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M12 21s7-5.2 7-11a7 7 0 1 0-14 0c0 5.8 7 11 7 11Z"></path><circle cx="12" cy="10" r="2.5"></circle></svg>
            </span>
            <span data-cms-key="home.visit.cta.label">{home.visit.cta.label}</span>
            <span class="button-arrow" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"></path></svg>
            </span>
          </a>
          <p class="address-line">
            <span class="address-line__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M12 21s7-5.2 7-11a7 7 0 1 0-14 0c0 5.8 7 11 7 11Z"></path><circle cx="12" cy="10" r="2.5"></circle></svg>
            </span>
            <span class="address-line__copy" data-cms-key="home.visit.address">
              <span>{visitStreet}{visitCityLine && ','}</span>
              {visitCityLine && <span>{visitCityLine}</span>}
            </span>
          </p>
        </div>
        <div class="visit-art parchment-card" aria-hidden="true">
        </div>
      </section>

      <section class="newsletter-card" aria-labelledby="newsletter-heading">
        <div class="newsletter-copy">
          <p class="section-kicker" data-cms-key="home.newsletter.title">{home.newsletter.title}</p>
          <h2 id="newsletter-heading" data-cms-key="home.newsletter.body">{home.newsletter.body}</h2>
          <form class="newsletter-form" id="newsletter-request-form" action="/contact" method="get">
            <input type="hidden" name="subscription" value="request">
            <label class="form-honeypot" aria-hidden="true" tabindex="-1">
              Website
              <input type="text" name="website" autocomplete="off" tabindex="-1">
            </label>
            <label class="newsletter-form__prompt" for="newsletter-email" data-cms-key="home.newsletter.placeholder">{home.newsletter.placeholder}</label>
            <input id="newsletter-email" type="email" name="email" autocomplete="email" inputmode="email" spellcheck="false" pattern="[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+[.][A-Za-z]{2,}" title="Enter a valid email address, like name@example.com" required>
            <button type="submit" data-cms-key="home.newsletter.button">{home.newsletter.button}</button>
          </form>
        </div>
        <div class="newsletter-art" aria-hidden="true"></div>
      </section>

    </div>
  </main>

  <Footer />
</BaseLayout>

<script>
  if (window.history && 'scrollRestoration' in window.history) {
    window.history.scrollRestoration = 'manual';
  }

  const resetHomeScroll = () => {
    if (window.location.hash) return;

    window.scrollTo(0, 0);
    window.requestAnimationFrame(() => window.scrollTo(0, 0));
  };

  resetHomeScroll();
  window.addEventListener('load', resetHomeScroll);
  window.addEventListener('pageshow', resetHomeScroll);

  const newsletterForm = document.querySelector('#newsletter-request-form');
  const isLikelyEmail = (value) => /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/i.test(value);

  if (newsletterForm instanceof HTMLFormElement) {
    const emailInput = newsletterForm.querySelector('#newsletter-email');
    const honeypot = newsletterForm.querySelector('input[name="website"]');

    if (emailInput instanceof HTMLInputElement) {
      emailInput.addEventListener('input', () => {
        emailInput.setCustomValidity('');
      });
    }

    newsletterForm.addEventListener('submit', (event) => {
      event.preventDefault();

      const formData = new FormData(newsletterForm);
      const email = String(formData.get('email') || '').trim();
      const trap = String(formData.get('website') || '').trim();

      if (trap || (honeypot instanceof HTMLInputElement && honeypot.value.trim())) {
        return;
      }

      if (emailInput instanceof HTMLInputElement) {
        emailInput.setCustomValidity('');
      }

      if (!email || !isLikelyEmail(email)) {
        if (emailInput instanceof HTMLInputElement) {
          emailInput.setCustomValidity('Enter a valid email address, like name@example.com.');
        }
        newsletterForm.reportValidity();
        return;
      }

      if (!newsletterForm.checkValidity()) {
        newsletterForm.reportValidity();
        return;
      }

      const normalizedEmail = email.toLowerCase();
      const previousEmail = sessionStorage.getItem('oht-subscription-request-email');

      if (previousEmail === normalizedEmail && emailInput instanceof HTMLInputElement) {
        emailInput.setCustomValidity('We already opened the request form for this email in this browser.');
        newsletterForm.reportValidity();
        return;
      }

      sessionStorage.setItem('oht-subscription-request-email', normalizedEmail);

      const params = new URLSearchParams({
        subscription: 'request',
        email,
      });

      window.location.href = `/contact?${params.toString()}#subscription-request`;
    });
  }
</script>
