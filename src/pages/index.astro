                <p>Plan around services, holidays, special events, and community life.</p>
            </div>
            <div class="home-calendar-frame home-calendar-list">
                {upcomingCalendarEvents.length > 0 ? (
                    <ol class="home-calendar-events" aria-label="Upcoming congregation calendar events">
                        {upcomingCalendarEvents.map((event) => (
                            <li class="home-calendar-event">
                                <time datetime={event.start.toISOString()}>
                                    <span>{formatCalendarDate(event.start)}</span>
                                    <strong>{formatCalendarTime(event)}</strong>
                                </time>
                                <div>
                                    <h3>{event.title}</h3>
                                    {event.location && <p>{event.location}</p>}
                                    {event.recurring && <small>Weekly gathering</small>}
                                </div>
                            </li>
                        ))}
                    </ol>
                ) : (
                    <div class="home-calendar-empty">
                        <h3>Calendar events are available through Google Calendar.</h3>
                        <p>If the embedded calendar is blocked by the browser, open or subscribe to the public calendar directly.</p>
                    </div>
