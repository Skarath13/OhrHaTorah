---
import PageLayout from '../layouts/PageLayout.astro';
import { congregationName } from '../data/congregationIdentity';

const zelleTag = 'ohrhatorahoc';
const zelleRecipientName = 'CONGREGATION OHR HAT';
const zellePaymentUrl = 'https://enroll.zellepay.com/qr-codes?data=eyJuYW1lIjoiQ09OR1JFR0FUSU9OIE9IUiBIQVQiLCJ0b2tlbiI6Im9ocmhhdG9yYWhvYyJ9';
const paypalHostedButtonId = 'LPN2RWR887N84';
const paypalDonationUrl = `https://www.paypal.com/donate/?hosted_button_id=${paypalHostedButtonId}`;
const paypalQrDonationUrl = `${paypalDonationUrl}&source=qr`;
---

<PageLayout title="Support Kehilat Ohr HaTorah" description="Give to Kehilat Ohr HaTorah through Zelle, PayPal, or check.">
    <section class="donate-content" aria-labelledby="giving-title">
        <div class="giving-heading">
            <p class="giving-kicker">Community giving</p>
            <h1 id="giving-title">Support Kehilat Ohr HaTorah</h1>
            <p>Choose Zelle® or PayPal. Your gift is completed directly with the provider.</p>
        </div>

        <div class="donation-grid donation-methods">
            <section class="donation-card donation-card-zelle" aria-labelledby="zelle-giving-title">
                <header class="payment-brand-header">
                    <div class="payment-brand-mark zelle-brand-mark">
                        <img src="/images/payments/zelle-bank-wordmark.png" width="1800" height="834" alt="Zelle" />
                    </div>
                    <span>From your banking app</span>
                </header>

                <div class="payment-card-body">
                    <div class="payment-intro">
                        <h2 id="zelle-giving-title">Give with Zelle®</h2>
                        <p>Scan the bank-generated QR code, or use the congregation’s Zelle® tag.</p>
                    </div>

                    <a
                        class="payment-qr-link"
                        href={zellePaymentUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={`Open the Zelle payment link for tag ${zelleTag}`}
                    >
                        <span class="payment-qr-frame">
                            <img src="/images/payments/zelle-ohrhatorahoc-qr.png" width="240" height="240" alt={`Zelle QR code for congregation tag ${zelleTag}`} />
                        </span>
                        <span class="payment-scan-label"><i class="fas fa-mobile-screen-button" aria-hidden="true"></i> Scan with your banking app</span>
                    </a>

                    <dl class="payment-details">
                        <div>
                            <dt>Zelle® tag</dt>
                            <dd class="zelle-tag-control">
                                <code id="zelle-tag-value">{zelleTag}</code>
                                <button type="button" class="zelle-copy-button" data-copy-zelle-tag data-zelle-tag={zelleTag}>
                                    <i class="far fa-copy" aria-hidden="true"></i>
                                    Copy
                                </button>
                            </dd>
                        </div>
                        <div>
                            <dt>Confirm recipient</dt>
                            <dd><strong>{zelleRecipientName}</strong></dd>
                        </div>
                    </dl>

                    <p class="zelle-copy-status" role="status" aria-live="polite" aria-atomic="true"></p>

                    <a class="provider-primary-action zelle-primary-action" href={zellePaymentUrl} target="_blank" rel="noopener noreferrer">
                        Open Zelle®
                        <i class="fas fa-arrow-up-right-from-square" aria-hidden="true"></i>
                    </a>

                    <p class="provider-note">Before sending, confirm the recipient name and tag. Payments to an enrolled recipient generally cannot be canceled, and Zelle® does not offer purchase protection.</p>
                </div>
            </section>

            <section class="donation-card donation-card-paypal" aria-labelledby="paypal-giving-title">
                <header class="payment-brand-header">
                    <a class="payment-brand-mark paypal-brand-mark" href={paypalDonationUrl} target="_blank" rel="noopener noreferrer" aria-label="Open the Kehilat Ohr HaTorah donation page on PayPal">
                        <img src="https://www.paypalobjects.com/webstatic/mktg/logo/pp_cc_mark_111x69.jpg" width="111" height="69" alt="PayPal" referrerpolicy="strict-origin-when-cross-origin" />
                    </a>
                    <span>PayPal-hosted giving</span>
                </header>

                <div class="payment-card-body">
                    <div class="payment-intro">
                        <h2 id="paypal-giving-title">Give with PayPal</h2>
                        <p>Make a one-time, monthly, or yearly gift on PayPal’s hosted donation page.</p>
                    </div>

                    <a
                        class="payment-qr-link"
                        href={paypalQrDonationUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="Open the PayPal donation page for Kehilat Ohr HaTorah"
                    >
                        <span class="payment-qr-frame">
                            <img src="/images/payments/paypal-donation-qr.png" width="240" height="240" alt="PayPal QR code for Kehilat Ohr HaTorah donations" />
                        </span>
                        <span class="payment-scan-label"><i class="fas fa-camera" aria-hidden="true"></i> Scan with your camera</span>
                    </a>

                    <dl class="payment-details">
                        <div>
                            <dt>Giving options</dt>
                            <dd><strong>One-time, monthly, or yearly</strong></dd>
                        </div>
                        <div>
                            <dt>Payment handled by</dt>
                            <dd><strong>PayPal</strong></dd>
                        </div>
                    </dl>

                    <p class="payment-status-placeholder" aria-hidden="true"></p>

                    <a class="provider-primary-action paypal-primary-action" href={paypalDonationUrl} target="_blank" rel="noopener noreferrer">
                        <i class="fab fa-paypal" aria-hidden="true"></i>
                        Continue to PayPal
                        <i class="fas fa-arrow-up-right-from-square" aria-hidden="true"></i>
                    </a>

                    <p class="provider-note">PayPal processes the donation on its website. This site does not receive your PayPal password or payment credentials.</p>
                </div>
            </section>
        </div>

        <div class="secondary-giving" aria-label="Additional giving information">
            <details class="giving-disclosure">
                <summary>
                    <span><i class="fas fa-money-check" aria-hidden="true"></i> Give by check</span>
                    <i class="fas fa-plus" aria-hidden="true"></i>
                </summary>
                <dl class="check-details">
                    <div>
                        <dt>Make payable to</dt>
                        <dd><strong>{congregationName}</strong></dd>
                    </div>
                    <div>
                        <dt>Mailbox</dt>
                        <dd><address>360 E. 1st Street, #856<br />Tustin, CA 92780</address></dd>
                    </div>
                </dl>
            </details>

            <details class="giving-disclosure">
                <summary>
                    <span><i class="fas fa-file-shield" aria-hidden="true"></i> Giving records and special gifts</span>
                    <i class="fas fa-plus" aria-hidden="true"></i>
                </summary>
                <div class="records-copy">
                    <h2>Giving acknowledgments and special contributions</h2>
                    <p>Please keep your check or bank record. Contact <strong>{congregationName}</strong> if you need a giving acknowledgment or believe a record should be corrected.</p>
                    <p>Whether a contribution is deductible depends on applicable law and your individual circumstances; nothing on this website is tax advice. Please consult a qualified adviser. Contact us before sending a non-cash or other special contribution so we can confirm whether it can be accepted.</p>
                </div>
            </details>
        </div>

        <p class="provider-legal">Zelle® is a registered trademark of Early Warning Services, LLC. Kehilat Ohr HaTorah is not affiliated with, sponsored by, or endorsed by Early Warning Services, LLC.</p>
    </section>
</PageLayout>

<style>
    .donate-content {
        --giving-navy: #061d35;
        --giving-ink: #0b2d57;
        --giving-muted: #5d6877;
        --giving-line: rgba(11, 45, 87, 0.14);
        --giving-paper: #fffdf8;
        --zelle-purple: #6d1ed4;
        --zelle-deep: #4f1499;
        --zelle-soft: #f7f1ff;
        --paypal-blue: #0070ba;
        --paypal-deep: #003087;
        --paypal-yellow: #ffc439;
        --paypal-soft: #f1f8fd;
        max-width: 72rem;
        margin: 0 auto;
        color: var(--giving-ink);
    }

    .giving-heading {
        max-width: 46rem;
        margin: 0 auto clamp(2.25rem, 5vw, 3.75rem);
        text-align: center;
    }

    .giving-heading .giving-kicker {
        margin: 0 0 0.75rem;
        color: #8b671b;
        font-size: 0.7rem;
        font-weight: 850;
        letter-spacing: 0.15em;
        line-height: 1.3;
        text-transform: uppercase;
    }

    .giving-heading h1 {
        margin: 0;
        color: var(--giving-navy);
        font-family: var(--font-display);
        font-size: clamp(2.25rem, 4.5vw, 3.65rem);
        font-weight: 600;
        letter-spacing: -0.045em;
        line-height: 0.98;
        text-wrap: balance;
    }

    .giving-heading > p:last-child {
        max-width: 38rem;
        margin: 1.1rem auto 0;
        color: var(--giving-muted);
        font-size: clamp(0.98rem, 1.5vw, 1.08rem);
        line-height: 1.65;
    }

    .donation-grid.donation-methods {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: clamp(1rem, 2.5vw, 1.75rem);
        align-items: stretch;
        margin: 0;
        background: transparent;
    }

    .donation-card {
        --payment-accent: #8b671b;
        --payment-deep: var(--giving-navy);
        --payment-soft: #faf7ef;
        display: flex;
        min-width: 0;
        overflow: hidden;
        border: 1px solid var(--giving-line);
        border-top: 3px solid var(--payment-accent);
        border-radius: 1.35rem;
        flex-direction: column;
        background: var(--giving-paper);
        box-shadow:
            0 1.25rem 3.25rem rgba(6, 29, 53, 0.08),
            0 0.15rem 0.45rem rgba(6, 29, 53, 0.035);
        text-align: left;
    }

    .donation-card-zelle {
        --payment-accent: var(--zelle-purple);
        --payment-deep: var(--zelle-deep);
        --payment-soft: var(--zelle-soft);
    }

    .donation-card-paypal {
        --payment-accent: var(--paypal-blue);
        --payment-deep: var(--paypal-deep);
        --payment-soft: var(--paypal-soft);
    }

    .payment-brand-header {
        display: flex;
        min-height: 5.2rem;
        box-sizing: border-box;
        gap: 1rem;
        padding: 1rem clamp(1.25rem, 3vw, 1.75rem);
        border-bottom: 1px solid color-mix(in srgb, var(--payment-accent) 16%, transparent);
        align-items: center;
        justify-content: space-between;
        background: var(--payment-soft);
    }

    .payment-brand-header > span {
        color: var(--payment-deep);
        font-size: 0.7rem;
        font-weight: 800;
        line-height: 1.3;
        text-align: right;
    }

    .payment-brand-mark {
        display: grid;
        width: 7.1rem;
        height: 3rem;
        flex: 0 0 auto;
        box-sizing: border-box;
        place-items: center;
    }

    .zelle-brand-mark {
        padding: 0.2rem 0;
    }

    .zelle-brand-mark img {
        display: block;
        width: 7rem;
        height: auto;
    }

    .paypal-brand-mark {
        width: 5.25rem;
        overflow: hidden;
        border: 1px solid rgba(0, 48, 135, 0.12);
        border-radius: 0.55rem;
        background: #ffffff;
    }

    .paypal-brand-mark img {
        display: block;
        width: 4.5rem;
        height: auto;
    }

    .payment-card-body {
        display: flex;
        min-width: 0;
        flex: 1;
        flex-direction: column;
        padding: clamp(1.4rem, 3vw, 2rem);
    }

    .payment-intro {
        min-height: 7rem;
        text-align: center;
    }

    .payment-intro h2 {
        margin: 0;
        color: var(--payment-deep);
        font-family: var(--font-display);
        font-size: clamp(2rem, 3.5vw, 2.75rem);
        font-weight: 600;
        letter-spacing: -0.035em;
        line-height: 1;
    }

    .payment-intro p {
        max-width: 31rem;
        margin: 0.85rem auto 0;
        color: var(--giving-muted);
        font-size: 0.92rem;
        line-height: 1.6;
        text-align: center;
    }

    .payment-qr-link {
        display: grid;
        width: min(15.25rem, 100%);
        max-width: 100%;
        min-height: 44px;
        gap: 0.8rem;
        margin: 0.25rem auto 1.45rem;
        justify-items: center;
        color: var(--payment-deep);
        text-decoration: none;
    }

    .payment-qr-frame {
        display: grid;
        width: 100%;
        aspect-ratio: 1;
        box-sizing: border-box;
        padding: 0.8rem;
        border: 1px solid color-mix(in srgb, var(--payment-accent) 27%, transparent);
        border-radius: 1rem;
        place-items: center;
        background: #ffffff;
        box-shadow: 0 0.85rem 2rem rgba(6, 29, 53, 0.075);
        transition: border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
    }

    .payment-qr-frame img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: contain;
        image-rendering: pixelated;
    }

    .payment-scan-label {
        display: inline-flex;
        gap: 0.5rem;
        align-items: center;
        color: var(--payment-deep);
        font-size: 0.72rem;
        font-weight: 800;
        line-height: 1.35;
    }

    .payment-qr-link:hover .payment-qr-frame {
        border-color: color-mix(in srgb, var(--payment-accent) 56%, transparent);
        box-shadow: 0 1rem 2.3rem rgba(6, 29, 53, 0.11);
        transform: translateY(-2px);
    }

    .payment-details {
        margin: 0;
        overflow: hidden;
        border-top: 1px solid var(--giving-line);
        border-bottom: 1px solid var(--giving-line);
    }

    .payment-details > div {
        display: grid;
        min-height: 4.65rem;
        box-sizing: border-box;
        grid-template-columns: minmax(7.25rem, 0.7fr) minmax(0, 1.3fr);
        gap: 1rem;
        padding: 0.9rem 0.15rem;
        align-items: center;
    }

    .payment-details > div + div {
        border-top: 1px solid var(--giving-line);
    }

    .payment-details dt,
    .check-details dt {
        color: var(--giving-muted);
        font-size: 0.66rem;
        font-weight: 850;
        letter-spacing: 0.09em;
        line-height: 1.35;
        text-transform: uppercase;
    }

    .payment-details dd,
    .check-details dd {
        min-width: 0;
        margin: 0;
        color: var(--giving-ink);
        font-size: 0.82rem;
        line-height: 1.4;
        overflow-wrap: anywhere;
    }

    .payment-details strong,
    .check-details strong {
        color: inherit;
    }

    .zelle-tag-control {
        display: flex;
        gap: 0.65rem;
        align-items: center;
        justify-content: space-between;
    }

    .zelle-tag-control code {
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 0.88rem;
        font-weight: 850;
    }

    .zelle-copy-button {
        display: inline-flex;
        min-width: 4.5rem;
        min-height: 44px;
        box-sizing: border-box;
        gap: 0.35rem;
        padding: 0.6rem 0.75rem;
        border: 1px solid color-mix(in srgb, var(--payment-accent) 45%, transparent);
        border-radius: 999px;
        align-items: center;
        justify-content: center;
        background: #ffffff;
        color: var(--payment-deep);
        font: 800 0.68rem/1 var(--font-body);
        cursor: pointer;
        transition: background-color 180ms ease, color 180ms ease;
    }

    .zelle-copy-button:hover {
        background: var(--payment-deep);
        color: #ffffff;
    }

    .zelle-copy-status,
    .payment-status-placeholder {
        min-height: 1.05rem;
        margin: 0.45rem 0 0;
        color: #216b4b;
        font-size: 0.68rem;
        font-weight: 750;
        line-height: 1.4;
    }

    .provider-primary-action {
        display: flex;
        width: 100%;
        min-height: 52px;
        box-sizing: border-box;
        gap: 0.6rem;
        margin: 0.8rem 0 0;
        padding: 0.8rem 1rem;
        border-radius: 999px;
        align-items: center;
        justify-content: center;
        font-size: 0.78rem;
        font-weight: 850;
        line-height: 1.25;
        text-align: center;
        text-decoration: none;
        transition: box-shadow 180ms ease, transform 180ms ease;
    }

    .provider-primary-action:hover {
        transform: translateY(-2px);
    }

    .zelle-primary-action {
        background: var(--zelle-deep);
        box-shadow: 0 0.75rem 1.5rem rgba(79, 20, 153, 0.15);
        color: #ffffff;
    }

    .paypal-primary-action {
        background: var(--paypal-yellow);
        box-shadow: 0 0.75rem 1.5rem rgba(0, 48, 135, 0.13);
        color: var(--paypal-deep);
    }

    .paypal-primary-action .fa-paypal {
        color: var(--paypal-blue);
        font-size: 1rem;
    }

    .provider-note {
        min-height: 4.25rem;
        margin: 1rem 0 0;
        color: var(--giving-muted);
        font-size: 0.7rem;
        line-height: 1.55;
        text-align: center;
    }

    .secondary-giving {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.85rem;
        margin: clamp(1.5rem, 4vw, 2.5rem) 0 0;
    }

    .giving-disclosure {
        min-width: 0;
        border: 1px solid var(--giving-line);
        border-radius: 0.9rem;
        background: rgba(255, 253, 248, 0.72);
    }

    .giving-disclosure summary {
        display: flex;
        min-height: 54px;
        box-sizing: border-box;
        gap: 1rem;
        padding: 0.85rem 1rem;
        align-items: center;
        justify-content: space-between;
        color: var(--giving-ink);
        font-size: 0.75rem;
        font-weight: 800;
        line-height: 1.35;
        list-style: none;
        cursor: pointer;
    }

    .giving-disclosure summary::-webkit-details-marker {
        display: none;
    }

    .giving-disclosure summary > span {
        display: inline-flex;
        gap: 0.55rem;
        align-items: center;
    }

    .giving-disclosure summary > span i {
        color: #9b731d;
    }

    .giving-disclosure summary > .fa-plus {
        color: var(--giving-muted);
        font-size: 0.65rem;
        transition: transform 180ms ease;
    }

    .giving-disclosure[open] summary {
        border-bottom: 1px solid var(--giving-line);
    }

    .giving-disclosure[open] summary > .fa-plus {
        transform: rotate(45deg);
    }

    .check-details {
        display: grid;
        margin: 0;
        padding: 1rem;
        gap: 1rem;
    }

    .check-details > div {
        display: grid;
        grid-template-columns: minmax(7rem, 0.65fr) minmax(0, 1.35fr);
        gap: 1rem;
    }

    .check-details address {
        font-style: normal;
    }

    .records-copy {
        padding: 1rem;
    }

    .records-copy h2 {
        margin: 0 0 0.75rem;
        color: var(--giving-ink);
        font-family: var(--font-body);
        font-size: 0.78rem;
        font-weight: 850;
        line-height: 1.4;
    }

    .records-copy p {
        margin: 0;
        color: var(--giving-muted);
        font-size: 0.72rem;
        line-height: 1.6;
    }

    .records-copy p + p {
        margin-top: 0.7rem;
    }

    .provider-legal {
        max-width: 60rem;
        margin: 1.25rem auto 0;
        color: #7a828d;
        font-size: 0.62rem;
        line-height: 1.55;
        text-align: center;
    }

    .payment-qr-link:focus-visible,
    .payment-brand-mark:focus-visible,
    .provider-primary-action:focus-visible,
    .zelle-copy-button:focus-visible,
    .giving-disclosure summary:focus-visible {
        outline: 3px solid #0b6eb7;
        outline-offset: 3px;
    }

    @media (max-width: 860px) {
        .donation-grid.donation-methods,
        .secondary-giving {
            grid-template-columns: minmax(0, 1fr);
        }

        .donation-card-zelle {
            order: 1;
        }

        .donation-card-paypal {
            order: 2;
        }

        .payment-intro {
            min-height: 0;
            margin-bottom: 0.5rem;
        }

        .provider-note {
            min-height: 0;
        }
    }

    @media (max-width: 520px) {
        .giving-heading {
            margin-bottom: 1.8rem;
        }

        .payment-brand-header {
            min-height: 4.75rem;
            padding: 0.85rem 1rem;
        }

        .payment-card-body {
            padding: 1.15rem;
        }

        .payment-qr-frame {
            width: 100%;
        }

        .payment-qr-link {
            width: min(15rem, 82vw);
        }

        .payment-details > div,
        .check-details > div {
            grid-template-columns: minmax(0, 1fr);
            gap: 0.4rem;
        }

        .payment-details > div {
            min-height: 0;
        }

        .zelle-tag-control {
            align-items: center;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .payment-qr-frame,
        .provider-primary-action,
        .giving-disclosure summary > .fa-plus {
            transition: none;
        }

        .payment-qr-link:hover .payment-qr-frame,
        .provider-primary-action:hover {
            transform: none;
        }
    }
</style>

<script>
    const copyButton = document.querySelector<HTMLButtonElement>('[data-copy-zelle-tag]');
    const copyStatus = document.querySelector<HTMLElement>('.zelle-copy-status');
    const tagElement = document.getElementById('zelle-tag-value');

    copyButton?.addEventListener('click', async () => {
        const tag = copyButton.dataset.zelleTag?.trim();
        if (!tag || !copyStatus) return;

        try {
            await navigator.clipboard.writeText(tag);
            copyStatus.textContent = `Copied ${tag} to the clipboard.`;
        } catch {
            if (tagElement) {
                const range = document.createRange();
                range.selectNodeContents(tagElement);
                const selection = window.getSelection();
                selection?.removeAllRanges();
                selection?.addRange(range);
            }
            copyStatus.textContent = 'The tag is selected. Copy it from your browser.';
        }
    });
</script>
