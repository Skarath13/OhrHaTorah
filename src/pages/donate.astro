---
import PageLayout from '../layouts/PageLayout.astro';
import { congregationName } from '../data/congregationIdentity';

const zelleTag = 'ohrhatorahoc';
const zelleRecipientName = 'CONGREGATION OHR HAT';
const zellePaymentUrl = 'https://enroll.zellepay.com/qr-codes?data=eyJuYW1lIjoiQ09OR1JFR0FUSU9OIE9IUiBIQVQiLCJ0b2tlbiI6Im9ocmhhdG9yYWhvYyJ9';
const paypalHostedButtonId = 'LPN2RWR887N84';
const paypalDonationUrl = `https://www.paypal.com/donate/?hosted_button_id=${paypalHostedButtonId}`;
const paypalQrDonationUrl = `${paypalDonationUrl}&source=qr`;
---

<PageLayout title="Support Kehilat Ohr HaTorah" pageTitle="Support Kehilat Ohr HaTorah" pageIcon="fas fa-heart" description="Ways to support Kehilat Ohr HaTorah through Zelle, PayPal, or check.">
    <div class="donate-content">
    <blockquote class="donation-verse">
        <p>“God loves a cheerful giver.”</p>
        <cite>2 Corinthians 9:7</cite>
    </blockquote>

    <div class="donation-grid donation-methods">
        <section class="donation-card donation-card-zelle" aria-labelledby="zelle-giving-title">
            <div class="donation-method-heading">
                <div class="donation-icon" aria-hidden="true">
                    <i class="fas fa-qrcode"></i>
                </div>
                <h3 id="zelle-giving-title">Donate using Zelle® payments</h3>
                <span class="donation-status donation-status-available"><i class="fas fa-check-circle" aria-hidden="true"></i> Available now</span>
            </div>

            <div class="zelle-layout">
                <div class="zelle-copy">
                    <p class="zelle-intro">Scan the QR code in your participating bank or credit union app, or enter the congregation’s Zelle® tag.</p>

                    <dl class="zelle-account-details">
                        <div>
                            <dt>Zelle® tag</dt>
                            <dd class="zelle-tag-control">
                                <code id="zelle-tag-value">{zelleTag}</code>
                                <button type="button" class="zelle-copy-button" data-copy-zelle-tag data-zelle-tag={zelleTag}>Copy tag</button>
                            </dd>
                        </div>
                        <div>
                            <dt>Confirm recipient</dt>
                            <dd><strong>{zelleRecipientName}</strong></dd>
                        </div>
                    </dl>

                    <p class="zelle-copy-status" role="status" aria-live="polite" aria-atomic="true"></p>
                    <aside class="payment-safety-note" aria-label="Zelle payment safety">
                        <i class="fas fa-circle-info" aria-hidden="true"></i>
                        <p>Confirm the recipient name and tag before authorizing the donation. Payments to an enrolled recipient generally cannot be canceled, and Zelle® does not offer purchase protection.</p>
                    </aside>
                </div>
                <a
                    class="zelle-qr-link"
                    href={zellePaymentUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`Open the Zelle payment link for tag ${zelleTag}`}
                >
                    <span class="zelle-qr-frame">
                        <img src="/images/payments/zelle-ohrhatorahoc-qr.png" width="180" height="180" alt={`Zelle QR code for congregation tag ${zelleTag}`} />
                    </span>
                    <span>Scan in your banking app</span>
                    <small>Or open the payment link</small>
                </a>
            </div>

            <p class="zelle-trademark-note">Zelle® is a registered trademark of Early Warning Services, LLC. Kehilat Ohr HaTorah is not affiliated with, sponsored by, or endorsed by Early Warning Services, LLC.</p>
        </section>

        <section class="donation-card donation-card-check" aria-labelledby="check-giving-title">
            <div class="donation-method-heading">
                <div class="donation-icon" aria-hidden="true">
                    <i class="fas fa-money-check"></i>
                </div>
                <h3 id="check-giving-title">Give by check</h3>
                <span class="donation-status"><i class="fas fa-check-circle" aria-hidden="true"></i> Available now</span>
            </div>

            <dl class="check-details">
                <div>
                    <dt>Make payable to</dt>
                    <dd><strong>{congregationName}</strong></dd>
                </div>
                <div>
                    <dt>Mail to</dt>
                    <dd><address>360 E. 1st Street, #856<br />Tustin, CA 92780</address></dd>
                </div>
            </dl>
        </section>

        <section class="donation-card donation-card-paypal" aria-labelledby="paypal-giving-title">
            <div class="donation-method-heading">
                <div class="donation-icon" aria-hidden="true">
                    <i class="fas fa-wallet"></i>
                </div>
                <h3 id="paypal-giving-title">PayPal donations</h3>
                <span class="donation-status donation-status-available"><i class="fas fa-check-circle" aria-hidden="true"></i> Available now</span>
            </div>

            <div class="paypal-layout">
                <div class="paypal-copy">
                    <p class="paypal-intro">Donate on PayPal’s secure hosted page with a one-time, monthly, or yearly gift. Suggested amounts are $18, $36, and $72, or choose your own amount.</p>
                    <form class="paypal-donate-form" action="https://www.paypal.com/donate" method="post" target="_top" aria-label="Donate to Kehilat Ohr HaTorah with PayPal">
                        <input type="hidden" name="hosted_button_id" value={paypalHostedButtonId} />
                        <input
                            type="image"
                            src="https://www.paypalobjects.com/en_US/i/btn/btn_donateCC_LG.gif"
                            name="submit"
                            title="PayPal - The safer, easier way to pay online!"
                            alt="Donate with PayPal button"
                            referrerpolicy="strict-origin-when-cross-origin"
                        />
                    </form>
                    <p class="paypal-provider-note">PayPal processes the donation on its website. This site does not receive your PayPal password or payment credentials.</p>
                </div>
                <a
                    class="paypal-qr-link"
                    href={paypalQrDonationUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="Open the PayPal donation page for Kehilat Ohr HaTorah"
                >
                    <span class="paypal-qr-frame">
                        <img src="/images/payments/paypal-donation-qr.png" width="256" height="256" alt="PayPal QR code for Kehilat Ohr HaTorah donations" />
                    </span>
                    <span>Scan to donate with PayPal</span>
                    <small>Opens PayPal’s hosted page</small>
                </a>
            </div>
        </section>
    </div>

    <section class="donation-records-notice" aria-labelledby="giving-records-title">
        <div>
            <p class="donation-notice-kicker">A note for your records</p>
            <h3 id="giving-records-title">Giving acknowledgments and special contributions</h3>
        </div>
        <div>
            <p>Please keep your check or bank record. Contact <strong>{congregationName}</strong> if you need a giving acknowledgment or believe a record should be corrected.</p>
            <p>Whether a contribution is deductible depends on applicable law and your individual circumstances; nothing on this website is tax advice. Please consult a qualified adviser. Contact us before sending a non-cash or other special contribution so we can confirm whether it can be accepted.</p>
        </div>
    </section>

    <section class="giving-info" aria-labelledby="why-give-title">
        <div class="giving-info-heading">
            <div class="giving-info-icon" aria-hidden="true"><i class="fas fa-hand-holding-heart"></i></div>
            <div>
                <h3 id="why-give-title">Why give?</h3>
                <p>Your generosity sustains the worship, learning, and care we share.</p>
            </div>
        </div>
        <ul class="giving-list">
            <li><i class="fas fa-check" aria-hidden="true"></i><span>Shabbat services and teaching</span></li>
            <li><i class="fas fa-check" aria-hidden="true"></i><span>Jewish learning and teaching</span></li>
            <li><i class="fas fa-check" aria-hidden="true"></i><span>Community outreach</span></li>
            <li><i class="fas fa-check" aria-hidden="true"></i><span>Support for Israel ministries</span></li>
            <li><i class="fas fa-check" aria-hidden="true"></i><span>Future youth learning</span></li>
            <li><i class="fas fa-check" aria-hidden="true"></i><span>Facility care and operations</span></li>
        </ul>
    </section>

    <div class="contact-box">
        <h4><i class="fas fa-hand-holding-heart"></i> Questions about giving?</h4>
        <div class="contact-links">
            <a href="tel:+17144061513" aria-label="Call Kehilat Ohr HaTorah at (714) 406-1513"><i class="fas fa-phone"></i> Call us</a>
            <a href="mailto:OhrHaTorahOC@gmail.com" aria-label="Email Kehilat Ohr HaTorah at OhrHaTorahOC@gmail.com"><i class="fas fa-envelope"></i> Email us</a>
        </div>
    </div>
    </div>
</PageLayout>

<style>
    .donate-content .donation-verse {
        display: flex;
        gap: 0.8rem;
        margin: 0 0 clamp(2rem, 4vw, 2.75rem);
        padding: 0.15rem 0 0.15rem 1.1rem;
        border-left: 3px solid var(--interior-gold, #d1a12d);
        align-items: baseline;
        color: var(--interior-navy, #061a32);
    }

    .donate-content .donation-verse p {
        margin: 0;
        font-family: var(--font-display);
        font-size: clamp(1.45rem, 2.7vw, 2rem);
        font-style: italic;
        line-height: 1.25;
    }

    .donate-content .donation-verse cite {
        color: var(--interior-gold, #d1a12d);
        font-family: var(--font-body);
        font-size: 0.82rem;
        font-style: normal;
        font-weight: 800;
        white-space: nowrap;
    }

    .donate-content .donation-grid.donation-methods {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1px;
        margin: 0 0 clamp(1.75rem, 4vw, 2.5rem);
        overflow: hidden;
        border: 1px solid var(--interior-line, #c7c9c7);
        border-radius: 1.15rem;
        align-items: stretch;
        background: var(--interior-line, #c7c9c7);
    }

    .donate-content .donation-card {
        display: flex;
        min-width: 0;
        box-sizing: border-box;
        flex-direction: column;
        padding: clamp(1.5rem, 3vw, 2rem);
        background: var(--interior-paper, #fbf8f0);
        text-align: left;
    }

    .donate-content .donation-method-heading {
        display: grid;
        grid-template-columns: 2.9rem minmax(0, 1fr) auto;
        gap: 0.85rem;
        min-height: 4.15rem;
        align-items: center;
        padding-bottom: 1.1rem;
        margin-bottom: 1.25rem;
        border-bottom: 1px solid var(--interior-line, #c7c9c7);
    }

    .donate-content .donation-icon,
    .donate-content .giving-info-icon {
        display: inline-flex;
        width: 2.9rem;
        height: 2.9rem;
        flex: 0 0 2.9rem;
        margin: 0;
        border: 1px solid rgba(209, 161, 45, 0.62);
        border-radius: 50%;
        align-items: center;
        justify-content: center;
        background: transparent;
        color: var(--interior-navy, #061a32);
    }

    .donate-content .donation-icon i,
    .donate-content .giving-info-icon i {
        color: inherit;
        font-size: 1.05rem;
    }

    .donate-content .donation-card h3 {
        margin: 0;
        color: var(--interior-navy, #061a32);
        font-size: clamp(1.4rem, 2.2vw, 1.75rem);
        line-height: 1.1;
    }

    .donate-content .donation-status {
        display: inline-flex;
        gap: 0.35rem;
        align-items: center;
        color: var(--interior-muted, #5f6973);
        font-family: var(--font-body);
        font-size: 0.75rem;
        font-weight: 700;
        white-space: nowrap;
    }

    .donate-content .donation-status-available {
        color: #276749;
    }

    .donate-content .donation-card-zelle {
        grid-column: 1 / -1;
    }

    .donate-content .zelle-layout {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(12rem, 0.42fr);
        gap: clamp(2rem, 5vw, 4rem);
        flex: 1;
        align-items: center;
    }

    .donate-content .zelle-intro {
        max-width: 60ch;
        margin: 0;
        color: var(--interior-muted, #5f6973);
        line-height: 1.6;
    }

    .donate-content .zelle-account-details {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0;
        margin: 1.25rem 0 0;
        border-top: 1px solid var(--interior-line, #c7c9c7);
        border-bottom: 1px solid var(--interior-line, #c7c9c7);
    }

    .donate-content .zelle-account-details > div {
        min-width: 0;
        padding: 1rem;
    }

    .donate-content .zelle-account-details > div:first-child {
        padding-left: 0;
        border-right: 1px solid var(--interior-line, #c7c9c7);
    }

    .donate-content .zelle-account-details dt {
        margin-bottom: 0.45rem;
        color: var(--interior-muted, #5f6973);
        font-family: var(--font-body);
        font-size: 0.74rem;
        font-weight: 800;
        letter-spacing: 0.06em;
        text-transform: uppercase;
    }

    .donate-content .zelle-account-details dd {
        margin: 0;
        color: var(--interior-navy, #061a32);
        overflow-wrap: anywhere;
    }

    .donate-content .zelle-tag-control {
        display: flex;
        min-width: 0;
        align-items: center;
        gap: 0.65rem;
    }

    .donate-content .zelle-tag-control code {
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: clamp(0.92rem, 2vw, 1.05rem);
        font-weight: 800;
    }

    .donate-content .zelle-copy-button {
        min-height: 38px;
        padding: 0.5rem 0.75rem;
        border: 1px solid var(--interior-navy, #061a32);
        border-radius: 999px;
        background: transparent;
        color: var(--interior-navy, #061a32);
        font: 800 0.72rem/1 var(--font-body);
        cursor: pointer;
    }

    .donate-content .zelle-copy-button:hover,
    .donate-content .zelle-copy-button:focus-visible {
        background: var(--interior-navy, #061a32);
        color: #fff;
    }

    .donate-content .zelle-copy-status {
        min-height: 1.2rem;
        margin: 0.45rem 0 0;
        color: #276749;
        font-size: 0.75rem;
        font-weight: 750;
    }

    .donate-content .payment-safety-note {
        display: grid;
        grid-template-columns: 1.15rem minmax(0, 1fr);
        gap: 0.65rem;
        margin-top: 0.8rem;
        padding: 0.85rem 0.95rem;
        border-left: 3px solid var(--interior-gold, #d1a12d);
        background: rgba(209, 161, 45, 0.08);
        color: var(--interior-muted, #5f6973);
    }

    .donate-content .payment-safety-note i {
        margin-top: 0.2rem;
        color: #8a6616;
    }

    .donate-content .payment-safety-note p {
        margin: 0;
        line-height: 1.55;
    }

    .donate-content .zelle-qr-link {
        display: grid;
        justify-self: center;
        place-items: center;
        gap: 0.45rem;
        color: var(--interior-navy, #061a32);
        font-size: 0.82rem;
        font-weight: 800;
        text-align: center;
        text-decoration: none;
    }

    .donate-content .zelle-qr-frame {
        display: grid;
        width: min(100%, 13.25rem);
        box-sizing: border-box;
        padding: 1rem;
        border: 1px solid rgba(209, 161, 45, 0.68);
        border-radius: 0.9rem;
        place-items: center;
        background: #fff;
        box-shadow: 0 0.85rem 2rem rgba(6, 26, 50, 0.09);
    }

    .donate-content .zelle-qr-frame img {
        display: block;
        width: 100%;
        height: auto;
        image-rendering: pixelated;
    }

    .donate-content .zelle-qr-link small {
        color: var(--interior-muted, #5f6973);
        font-size: 0.7rem;
        font-weight: 650;
    }

    .donate-content .zelle-qr-link:hover small,
    .donate-content .zelle-qr-link:focus-visible small {
        color: var(--interior-navy, #061a32);
        text-decoration: underline;
    }

    .donate-content .zelle-trademark-note {
        margin: 1.35rem 0 0;
        color: var(--interior-muted, #5f6973);
        font-size: 0.66rem;
        line-height: 1.45;
    }

    .donate-content .paypal-layout {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(8.5rem, 0.55fr);
        gap: clamp(1rem, 2.5vw, 1.6rem);
        flex: 1;
        align-items: center;
        color: var(--interior-navy, #061a32);
    }

    .donate-content .paypal-intro {
        margin: 0;
        color: var(--interior-muted, #5f6973);
        line-height: 1.6;
    }

    .donate-content .paypal-donate-form {
        min-height: 47px;
        margin: 1rem 0 0;
    }

    .donate-content .paypal-donate-form input[type='image'] {
        display: block;
        max-width: 100%;
        height: auto;
    }

    .donate-content .paypal-provider-note {
        margin: 0.85rem 0 0;
        color: var(--interior-muted, #5f6973);
        font-size: 0.72rem;
        line-height: 1.5;
    }

    .donate-content .paypal-qr-link {
        display: grid;
        justify-self: center;
        place-items: center;
        gap: 0.4rem;
        color: var(--interior-navy, #061a32);
        font-size: 0.76rem;
        font-weight: 800;
        text-align: center;
        text-decoration: none;
    }

    .donate-content .paypal-qr-frame {
        display: grid;
        width: min(100%, 10rem);
        box-sizing: border-box;
        padding: 0.8rem;
        border: 1px solid rgba(209, 161, 45, 0.68);
        border-radius: 0.9rem;
        place-items: center;
        background: #fff;
        box-shadow: 0 0.85rem 2rem rgba(6, 26, 50, 0.09);
    }

    .donate-content .paypal-qr-frame img {
        display: block;
        width: 100%;
        height: auto;
        image-rendering: pixelated;
    }

    .donate-content .paypal-qr-link small {
        color: var(--interior-muted, #5f6973);
        font-size: 0.67rem;
        font-weight: 650;
    }

    .donate-content .paypal-qr-link:hover small,
    .donate-content .paypal-qr-link:focus-visible small {
        color: var(--interior-navy, #061a32);
        text-decoration: underline;
    }

    .donate-content .check-details {
        display: grid;
        flex: 1;
        grid-template-rows: repeat(2, minmax(0, 1fr));
        margin: 0;
    }

    .donate-content .check-details > div {
        display: grid;
        grid-template-columns: minmax(7.5rem, 0.42fr) minmax(0, 1fr);
        gap: 1rem;
        padding: 1.15rem 0;
        border-bottom: 1px solid var(--interior-line, #c7c9c7);
        align-items: baseline;
    }

    .donate-content .check-details > div:first-child {
        padding-top: 0;
    }

    .donate-content .check-details > div:last-child {
        padding-bottom: 0;
        border-bottom: 0;
    }

    .donate-content .check-details dt {
        color: var(--interior-muted, #5f6973);
        font-family: var(--font-body);
        font-size: 0.82rem;
        font-weight: 700;
    }

    .donate-content .check-details dd {
        margin: 0;
        color: var(--interior-navy, #061a32);
        font-family: var(--font-display);
        font-size: clamp(1.1rem, 2vw, 1.3rem);
        font-weight: 700;
        line-height: 1.4;
    }

    .donate-content .check-details address {
        font: inherit;
    }

    .donate-content .donation-records-notice {
        display: grid;
        grid-template-columns: minmax(15rem, 0.75fr) minmax(0, 1.25fr);
        gap: clamp(1.5rem, 4vw, 2.5rem);
        padding: clamp(1.35rem, 2.5vw, 1.75rem);
        margin: 0 0 clamp(1.75rem, 3vw, 2rem);
        border: 1px solid rgba(209, 161, 45, 0.52);
        border-radius: 1rem;
        background: rgba(209, 161, 45, 0.07);
        align-items: start;
    }

    .donate-content .donation-records-notice h3 {
        margin: 0;
        color: var(--interior-navy, #061a32);
        font-size: clamp(1.35rem, 2.4vw, 1.75rem);
        line-height: 1.15;
    }

    .donate-content .donation-notice-kicker {
        margin: 0 0 0.5rem;
        color: #8a6616;
        font-size: 0.72rem;
        font-weight: 850;
        letter-spacing: 0.1em;
        line-height: 1.35;
        text-transform: uppercase;
    }

    .donate-content .donation-records-notice > div:last-child p {
        margin: 0 0 0.75rem;
        color: var(--interior-muted, #5f6973);
        line-height: 1.65;
    }

    .donate-content .donation-records-notice > div:last-child p:last-child {
        margin-bottom: 0;
    }

    .donate-content .giving-info {
        display: grid;
        grid-template-columns: minmax(15rem, 0.75fr) minmax(0, 1.25fr);
        gap: clamp(1.5rem, 4vw, 2.5rem);
        padding: clamp(1.35rem, 2.5vw, 1.75rem) 0;
        margin: 0 0 clamp(1.75rem, 3vw, 2rem);
        border: 0;
        border-top: 1px solid var(--interior-line, #c7c9c7);
        border-bottom: 1px solid var(--interior-line, #c7c9c7);
        border-radius: 0;
        align-items: start;
        background: transparent;
    }

    .donate-content .giving-info-heading {
        display: flex;
        gap: 0.9rem;
        align-items: flex-start;
    }

    .donate-content .giving-info h3 {
        margin: 0 0 0.45rem;
        color: var(--interior-navy, #061a32);
        font-size: clamp(1.55rem, 2.8vw, 2rem);
        line-height: 1.05;
    }

    .donate-content .giving-info p {
        margin: 0;
        color: var(--interior-muted, #5f6973);
        line-height: 1.5;
    }

    .donate-content .giving-list {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0;
        margin: 0 !important;
        padding: 0 !important;
        list-style: none;
    }

    .donate-content .giving-list li {
        display: grid;
        grid-template-columns: 1rem minmax(0, 1fr);
        gap: 0.65rem;
        min-height: 0;
        padding: 0.75rem 1rem;
        margin: 0 !important;
        border-bottom: 1px solid var(--interior-line, #c7c9c7);
        align-items: center;
        color: var(--interior-navy, #061a32);
        font-weight: 700;
        line-height: 1.3;
    }

    .donate-content .giving-list li:nth-last-child(-n + 2) {
        border-bottom: 0;
    }

    .donate-content .giving-list i {
        color: var(--interior-gold, #d1a12d);
        font-size: 0.75rem;
    }

    @media (max-width: 760px) {
        .donate-content .donation-verse {
            display: block;
            margin-bottom: 2rem;
        }

        .donate-content .donation-verse cite {
            display: block;
            margin-top: 0.35rem;
