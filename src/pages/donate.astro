---
import PageLayout from '../layouts/PageLayout.astro';
import { congregationName } from '../data/congregationIdentity';

const zelleTag = 'ohrhatorahoc';
const zelleRecipientName = 'CONGREGATION OHR HAT';
const zellePaymentUrl = 'https://enroll.zellepay.com/qr-codes?data=eyJuYW1lIjoiQ09OR1JFR0FUSU9OIE9IUiBIQVQiLCJ0b2tlbiI6Im9ocmhhdG9yYWhvYyJ9';
const paypalHostedButtonId = 'LPN2RWR887N84';
const paypalDonationUrl = `https://www.paypal.com/donate/?hosted_button_id=${paypalHostedButtonId}`;
const paypalQrDonationUrl = `${paypalDonationUrl}&source=qr`;
---

<PageLayout title="Support Kehilat Ohr HaTorah" pageTitle="Support Kehilat Ohr HaTorah" pageIcon="fas fa-heart" description="Ways to support Kehilat Ohr HaTorah through Zelle, PayPal, or check.">
    <div class="donate-content">
        <section class="giving-intro" aria-labelledby="giving-intro-title">
            <div class="giving-intro-copy">
                <p class="giving-eyebrow"><span aria-hidden="true"></span> Giving at Kehilat Ohr HaTorah</p>
                <h2 id="giving-intro-title">Give generously.<br /><em>Give with confidence.</em></h2>
                <p class="giving-intro-lede">Your gift helps sustain a welcoming home for worship, learning, fellowship, and care. Choose the giving path that works best for you.</p>
                <ul class="giving-intro-assurances" aria-label="Giving privacy assurances">
                    <li><i class="fas fa-arrow-up-right-from-square" aria-hidden="true"></i> Payment completed with the provider</li>
                    <li><i class="fas fa-lock" aria-hidden="true"></i> No banking credentials collected here</li>
                </ul>
            </div>

            <blockquote class="donation-verse">
                <span class="verse-mark" aria-hidden="true">“</span>
                <p class="donation-verse-copy">God loves a cheerful giver.</p>
                <cite>2 Corinthians 9:7</cite>
            </blockquote>
        </section>

        <div class="giving-section-heading">
            <div>
                <p class="giving-eyebrow giving-eyebrow-dark"><span aria-hidden="true"></span> Choose a giving method</p>
                <h2>Two trusted paths, one shared purpose.</h2>
            </div>
            <p>Zelle and PayPal open their own payment experiences. Always confirm the congregation details before you send.</p>
        </div>

        <div class="donation-grid donation-methods">
            <section class="donation-card donation-card-zelle" aria-labelledby="zelle-giving-title">
                <header class="provider-header">
                    <div class="provider-brand provider-brand-zelle">
                        <div class="provider-logo-shell">
                            <img src="/images/payments/zelle-bank-wordmark.png" width="1800" height="834" alt="Zelle" />
                        </div>
                        <div>
                            <p>Direct from your banking app</p>
                            <span>Bank-issued payment details</span>
                        </div>
                    </div>
                    <span class="provider-state"><i class="fas fa-circle-check" aria-hidden="true"></i> Available now</span>
                </header>

                <div class="provider-body zelle-layout">
                    <div class="provider-copy zelle-copy">
                        <p class="method-number">Giving method 01</p>
                        <h3 id="zelle-giving-title">Send with Zelle®</h3>
                        <p class="method-intro">Scan the bank-generated QR code in your participating bank or credit union app, or enter the congregation’s Zelle® tag.</p>

                        <ul class="payment-assurance-list" aria-label="Zelle transfer details">
                            <li><i class="fas fa-building-columns" aria-hidden="true"></i><span>Bank-generated QR</span></li>
                            <li><i class="fas fa-shield-halved" aria-hidden="true"></i><span>No bank sign-in on this site</span></li>
                            <li><i class="fas fa-circle-check" aria-hidden="true"></i><span>Confirm recipient before sending</span></li>
                        </ul>

                        <dl class="zelle-account-details">
                            <div>
                                <dt>Zelle® tag</dt>
                                <dd class="zelle-tag-control">
                                    <code id="zelle-tag-value">{zelleTag}</code>
                                    <button type="button" class="zelle-copy-button" data-copy-zelle-tag data-zelle-tag={zelleTag}>
                                        <i class="far fa-copy" aria-hidden="true"></i>
                                        Copy tag
                                    </button>
                                </dd>
                            </div>
                            <div>
                                <dt>Confirm recipient</dt>
                                <dd><strong>{zelleRecipientName}</strong></dd>
                            </div>
                        </dl>

                        <p class="zelle-copy-status" role="status" aria-live="polite" aria-atomic="true"></p>
                        <a class="provider-primary-action zelle-primary-action" href={zellePaymentUrl} target="_blank" rel="noopener noreferrer">
                            Open the Zelle payment link
                            <i class="fas fa-arrow-up-right-from-square" aria-hidden="true"></i>
                        </a>
                    </div>

                    <a
                        class="payment-scan-card zelle-qr-link"
                        href={zellePaymentUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={`Open the Zelle payment link for tag ${zelleTag}`}
                    >
                        <span class="scan-card-kicker"><i class="fas fa-mobile-screen-button" aria-hidden="true"></i> Scan with your bank app</span>
                        <span class="payment-qr-frame zelle-qr-frame">
                            <img src="/images/payments/zelle-ohrhatorahoc-qr.png" width="180" height="180" alt={`Zelle QR code for congregation tag ${zelleTag}`} />
                        </span>
                        <strong>Scan to give with Zelle®</strong>
                        <small>Tap here instead if you are on mobile</small>
                    </a>
                </div>

                <aside class="payment-safety-note" aria-label="Zelle payment safety">
                    <i class="fas fa-circle-info" aria-hidden="true"></i>
                    <p><strong>Before you send:</strong> confirm the recipient name and tag. Payments to an enrolled recipient generally cannot be canceled, and Zelle® does not offer purchase protection.</p>
                </aside>
                <p class="zelle-trademark-note">Zelle® is a registered trademark of Early Warning Services, LLC. Kehilat Ohr HaTorah is not affiliated with, sponsored by, or endorsed by Early Warning Services, LLC.</p>
            </section>

            <section class="donation-card donation-card-paypal" aria-labelledby="paypal-giving-title">
                <header class="provider-header">
                    <div class="provider-brand provider-brand-paypal">
                        <a href={paypalDonationUrl} target="_blank" rel="noopener noreferrer" aria-label="Open the Kehilat Ohr HaTorah donation page on PayPal">
                            <img src="https://www.paypalobjects.com/webstatic/mktg/logo/pp_cc_mark_111x69.jpg" width="111" height="69" alt="PayPal" referrerpolicy="strict-origin-when-cross-origin" />
                        </a>
                        <div>
                            <p>Give on PayPal</p>
                            <span>PayPal-hosted donation page</span>
                        </div>
                    </div>
                    <span class="provider-state"><i class="fas fa-circle-check" aria-hidden="true"></i> Available now</span>
                </header>

                <div class="provider-body paypal-layout">
                    <div class="provider-copy paypal-copy">
                        <p class="method-number">Giving method 02</p>
                        <h3 id="paypal-giving-title">Donate with PayPal</h3>
                        <p class="method-intro">Make a one-time, monthly, or yearly gift on PayPal’s hosted page. Suggested amounts are $18, $36, and $72, or choose your own amount.</p>

                        <ul class="payment-assurance-list" aria-label="PayPal checkout details">
                            <li><i class="fas fa-arrow-up-right-from-square" aria-hidden="true"></i><span>PayPal-hosted checkout</span></li>
                            <li><i class="fas fa-lock" aria-hidden="true"></i><span>No payment credentials stored here</span></li>
                            <li><i class="fas fa-arrows-rotate" aria-hidden="true"></i><span>One-time or recurring gifts</span></li>
                        </ul>

                        <a class="provider-primary-action paypal-primary-action" href={paypalDonationUrl} target="_blank" rel="noopener noreferrer">
                            <i class="fab fa-paypal" aria-hidden="true"></i>
                            Continue to PayPal
                            <i class="fas fa-arrow-up-right-from-square" aria-hidden="true"></i>
                        </a>

                        <div class="paypal-official-button">
                            <span>Official PayPal Donate button</span>
                            <form class="paypal-donate-form" action="https://www.paypal.com/donate" method="post" target="_top" aria-label="Donate to Kehilat Ohr HaTorah with PayPal">
                                <input type="hidden" name="hosted_button_id" value={paypalHostedButtonId} />
                                <input
                                    type="image"
                                    src="https://www.paypalobjects.com/en_US/i/btn/btn_donateCC_LG.gif"
                                    name="submit"
                                    title="PayPal - The safer, easier way to pay online!"
                                    alt="Donate with PayPal button"
                                    referrerpolicy="strict-origin-when-cross-origin"
                                />
                            </form>
                        </div>

                        <div class="paypal-gift-options" aria-label="Giving options available on PayPal">
                            <p>Choose your giving rhythm</p>
                            <ul>
                                <li><i class="fas fa-heart" aria-hidden="true"></i> One-time</li>
                                <li><i class="fas fa-calendar-check" aria-hidden="true"></i> Monthly</li>
                                <li><i class="fas fa-calendar-days" aria-hidden="true"></i> Yearly</li>
                                <li><i class="fas fa-pen" aria-hidden="true"></i> Your amount</li>
                            </ul>
                        </div>
                    </div>

                    <a
                        class="payment-scan-card paypal-qr-link"
                        href={paypalQrDonationUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="Open the PayPal donation page for Kehilat Ohr HaTorah"
                    >
                        <span class="scan-card-kicker"><i class="fab fa-paypal" aria-hidden="true"></i> Scan with your camera</span>
                        <span class="payment-qr-frame paypal-qr-frame">
                            <img src="/images/payments/paypal-donation-qr.png" width="256" height="256" alt="PayPal QR code for Kehilat Ohr HaTorah donations" />
                        </span>
                        <strong>Scan to give with PayPal</strong>
                        <small>Opens PayPal’s hosted donation page</small>
                    </a>
                </div>

                <aside class="payment-safety-note paypal-security-note" aria-label="PayPal payment privacy">
                    <i class="fas fa-shield-halved" aria-hidden="true"></i>
                    <p><strong>Completed on PayPal:</strong> PayPal processes the donation on its website. This site does not receive your PayPal password or payment credentials.</p>
                </aside>
            </section>

            <section class="donation-card donation-card-check" aria-labelledby="check-giving-title">
                <div class="check-intro">
                    <span class="check-icon" aria-hidden="true"><i class="fas fa-money-check"></i></span>
                    <div>
                        <p class="method-number">Giving method 03</p>
                        <h3 id="check-giving-title">Prefer to give by check?</h3>
                        <p>Send your gift through the mail using the details shown here.</p>
                    </div>
                </div>

                <dl class="check-details">
                    <div>
                        <dt>Make payable to</dt>
                        <dd><strong>{congregationName}</strong></dd>
                    </div>
                    <div>
                        <dt>Mail to</dt>
                        <dd><address>360 E. 1st Street, #856<br />Tustin, CA 92780</address></dd>
                    </div>
                </dl>
            </section>
        </div>

        <section class="giving-confidence" aria-labelledby="giving-confidence-title">
            <div class="confidence-heading">
                <p class="giving-eyebrow giving-eyebrow-dark"><span aria-hidden="true"></span> A clear giving path</p>
                <h2 id="giving-confidence-title">Give with confidence in three simple steps.</h2>
            </div>
            <ol>
                <li>
                    <span>01</span>
                    <div><strong>Choose your provider</strong><p>Use Zelle, PayPal, or send a check.</p></div>
                </li>
                <li>
                    <span>02</span>
                    <div><strong>Confirm the destination</strong><p>Review the recipient or hosted page before sending.</p></div>
                </li>
                <li>
                    <span>03</span>
                    <div><strong>Keep your confirmation</strong><p>Save your bank, PayPal, or check record.</p></div>
                </li>
            </ol>
        </section>

        <section class="giving-info" aria-labelledby="why-give-title">
            <div class="giving-info-heading">
                <div class="giving-info-icon" aria-hidden="true"><i class="fas fa-hand-holding-heart"></i></div>
                <div>
                    <p class="giving-eyebrow giving-eyebrow-gold">Your gift at work</p>
                    <h3 id="why-give-title">What your generosity sustains</h3>
                    <p>Your generosity helps nourish the worship, learning, and care we share.</p>
                </div>
            </div>
            <ul class="giving-list">
                <li><i class="fas fa-check" aria-hidden="true"></i><span>Shabbat services and teaching</span></li>
                <li><i class="fas fa-check" aria-hidden="true"></i><span>Jewish learning and teaching</span></li>
                <li><i class="fas fa-check" aria-hidden="true"></i><span>Community outreach</span></li>
                <li><i class="fas fa-check" aria-hidden="true"></i><span>Support for Israel ministries</span></li>
                <li><i class="fas fa-check" aria-hidden="true"></i><span>Future youth learning</span></li>
                <li><i class="fas fa-check" aria-hidden="true"></i><span>Facility care and operations</span></li>
            </ul>
        </section>

        <section class="donation-records-notice" aria-labelledby="giving-records-title">
            <div class="records-heading">
                <i class="fas fa-file-shield" aria-hidden="true"></i>
                <div>
                    <p class="donation-notice-kicker">For your records</p>
                    <h3 id="giving-records-title">Giving acknowledgments and special contributions</h3>
                </div>
            </div>
            <div>
                <p>Please keep your check or bank record. Contact <strong>{congregationName}</strong> if you need a giving acknowledgment or believe a record should be corrected.</p>
                <p>Whether a contribution is deductible depends on applicable law and your individual circumstances; nothing on this website is tax advice. Please consult a qualified adviser. Contact us before sending a non-cash or other special contribution so we can confirm whether it can be accepted.</p>
            </div>
        </section>

        <div class="giving-contact-box">
            <div>
                <p class="giving-eyebrow giving-eyebrow-gold">We’re here to help</p>
                <h4>Questions about giving?</h4>
                <p class="giving-contact-description">Reach out before sending a special contribution or whenever you need help.</p>
            </div>
            <div class="contact-links">
                <a href="tel:+17144061513" aria-label="Call Kehilat Ohr HaTorah at (714) 406-1513"><i class="fas fa-phone" aria-hidden="true"></i> Call us</a>
                <a href="mailto:OhrHaTorahOC@gmail.com" aria-label="Email Kehilat Ohr HaTorah at OhrHaTorahOC@gmail.com"><i class="fas fa-envelope" aria-hidden="true"></i> Email us</a>
            </div>
        </div>
    </div>
</PageLayout>

<style>
    .donate-content {
        --giving-navy: #061a32;
        --giving-navy-soft: #102b49;
        --giving-gold: #d1a12d;
        --giving-gold-light: #f0cf76;
        --giving-paper: #fbf8f0;
        --giving-ink: #061a32;
        --giving-muted: #596778;
        --zelle-purple: #6d1ed4;
        --zelle-deep: #43107f;
        --zelle-soft: #f3eaff;
        --paypal-blue: #0070ba;
        --paypal-deep: #003087;
        --paypal-yellow: #ffc439;
        --paypal-soft: #eaf6fd;
        color: var(--giving-ink);
    }

    .donate-content .giving-intro {
        display: grid;
        position: relative;
        grid-template-columns: minmax(0, 1.35fr) minmax(18rem, 0.65fr);
        gap: clamp(2rem, 5vw, 4.75rem);
        margin: 0 0 clamp(3.25rem, 7vw, 5.5rem);
        padding: clamp(2.25rem, 5vw, 4.75rem);
        overflow: hidden;
        border: 1px solid rgba(240, 207, 118, 0.34);
        border-radius: clamp(1.25rem, 2.5vw, 2rem);
        align-items: center;
        background:
            radial-gradient(circle at 88% 8%, rgba(240, 207, 118, 0.19), transparent 27%),
            radial-gradient(circle at 8% 108%, rgba(51, 121, 181, 0.22), transparent 31%),
            linear-gradient(135deg, #061a32 0%, #0b2948 62%, #102f50 100%);
        box-shadow: 0 2rem 5rem rgba(6, 26, 50, 0.2);
        isolation: isolate;
    }

    .donate-content .giving-intro::before,
    .donate-content .giving-intro::after {
        position: absolute;
        border: 1px solid rgba(240, 207, 118, 0.18);
        border-radius: 50%;
        content: '';
        pointer-events: none;
        z-index: -1;
    }

    .donate-content .giving-intro::before {
        width: clamp(16rem, 34vw, 34rem);
        height: clamp(16rem, 34vw, 34rem);
        top: -46%;
        right: -8%;
    }

    .donate-content .giving-intro::after {
        width: clamp(8rem, 18vw, 18rem);
        height: clamp(8rem, 18vw, 18rem);
        right: 18%;
        bottom: -40%;
    }

    .donate-content .giving-intro-copy {
        position: relative;
        z-index: 1;
    }

    .donate-content .giving-eyebrow {
        display: flex;
        gap: 0.65rem;
        margin: 0 0 1rem;
        align-items: center;
        color: var(--giving-gold-light);
        font-family: var(--font-body);
        font-size: 0.72rem;
        font-weight: 850;
        letter-spacing: 0.14em;
        line-height: 1.35;
        text-transform: uppercase;
    }

    .donate-content .giving-eyebrow > span {
        width: 2rem;
        height: 1px;
        flex: 0 0 auto;
        background: currentColor;
    }

    .donate-content .giving-eyebrow-dark {
        color: #826018;
    }

    .donate-content .giving-eyebrow-gold {
        color: var(--giving-gold-light);
    }

    .donate-content .giving-intro h2 {
        max-width: 13ch;
        margin: 0;
        color: #ffffff;
        font-family: var(--font-display);
        font-size: clamp(2.7rem, 6.2vw, 5.45rem);
        font-weight: 650;
        letter-spacing: -0.045em;
        line-height: 0.93;
    }

    .donate-content .giving-intro h2 em {
        color: var(--giving-gold-light);
        font-weight: inherit;
    }

    .donate-content .giving-intro-lede {
        max-width: 59ch;
        margin: clamp(1.35rem, 3vw, 2rem) 0 0;
        color: rgba(255, 255, 255, 0.78);
        font-size: clamp(1rem, 1.6vw, 1.15rem);
        line-height: 1.7;
    }

    .donate-content .giving-intro-assurances {
        display: flex;
        flex-wrap: wrap;
        gap: 0.65rem 1.1rem;
        margin: 1.65rem 0 0;
        padding: 1.1rem 0 0;
        border-top: 1px solid rgba(255, 255, 255, 0.14);
        list-style: none;
    }

    .donate-content .giving-intro .giving-intro-assurances li {
        display: inline-flex;
        gap: 0.5rem;
        align-items: center;
        color: rgba(255, 255, 255, 0.8);
        font-size: 0.76rem;
        font-weight: 700;
        line-height: 1.35;
    }

    .donate-content .giving-intro-assurances i {
        color: var(--giving-gold-light);
    }

    .donate-content .donation-verse {
        position: relative;
        margin: 0;
        padding: clamp(1.5rem, 3vw, 2.25rem);
        border: 1px solid rgba(255, 255, 255, 0.18);
        border-radius: 1.25rem;
        background: rgba(255, 255, 255, 0.075);
        box-shadow: inset 0 1px rgba(255, 255, 255, 0.08);
        color: #ffffff;
        backdrop-filter: blur(10px);
    }

    .donate-content .verse-mark {
        display: block;
        height: 2rem;
        margin-bottom: 0.5rem;
        color: var(--giving-gold-light);
        font-family: Georgia, serif;
        font-size: 4.75rem;
        line-height: 0.85;
    }

    .donate-content .giving-intro .donation-verse .donation-verse-copy {
        margin: 0;
        color: #ffffff;
        font-family: var(--font-display);
        font-size: clamp(1.55rem, 2.7vw, 2.25rem);
        font-style: italic;
        line-height: 1.2;
    }

    .donate-content .donation-verse cite {
        display: block;
        margin-top: 1.25rem;
        color: var(--giving-gold-light);
        font-family: var(--font-body);
        font-size: 0.72rem;
        font-style: normal;
        font-weight: 850;
        letter-spacing: 0.12em;
        text-transform: uppercase;
    }

    .donate-content .giving-section-heading {
        display: grid;
        grid-template-columns: minmax(0, 1.25fr) minmax(18rem, 0.75fr);
        gap: clamp(1.5rem, 5vw, 4rem);
        margin: 0 0 clamp(1.75rem, 4vw, 2.5rem);
        align-items: end;
    }

    .donate-content .giving-section-heading h2,
    .donate-content .confidence-heading h2 {
        max-width: 17ch;
        margin: 0;
        color: var(--giving-navy);
        font-family: var(--font-display);
        font-size: clamp(2.05rem, 4vw, 3.6rem);
        font-weight: 650;
        letter-spacing: -0.035em;
        line-height: 1;
    }

    .donate-content .giving-section-heading > p {
        max-width: 49ch;
        margin: 0;
        padding-left: clamp(1rem, 2.5vw, 2rem);
        border-left: 1px solid rgba(6, 26, 50, 0.2);
        color: var(--giving-muted);
        line-height: 1.65;
    }

    .donate-content .donation-grid.donation-methods {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: clamp(1rem, 2.5vw, 1.75rem);
        margin: 0 0 clamp(3.5rem, 7vw, 5.5rem);
        align-items: stretch;
        background: transparent;
    }

    .donate-content .donation-card {
        --payment-accent: var(--giving-gold);
        --payment-deep: var(--giving-navy);
        --payment-soft: rgba(209, 161, 45, 0.1);
        display: flex;
        position: relative;
        min-width: 0;
        box-sizing: border-box;
        flex-direction: column;
        overflow: hidden;
        border: 1px solid rgba(6, 26, 50, 0.12);
        border-radius: clamp(1.2rem, 2vw, 1.65rem);
        background: #ffffff;
        box-shadow:
            0 1.5rem 3.5rem rgba(6, 26, 50, 0.1),
            0 0.2rem 0.8rem rgba(6, 26, 50, 0.04);
        text-align: left;
    }

    .donate-content .donation-card-zelle {
        --payment-accent: var(--zelle-purple);
        --payment-deep: var(--zelle-deep);
        --payment-soft: var(--zelle-soft);
    }

    .donate-content .donation-card-paypal {
        --payment-accent: var(--paypal-blue);
        --payment-deep: var(--paypal-deep);
        --payment-soft: var(--paypal-soft);
    }

    .donate-content .donation-card-zelle::after,
    .donate-content .donation-card-paypal::after {
        position: absolute;
        width: 15rem;
        height: 15rem;
        top: 4rem;
        right: -9rem;
        border: 1px solid color-mix(in srgb, var(--payment-accent) 16%, transparent);
        border-radius: 50%;
        content: '';
        pointer-events: none;
    }

    .donate-content .provider-header {
        display: flex;
        position: relative;
        min-height: 6.25rem;
        box-sizing: border-box;
        gap: 1rem;
        padding: 1.15rem clamp(1.25rem, 2.5vw, 1.75rem);
        border-bottom: 1px solid color-mix(in srgb, var(--payment-accent) 18%, transparent);
        align-items: center;
        justify-content: space-between;
        z-index: 1;
    }

    .donate-content .donation-card-zelle .provider-header {
        background:
            radial-gradient(circle at 10% 0%, rgba(109, 30, 212, 0.13), transparent 45%),
            linear-gradient(120deg, #faf7ff 0%, #f2e8ff 100%);
    }

    .donate-content .donation-card-paypal .provider-header {
        background:
            linear-gradient(90deg, rgba(0, 48, 135, 0.065) 0 76%, rgba(255, 196, 57, 0.22) 76% 100%),
            linear-gradient(120deg, #f7fbff 0%, #e8f5fc 100%);
    }

    .donate-content .provider-brand {
        display: flex;
        min-width: 0;
