---
// Page Layout - Used for interior pages (FAQ, About, Contact, etc.)
import BaseLayout from './BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Navigation from '../components/layout/Navigation.astro';
import MobileNavigation from '../components/layout/MobileNavigation.astro';
import Footer from '../components/layout/Footer.astro';
import SectionDivider from '../components/layout/SectionDivider.astro';

interface Props {
  title?: string;
  pageTitle?: string;
  pageIcon?: string;
  description?: string;
  stylesheets?: string[];
}

const {
  title = "Kehilat Ohr HaTorah Messianic Congregation",
  pageTitle,
  description,
  stylesheets = [],
} = Astro.props;

type PageSection = {
    section: string;
    sectionHref: string;
};

const pageSections: Record<string, PageSection> = {
    '/about': {
        section: 'Welcome',
        sectionHref: '/about',
    },
    '/accessibility': {
        section: 'Accessibility',
        sectionHref: '/accessibility',
    },
    '/contact': {
        section: 'Connect',
        sectionHref: '/contact',
    },
    '/donate': {
        section: 'Connect',
        sectionHref: '/contact',
    },
    '/events': {
        section: 'Events & Services',
        sectionHref: '/services',
    },
    '/expect': {
        section: 'Welcome',
        sectionHref: '/about',
    },
    '/faq': {
        section: 'Welcome',
        sectionHref: '/about',
    },
    '/holidays': {
        section: 'Events & Services',
        sectionHref: '/services',
    },
    '/israel': {
        section: 'Community',
        sectionHref: '/israel',
    },
    '/location': {
        section: 'Welcome',
        sectionHref: '/about',
    },
    '/mission': {
        section: 'Welcome',
        sectionHref: '/about',
    },
    '/privacy': {
        section: 'Privacy Notice',
        sectionHref: '/privacy',
    },
    '/resources': {
        section: 'Learn',
        sectionHref: '/resources',
    },
    '/services': {
        section: 'Events & Services',
        sectionHref: '/services',
    },
    '/umjc': {
        section: 'Welcome',
        sectionHref: '/about',
    },
    '/youth': {
        section: 'Events & Services',
        sectionHref: '/services',
    },
    '/website-use': {
        section: 'Website Use',
        sectionHref: '/website-use',
    },
};

const currentPath = Astro.url.pathname === '/'
    ? '/'
    : Astro.url.pathname.replace(/\/+$/, '');
const pageSection = pageSections[currentPath] ?? pageSections['/about'];
const showSectionCrumb = pageSection.sectionHref !== currentPath;
---

<BaseLayout title={title} description={description} stylesheets={['/styles/interior.css', ...stylesheets]}>
    <div class="interior-shell">
        <div class="site-navigation-shell">
            <Header showLogo={false} />
            <Navigation />
        </div>
        <MobileNavigation />

        {pageTitle && (
            <header class="page-hero">
                <div class="page-hero-inner">
                    <div class="page-hero-title">
                        <nav class="site-breadcrumbs" aria-label="Breadcrumb">
                            <ol>
                                <li><a href="/">Home</a></li>
                                {showSectionCrumb && <li><a href={pageSection.sectionHref}>{pageSection.section}</a></li>}
                                <li aria-current="page">{pageTitle}</li>
                            </ol>
                        </nav>
                        <span class="page-hero-rule" aria-hidden="true"></span>
                        <h1 id="page-title">{pageTitle}</h1>
                    </div>
                </div>
            </header>
        )}

        {pageTitle && <SectionDivider from="var(--interior-navy)" to="var(--interior-cream)" shape="sweep-reverse" />}

        <main class="page-content interior-page" aria-labelledby={pageTitle ? 'page-title' : undefined}>
            <article class="page-container">
            <div class="page-body">
                <slot />
            </div>
            <div class="page-footer">
                    <a href="/" class="page-home-link">Return home <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
            </div>
            </article>
            <SectionDivider from="var(--interior-cream)" to="var(--site-chrome-navy)" shape="rise" />
        </main>

        <Footer />
    </div>
</BaseLayout>
