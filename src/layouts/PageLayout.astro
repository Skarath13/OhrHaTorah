---
// Page Layout - Used for interior pages (FAQ, About, Contact, etc.)
import BaseLayout from './BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Navigation from '../components/layout/Navigation.astro';
import MobileNavigation from '../components/layout/MobileNavigation.astro';
import Footer from '../components/layout/Footer.astro';
import SectionDivider from '../components/layout/SectionDivider.astro';

interface Props {
  title?: string;
  pageTitle?: string;
  pageIcon?: string;
  description?: string;
}

const {
  title = "Ohr HaTorah Messianic Congregation",
  pageTitle,
  description,
} = Astro.props;

type PagePresentation = {
    image: string;
    alt: string;
    position?: string;
    section: string;
    sectionHref: string;
};

const pagePresentations: Record<string, PagePresentation> = {
    '/about': {
        image: '/images/stock/torah-study.webp',
        alt: 'A hand following text in a Torah scroll',
        position: '50% 54%',
        section: 'Welcome',
        sectionHref: '/about',
    },
    '/contact': {
        image: '/images/stock/mezuzah-light.webp',
        alt: 'A hand holding a mezuzah in warm light',
        position: '50% 58%',
        section: 'Connect',
        sectionHref: '/contact',
    },
    '/donate': {
        image: '/images/stock/olive-branches.webp',
        alt: 'Olive branches in Mediterranean sunlight',
        position: '38% 48%',
        section: 'Connect',
        sectionHref: '/contact',
    },
    '/events': {
        image: '/images/stock/holiday-table.webp',
        alt: 'A Jewish holiday table set with a Hanukkah menorah',
        position: '56% 44%',
        section: 'Events & Services',
        sectionHref: '/services',
    },
    '/expect': {
        image: '/images/stock/open-torah-scroll.webp',
        alt: 'An open Torah scroll resting on a synagogue reading table',
        position: '50% 50%',
        section: 'Welcome',
        sectionHref: '/about',
    },
    '/faq': {
        image: '/images/stock/torah-ark.webp',
        alt: 'Torah scrolls resting inside an ark',
        position: '50% 58%',
        section: 'Welcome',
        sectionHref: '/about',
    },
    '/holidays': {
        image: '/images/stock/holiday-table.webp',
        alt: 'A Jewish holiday table set with candles and flowers',
        position: '56% 44%',
        section: 'Events & Services',
        sectionHref: '/services',
    },
    '/israel': {
        image: '/images/stock/jerusalem-panorama.webp',
        alt: 'A panoramic view of Jerusalem',
        position: '50% 58%',
        section: 'Community',
        sectionHref: '/israel',
    },
    '/location': {
        image: '/images/stock/mezuzah-light.webp',
        alt: 'A hand holding a mezuzah in warm light',
        position: '50% 58%',
        section: 'Welcome',
        sectionHref: '/about',
    },
    '/mission': {
        image: '/images/stock/star-of-david-ark.webp',
        alt: 'A Torah ark marked with Stars of David and Hebrew inscription',
        position: '50% 32%',
        section: 'Welcome',
        sectionHref: '/about',
    },
    '/resources': {
        image: '/images/stock/torah-ark.webp',
        alt: 'Torah scrolls resting inside an ark',
        position: '50% 58%',
        section: 'Learn',
        sectionHref: '/resources',
    },
    '/services': {
        image: '/images/stock/open-torah-scroll.webp',
        alt: 'An open Torah scroll resting on a synagogue reading table',
        position: '50% 50%',
        section: 'Events & Services',
        sectionHref: '/services',
    },
    '/umjc': {
        image: '/images/stock/torah-study.webp',
        alt: 'A hand following text in a Torah scroll',
        position: '50% 54%',
        section: 'Welcome',
        sectionHref: '/about',
    },
    '/youth': {
        image: '/images/stock/torah-study.webp',
        alt: 'A hand following text in a Torah scroll',
        position: '50% 54%',
        section: 'Events & Services',
        sectionHref: '/services',
    },
};

const currentPath = Astro.url.pathname === '/'
    ? '/'
    : Astro.url.pathname.replace(/\/+$/, '');
const presentation = pagePresentations[currentPath] ?? pagePresentations['/about'];
const showSectionCrumb = presentation.sectionHref !== currentPath;
---

<BaseLayout title={title} description={description} stylesheets={['/styles/interior.css']}>
    <div class="interior-shell">
        <div class="site-navigation-shell">
            <Header showLogo={false} />
            <Navigation />
        </div>
        <MobileNavigation />

        {pageTitle && (
            <header class="page-hero">
                <div class="page-hero-inner">
                    <div class="page-hero-title">
                        <nav class="site-breadcrumbs" aria-label="Breadcrumb">
                            <ol>
                                <li><a href="/">Home</a></li>
                                {showSectionCrumb && <li><a href={presentation.sectionHref}>{presentation.section}</a></li>}
                                <li aria-current="page">{pageTitle}</li>
                            </ol>
                        </nav>
                        <span class="page-hero-rule" aria-hidden="true"></span>
                        <h1 id="page-title">{pageTitle}</h1>
                    </div>
                    <figure class="page-hero-media" style={`--hero-position: ${presentation.position ?? '50% 50%'}`}>
                        <img
                            src={presentation.image}
                            alt={presentation.alt}
                            width="1800"
                            height="1200"
                            loading="eager"
                            fetchpriority="high"
                        >
                    </figure>
                </div>
            </header>
        )}

        {pageTitle && <SectionDivider from="var(--interior-navy)" to="var(--interior-cream)" />}

        <main class="page-content interior-page" aria-labelledby={pageTitle ? 'page-title' : undefined}>
            <article class="page-container">
            <div class="page-body">
                <slot />
            </div>
            <div class="page-footer">
                    <a href="/" class="page-home-link">Return home <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
            </div>
            </article>
            <SectionDivider from="var(--interior-cream)" to="var(--site-chrome-navy)" flip />
        </main>

        <Footer />
    </div>
</BaseLayout>
