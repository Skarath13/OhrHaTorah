---
// Page Layout - Used for interior pages (FAQ, About, Contact, etc.)
import BaseLayout from './BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Navigation from '../components/layout/Navigation.astro';
import Footer from '../components/layout/Footer.astro';

interface Props {
  title?: string;
  pageTitle?: string;
  pageIcon?: string;
}

const {
  title = "Ohr HaTorah Messianic Congregation",
  pageTitle,
  pageIcon = "fas fa-star-of-david"
} = Astro.props;
---

<BaseLayout title={title}>
    <Header />
    <Navigation />

    <main class="page-content premium-page">
        <div class="page-container">
            {pageTitle && (
                <div class="page-header">
                    <div class="page-kicker">
                        <i class="fas fa-star-of-david" aria-hidden="true"></i>
                        Ohr HaTorah
                    </div>
                    <h1><i class={pageIcon}></i> {pageTitle}</h1>
                </div>
            )}
            <div class="page-body">
                <slot />
            </div>
            <div class="page-footer">
                <a href="/" class="btn btn-blue"><i class="fas fa-home"></i> Back to Home</a>
            </div>
        </div>
    </main>

    <Footer />
</BaseLayout>

<style is:global>
    .page-content {
        min-height: calc(100vh - 200px);
        padding: clamp(96px, 10vw, 138px) var(--page-gutter) clamp(56px, 8vw, 92px);
        color: var(--ink);
        background:
            radial-gradient(circle at 12% 10%, rgba(39, 108, 197, 0.16), transparent 30rem),
            radial-gradient(circle at 86% 24%, rgba(215, 168, 77, 0.12), transparent 32rem),
            linear-gradient(180deg, var(--surface-warm) 0%, var(--surface) 62%, #f8efe2 100%);
    }

    .page-container {
        width: min(100%, 1240px);
        margin: 0 auto;
        background: transparent;
        border: 0;
        border-radius: 0;
        box-shadow: none;
        overflow: visible;
        min-width: 0;
        backdrop-filter: none;
    }

    .page-header {
        position: relative;
        isolation: isolate;
        overflow: hidden;
        color: var(--ink);
        padding: clamp(46px, 7vw, 84px) clamp(22px, 6vw, 64px);
        margin-bottom: clamp(20px, 3vw, 34px);
        border: 1px solid rgba(22, 35, 61, 0.12);
        border-radius: 1.25rem;
        text-align: center;
        background-color: var(--surface-warm);
        background-image: image-set(url('/images/premium/torah-card-landscape.webp') type('image/webp'));
        background-size: cover;
        background-position: center;
        box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.65), 0 24px 80px rgba(70, 46, 13, 0.12);
        backdrop-filter: none;
        -webkit-backdrop-filter: none;
    }

    .page-header::before {
        content: none;
    }

    .page-kicker {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        margin-bottom: 12px;
        color: var(--gold-deep);
        font-size: 0.78rem;
        font-weight: 800;
        letter-spacing: 0.14em;
        text-transform: uppercase;
    }

    .page-header h1 {
        margin: 0;
        color: var(--ink) !important;
        font-family: var(--font-serif);
        font-size: clamp(2.4rem, 6vw, 4.9rem);
        font-weight: 700;
        line-height: 0.95;
        text-wrap: balance;
        text-shadow: 0 1px 8px rgba(255, 253, 248, 0.9), 0 10px 32px rgba(255, 253, 248, 0.7);
    }

    .page-header h1 i {
        margin-right: 0.24em;
        color: var(--gold-deep) !important;
        font-size: 0.72em;
    }

    .page-body {
        display: grid;
        gap: clamp(18px, 2.5vw, 28px);
        padding: 0;
        min-width: 0;
    }

    .page-footer {
        padding: clamp(24px, 4vw, 42px) 0 0;
        text-align: center;
        border-top: 0;
        background: transparent;
    }

    .page-body > * {
        max-width: 100%;
    }

    .page-body img,
    .page-body iframe {
        max-width: 100%;
    }

    .page-body :where(h2, h3, h4) {
        line-height: 1.25;
        text-wrap: balance;
    }

    @media (max-width: 1023px) {
        .page-content { padding-top: 96px; }
    }

    @media (max-width: 767px) {
        .page-container {
            border-radius: var(--radius-lg);
        }

        .page-header {
            background-position: center right 24%;
        }

        .page-body {
            padding: 0;
        }

        .page-footer {
            padding: 20px 0 0;
        }

        .page-body :where(.section, .resource-section, .service-schedule, .values-section, .programs-section, .directions-section, .location-card, .info-section, .tips-section, .highlight-section, .priority-section, .involvement-section, .vision-section, .mission-section, .about-section, .contact-box, .welcome-banner, .cta-section) {
            margin-bottom: 24px;
        }

        .page-body :where(.identity-section, .highlight-section, .priority-section, .tips-section, .resource-card, .event-card, .contact-card, .direction-card, .location-card, .mission-section, .vision-section, .cta-section, .about-section, .info-section, .involvement-section, .practical-item, .experience-item, .stat-item, .value-card, .program-item) {
            padding: 20px;
        }

        .page-body :where(.worship-grid, .events-grid, .values-grid, .directions-grid, .location-grid, .contact-grid, .experience-grid, .practical-grid, .stats-grid) {
            grid-template-columns: minmax(0, 1fr);
        }

        .page-body :where(.contact-links, .contact-info) {
            flex-direction: column;
            align-items: stretch;
            gap: 12px;
        }

        .page-body :where(.contact-links a, .contact-info a, .cta-button, .directions-btn) {
            justify-content: center;
            width: 100%;
            box-sizing: border-box;
        }
    }
</style>
