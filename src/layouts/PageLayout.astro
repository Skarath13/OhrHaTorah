---
// Page Layout - Used for interior pages (FAQ, About, Contact, etc.)
import BaseLayout from './BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { IconArrowLeft } from '@tabler/icons-astro';

interface Props {
  title?: string;
  description?: string;
  pageTitle?: string;
}

const {
  title = 'Ohr HaTorah Messianic Congregation',
  description = 'Learn more about Ohr HaTorah Messianic Congregation in Orange County, California.',
  pageTitle,
} = Astro.props;

const pageDecks: Record<string, string> = {
  '/about': 'A congregation shaped by Jewish faith, Scripture, and welcome.',
  '/expect': 'A clear guide for your first Shabbat with us.',
  '/mission': 'The convictions that shape our congregational life.',
  '/location': 'Saturday at 2:30 PM · Fountain Valley, California.',
  '/faq': 'Plain answers before your first visit.',
  '/umjc': 'Connected to the wider Messianic Jewish community.',
  '/services': 'Music, prayer, Torah, and discussion every Shabbat.',
  '/holidays': 'Remembering God’s appointed times together.',
  '/events': 'Congregational life beyond the weekly Shabbat.',
  '/youth': 'Jewish learning and belonging for the next generation.',
  '/israel': 'Prayer, solidarity, and practical support.',
  '/resources': 'A considered starting place for deeper study.',
  '/contact': 'Questions are welcome. We would be glad to hear from you.',
  '/donate': 'Help sustain worship, teaching, and community life.',
};
const pageDeck = pageDecks[Astro.url.pathname] ?? 'Torah, Messiah, and sacred community in Orange County.';
---

<BaseLayout title={title} description={description} bodyClass="interior-page">
    <Header />

    <main class="page-content" id="main-content" tabindex="-1">
        <section class="page-hero" aria-labelledby="page-title">
            <div class="page-hero__inner">
                {pageTitle && <h1 id="page-title">{pageTitle}</h1>}
                <p>{pageDeck}</p>
            </div>
        </section>

        <article class="page-article">
            <div class="page-body">
                <slot />
            </div>
            <footer class="page-footer">
                <a href="/" class="editorial-back-link"><IconArrowLeft size={19} stroke={1.8} aria-hidden="true" /> Back to Home</a>
            </footer>
        </article>
    </main>

    <Footer />
</BaseLayout>
