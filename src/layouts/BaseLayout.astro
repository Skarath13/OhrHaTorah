---
import InlineEditor from '../components/admin/InlineEditor.astro';
import LoginModal from '../components/admin/LoginModal.astro';
import UnderConstructionModal from '../components/layout/UnderConstructionModal.astro';
import { mobileEntryScrollScript } from '../lib/mobileEntryScroll';

interface Props {
  title?: string;
  description?: string;
  stylesheets?: string[];
}
const {
  title = "Kehilat Ohr HaTorah Messianic Congregation",
  description = "Kehilat Ohr HaTorah is a Messianic Jewish congregation in Fountain Valley, California, welcoming Jewish and non-Jewish people to grow in Torah, Jewish life, and faith in Yeshua the Messiah.",
  stylesheets = [],
} = Astro.props;
const socialImage = new URL('/images/ohr-hatorah-social.png', Astro.url);
const stylesheetVersion = '20260811-safari-upcoming-2';
const versionStylesheet = (href: string) => {
  const separator = href.includes('?') ? '&' : '?';
  return `${href}${separator}v=${stylesheetVersion}`;
};
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="theme-color" content="#061d35">
    <meta name="theme-color" content="#061d35" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#031323" media="(prefers-color-scheme: dark)">
    <meta name="color-scheme" content="light">
    <script is:inline set:html={mobileEntryScrollScript}></script>
    <title>{title}</title>

    <!-- Favicon -->
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon.png">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">

    <!-- Open Graph Meta Tags for Social Media -->
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:image" content={socialImage}>
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:url" content={Astro.url.href}>
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Kehilat Ohr HaTorah Messianic Congregation">

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={socialImage}>

    <!-- Additional Meta Tags -->
    <meta name="description" content={description}>
    <meta name="keywords" content="Messianic Judaism, Jewish congregation, Yeshua, Jesus, Fountain Valley California, Orange County synagogue, Torah, Hebrew calendar, Jewish holidays">

    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">

    <!-- Stylesheets -->
    <link rel="stylesheet" href={versionStylesheet('/styles/style.css')}>
    {stylesheets.map((href) => <link rel="stylesheet" href={versionStylesheet(href)} />)}
    <link rel="stylesheet" href={versionStylesheet('/styles/chrome.css')}>
    <link rel="stylesheet" href={versionStylesheet('/styles/motion.css')}>
</head>
<body>
    <div id="top" aria-hidden="true"></div>
    <slot />
    <InlineEditor />
    <LoginModal />
    <UnderConstructionModal />
</body>
</html>
