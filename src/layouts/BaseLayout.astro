---
import InlineEditor from '../components/admin/InlineEditor.astro';
import LoginModal from '../components/admin/LoginModal.astro';
import UnderConstructionModal from '../components/layout/UnderConstructionModal.astro';

interface Props {
  title?: string;
  description?: string;
  bodyClass?: string;
  preloadImage?: string;
}
const {
  title = 'Ohr HaTorah Messianic Congregation',
  description = 'A Messianic Jewish congregation in Orange County, California, rooted in Torah and centered on Yeshua.',
  bodyClass = '',
  preloadImage,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, 'https://ohrhatorah.pages.dev').toString();
const socialImageUrl = new URL('/images/generated/oht-watercolor-hero.webp', canonicalUrl).toString();
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>{title}</title>
    <meta name="description" content={description}>
    <meta name="theme-color" content="#0B2440">
    <link rel="canonical" href={canonicalUrl}>
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high">}

    <!-- Favicon -->
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon.png">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">

    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:image" content={socialImageUrl}>
    <meta property="og:image:width" content="1717">
    <meta property="og:image:height" content="916">
    <meta property="og:url" content={canonicalUrl}>
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Ohr HaTorah Messianic Congregation">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={socialImageUrl}>

    <script is:inline>document.documentElement.classList.add('js');</script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&amp;family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400;1,6..72,500&amp;family=Noto+Serif+Hebrew:wght@400;500;600&amp;display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/styles/site.css">
</head>
<body class={bodyClass}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <slot />
    <InlineEditor />
    <LoginModal />
    <UnderConstructionModal />
</body>
</html>
