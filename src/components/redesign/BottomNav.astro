---
interface BottomItem {
  label: string;
  href: string;
  icon: 'home' | 'about' | 'visit' | 'connect' | 'give';
  featured: boolean;
}

interface Props {
  items: BottomItem[];
}

const { items } = Astro.props;

const icons: Record<BottomItem['icon'], string> = {
  home: '<path d="M3 11.5 12 4l9 7.5"/><path d="M5.5 10.5V20h13v-9.5"/><path d="M9.5 20v-6h5v6"/>',
  about: '<path d="m12 3 2.7 5.5 6.1.9-4.4 4.3 1 6.1L12 16.9 6.6 19.8l1-6.1-4.4-4.3 6.1-.9L12 3Z"/>',
  visit: '<path d="M12 4v13"/><path d="M5.5 6.5v3a6.5 6.5 0 0 0 13 0v-3"/><path d="M8.5 5.5V10a3.5 3.5 0 0 0 7 0V5.5"/><path d="M9 18h6"/><path d="M7.5 21h9"/><path d="M5.5 6.5h0M8.5 5.5h0M12 4h0M15.5 5.5h0M18.5 6.5h0"/>',
  connect: '<path d="M16 11a4 4 0 1 0-8 0"/><path d="M4 20a8 8 0 0 1 16 0"/><path d="M18 8.5a3 3 0 0 1 2 2.8"/><path d="M22 20a6.5 6.5 0 0 0-3.4-5.7"/><path d="M6 8.5a3 3 0 0 0-2 2.8"/><path d="M2 20a6.5 6.5 0 0 1 3.4-5.7"/>',
  give: '<path d="M20.8 5.8a5 5 0 0 0-7.1 0L12 7.5l-1.7-1.7a5 5 0 0 0-7.1 7.1L12 21.7l8.8-8.8a5 5 0 0 0 0-7.1Z"/>',
};
---
<nav class="bottom-nav" aria-label="Mobile quick navigation">
  {items.map(item => (
    <a class:list={['bottom-nav__item', { 'bottom-nav__item--featured': item.featured }]} href={item.href}>
      <svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons[item.icon]}></svg>
      <span>{item.label}</span>
    </a>
  ))}
</nav>
