---
// Navigation component with dropdown menus
---
<!-- Navigation Overlay -->
<div class="nav-overlay" id="nav-overlay" aria-hidden="true"></div>

<!-- Navigation -->
<nav class="nav-container" id="nav-container" aria-label="Primary navigation">
    <div class="nav-drawer-header">
        <button class="nav-close-btn" id="nav-close-btn" type="button" aria-label="Close navigation drawer">
            <i class="fas fa-times" aria-hidden="true"></i>
            <span>Close</span>
        </button>
    </div>

    <div class="nav-drawer-scroll" id="nav-drawer-scroll">
    <ul class="nav-links">
        <li class="dropdown">
            <div class="nav-item-row">
                <a href="/" class="nav-primary-link" aria-label="Go to home"><i class="fas fa-home"></i><span>Home</span></a>
                <button
                    id="welcome-header"
                    class="nav-disclosure"
                    type="button"
                    aria-label="Open Welcome submenu"
                    aria-haspopup="true"
                    aria-expanded="false"
                    aria-controls="nav-welcome-submenu"
                    data-nav-label="Home"
                    data-nav-disclosure
                >
                    <i class="fas fa-home nav-mobile-trigger-icon" aria-hidden="true"></i>
                    <span class="nav-mobile-trigger-label" aria-hidden="true">Home</span>
                    <span class="nav-chevron" aria-hidden="true">&#9660;</span>
                </button>
            </div>
            <div class="dropdown-content" id="nav-welcome-submenu">
                <a class="nav-mobile-page-link" href="/" aria-label="Home"><i class="fas fa-home"></i> Home</a>
                <a href="/about" aria-label="About Ohr HaTorah"><i class="fas fa-info-circle"></i> About Ohr HaTorah</a>
                <a href="/expect" aria-label="What to expect"><i class="fas fa-door-open"></i> What to expect</a>
                <a href="/mission" aria-label="Mission vision and values"><i class="fas fa-bullseye"></i> Mission, vision, and values</a>
                <a href="/location" aria-label="Our location"><i class="fas fa-map-marker-alt"></i> Our location</a>
                <a href="/faq" aria-label="FAQ"><i class="fas fa-question-circle"></i> FAQ</a>
                <a href="/umjc" aria-label="UMJC affiliation"><i class="fas fa-handshake"></i> UMJC affiliation</a>
            </div>
        </li>
        <li class="dropdown">
            <div class="nav-item-row">
                <a href="/services" class="nav-primary-link" aria-label="Events and services"><i class="fas fa-calendar-check"></i><span class="nav-label-default">Events &amp; Services</span><span class="nav-label-compact" aria-hidden="true">Services</span></a>
                <button
                    id="events-header"
                    class="nav-disclosure"
                    type="button"
                    aria-label="Open Events & Services submenu"
                    aria-haspopup="true"
                    aria-expanded="false"
                    aria-controls="nav-events-submenu"
                    data-nav-label="Events & Services"
                    data-nav-disclosure
                >
                    <i class="fas fa-calendar-check nav-mobile-trigger-icon" aria-hidden="true"></i>
                    <span class="nav-mobile-trigger-label" aria-hidden="true">Events &amp; Services</span>
                    <span class="nav-chevron" aria-hidden="true">&#9660;</span>
                </button>
            </div>
            <div class="dropdown-content" id="nav-events-submenu">
                <a href="/services" aria-label="Shabbat services"><i class="fas fa-star-of-david"></i> Shabbat services</a>
                <a href="/holidays" aria-label="Holidays"><i class="fas fa-calendar-day"></i> Holidays</a>
                <a href="/events" aria-label="Special events"><i class="fas fa-star"></i> Special events</a>
                <a href="/youth" aria-label="Shabbat School for youth"><i class="fas fa-child"></i> Shabbat School for youth</a>
            </div>
        </li>
        <li class="dropdown">
            <div class="nav-item-row">
                <button
                    id="community-header"
                    class="nav-primary-link nav-disclosure nav-disclosure-primary"
                    type="button"
                    aria-label="Open Community submenu"
                    aria-haspopup="true"
                    aria-expanded="false"
                    aria-controls="nav-community-submenu"
                    data-nav-label="Community"
                    data-nav-disclosure
                >
                    <i class="fas fa-users"></i>
                    <span>Community</span>
                    <span class="nav-chevron" aria-hidden="true">&#9660;</span>
                </button>
            </div>
            <div class="dropdown-content" id="nav-community-submenu">
                <a href="/#congregation-calendar" aria-label="Calendar"><i class="fas fa-calendar-alt"></i> Calendar</a>
                <a href="/israel" aria-label="Stand with Israel"><i class="fas fa-flag"></i> Stand with Israel</a>
            </div>
        </li>
        <li class="dropdown">
            <div class="nav-item-row">
                <a href="/resources" class="nav-primary-link" aria-label="Learn"><i class="fas fa-graduation-cap"></i><span>Learn</span></a>
                <button
                    id="learn-header"
                    class="nav-disclosure"
                    type="button"
                    aria-label="Open Learn submenu"
                    aria-haspopup="true"
                    aria-expanded="false"
                    aria-controls="nav-learn-submenu"
                    data-nav-label="Learn"
                    data-nav-disclosure
                >
                    <i class="fas fa-graduation-cap nav-mobile-trigger-icon" aria-hidden="true"></i>
                    <span class="nav-mobile-trigger-label" aria-hidden="true">Learn</span>
                    <span class="nav-chevron" aria-hidden="true">&#9660;</span>
                </button>
            </div>
            <div class="dropdown-content" id="nav-learn-submenu">
                <a href="/resources" aria-label="Messianic Jewish resources"><i class="fas fa-book-open"></i> Messianic Jewish resources</a>
                <a href="/#shabbat-activities-section" aria-label="Weekly Torah readings"><i class="fas fa-scroll"></i> Weekly Torah readings</a>
                <a href="/faq" aria-label="Questions about Messianic Judaism"><i class="fas fa-question-circle"></i> Common questions</a>
            </div>
        </li>
        <li class="dropdown">
            <div class="nav-item-row">
                <button
                    id="resources-header"
                    class="nav-primary-link nav-disclosure nav-disclosure-primary"
                    type="button"
                    aria-label="Open Resources submenu"
                    aria-haspopup="true"
                    aria-expanded="false"
                    aria-controls="nav-resources-submenu"
                    data-nav-label="Resources"
                    data-nav-disclosure
                >
                    <i class="fas fa-archive"></i>
                    <span>Resources</span>
                    <span class="nav-chevron" aria-hidden="true">&#9660;</span>
                </button>
            </div>
            <div class="dropdown-content" id="nav-resources-submenu">
                <a class="nav-mobile-page-link" href="/resources" aria-label="Resources overview"><i class="fas fa-book-open"></i> Resources overview</a>
                <a href="/umjc" aria-label="UMJC affiliation"><i class="fas fa-handshake"></i> UMJC affiliation</a>
                <a href="/#congregation-calendar" aria-label="Congregation calendar"><i class="fas fa-calendar-alt"></i> Congregation calendar</a>
            </div>
        </li>
        <li><a href="/contact" aria-label="Contact us"><i class="fas fa-envelope"></i><span class="nav-label-default">Contact Us</span><span class="nav-label-compact" aria-hidden="true">Contact</span></a></li>
        <li><a href="/donate" class="donate-btn" aria-label="Donate"><i class="fas fa-heart"></i><span>Donate</span></a></li>
    </ul>
    </div>
</nav>

<script>
    const navContainer = document.getElementById('nav-container');
    const navDrawerScroll = document.getElementById('nav-drawer-scroll');
    const mobileMenuQuery = window.matchMedia('(max-width: 1359px)');
    const navOverlay = document.getElementById('nav-overlay');
    const menuBtn = document.getElementById('mobile-menu-btn');
    const closeBtn = document.getElementById('nav-close-btn');
    const dropdownItems = Array.from(document.querySelectorAll<HTMLElement>('.nav-links .dropdown'));
    let previouslyFocusedElement: HTMLElement | null = null;
    let savedBodyOverflow: string | null = null;
    let savedDocumentOverflow: string | null = null;
    let savedBodyPosition: string | null = null;
    let savedBodyTop: string | null = null;
    let savedBodyWidth: string | null = null;
    let savedPageScrollY = 0;
    let focusEntryTimer: number | null = null;

    function setDropdownState(dropdown: HTMLElement | null, expanded: boolean) {
        if (!dropdown) return;

        dropdown.classList.toggle('active', expanded);

        const trigger = dropdown.querySelector<HTMLButtonElement>('[data-nav-disclosure]');
        trigger?.setAttribute('aria-expanded', String(expanded));
        if (trigger) {
            const navLabel = trigger.dataset.navLabel ?? 'navigation';
            trigger.setAttribute('aria-label', `${expanded ? 'Close' : 'Open'} ${navLabel} submenu`);
        }
    }

    function closeAllDropdowns(except: HTMLElement | null = null) {
        dropdownItems.forEach(dropdown => {
            if (dropdown !== except) setDropdownState(dropdown, false);
        });
    }

    function isMenuOpen() {
        return navContainer?.classList.contains('active') ?? false;
    }

    function setDrawerAccessibility(isOpen: boolean) {
        if (!navContainer || !mobileMenuQuery.matches) return;

        navContainer.setAttribute('aria-hidden', String(!isOpen));
        navContainer.toggleAttribute('inert', !isOpen);
        navOverlay?.setAttribute('aria-hidden', String(!isOpen));
    }

    function restoreBodyScroll() {
        if (savedBodyOverflow === null) return;
        document.body.style.overflow = savedBodyOverflow;
        document.documentElement.style.overflow = savedDocumentOverflow ?? '';
        document.body.style.position = savedBodyPosition ?? '';
        document.body.style.top = savedBodyTop ?? '';
        document.body.style.width = savedBodyWidth ?? '';
        savedBodyOverflow = null;
        savedDocumentOverflow = null;
        savedBodyPosition = null;
        savedBodyTop = null;
        savedBodyWidth = null;
        window.scrollTo(0, savedPageScrollY);
    }

    function openMenu() {
        if (!mobileMenuQuery.matches || !navContainer) return;

        previouslyFocusedElement = document.activeElement instanceof HTMLElement
            ? document.activeElement
            : menuBtn;
        savedBodyOverflow = document.body.style.overflow;
        savedDocumentOverflow = document.documentElement.style.overflow;
        savedBodyPosition = document.body.style.position;
        savedBodyTop = document.body.style.top;
        savedBodyWidth = document.body.style.width;
        savedPageScrollY = window.scrollY;

        closeAllDropdowns();
        if (navDrawerScroll) navDrawerScroll.scrollTop = 0;

        navContainer.classList.add('active');
        navOverlay?.classList.add('active');
        menuBtn?.classList.add('active');
        menuBtn?.setAttribute('aria-expanded', 'true');
        menuBtn?.setAttribute('aria-label', 'Close navigation menu');
        if (menuBtn instanceof HTMLButtonElement) menuBtn.hidden = true;
        setDrawerAccessibility(true);
        document.body.style.overflow = 'hidden';
        document.documentElement.style.overflow = 'hidden';
        document.body.style.position = 'fixed';
        document.body.style.top = `-${savedPageScrollY}px`;
        document.body.style.width = '100%';

        window.requestAnimationFrame(() => {
            if (navDrawerScroll) navDrawerScroll.scrollTop = 0;
        });

        if (focusEntryTimer !== null) window.clearTimeout(focusEntryTimer);
        focusEntryTimer = window.setTimeout(() => {
            if (isMenuOpen()) closeBtn?.focus({ preventScroll: true });
            focusEntryTimer = null;
        }, 75);
    }

    function closeMenu({ restoreFocus = true } = {}) {
        const wasOpen = isMenuOpen();

        if (focusEntryTimer !== null) {
            window.clearTimeout(focusEntryTimer);
            focusEntryTimer = null;
        }

        navContainer?.classList.remove('active');
        navOverlay?.classList.remove('active');
        menuBtn?.classList.remove('active');
        if (menuBtn instanceof HTMLButtonElement) menuBtn.hidden = false;
        menuBtn?.setAttribute('aria-expanded', 'false');
        menuBtn?.setAttribute('aria-label', 'Open navigation menu');
        closeAllDropdowns();
        restoreBodyScroll();

        if (mobileMenuQuery.matches) {
            setDrawerAccessibility(false);
        } else {
            navContainer?.removeAttribute('aria-hidden');
            navContainer?.removeAttribute('inert');
            navOverlay?.setAttribute('aria-hidden', 'true');
        }

        if (wasOpen && restoreFocus) {
            previouslyFocusedElement?.focus({ preventScroll: true });
        }
        previouslyFocusedElement = null;
    }

    function toggleMenu() {
        if (isMenuOpen()) {
            closeMenu();
        } else {
            openMenu();
        }
    }

    function getVisibleDrawerControls() {
        if (!navContainer) return [];

        return Array.from(navContainer.querySelectorAll<HTMLElement>(
            'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])'
        )).filter(element => element.getClientRects().length > 0);
    }

    function syncNavigationMode() {
        closeMenu({ restoreFocus: false });

        if (!mobileMenuQuery.matches) {
            navContainer?.removeAttribute('aria-hidden');
            navContainer?.removeAttribute('inert');
        }
    }

    menuBtn?.addEventListener('click', toggleMenu);
    closeBtn?.addEventListener('click', () => closeMenu());
    navOverlay?.addEventListener('click', () => closeMenu());

    document.querySelectorAll(
        '.dropdown-content a, .nav-item-row > a.nav-primary-link, .nav-links > li:not(.dropdown) > a'
    ).forEach(link => {
        link.addEventListener('click', () => {
            if (mobileMenuQuery.matches) {
                closeMenu({ restoreFocus: false });
            } else {
                closeAllDropdowns();
            }
        });
    });

    dropdownItems.forEach(dropdown => {
        const trigger = dropdown.querySelector<HTMLButtonElement>('[data-nav-disclosure]');
        if (!trigger) return;

        trigger.addEventListener('click', () => {
            const shouldExpand = !dropdown.classList.contains('active');
            closeAllDropdowns(dropdown);
            setDropdownState(dropdown, shouldExpand);
        });

        dropdown.addEventListener('focusout', () => {
            window.setTimeout(() => {
                if (!mobileMenuQuery.matches && !dropdown.contains(document.activeElement)) {
                    setDropdownState(dropdown, false);
                }
            }, 0);
        });

        dropdown.addEventListener('pointerleave', () => {
            if (!mobileMenuQuery.matches && !dropdown.contains(document.activeElement)) {
                setDropdownState(dropdown, false);
            }
        });
    });

    document.addEventListener('click', event => {
        if (!(event.target instanceof Element) || event.target.closest('.dropdown')) return;
        closeAllDropdowns();
    });

    document.addEventListener('keydown', event => {
        if (event.key === 'Escape') {
            if (mobileMenuQuery.matches && isMenuOpen()) {
                event.preventDefault();
                closeMenu();
            } else {
                const focusedDropdown = document.activeElement instanceof Element
                    ? document.activeElement.closest<HTMLElement>('.dropdown')
                    : null;
                closeAllDropdowns();

                if (focusedDropdown) {
                    focusedDropdown.querySelector<HTMLButtonElement>('[data-nav-disclosure]')?.focus();
                }
            }
            return;
        }

        if (event.key !== 'Tab' || !mobileMenuQuery.matches || !isMenuOpen()) return;

        const controls = getVisibleDrawerControls();
        if (controls.length === 0) return;

        const firstControl = controls[0];
        const lastControl = controls[controls.length - 1];

        if (event.shiftKey && document.activeElement === firstControl) {
            event.preventDefault();
            lastControl.focus();
        } else if (!event.shiftKey && document.activeElement === lastControl) {
            event.preventDefault();
            firstControl.focus();
        }
    }, true);

    mobileMenuQuery.addEventListener('change', syncNavigationMode);
    syncNavigationMode();
</script>
