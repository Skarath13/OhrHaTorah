---
import {
    IconBook2,
    IconCalendarEvent,
    IconChevronDown,
    IconDoorEnter,
    IconFlag,
    IconHeartHandshake,
    IconInfoCircle,
    IconJewishStar,
    IconLanguage,
    IconMail,
    IconMapPin,
    IconMenu2,
    IconSchool,
    IconTargetArrow,
    IconX,
} from '@tabler/icons-astro';

interface Props {
    currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
const active = (paths: string[]) => paths.some(path => currentPath === path || currentPath.startsWith(`${path}/`));
---

<div class="mobile-nav-bar">
    <a class="mobile-nav-bar__brand" href="/" aria-label="Kehilat Ohr HaTorah home">
        <img src="/images/logo.png" alt="" width="612" height="408" decoding="async">
        <span>Ohr HaTorah</span>
    </a>
    <a class="mobile-nav-bar__visit" href="/#visit">Visit</a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="primary-nav-panel" aria-label="Open navigation" data-nav-toggle>
        <IconMenu2 class="nav-toggle__open" size={25} stroke={1.7} aria-hidden="true" />
        <IconX class="nav-toggle__close" size={25} stroke={1.7} aria-hidden="true" />
        <span>Menu</span>
    </button>
</div>

<nav class="color-navigation" id="primary-nav-panel" aria-label="Primary navigation" data-nav-panel>
    <a class="nav-brand" href="/" aria-label="Kehilat Ohr HaTorah home">
        <img src="/images/logo.png" alt="" width="612" height="408" decoding="async">
        <span>
            <strong>Kehilat Ohr HaTorah</strong>
            <small>Orange County, California</small>
        </span>
    </a>

    <ul class="nav-links">
        <li class:list={['nav-item', 'nav-item--blue', { active: active(['/expect', '/location', '/faq']) }]}>
            <div class="nav-item__top">
                <a href="/expect">Visit <IconChevronDown class="nav-item__chevron" size={15} stroke={1.8} aria-hidden="true" /></a>
                <button type="button" class="nav-submenu-toggle" aria-expanded="false" aria-controls="nav-welcome-submenu" aria-label="Show Visit pages"><IconChevronDown aria-hidden="true" /></button>
            </div>
            <div class="dropdown-content" id="nav-welcome-submenu">
                <a href="/expect"><IconDoorEnter aria-hidden="true" /> What to Expect</a>
                <a href="/location"><IconMapPin aria-hidden="true" /> Location &amp; Directions</a>
                <a href="/faq"><IconInfoCircle aria-hidden="true" /> Frequently Asked Questions</a>
            </div>
        </li>

        <li class:list={['nav-item', 'nav-item--pink', { active: active(['/about', '/mission', '/umjc', '/israel']) }]}>
            <div class="nav-item__top">
                <a href="/about">About <IconChevronDown class="nav-item__chevron" size={15} stroke={1.8} aria-hidden="true" /></a>
                <button type="button" class="nav-submenu-toggle" aria-expanded="false" aria-controls="nav-community-submenu" aria-label="Show About pages"><IconChevronDown aria-hidden="true" /></button>
            </div>
            <div class="dropdown-content" id="nav-community-submenu">
                <a href="/about"><IconInfoCircle aria-hidden="true" /> Who We Are</a>
                <a href="/mission"><IconTargetArrow aria-hidden="true" /> Mission &amp; Values</a>
                <a href="/umjc"><IconHeartHandshake aria-hidden="true" /> UMJC Affiliation</a>
                <a href="/israel"><IconFlag aria-hidden="true" /> Stand With Israel</a>
            </div>
        </li>

        <li class:list={['nav-item', 'nav-item--mint', { active: active(['/services', '/holidays', '/youth']) }]}>
            <div class="nav-item__top">
                <a href="/services">Shabbat <IconChevronDown class="nav-item__chevron" size={15} stroke={1.8} aria-hidden="true" /></a>
                <button type="button" class="nav-submenu-toggle" aria-expanded="false" aria-controls="nav-events-submenu" aria-label="Show Shabbat pages"><IconChevronDown aria-hidden="true" /></button>
            </div>
            <div class="dropdown-content" id="nav-events-submenu">
                <a href="/services"><IconJewishStar aria-hidden="true" /> Shabbat Services</a>
                <a href="/holidays"><IconCalendarEvent aria-hidden="true" /> Jewish Holidays</a>
                <a href="/youth"><IconSchool aria-hidden="true" /> Shabbat School for Youth</a>
            </div>
        </li>

        <li class:list={['nav-item', 'nav-item--yellow', { active: active(['/events']) }]}>
            <div class="nav-item__top">
                <a href="/events">Calendar <IconChevronDown class="nav-item__chevron" size={15} stroke={1.8} aria-hidden="true" /></a>
                <button type="button" class="nav-submenu-toggle" aria-expanded="false" aria-controls="nav-calendar-submenu" aria-label="Show Calendar pages"><IconChevronDown aria-hidden="true" /></button>
            </div>
            <div class="dropdown-content" id="nav-calendar-submenu">
                <a href="/#congregation-calendar"><IconCalendarEvent aria-hidden="true" /> Congregation Calendar</a>
                <a href="/events"><IconCalendarEvent aria-hidden="true" /> Special Events</a>
            </div>
        </li>

        <li class:list={['nav-item', 'nav-item--lilac', { active: active(['/resources']) }]}>
            <div class="nav-item__top">
                <a href="/resources">Learn <IconChevronDown class="nav-item__chevron" size={15} stroke={1.8} aria-hidden="true" /></a>
                <button type="button" class="nav-submenu-toggle" aria-expanded="false" aria-controls="nav-learn-submenu" aria-label="Show Learning pages"><IconChevronDown aria-hidden="true" /></button>
            </div>
            <div class="dropdown-content" id="nav-learn-submenu">
                <a href="/#weekly-readings"><IconBook2 aria-hidden="true" /> This Week's Readings</a>
                <a href="/resources"><IconBook2 aria-hidden="true" /> Messianic Jewish Resources</a>
                <a href="/contact"><IconLanguage aria-hidden="true" /> Ask About Hebrew Classes</a>
            </div>
        </li>

        <li class:list={['nav-item', 'nav-item--peach', { active: active(['/contact']) }]}>
            <div class="nav-item__top">
                <a href="/contact" aria-current={active(['/contact']) ? 'page' : undefined}>Contact</a>
            </div>
        </li>

        <li class:list={['nav-item', 'nav-item--gold', { active: active(['/donate']) }]}>
            <div class="nav-item__top">
                <a href="/donate" aria-current={active(['/donate']) ? 'page' : undefined}>Give</a>
            </div>
        </li>
    </ul>
</nav>

<button class="nav-scrim" type="button" aria-label="Close navigation" data-nav-scrim hidden></button>

<script>
    const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
    const panel = document.querySelector<HTMLElement>('[data-nav-panel]');
    const scrim = document.querySelector<HTMLButtonElement>('[data-nav-scrim]');
    const submenuToggles = Array.from(document.querySelectorAll<HTMLButtonElement>('.nav-submenu-toggle'));
    const desktopMedia = window.matchMedia('(min-width: 1100px)');
    const pageRegions = [
        document.querySelector<HTMLElement>('main'),
        document.querySelector<HTMLElement>('.site-footer'),
        document.querySelector<HTMLElement>('.back-to-top'),
    ].filter((region): region is HTMLElement => Boolean(region));

    const closeSubmenus = (except?: HTMLButtonElement) => {
        submenuToggles.forEach(button => {
            if (button === except) return;
            button.setAttribute('aria-expanded', 'false');
            button.closest('.nav-item')?.classList.remove('submenu-open');
        });
    };

    const mobileFocusables = () => [
        toggle,
        ...Array.from(panel?.querySelectorAll<HTMLElement>('a[href], button:not([disabled])') ?? []),
    ].filter((element): element is HTMLElement => Boolean(element) && element.offsetParent !== null);

    const setOpen = (open: boolean, restoreFocus = false) => {
        if (!toggle || !panel || !scrim) return;
        const mobileOpen = open && !desktopMedia.matches;
        toggle.classList.toggle('is-open', mobileOpen);
        panel.classList.toggle('is-open', mobileOpen);
        toggle.setAttribute('aria-expanded', String(mobileOpen));
        toggle.setAttribute('aria-label', mobileOpen ? 'Close navigation' : 'Open navigation');
        const label = toggle.querySelector('span');
        if (label) label.textContent = mobileOpen ? 'Close' : 'Menu';
        scrim.hidden = !mobileOpen;
        document.body.classList.toggle('nav-open', mobileOpen);
        panel.inert = !desktopMedia.matches && !mobileOpen;
        pageRegions.forEach(region => { region.inert = mobileOpen; });

        if (mobileOpen) {
            requestAnimationFrame(() => panel.querySelector<HTMLAnchorElement>('.nav-links a')?.focus());
        } else {
            closeSubmenus();
            if (restoreFocus) toggle.focus();
        }
    };

    submenuToggles.forEach(button => {
        button.addEventListener('click', () => {
            const expanding = button.getAttribute('aria-expanded') !== 'true';
            closeSubmenus(button);
            button.setAttribute('aria-expanded', String(expanding));
            button.closest('.nav-item')?.classList.toggle('submenu-open', expanding);
        });
    });

    toggle?.addEventListener('click', () => setOpen(!panel?.classList.contains('is-open')));
    scrim?.addEventListener('click', () => setOpen(false, true));
    panel?.querySelectorAll('a[href]').forEach(link => {
        link.addEventListener('click', () => setOpen(false));
    });

    window.addEventListener('keydown', event => {
        if (event.key === 'Escape' && panel?.classList.contains('is-open')) {
            setOpen(false, true);
            return;
        }
        if (event.key !== 'Tab' || !panel?.classList.contains('is-open')) return;
        const focusables = mobileFocusables();
        const first = focusables[0];
        const last = focusables.at(-1);
        if (!first || !last) return;
        if (event.shiftKey && document.activeElement === first) {
            event.preventDefault();
            last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
            event.preventDefault();
            first.focus();
        }
    });

    desktopMedia.addEventListener('change', () => setOpen(false));
    setOpen(false);
</script>
