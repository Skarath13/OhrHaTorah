---
// Navigation component with dropdown menus
import Editable from '../content/Editable.astro';
---
<!-- Desktop navigation. Mobile uses MobileNavigation.astro so legacy desktop
     selectors can never affect the mobile drawer geometry. -->
<nav class="nav-container" id="nav-container" aria-label="Primary navigation">
    <ul class="nav-links">
        <li class="dropdown">
            <div class="nav-item-row">
                <button
                    id="welcome-header"
                    class="nav-primary-link nav-disclosure nav-disclosure-primary"
                    type="button"
                    aria-label="Welcome"
                    aria-expanded="false"
                    aria-controls="nav-welcome-submenu"
                    data-nav-disclosure
                >
                    <i class="fas fa-home" aria-hidden="true"></i>
                    <Editable field="nav.welcome" as="span">Welcome</Editable>
                    <i class="fas fa-chevron-down nav-chevron" aria-hidden="true"></i>
                </button>
            </div>
            <div class="dropdown-content" id="nav-welcome-submenu">
                <a href="/" aria-label="Home"><i class="fas fa-home"></i> <Editable field="nav.home" as="span">Home</Editable></a>
                <a href="/about" aria-label="About Kehilat Ohr HaTorah"><i class="fas fa-info-circle"></i> <Editable field="nav.about" as="span">About Kehilat Ohr HaTorah</Editable></a>
                <a href="/expect" aria-label="What to expect"><i class="fas fa-door-open"></i> <Editable field="nav.expect" as="span">What to expect</Editable></a>
                <a href="/mission" aria-label="Our identity, vision, commitments, and values"><i class="fas fa-bullseye"></i> <Editable field="nav.identity" as="span">Our identity</Editable></a>
                <a href="/#map" aria-label="Our location"><i class="fas fa-map-marker-alt"></i> <Editable field="nav.location" as="span">Our location</Editable></a>
                <a href="/faq" aria-label="FAQs"><i class="fas fa-question-circle"></i> <Editable field="nav.faq" as="span">FAQs</Editable></a>
                <a href="/umjc" aria-label="UMJC membership"><i class="fas fa-handshake"></i> <Editable field="nav.umjc" as="span">UMJC membership</Editable></a>
            </div>
        </li>
        <li class="dropdown">
            <div class="nav-item-row">
                <button
                    id="events-header"
                    class="nav-primary-link nav-disclosure nav-disclosure-primary"
                    type="button"
                    aria-label="Events & Services"
                    aria-expanded="false"
                    aria-controls="nav-events-submenu"
                    data-nav-disclosure
                >
                    <i class="fas fa-calendar-check" aria-hidden="true"></i>
                    <Editable field="nav.events" as="span" class="nav-label-default">Events &amp; Services</Editable>
                    <Editable field="nav.events-compact" as="span" class="nav-label-compact" aria-hidden="true">Services</Editable>
                    <i class="fas fa-chevron-down nav-chevron" aria-hidden="true"></i>
                </button>
            </div>
            <div class="dropdown-content" id="nav-events-submenu">
                <a href="/services" aria-label="Shabbat services"><i class="fas fa-star-of-david"></i> <Editable field="nav.services" as="span">Shabbat services</Editable></a>
                <a href="/holidays" aria-label="Holidays"><i class="fas fa-calendar-day"></i> <Editable field="nav.holidays" as="span">Holidays</Editable></a>
                <a href="/events" aria-label="Special events"><i class="fas fa-star"></i> <Editable field="nav.special-events" as="span">Special events</Editable></a>
                <a href="/youth" aria-label="Shabbat School for youth"><i class="fas fa-child"></i> <Editable field="nav.youth" as="span">Shabbat School for youth</Editable></a>
            </div>
        </li>
        <li class="dropdown">
            <div class="nav-item-row">
                <button
                    id="community-header"
                    class="nav-primary-link nav-disclosure nav-disclosure-primary"
                    type="button"
                    aria-label="Community"
                    aria-expanded="false"
                    aria-controls="nav-community-submenu"
                    data-nav-disclosure
                >
                    <i class="fas fa-users" aria-hidden="true"></i>
                    <Editable field="nav.community" as="span">Community</Editable>
                    <i class="fas fa-chevron-down nav-chevron" aria-hidden="true"></i>
                </button>
            </div>
            <div class="dropdown-content" id="nav-community-submenu">
                <a href="/#congregation-calendar" aria-label="Congregational Calendar"><i class="fas fa-calendar-alt"></i> <Editable field="nav.calendar" as="span">Congregational Calendar</Editable></a>
                <a href="/israel" aria-label="Stand with Israel"><i class="fas fa-flag"></i> <Editable field="nav.israel" as="span">Stand with Israel</Editable></a>
            </div>
        </li>
        <li class="dropdown">
            <div class="nav-item-row">
                <button
                    id="learn-header"
                    class="nav-primary-link nav-disclosure nav-disclosure-primary"
                    type="button"
                    aria-label="Learn"
                    aria-expanded="false"
                    aria-controls="nav-learn-submenu"
                    data-nav-disclosure
                >
                    <i class="fas fa-graduation-cap" aria-hidden="true"></i>
                    <Editable field="nav.learn" as="span">Learn</Editable>
                    <i class="fas fa-chevron-down nav-chevron" aria-hidden="true"></i>
                </button>
            </div>
            <div class="dropdown-content" id="nav-learn-submenu">
                <a href="/#shabbat-activities-section" aria-label="Weekly Torah readings"><i class="fas fa-scroll"></i> <Editable field="nav.torah-readings" as="span">Weekly Torah readings</Editable></a>
                <a href="/faq" aria-label="FAQs"><i class="fas fa-question-circle"></i> <Editable field="nav.faq" as="span">FAQs</Editable></a>
            </div>
        </li>
        <li class="dropdown">
            <div class="nav-item-row">
                <button
                    id="resources-header"
                    class="nav-primary-link nav-disclosure nav-disclosure-primary"
                    type="button"
                    aria-label="Resources"
                    aria-expanded="false"
                    aria-controls="nav-resources-submenu"
                    data-nav-disclosure
                >
                    <i class="fas fa-archive" aria-hidden="true"></i>
                    <Editable field="nav.resources" as="span">Resources</Editable>
                    <i class="fas fa-chevron-down nav-chevron" aria-hidden="true"></i>
                </button>
            </div>
            <div class="dropdown-content" id="nav-resources-submenu">
                <a href="/resources" aria-label="Messianic Jewish resources"><i class="fas fa-book-open"></i> <Editable field="nav.resources-list" as="span">Messianic Jewish resources</Editable></a>
                <a href="/umjc" aria-label="UMJC membership"><i class="fas fa-handshake"></i> <Editable field="nav.umjc" as="span">UMJC membership</Editable></a>
                <a href="/#congregation-calendar" aria-label="Congregational Calendar"><i class="fas fa-calendar-alt"></i> <Editable field="nav.calendar" as="span">Congregational Calendar</Editable></a>
            </div>
        </li>
        <li><a href="/contact" aria-label="Contact us"><i class="fas fa-envelope"></i><Editable field="nav.contact-us" as="span" class="nav-label-default">Contact Us</Editable><Editable field="nav.contact" as="span" class="nav-label-compact" aria-hidden="true">Contact</Editable></a></li>
        <li><a href="/donate" class="donate-btn" aria-label="Donate"><i class="fas fa-heart"></i><Editable field="nav.donate" as="span">Donate</Editable></a></li>
    </ul>
</nav>

<script>
    const navigation = document.getElementById('nav-container');
    const dropdownItems = Array.from(navigation?.querySelectorAll<HTMLElement>('.dropdown') ?? []);
    const desktopNavQuery = window.matchMedia('(min-width: 1360px)');
    const hoverOpenedDropdowns = new Set<HTMLElement>();
    // A cursor passing over the bar should not unroll every menu it crosses.
    const HOVER_INTENT_MS = 100;
    let hoverIntentTimer = 0;
    // A menu closed by the pointer this recently means the visitor is moving tab to tab.
    const SWITCH_WINDOW_MS = 250;
    let lastHoverCloseAt = -Infinity;

    function cancelHoverIntent() {
        window.clearTimeout(hoverIntentTimer);
        hoverIntentTimer = 0;
    }

    // Moving from one open menu to the next plays the shorter unroll.
    function markSwitching(switching: boolean) {
        if (!navigation) return;
        if (switching) navigation.setAttribute('data-nav-switching', '');
        else navigation.removeAttribute('data-nav-switching');
    }

    // The rolled edge sits outside the clipped panel, so it needs the panel size.
    function measureScroll(dropdown: HTMLElement) {
        const panel = dropdown.querySelector<HTMLElement>('.dropdown-content');
        if (!panel) return;
        dropdown.style.setProperty('--scroll-h', `${panel.offsetHeight}px`);
        dropdown.style.setProperty('--scroll-w', `${panel.offsetWidth}px`);
    }

    function setDropdownState(dropdown: HTMLElement | null, expanded: boolean) {
        if (!dropdown) return;

        if (expanded) measureScroll(dropdown);
        dropdown.classList.toggle('active', expanded);

        const trigger = dropdown.querySelector<HTMLButtonElement>('[data-nav-disclosure]');
        trigger?.setAttribute('aria-expanded', String(expanded));
        if (!expanded) hoverOpenedDropdowns.delete(dropdown);
    }

    function closeAllDropdowns(except: HTMLElement | null = null) {
        dropdownItems.forEach(dropdown => {
            if (dropdown !== except) setDropdownState(dropdown, false);
        });
    }

    dropdownItems.forEach(dropdown => {
        const trigger = dropdown.querySelector<HTMLButtonElement>('[data-nav-disclosure]');
        if (!trigger) return;

        trigger.addEventListener('click', () => {
            cancelHoverIntent();
            markSwitching(false);
            // The first click keeps a hover-opened menu open; a second closes it.
            const shouldExpand = !dropdown.classList.contains('active') || hoverOpenedDropdowns.has(dropdown);
            hoverOpenedDropdowns.delete(dropdown);
            closeAllDropdowns(dropdown);
            setDropdownState(dropdown, shouldExpand);
        });

        dropdown.addEventListener('pointerenter', event => {
            if (!desktopNavQuery.matches || event.pointerType !== 'mouse') return;
            cancelHoverIntent();
            if (dropdown.classList.contains('active')) return;

            const open = () => {
                hoverIntentTimer = 0;
                const anotherIsOpen = dropdownItems.some(item => item !== dropdown && item.classList.contains('active'));
                markSwitching(anotherIsOpen || performance.now() - lastHoverCloseAt < SWITCH_WINDOW_MS);
                closeAllDropdowns(dropdown);
                setDropdownState(dropdown, true);
                hoverOpenedDropdowns.add(dropdown);
            };

            const moving = dropdownItems.some(item => item.classList.contains('active'))
                || performance.now() - lastHoverCloseAt < SWITCH_WINDOW_MS;
            if (moving) open();
            else hoverIntentTimer = window.setTimeout(open, HOVER_INTENT_MS);
        });

        dropdown.addEventListener('focusout', () => {
            window.setTimeout(() => {
                if (!dropdown.contains(document.activeElement)) {
                    setDropdownState(dropdown, false);
                }
            }, 0);
        });

        dropdown.addEventListener('pointerleave', () => {
            cancelHoverIntent();
            if (!dropdown.contains(document.activeElement)) {
                if (dropdown.classList.contains('active')) lastHoverCloseAt = performance.now();
                setDropdownState(dropdown, false);
            }
        });
    });

    document.addEventListener('click', event => {
        if (!(event.target instanceof Element)) return;
        if (!navigation?.contains(event.target) || event.target.closest('a[href]')) {
            closeAllDropdowns();
        }
    });

    document.addEventListener('keydown', event => {
        if (event.key !== 'Escape') return;

        const focusedDropdown = document.activeElement instanceof Element
            ? document.activeElement.closest<HTMLElement>('.dropdown')
            : null;
        const wasExpanded = focusedDropdown?.classList.contains('active');
        closeAllDropdowns();

        if (focusedDropdown && wasExpanded) {
            event.preventDefault();
            focusedDropdown.querySelector<HTMLButtonElement>('[data-nav-disclosure]')?.focus();
        }
    });

    desktopNavQuery.addEventListener('change', () => closeAllDropdowns());
    window.addEventListener('resize', () => dropdownItems.forEach(measureScroll));
    dropdownItems.forEach(measureScroll);
    // CSS hover/focus is a fallback only; enhanced menus share one visible/ARIA state.
    navigation?.setAttribute('data-nav-enhanced', '');
</script>
