---
// Navigation component with dropdown menus
---
<!-- Desktop navigation. Mobile uses MobileNavigation.astro so legacy desktop
     selectors can never affect the mobile drawer geometry. -->
<nav class="nav-container" id="nav-container" aria-label="Primary navigation">
    <ul class="nav-links">
        <li class="dropdown">
            <div class="nav-item-row">
                <button
                    id="welcome-header"
                    class="nav-primary-link nav-disclosure nav-disclosure-primary"
                    type="button"
                    aria-label="Welcome"
                    aria-expanded="false"
                    aria-controls="nav-welcome-submenu"
                    data-nav-disclosure
                >
                    <i class="fas fa-home" aria-hidden="true"></i>
                    <span>Welcome</span>
                    <i class="fas fa-chevron-down nav-chevron" aria-hidden="true"></i>
                </button>
            </div>
            <div class="dropdown-content" id="nav-welcome-submenu">
                <a href="/" aria-label="Home"><i class="fas fa-home"></i> Home</a>
                <a href="/about" aria-label="About Kehilat Ohr HaTorah"><i class="fas fa-info-circle"></i> About Kehilat Ohr HaTorah</a>
                <a href="/expect" aria-label="What to expect"><i class="fas fa-door-open"></i> What to expect</a>
                <a href="/mission" aria-label="Our identity, vision, commitments, and values"><i class="fas fa-bullseye"></i> Our identity</a>
                <a href="/#map" aria-label="Our location"><i class="fas fa-map-marker-alt"></i> Our location</a>
                <a href="/faq" aria-label="FAQs"><i class="fas fa-question-circle"></i> FAQs</a>
                <a href="/umjc" aria-label="UMJC membership"><i class="fas fa-handshake"></i> UMJC membership</a>
            </div>
        </li>
        <li class="dropdown">
            <div class="nav-item-row">
                <button
                    id="events-header"
                    class="nav-primary-link nav-disclosure nav-disclosure-primary"
                    type="button"
                    aria-label="Events & Services"
                    aria-expanded="false"
                    aria-controls="nav-events-submenu"
                    data-nav-disclosure
                >
                    <i class="fas fa-calendar-check" aria-hidden="true"></i>
                    <span class="nav-label-default">Events &amp; Services</span>
                    <span class="nav-label-compact" aria-hidden="true">Services</span>
                    <i class="fas fa-chevron-down nav-chevron" aria-hidden="true"></i>
                </button>
            </div>
            <div class="dropdown-content" id="nav-events-submenu">
                <a href="/services" aria-label="Shabbat services"><i class="fas fa-star-of-david"></i> Shabbat services</a>
                <a href="/holidays" aria-label="Holidays"><i class="fas fa-calendar-day"></i> Holidays</a>
                <a href="/events" aria-label="Special events"><i class="fas fa-star"></i> Special events</a>
                <a href="/youth" aria-label="Shabbat School for youth"><i class="fas fa-child"></i> Shabbat School for youth</a>
            </div>
        </li>
        <li class="dropdown">
            <div class="nav-item-row">
                <button
                    id="community-header"
                    class="nav-primary-link nav-disclosure nav-disclosure-primary"
                    type="button"
                    aria-label="Community"
                    aria-expanded="false"
                    aria-controls="nav-community-submenu"
                    data-nav-disclosure
                >
                    <i class="fas fa-users" aria-hidden="true"></i>
                    <span>Community</span>
                    <i class="fas fa-chevron-down nav-chevron" aria-hidden="true"></i>
                </button>
            </div>
            <div class="dropdown-content" id="nav-community-submenu">
                <a href="/#congregation-calendar" aria-label="Congregational Calendar"><i class="fas fa-calendar-alt"></i> Congregational Calendar</a>
                <a href="/israel" aria-label="Stand with Israel"><i class="fas fa-flag"></i> Stand with Israel</a>
            </div>
        </li>
        <li class="dropdown">
            <div class="nav-item-row">
                <button
                    id="learn-header"
                    class="nav-primary-link nav-disclosure nav-disclosure-primary"
                    type="button"
                    aria-label="Learn"
                    aria-expanded="false"
                    aria-controls="nav-learn-submenu"
                    data-nav-disclosure
                >
                    <i class="fas fa-graduation-cap" aria-hidden="true"></i>
                    <span>Learn</span>
                    <i class="fas fa-chevron-down nav-chevron" aria-hidden="true"></i>
                </button>
            </div>
            <div class="dropdown-content" id="nav-learn-submenu">
                <a href="/#shabbat-activities-section" aria-label="Weekly Torah readings"><i class="fas fa-scroll"></i> Weekly Torah readings</a>
                <a href="/faq" aria-label="FAQs"><i class="fas fa-question-circle"></i> FAQs</a>
            </div>
        </li>
        <li class="dropdown">
            <div class="nav-item-row">
                <button
                    id="resources-header"
                    class="nav-primary-link nav-disclosure nav-disclosure-primary"
                    type="button"
                    aria-label="Resources"
                    aria-expanded="false"
                    aria-controls="nav-resources-submenu"
                    data-nav-disclosure
                >
                    <i class="fas fa-archive" aria-hidden="true"></i>
                    <span>Resources</span>
                    <i class="fas fa-chevron-down nav-chevron" aria-hidden="true"></i>
                </button>
            </div>
            <div class="dropdown-content" id="nav-resources-submenu">
                <a href="/resources" aria-label="Messianic Jewish resources"><i class="fas fa-book-open"></i> Messianic Jewish resources</a>
                <a href="/umjc" aria-label="UMJC membership"><i class="fas fa-handshake"></i> UMJC membership</a>
                <a href="/#congregation-calendar" aria-label="Congregational Calendar"><i class="fas fa-calendar-alt"></i> Congregational Calendar</a>
            </div>
        </li>
        <li><a href="/contact" aria-label="Contact us"><i class="fas fa-envelope"></i><span class="nav-label-default">Contact Us</span><span class="nav-label-compact" aria-hidden="true">Contact</span></a></li>
        <li><a href="/donate" class="donate-btn" aria-label="Donate"><i class="fas fa-heart"></i><span>Donate</span></a></li>
    </ul>
</nav>

<script>
    const navigation = document.getElementById('nav-container');
    const dropdownItems = Array.from(navigation?.querySelectorAll<HTMLElement>('.dropdown') ?? []);
    const desktopNavQuery = window.matchMedia('(min-width: 1360px)');
    const hoverOpenedDropdowns = new Set<HTMLElement>();

    function setDropdownState(dropdown: HTMLElement | null, expanded: boolean) {
        if (!dropdown) return;

        dropdown.classList.toggle('active', expanded);

        const trigger = dropdown.querySelector<HTMLButtonElement>('[data-nav-disclosure]');
        trigger?.setAttribute('aria-expanded', String(expanded));
        if (!expanded) hoverOpenedDropdowns.delete(dropdown);
    }

    function closeAllDropdowns(except: HTMLElement | null = null) {
        dropdownItems.forEach(dropdown => {
            if (dropdown !== except) setDropdownState(dropdown, false);
        });
    }

    dropdownItems.forEach(dropdown => {
        const trigger = dropdown.querySelector<HTMLButtonElement>('[data-nav-disclosure]');
        if (!trigger) return;

        trigger.addEventListener('click', () => {
            // The first click keeps a hover-opened menu open; a second closes it.
            const shouldExpand = !dropdown.classList.contains('active') || hoverOpenedDropdowns.has(dropdown);
            hoverOpenedDropdowns.delete(dropdown);
            closeAllDropdowns(dropdown);
            setDropdownState(dropdown, shouldExpand);
        });

        dropdown.addEventListener('pointerenter', event => {
            if (!desktopNavQuery.matches || event.pointerType !== 'mouse') return;
            closeAllDropdowns(dropdown);
            if (!dropdown.classList.contains('active')) {
                setDropdownState(dropdown, true);
                hoverOpenedDropdowns.add(dropdown);
            }
        });

        dropdown.addEventListener('focusout', () => {
            window.setTimeout(() => {
                if (!dropdown.contains(document.activeElement)) {
                    setDropdownState(dropdown, false);
                }
            }, 0);
        });

        dropdown.addEventListener('pointerleave', () => {
            if (!dropdown.contains(document.activeElement)) {
                setDropdownState(dropdown, false);
            }
        });
    });

    document.addEventListener('click', event => {
        if (!(event.target instanceof Element)) return;
        if (!navigation?.contains(event.target) || event.target.closest('a[href]')) {
            closeAllDropdowns();
        }
    });

    document.addEventListener('keydown', event => {
        if (event.key !== 'Escape') return;

        const focusedDropdown = document.activeElement instanceof Element
            ? document.activeElement.closest<HTMLElement>('.dropdown')
            : null;
        const wasExpanded = focusedDropdown?.classList.contains('active');
        closeAllDropdowns();

        if (focusedDropdown && wasExpanded) {
            event.preventDefault();
            focusedDropdown.querySelector<HTMLButtonElement>('[data-nav-disclosure]')?.focus();
        }
    });

    desktopNavQuery.addEventListener('change', () => closeAllDropdowns());
    // CSS hover/focus is a fallback only; enhanced menus share one visible/ARIA state.
    navigation?.setAttribute('data-nav-enhanced', '');
</script>
