---
interface Props {
  tagline?: string;
  unity?: string;
}

const {
  tagline = 'One people. One heart.',
  unity = 'Am Yisrael. Am Echad.',
} = Astro.props;
---
<footer class="site-footer">
  <div>
    <p class="script-line" data-cms-key="home.footer.unity">{unity}</p>
    <p data-cms-key="home.footer.tagline">{tagline}</p>
  </div>
  <div class="footer-links" aria-label="Footer links">
    <a href="/contact">Contact</a>
    <a href="/services">Services</a>
    <a href="/donate">Give</a>
    <a href="/admin">Admin</a>
  </div>
</footer>
