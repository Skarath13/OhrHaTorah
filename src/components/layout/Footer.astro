---
import { IconArrowRight, IconArrowUp, IconExternalLink } from '@tabler/icons-astro';

const year = new Date().getFullYear();
---

<footer class="site-footer">
    <div class="site-footer__inner">
        <div class="site-footer__grid">
            <section class="site-footer__brand" aria-label="Ohr HaTorah">
                <img src="/images/logo.png" alt="Kehilat Ohr HaTorah Messianic Synagogue" width="612" height="408" decoding="async">
                <p>Torah and Messiah, together as one, in the heart of Orange County.</p>
                <button type="button" class="admin-access" id="adminLoginLink">Admin access</button>
            </section>

            <nav aria-label="Explore">
                <strong>Explore</strong>
                <a href="/about">Who we are</a>
                <a href="/mission">Mission &amp; values</a>
                <a href="/services">Shabbat services</a>
                <a href="/events">Gatherings</a>
                <a href="/resources">Learning resources</a>
                <a href="/umjc">UMJC affiliation</a>
            </nav>

            <section class="site-footer__contact">
                <strong>Visit &amp; contact</strong>
                <address>10460 Slater Ave<br>Fountain Valley, CA 92708</address>
                <a href="tel:+17144061513">(714) 406-1513</a>
                <a href="mailto:OhrHaTorahOC@gmail.com">OhrHaTorahOC@gmail.com</a>
                <a href="https://www.google.com/maps/dir/?api=1&amp;destination=Kehilat+OhrHaTorah+Messianic+Jewish+Synagogue,+10460+Slater+Ave,+Fountain+Valley,+CA+92708" target="_blank" rel="noopener noreferrer">Get directions <IconExternalLink size={16} stroke={1.8} aria-hidden="true" /><span class="sr-only"> (opens in a new tab)</span></a>
            </section>

            <section class="site-footer__newsletter">
                <strong>Congregation updates</strong>
                <p>Events, teachings, and community news.</p>
                <form id="newsletter-form">
                    <input type="hidden" name="access_key" value="d3f52dee-3156-4b82-a76a-fe9bbf9eb30e">
                    <input type="hidden" name="subject" value="New Newsletter Subscription - Ohr HaTorah">
                    <input type="hidden" name="from_name" value="Ohr HaTorah Website">
                    <label class="site-footer__email"><span>Email address</span><input type="email" name="email" autocomplete="email" placeholder="you@example.com" required></label>
                    <button type="submit">Request updates <IconArrowRight size={18} stroke={1.8} aria-hidden="true" /></button>
                    <p id="newsletter-status" class="form-status" aria-live="polite"></p>
                </form>
            </section>
        </div>

        <div class="site-footer__bar">
            <p>© {year} Kehilat Ohr HaTorah. All rights reserved.</p>
            <p>Messianic Jewish congregation · Orange County, California</p>
        </div>
    </div>
</footer>

<button type="button" class="back-to-top" id="backToTop" aria-label="Back to top"><IconArrowUp size={20} stroke={1.8} aria-hidden="true" /></button>

<script>
    const backToTopButton = document.querySelector<HTMLButtonElement>('#backToTop');
    const updateBackToTop = () => backToTopButton?.classList.toggle('visible', window.scrollY > 480);
    window.addEventListener('scroll', updateBackToTop, { passive: true });
    updateBackToTop();

    backToTopButton?.addEventListener('click', event => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
    });

    const newsletterForm = document.querySelector<HTMLFormElement>('#newsletter-form');
    const statusElement = document.querySelector<HTMLElement>('#newsletter-status');

    newsletterForm?.addEventListener('submit', async event => {
        event.preventDefault();
        const submitButton = newsletterForm.querySelector<HTMLButtonElement>('button[type="submit"]');
        if (!submitButton || !statusElement) return;

        submitButton.disabled = true;
            statusElement.textContent = 'Sending request…';
        statusElement.dataset.state = 'loading';

        try {
            const response = await fetch('https://api.web3forms.com/submit', {
                method: 'POST',
                body: new FormData(newsletterForm),
            });
            const result = await response.json() as { success?: boolean };
            if (!response.ok || !result.success) throw new Error('Newsletter request failed');
            newsletterForm.reset();
            statusElement.textContent = 'Thank you — your request was sent.';
            statusElement.dataset.state = 'success';
        } catch {
            statusElement.textContent = 'Unable to send the request right now. Please email us instead.';
            statusElement.dataset.state = 'error';
        } finally {
            submitButton.disabled = false;
        }
    });
</script>
