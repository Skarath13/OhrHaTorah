---
// Footer component
import {
    congregationName,
    officialIdentityStatementRemainder,
} from '../../data/congregationIdentity';
import { UPDATE_REQUEST_CONSENT } from '../../lib/updateRequests';

const currentYear = new Date().getFullYear();
const turnstileSiteKey = Astro.locals.runtime?.env?.TURNSTILE_SITE_KEY ?? '';
const updateRequestId = crypto.randomUUID();
---
<footer class="footer site-footer">
    <div class="footer-content">
        <div class="footer-grid">
            <div class="footer-col">
                <h4><i class="fas fa-star-of-david" aria-hidden="true"></i><strong>{congregationName}</strong></h4>
                <p><strong>{congregationName}</strong>{officialIdentityStatementRemainder}</p>
            </div>

            <div class="footer-col">
                <h4><i class="fas fa-link"></i> Quick links</h4>
                <ul class="footer-links">
                    <li><a href="/about"><i class="fas fa-chevron-right"></i> About us</a></li>
                    <li><a href="/services"><i class="fas fa-chevron-right"></i> Shabbat services</a></li>
                    <li><a href="/#upcoming-dates"><i class="fas fa-chevron-right"></i> Upcoming dates</a></li>
                    <li><a href="/resources"><i class="fas fa-chevron-right"></i> Resources</a></li>
                    <li><a href="/donate"><i class="fas fa-chevron-right"></i> Donate</a></li>
                    <li><a href="/contact"><i class="fas fa-chevron-right"></i> Contact</a></li>
                    <li><a href="#" id="adminLoginLink"><i class="fas fa-chevron-right"></i> Admin</a></li>
                </ul>
            </div>

            <div class="footer-col">
                <h4><i class="fas fa-envelope"></i> Stay connected</h4>
                <p>Stay in the loop with a friendly weekly email about gatherings and community news, plus occasional important updates.</p>
                <form id="newsletter-form" class="newsletter-form-expanded" method="post" action="/api/update-requests">
                    <input type="hidden" name="submissionId" value={updateRequestId}>
                    <input type="text" name="website" class="newsletter-botcheck" tabindex="-1" autocomplete="off" aria-hidden="true">

                    <div class="newsletter-name-fields">
                        <label class="newsletter-field">
                            <span class="newsletter-field-label">First name <span aria-hidden="true">*</span></span>
                            <input type="text" name="firstName" required maxlength="80" autocomplete="given-name">
                        </label>
                        <label class="newsletter-field">
                            <span class="newsletter-field-label">Last name <span aria-hidden="true">*</span></span>
                            <input type="text" name="lastName" required maxlength="80" autocomplete="family-name">
                        </label>
                    </div>
                    <label class="newsletter-field">
                        <span class="newsletter-field-label">Email address <span aria-hidden="true">*</span></span>
                        <input type="email" name="email" required maxlength="254" autocomplete="email" aria-describedby="newsletter-privacy">
                    </label>
                    <label class="newsletter-field">
                        <span class="newsletter-field-label">Phone number <span class="newsletter-optional">(optional)</span></span>
                        <input type="tel" name="phone" maxlength="40" autocomplete="tel" inputmode="tel">
                    </label>
                    <label class="newsletter-consent">
                        <input type="checkbox" name="consent" value="true" required>
                        <span>
                            {UPDATE_REQUEST_CONSENT.permission} {UPDATE_REQUEST_CONSENT.frequency}
                            {UPDATE_REQUEST_CONSENT.termsLead} <a href="/website-use#email-updates">{UPDATE_REQUEST_CONSENT.termsLabel}</a> {UPDATE_REQUEST_CONSENT.termsEffective}
                            {UPDATE_REQUEST_CONSENT.privacyLead} <a href="/privacy">{UPDATE_REQUEST_CONSENT.privacyLabel}</a>{UPDATE_REQUEST_CONSENT.ending}
                        </span>
                    </label>
                    {turnstileSiteKey ? (
                        <div class="newsletter-turnstile">
                            <div
                                class="cf-turnstile"
                                data-sitekey={turnstileSiteKey}
                                data-action="updates_request"
                                data-theme="dark"
                                data-size="flexible"
                                data-appearance="interaction-only"
                                data-response-field-name="turnstileToken"
                            ></div>
                        </div>
                    ) : (
                        <p class="newsletter-unavailable" role="status">Update requests are temporarily unavailable.</p>
                    )}
                    <p id="newsletter-privacy" class="newsletter-privacy">Protected and delivered through Cloudflare. The optional phone field does not enroll you in text messages or automated calls.</p>
                    <button type="submit" class="newsletter-btn-full" disabled={!turnstileSiteKey}>
                        Request weekly emails <i class="fas fa-arrow-right"></i>
                    </button>
                    <p id="newsletter-status" class="form-status" role="status" aria-live="polite"></p>
                </form>
            </div>

            <div class="footer-col">
                <h4><i class="fas fa-map-marker-alt"></i> Contact</h4>
                <ul class="footer-contact">
                    <li>
                        <i class="fas fa-envelope" aria-hidden="true"></i>
                        <span class="footer-contact-copy">OhrHaTorahOC@gmail.com</span>
                    </li>
                    <li>
                        <i class="fas fa-phone" aria-hidden="true"></i>
                        <span class="footer-contact-copy">(714) 406-1513</span>
                    </li>
                    <li>
                        <i class="fas fa-map-marker-alt" aria-hidden="true"></i>
                        <span class="footer-contact-copy"><strong>Services:</strong> 10460 Slater Ave<br>Fountain Valley, CA 92708</span>
                    </li>
                    <li>
                        <i class="fas fa-map-marker-alt" aria-hidden="true"></i>
                        <span class="footer-contact-copy"><strong>Mailing:</strong> 360 E. 1st Street, #856<br>Tustin, CA 92780</span>
                    </li>
                </ul>
            </div>
        </div>

        <div class="footer-bottom">
            <p>&copy; {currentYear} <strong>{congregationName}</strong>. All rights reserved.</p>
            <nav class="footer-legal" aria-label="Website policies">
                <a href="/privacy">Privacy</a>
                <a href="/website-use">Terms &amp; Conditions</a>
                <a href="/accessibility">Accessibility</a>
                <a href="/website-use#copyright-sources">Copyright &amp; sources</a>
            </nav>
        </div>
    </div>
</footer>

<!-- Back to Top Button -->
<a href="#top" class="back-to-top" id="backToTop" aria-label="Back to top">
    <i class="fas fa-chevron-up"></i>
</a>

{turnstileSiteKey && (
    <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
)}

<script>
    const backToTopButton = document.getElementById('backToTop');

    if (backToTopButton) {
        window.addEventListener('scroll', function() {
            if (window.pageYOffset > 300) {
                backToTopButton.classList.add('visible');
            } else {
                backToTopButton.classList.remove('visible');
            }
        });

        backToTopButton.addEventListener('click', function(e) {
            e.preventDefault();
            window.scrollTo({
                top: 0,
                behavior: 'smooth'
            });
        });

        const footer = document.querySelector('.footer');
        if (footer) {
            let footerOffsetFrame = 0;
            const updateFooterOffset = () => {
                footerOffsetFrame = 0;
                const rect = footer.getBoundingClientRect();
                const visibleHeight = Math.max(0, Math.min(window.innerHeight, rect.bottom) - Math.max(0, rect.top));

                if (visibleHeight > 0) {
                    const clearance = Math.ceil(visibleHeight) + 18;
                    backToTopButton.style.setProperty('bottom', `${clearance}px`, 'important');
                } else {
                    backToTopButton.style.removeProperty('bottom');
                }
            };
            const scheduleFooterOffset = () => {
                if (footerOffsetFrame) return;
                footerOffsetFrame = window.requestAnimationFrame(updateFooterOffset);
            };

            window.addEventListener('scroll', scheduleFooterOffset, { passive: true });
            window.addEventListener('resize', scheduleFooterOffset);
            scheduleFooterOffset();
        }
    }

    // Email-updates request submission
    const newsletterForm = document.getElementById('newsletter-form');
    const statusEl = document.getElementById('newsletter-status');

    if (newsletterForm instanceof HTMLFormElement && statusEl) {
        newsletterForm.addEventListener('submit', async function(e) {
            e.preventDefault();
            const formData = new FormData(this);
            const submitBtn = this.querySelector('button[type="submit"]');
            const turnstileToken = String(formData.get('turnstileToken') || '');

            if (!turnstileToken) {
                statusEl.textContent = 'Please complete the security check and try again.';
                statusEl.className = 'form-status error';
                return;
            }

            statusEl.textContent = 'Sending your request…';
            statusEl.className = 'form-status loading';
            if (submitBtn instanceof HTMLButtonElement) submitBtn.disabled = true;

            try {
                const response = await fetch(this.action, {
                    method: 'POST',
                    headers: {
                        'Accept': 'application/json',
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        submissionId: formData.get('submissionId'),
                        firstName: formData.get('firstName'),
                        lastName: formData.get('lastName'),
                        email: formData.get('email'),
                        phone: formData.get('phone'),
                        consent: formData.get('consent') === 'true',
                        website: formData.get('website'),
                        turnstileToken,
                    }),
                });
                const data = await response.json().catch(() => null);

                if (response.ok && data?.success) {
                    statusEl.textContent = 'Your update request was received.';
                    statusEl.className = 'form-status success';
                    newsletterForm.reset();
                    const requestIdInput = newsletterForm.elements.namedItem('submissionId');
                    if (requestIdInput instanceof HTMLInputElement) requestIdInput.value = crypto.randomUUID();
                } else {
                    statusEl.textContent = data?.message || (response.status === 429
                        ? 'Please wait a little while before trying again.'
                        : 'We could not receive your request. Please try again.');
                    statusEl.className = 'form-status error';
                }
            } catch (error) {
                statusEl.textContent = 'We could not receive your request. Please try again.';
                statusEl.className = 'form-status error';
            } finally {
                if (submitBtn instanceof HTMLButtonElement) submitBtn.disabled = false;
                const turnstileApi = (window as Window & { turnstile?: { reset: () => void } }).turnstile;
                turnstileApi?.reset();
            }
        });
    }
</script>
