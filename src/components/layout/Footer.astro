---
// Footer component
import {
    congregationName,
    officialIdentityStatementRemainder,
} from '../../data/congregationIdentity';
import { UPDATE_REQUEST_CONSENT } from '../../lib/updateRequests';
import Editable from '../content/Editable.astro';

const currentYear = new Date().getFullYear();
const turnstileSiteKey = Astro.locals.runtime?.env?.TURNSTILE_SITE_KEY ?? '';
const updateRequestId = crypto.randomUUID();
---
<footer class="footer site-footer">
    <div class="footer-content">
        <div class="footer-grid">
            <div class="footer-col">
                <h2><i class="fas fa-star-of-david" aria-hidden="true"></i><Editable field="footer.identity-title" as="strong">{congregationName}</Editable></h2>
                <Editable field="footer.identity-text" as="p"><strong>{congregationName}</strong>{officialIdentityStatementRemainder}</Editable>
            </div>

            <div class="footer-col">
                <h2><i class="fas fa-link" aria-hidden="true"></i> <Editable field="footer.links-title" as="span">Quick links</Editable></h2>
                <ul class="footer-links">
                    <li><a href="/about"><i class="fas fa-chevron-right" aria-hidden="true"></i> <Editable field="footer.link-about" as="span">About us</Editable></a></li>
                    <li><a href="/services"><i class="fas fa-chevron-right" aria-hidden="true"></i> <Editable field="footer.link-services" as="span">Shabbat services</Editable></a></li>
                    <li><a href="/#congregation-calendar"><i class="fas fa-chevron-right" aria-hidden="true"></i> <Editable field="footer.link-calendar" as="span">Congregational Calendar</Editable></a></li>
                    <li><a href="/resources"><i class="fas fa-chevron-right" aria-hidden="true"></i> <Editable field="footer.link-resources" as="span">Resources</Editable></a></li>
                    <li><a href="/donate"><i class="fas fa-chevron-right" aria-hidden="true"></i> <Editable field="footer.link-donate" as="span">Donate</Editable></a></li>
                    <li><a href="/contact"><i class="fas fa-chevron-right" aria-hidden="true"></i> <Editable field="footer.link-contact" as="span">Contact</Editable></a></li>
                    <li><a href="#" id="adminLoginLink"><i class="fas fa-chevron-right" aria-hidden="true"></i> Admin</a></li>
                </ul>
            </div>

            <div class="footer-col">
                <h2><i class="fas fa-envelope" aria-hidden="true"></i> <Editable field="footer.connect-title" as="span">Stay connected</Editable></h2>
                <Editable field="footer.connect-text" as="p">Stay in the loop with a friendly weekly email about gatherings and community news, plus occasional important updates.</Editable>
                <form id="newsletter-form" class="newsletter-form-expanded" method="post" action="/api/update-requests">
                    <input type="hidden" name="submissionId" value={updateRequestId}>
                    <input type="text" name="website" class="newsletter-botcheck" tabindex="-1" autocomplete="off" aria-hidden="true">

                    <div class="newsletter-name-fields">
                        <label class="newsletter-field">
                            <span class="newsletter-field-label">First name <span aria-hidden="true">*</span></span>
                            <input type="text" name="firstName" required maxlength="80" autocomplete="given-name">
                        </label>
                        <label class="newsletter-field">
                            <span class="newsletter-field-label">Last name <span aria-hidden="true">*</span></span>
                            <input type="text" name="lastName" required maxlength="80" autocomplete="family-name">
                        </label>
                    </div>
                    <label class="newsletter-field">
                        <span class="newsletter-field-label">Email address <span aria-hidden="true">*</span></span>
                        <input type="email" name="email" required maxlength="254" autocomplete="email" aria-describedby="newsletter-privacy">
                    </label>
                    <label class="newsletter-field">
                        <span class="newsletter-field-label">Phone number <span class="newsletter-optional">(optional)</span></span>
                        <input type="tel" name="phone" maxlength="40" autocomplete="tel" inputmode="tel">
                    </label>
                    <label class="newsletter-consent">
                        <input type="checkbox" name="consent" value="true" required>
                        <span>
                            {UPDATE_REQUEST_CONSENT.permission} {UPDATE_REQUEST_CONSENT.unsubscribe}
                            {UPDATE_REQUEST_CONSENT.termsLead} <a href="/website-use#email-updates">{UPDATE_REQUEST_CONSENT.termsLabel}</a>
                            {UPDATE_REQUEST_CONSENT.privacyLead} <a href="/privacy">{UPDATE_REQUEST_CONSENT.privacyLabel}</a>{UPDATE_REQUEST_CONSENT.ending}
                        </span>
                    </label>
                    {turnstileSiteKey ? (
                        <div class="newsletter-turnstile">
                            <div
                                id="newsletter-turnstile-widget"
                                data-sitekey={turnstileSiteKey}
                                data-action="updates_request"
                            ></div>
                        </div>
                    ) : (
                        <p class="newsletter-unavailable" role="status">Update requests are temporarily unavailable.</p>
                    )}
                    <p id="newsletter-privacy" class="newsletter-privacy">Cloudflare-protected. The optional phone field does not authorize texts or automated calls.</p>
                    <button type="submit" class="newsletter-btn-full" disabled={!turnstileSiteKey}>
                        Request weekly emails <i class="fas fa-arrow-right" aria-hidden="true"></i>
                    </button>
                    <p id="newsletter-status" class="form-status" role="status" aria-live="polite"></p>
                </form>
            </div>

            <div class="footer-col">
                <h2><i class="fas fa-map-marker-alt" aria-hidden="true"></i> <Editable field="footer.contact-title" as="span">Contact</Editable></h2>
                <ul class="footer-contact">
                    <li>
                        <i class="fas fa-envelope" aria-hidden="true"></i>
                        <Editable field="footer.contact-email" as="span" class="footer-contact-copy">OhrHaTorahOC@gmail.com</Editable>
                    </li>
                    <li>
                        <i class="fas fa-phone" aria-hidden="true"></i>
                        <Editable field="footer.contact-phone" as="span" class="footer-contact-copy">(714) 406-1513</Editable>
                    </li>
                    <li>
                        <i class="fas fa-map-marker-alt" aria-hidden="true"></i>
                        <Editable field="footer.contact-services" as="span" class="footer-contact-copy"><strong>Services:</strong> 10460 Slater Ave<br>Fountain Valley, CA 92708</Editable>
                    </li>
                    <li>
                        <i class="fas fa-map-marker-alt" aria-hidden="true"></i>
                        <Editable field="footer.contact-mailing" as="span" class="footer-contact-copy"><strong>Mailing:</strong> 360 E. 1st Street, #856<br>Tustin, CA 92780</Editable>
                    </li>
                </ul>
            </div>
        </div>

        <div class="footer-bottom">
            <p>&copy; {currentYear} <strong>{congregationName}</strong>. <Editable field="footer.rights" as="span">All rights reserved.</Editable></p>
            <nav class="footer-legal" aria-label="Website policies">
                <a href="/privacy"><Editable field="footer.legal-privacy" as="span">Privacy</Editable></a>
                <a href="/website-use"><Editable field="footer.legal-terms" as="span">Terms &amp; Conditions</Editable></a>
                <a href="/accessibility"><Editable field="footer.legal-accessibility" as="span">Accessibility</Editable></a>
                <a href="/website-use#copyright-sources"><Editable field="footer.legal-copyright" as="span">Copyright &amp; sources</Editable></a>
            </nav>
        </div>
    </div>
</footer>

<!-- Back to Top Button -->
<a href="#top" class="back-to-top" id="backToTop" aria-label="Back to top">
    <i class="fas fa-chevron-up" aria-hidden="true"></i>
</a>

{turnstileSiteKey && (
    <>
        <script is:inline>
            window.onKohTurnstileReady = function () {
                window.dispatchEvent(new Event('koh:turnstile-ready'));
            };
        </script>
        <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?onload=onKohTurnstileReady&render=explicit" defer></script>
    </>
)}

<script>
    type TurnstileApi = {
        render(container: HTMLElement, options: Record<string, unknown>): string;
        reset(widgetId: string): void;
    };

    const newsletterTurnstileContainer = document.getElementById('newsletter-turnstile-widget');
    let newsletterTurnstileWidgetId: string | null = null;

    function getTurnstile(): TurnstileApi | undefined {
        return (window as Window & { turnstile?: TurnstileApi }).turnstile;
    }

    function renderNewsletterTurnstile() {
        if (!newsletterTurnstileContainer
            || newsletterTurnstileWidgetId !== null) return;
        const sitekey = newsletterTurnstileContainer.dataset.sitekey;
        const turnstile = getTurnstile();
        if (!sitekey || !turnstile) return;

        newsletterTurnstileWidgetId = turnstile.render(newsletterTurnstileContainer, {
            sitekey,
            action: 'updates_request',
            theme: 'dark',
            size: 'flexible',
            appearance: 'interaction-only',
            'response-field-name': 'turnstileToken',
        });
    }

    window.addEventListener('koh:turnstile-ready', renderNewsletterTurnstile);
    renderNewsletterTurnstile();

    const backToTopButton = document.getElementById('backToTop');

    if (backToTopButton) {
        const syncBackToTopVisibility = () => {
            backToTopButton.classList.toggle('visible', window.scrollY > 300);
        };

        window.addEventListener('scroll', syncBackToTopVisibility, { passive: true });
        syncBackToTopVisibility();

        backToTopButton.addEventListener('click', function(e) {
            e.preventDefault();
            window.scrollTo({
                top: 0,
                behavior: 'smooth'
            });
        });
    }

    // Email-updates request submission
    const newsletterForm = document.getElementById('newsletter-form');
    const statusEl = document.getElementById('newsletter-status');

    if (newsletterForm instanceof HTMLFormElement && statusEl) {
        newsletterForm.addEventListener('submit', async function(e) {
            e.preventDefault();
            const formData = new FormData(this);
            const submitBtn = this.querySelector('button[type="submit"]');
            const turnstileToken = String(formData.get('turnstileToken') || '');

            if (!turnstileToken) {
                statusEl.textContent = 'Please complete the security check and try again.';
                statusEl.className = 'form-status error';
                return;
            }

            statusEl.textContent = 'Sending your request…';
            statusEl.className = 'form-status loading';
            if (submitBtn instanceof HTMLButtonElement) submitBtn.disabled = true;

            try {
                const response = await fetch(this.action, {
                    method: 'POST',
                    headers: {
                        'Accept': 'application/json',
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        submissionId: formData.get('submissionId'),
                        firstName: formData.get('firstName'),
                        lastName: formData.get('lastName'),
                        email: formData.get('email'),
                        phone: formData.get('phone'),
                        consent: formData.get('consent') === 'true',
                        website: formData.get('website'),
                        turnstileToken,
                    }),
                });
                const data = await response.json().catch(() => null);

                if (response.ok && data?.success) {
                    statusEl.textContent = 'Your update request was received.';
                    statusEl.className = 'form-status success';
                    newsletterForm.reset();
                    const requestIdInput = newsletterForm.elements.namedItem('submissionId');
                    if (requestIdInput instanceof HTMLInputElement) requestIdInput.value = crypto.randomUUID();
                } else {
                    statusEl.textContent = data?.message || (response.status === 429
                        ? 'Please wait a little while before trying again.'
                        : 'We could not receive your request. Please try again.');
                    statusEl.className = 'form-status error';
                }
            } catch (error) {
                statusEl.textContent = 'We could not receive your request. Please try again.';
                statusEl.className = 'form-status error';
            } finally {
                if (submitBtn instanceof HTMLButtonElement) submitBtn.disabled = false;
                if (newsletterTurnstileWidgetId !== null) {
                    getTurnstile()?.reset(newsletterTurnstileWidgetId);
                }
            }
        });
    }
</script>
