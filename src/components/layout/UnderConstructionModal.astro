---
import { canViewAdminPreview } from '../../lib/adminPreview';
const canPreview = canViewAdminPreview(Astro.locals.user);
---
<dialog id="underConstructionModal" class="uc-modal" aria-labelledby="uc-title" aria-describedby="uc-description" data-can-preview={String(canPreview)}>
    <div class="uc-modal-content">
        <h2 id="uc-title"><span class="uc-symbol" aria-hidden="true">🚧</span><span>We’re preparing this page.</span></h2>
        <p id="uc-description">This section is under construction. Please check back soon.</p>
        <form method="dialog"><button class="uc-close" autofocus>Back to browsing <span aria-hidden="true">→</span></button></form>
        <p class="uc-timing">This notice closes automatically. Interact with it to keep it open.</p>
    </div>
</dialog>
<style>
    .uc-modal { width: min(31rem, calc(100% - 2rem)); max-height: calc(100dvh - 2rem); padding: 0; border: 1px solid #d7c8a5; border-radius: 1rem; margin: auto; background: #fbf8f1; color: #061d35; box-shadow: 0 24px 80px #061d3540; overflow: auto; }
    .uc-modal::backdrop { background: #061d3580; backdrop-filter: blur(5px); }
    .uc-modal-content { padding: clamp(1.5rem, 5vw, 2.75rem); text-align: left; }
    .uc-symbol { flex-shrink: 0; font-size: 1.75rem; }
    .uc-modal h2 { display: flex; align-items: baseline; gap: .75rem; margin: 0 0 1rem; color: #061d35; font-size: clamp(1.8rem, 5vw, 2.4rem); line-height: 1.15; font-weight: 500; }
    #uc-description { font-size: 1.25rem; line-height: 1.6; color: #46566a; }
    .uc-close { display: flex; align-items: center; justify-content: center; gap: 1rem; width: 100%; min-height: 50px; margin-top: 1.5rem; padding: .75rem 1rem; border: 0; border-radius: .4rem; background: #0b2d57; color: white; font: 650 1.125rem var(--font-body); cursor: pointer; }
    .uc-close:hover { background: #164770; }
    .uc-timing { color: #59677b; font-size: 1rem; line-height: 1.45; margin: 1rem 0 0; }
</style>
<script>
    import { isPendingPage } from '../../data/pendingPages';
    const modal = document.getElementById('underConstructionModal') as HTMLDialogElement;
    let closeTimer: ReturnType<typeof setTimeout> | undefined;
    let trigger: HTMLElement | null = null;
    const stopTimer = () => { clearTimeout(closeTimer); closeTimer = undefined; };
    // Initial autofocus is automatic; only deliberate interaction cancels dismissal.
    ['pointerdown', 'keydown', 'wheel'].forEach(event => modal.addEventListener(event, stopTimer));
    modal.addEventListener('click', event => { if (event.target === modal) modal.close(); });
    modal.addEventListener('close', () => { stopTimer(); trigger?.focus({ preventScroll: true }); });

    document.addEventListener('click', event => {
        if (event.defaultPrevented || event.button !== 0 || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey || modal.dataset.canPreview === 'true') return;
        const link = (event.target as Element)?.closest<HTMLAnchorElement>('a[href]');
        if (!link || link.target === '_blank' || link.hasAttribute('download')) return;
        const url = new URL(link.href, location.href);
        if (url.origin !== location.origin || !isPendingPage(url.pathname)) return;
        if (typeof modal.showModal !== 'function') return;
        event.preventDefault();
        stopTimer();
        const menu = document.getElementById('mobile-nav-dialog') as HTMLDialogElement | null;
        trigger = menu?.contains(link) ? document.getElementById('mobile-menu-btn') : link;
        if (menu?.open) menu.close();
        // Let mobile menu cleanup finish before taking the top layer.
        requestAnimationFrame(() => {
            if (modal.open) return;
            modal.showModal();
            closeTimer = setTimeout(() => modal.close(), 8000);
        });
    });
</script>
