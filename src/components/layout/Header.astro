---
interface Props {
    showLogo?: boolean;
}

const { showLogo = true } = Astro.props;
---

<div class="header">
    <a class="mobile-site-brand" href="/" aria-label="Kehilat Ohr HaTorah home">
        Kehilat Ohr HaTorah
    </a>
    <button
        class="mobile-menu-btn"
        id="mobile-menu-btn"
        type="button"
        aria-label="Open navigation menu"
        aria-controls="nav-container"
        aria-expanded="false"
    >
        <span></span>
        <span></span>
        <span></span>
    </button>
    {showLogo && (
        <a href="/" class="logo"><img src="/images/logo.png" alt="Ohr HaTorah Logo" class="logo-image" width="612" height="408"></a>
    )}
</div>
