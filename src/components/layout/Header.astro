---
import Editable from '../content/Editable.astro';

interface Props {
    showLogo?: boolean;
    // The home hero already shows the full logo, so its compact header drops the mark.
    showMobileMark?: boolean;
}

const { showLogo = true, showMobileMark = true } = Astro.props;
---

<div class="header">
    <a class="mobile-site-brand" href="/" aria-label="Kehilat Ohr HaTorah home">
        {showMobileMark && (
            <img
                class="mobile-site-mark"
                src="/images/logo.png"
                alt=""
                width="612"
                height="408"
                aria-hidden="true"
            >
        )}
        <Editable field="nav.brand" as="span">Kehilat Ohr HaTorah</Editable>
    </a>
    <button
        class="mobile-menu-btn"
        id="mobile-menu-btn"
        type="button"
        aria-label="Open navigation menu"
        aria-controls="mobile-nav-dialog"
        aria-expanded="false"
    >
        <span></span>
        <span></span>
        <span></span>
    </button>
    {showLogo && (
        <a href="/" class="logo"><img src="/images/logo.png" alt="Kehilat Ohr HaTorah logo" class="logo-image" width="612" height="408"></a>
    )}
</div>
