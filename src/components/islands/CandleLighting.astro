---
// Candle Lighting Times Card - Using Hebcal API
---
<div class="feature-card">
    <div class="card-header" role="heading" aria-level="3">
        <span data-editable="candle-card-title">Shabbat Candle Lighting</span>
    </div>
    <div class="card-body">
        <div class="candle-times" id="candle-times" aria-live="polite" aria-busy="true">
            <div class="candle-row">
                <div>
                    <div class="candle-day">This Friday</div>
                    <div class="candle-date" id="next-friday-date">Loading...</div>
                </div>
                <div class="candle-time"><span id="candle-time-1">Loading...</span></div>
            </div>
            <div class="candle-row">
                <div>
                    <div class="candle-day">Havdalah</div>
                    <div class="candle-date" id="havdalah-date">Loading...</div>
                </div>
                <div class="candle-time"><span id="havdalah-time">Loading...</span></div>
            </div>
            <div class="candle-row">
                <div>
                    <div class="candle-day">Next Friday</div>
                    <div class="candle-date" id="following-friday-date">Loading...</div>
                </div>
                <div class="candle-time"><span id="candle-time-2">Loading...</span></div>
            </div>
        </div>
        <div class="last-updated" id="candle-last-updated">
            <span class="live-indicator" id="candle-live-indicator" title="Live from Hebcal">
                <span class="live-dot"></span>
                <span class="live-text">LIVE</span>
            </span>
            <span class="updated-time" id="candle-updated-time"></span>
        </div>
        <div class="loader" id="candle-times-loader" style="display: none;"></div>
    </div>
</div>

<style>
    .feature-card {
        color: var(--home-ink, #172236);
    }

    .candle-times {
        gap: 0;
    }

    .candle-row {
        align-items: center;
        gap: 1rem;
        padding: 0.75rem 0;
        border-bottom: 1px solid var(--home-line, rgba(13, 51, 91, 0.16));
    }

    .candle-row:first-child {
        padding-top: 0;
    }

    .candle-row:last-child {
        padding-bottom: 0;
        border-bottom: 0;
    }

    .candle-day {
        color: var(--home-blue-900, #0b2f5b);
        font-weight: 700;
    }

    .candle-date {
        color: var(--home-muted, #596476);
    }

    .candle-time {
        color: var(--home-blue-900, #0b2f5b);
        font-variant-numeric: tabular-nums;
        font-weight: 700;
        white-space: nowrap;
    }

    .last-updated {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        font-size: 0.7rem;
        color: var(--home-muted, #596476);
        margin-top: 8px;
        padding-top: 8px;
        border-top: 1px solid var(--home-line, rgba(13, 51, 91, 0.16));
    }

    .live-indicator {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 2px 8px;
        border: 1px solid rgba(208, 163, 61, 0.42);
        border-radius: 999px;
        background: var(--home-cream-100, #f8f3e8);
        font-size: 0.65rem;
        font-weight: 800;
        color: var(--home-blue-800, #123f72);
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .live-indicator.active {
        opacity: 1;
    }

    .live-dot {
        width: 6px;
        height: 6px;
        background: var(--home-gold-500, #d0a33d);
        border-radius: 50%;
        animation: pulse 2s ease-in-out infinite;
    }

    @keyframes pulse {
        0%, 100% {
            opacity: 1;
            transform: scale(1);
        }
        50% {
            opacity: 0.5;
            transform: scale(1.2);
        }
    }

    .live-text {
        letter-spacing: 0.5px;
    }

    .updated-time {
        color: var(--home-muted, #596476);
    }

    .loader {
        border-color: rgba(13, 51, 91, 0.16);
        border-top-color: var(--home-gold-500, #d0a33d);
    }

    @media (prefers-reduced-motion: reduce) {
        .live-dot {
            animation: none;
        }
    }
</style>

<script>
    import {
        addCalendarDays,
        formatCongregationDate,
        formatCongregationTime,
        getCalendarDateParts,
        getNextFridayDate
    } from '../../lib/shabbatDetails';

    const HEBCAL_ZIP = '92708'; // Fountain Valley, CA

    interface HebcalItem {
        title: string;
        date: string;
        category: string;
        title_orig?: string;
        hebrew?: string;
        memo?: string;
    }

    interface HebcalResponse {
        title: string;
        date: string;
        items: HebcalItem[];
        location: {
            title: string;
            city: string;
            tzid: string;
        };
    }

    const fetchShabbatTimes = async (targetDate: string): Promise<HebcalResponse | null> => {
        const { year, month, day } = getCalendarDateParts(targetDate);

        const url = `https://www.hebcal.com/shabbat?cfg=json&zip=${HEBCAL_ZIP}&M=on&gy=${year}&gm=${month}&gd=${day}`;

        try {
            const response = await fetch(url);
            if (!response.ok) throw new Error('API request failed');
            return await response.json();
        } catch (error) {
            console.error('Hebcal API error:', error);
            return null;
        }
    };

    const loadCandleLighting = async () => {
        const liveIndicator = document.getElementById('candle-live-indicator');
        const candleTimes = document.getElementById('candle-times');
        const updatedTimeEl = document.getElementById('candle-updated-time');

        const setText = (id: string, value: string) => {
            const element = document.getElementById(id);
            if (element) element.textContent = value;
        };

        const showUnavailableState = () => {
            ['next-friday-date', 'havdalah-date', 'following-friday-date'].forEach((id) => {
                setText(id, 'Date unavailable');
            });
            ['candle-time-1', 'havdalah-time', 'candle-time-2'].forEach((id) => {
                setText(id, 'Unavailable');
            });
            liveIndicator?.classList.remove('active');
            if (updatedTimeEl) updatedTimeEl.textContent = 'Times are temporarily unavailable';
        };

        try {
            const thisFriday = getNextFridayDate();
            const nextFriday = addCalendarDays(thisFriday, 7);

            // Fetch both weeks in parallel
            const [thisWeekData, nextWeekData] = await Promise.all([
                fetchShabbatTimes(thisFriday),
                fetchShabbatTimes(nextFriday)
            ]);

            const candleLighting = thisWeekData?.items?.find(item => item.category === 'candles');
            const havdalah = thisWeekData?.items?.find(item => item.category === 'havdalah');
            const nextCandleLighting = nextWeekData?.items?.find(item => item.category === 'candles');
            if (!candleLighting || !havdalah || !nextCandleLighting) {
                throw new Error('Hebcal returned incomplete Shabbat times');
            }

            setText('next-friday-date', formatCongregationDate(candleLighting.date));
            setText('candle-time-1', formatCongregationTime(candleLighting.date));
            setText('havdalah-date', formatCongregationDate(havdalah.date));
            setText('havdalah-time', formatCongregationTime(havdalah.date));
            setText('following-friday-date', formatCongregationDate(nextCandleLighting.date));
            setText('candle-time-2', formatCongregationTime(nextCandleLighting.date));

            liveIndicator?.classList.add('active');

            if (updatedTimeEl) {
                const timeStr = formatCongregationTime(new Date().toISOString());
                updatedTimeEl.textContent = `Updated ${timeStr} via Hebcal`;
            }

        } catch (error) {
            console.error('Error loading candle lighting times:', error);
            showUnavailableState();
        } finally {
            candleTimes?.setAttribute('aria-busy', 'false');
        }
    };

    // Load on page load
    loadCandleLighting();

    // Refresh every 30 minutes
    window.setInterval(loadCandleLighting, 30 * 60 * 1000);
</script>
