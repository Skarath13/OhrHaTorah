<div class="kehilat-calendar-shell" aria-busy="true">
    <p class="kehilat-calendar-status" role="status" aria-live="polite" aria-atomic="true">Loading upcoming dates…</p>
    <div
        class="kehilat-calendar"
        role="feed"
        aria-label="Upcoming Kehilat Ohr HaTorah gatherings, Shabbat candle-lighting times, and Jewish dates"
    ></div>
    <p class="kehilat-calendar-empty" hidden>No upcoming dates are available right now.</p>
    <div class="kehilat-calendar-actions" hidden>
        <button class="kehilat-calendar-show-more" type="button">Show more dates</button>
        <button class="kehilat-calendar-show-fewer" type="button" hidden>Show fewer dates</button>
    </div>

    <article class="kehilat-calendar-details" id="kehilat-calendar-event-details" aria-live="polite" hidden>
        <div>
            <p class="kehilat-calendar-details-kicker">Upcoming date</p>
            <h4 class="kehilat-calendar-details-title"></h4>
            <p class="kehilat-calendar-details-time"></p>
            <p class="kehilat-calendar-details-hebrew" hidden></p>
            <p class="kehilat-calendar-details-description" hidden></p>
            <p class="kehilat-calendar-details-location" hidden></p>
        </div>
        <button class="kehilat-calendar-details-close" type="button" aria-label="Close event details">
            <span aria-hidden="true">×</span>
        </button>
    </article>

    <noscript>
        <p class="kehilat-calendar-noscript">JavaScript is required to view upcoming dates. Our regular Shabbat gathering begins Saturdays at 2:30 p.m.</p>
    </noscript>

    <details class="kehilat-calendar-attribution">
        <summary>
            <span class="kehilat-calendar-attribution-icon" aria-hidden="true">i</span>
            <span>Calendar sources &amp; license</span>
        </summary>
        <p>
            Jewish holiday and candle-lighting data provided by
            <a href="https://www.hebcal.com/" target="_blank" rel="noopener noreferrer">Hebcal.com</a>,
            licensed under
            <a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener noreferrer">CC BY 4.0</a>;
            reformatted for this list.
        </p>
    </details>
</div>

<script>
    import {
        formatHebrewCalendarDate,
        stripRepeatedHebrewYear,
    } from '../../lib/calendarDisplay';

    type CalendarGroup = 'congregation' | 'candle-lighting' | 'holiday' | 'observance';

    type CalendarEvent = {
        id: string;
        title: string;
        allDay?: boolean;
        start?: string;
        end?: string;
        extendedProps: {
            source: 'congregation' | 'hebcal';
            group: CalendarGroup;
            calendarDate?: string;
            description?: string;
            location?: string;
            hebrew?: string;
            hebrewDate?: string;
        };
    };

    type CalendarPayload = {
        success: boolean;
        events?: CalendarEvent[];
        error?: string;
        meta?: {
            warning?: string;
        };
    };

    type DateGroup = {
        date: string;
        events: CalendarEvent[];
    };

    const businessTimeZone = 'America/Los_Angeles';
    const mobileDateLimit = 3;
    const tabletDateLimit = 6;
    const desktopDateLimit = 9;
    const maximumRequestDays = 400;
    const isoDatePattern = /^\d{4}-\d{2}-\d{2}$/;

    const calendarRoot = document.querySelector<HTMLElement>('.kehilat-calendar-shell');
    const calendarElement = calendarRoot?.querySelector<HTMLElement>('.kehilat-calendar');
    const statusElement = calendarRoot?.querySelector<HTMLElement>('.kehilat-calendar-status');
    const emptyElement = calendarRoot?.querySelector<HTMLElement>('.kehilat-calendar-empty');
    const actionsElement = calendarRoot?.querySelector<HTMLElement>('.kehilat-calendar-actions');
    const showMoreButton = actionsElement?.querySelector<HTMLButtonElement>('.kehilat-calendar-show-more');
    const showFewerButton = actionsElement?.querySelector<HTMLButtonElement>('.kehilat-calendar-show-fewer');
    const detailsElement = calendarRoot?.querySelector<HTMLElement>('.kehilat-calendar-details');
    const detailsTitle = detailsElement?.querySelector<HTMLElement>('.kehilat-calendar-details-title');
    const detailsTime = detailsElement?.querySelector<HTMLElement>('.kehilat-calendar-details-time');
    const detailsHebrew = detailsElement?.querySelector<HTMLElement>('.kehilat-calendar-details-hebrew');
    const detailsDescription = detailsElement?.querySelector<HTMLElement>('.kehilat-calendar-details-description');
    const detailsLocation = detailsElement?.querySelector<HTMLElement>('.kehilat-calendar-details-location');
    const detailsClose = detailsElement?.querySelector<HTMLButtonElement>('.kehilat-calendar-details-close');

    if (
        calendarRoot
        && calendarElement
        && statusElement
        && emptyElement
        && actionsElement
        && showMoreButton
        && showFewerButton
        && detailsElement
        && detailsTitle
        && detailsTime
        && detailsHebrew
        && detailsDescription
        && detailsLocation
        && detailsClose
    ) {
        const mobileLayoutQuery = window.matchMedia('(max-width: 599px)');
        const desktopLayoutQuery = window.matchMedia('(min-width: 1180px)');
        const getDefaultDateLimit = (): number => {
            if (mobileLayoutQuery.matches) return mobileDateLimit;
            if (desktopLayoutQuery.matches) return desktopDateLimit;
            return tabletDateLimit;
        };
        let dateGroups: DateGroup[] = [];
        let defaultDateLimit = getDefaultDateLimit();
        let visibleDateLimit = defaultDateLimit;
        let activeRequest: AbortController | null = null;
        let lastEventTrigger: HTMLButtonElement | null = null;

        const getBusinessDate = (): string => {
            const parts = new Intl.DateTimeFormat('en-US', {
                timeZone: businessTimeZone,
                year: 'numeric',
                month: '2-digit',
                day: '2-digit',
            }).formatToParts(new Date());
            const values = Object.fromEntries(parts.map((part) => [part.type, part.value]));
            return `${values.year}-${values.month}-${values.day}`;
        };

        const addDateDays = (date: string, days: number): string => {
            const timestamp = Date.parse(`${date}T00:00:00.000Z`);
            return new Date(timestamp + (days * 86_400_000)).toISOString().slice(0, 10);
        };

        const formatDate = (date: string, options: Intl.DateTimeFormatOptions): string =>
            new Intl.DateTimeFormat('en-US', { ...options, timeZone: 'UTC' })
                .format(new Date(`${date}T12:00:00.000Z`));

        const formatClockTime = (value: string | undefined): string => {
            const match = value?.match(/T(\d{2}):(\d{2})/);
            if (!match) return '';
            const hours = Number(match[1]);
            const minutes = match[2];
            const period = hours >= 12 ? 'p.m.' : 'a.m.';
            const displayHours = hours % 12 || 12;
            return `${displayHours}:${minutes} ${period}`;
        };

        const formatEventTime = (event: CalendarEvent): string => {
            if (event.allDay) return 'All day';
            const startTime = formatClockTime(event.start);
            const endTime = formatClockTime(event.end);
            if (!startTime) return 'Time to be announced';
            return endTime ? `${startTime}–${endTime}` : startTime;
        };

        const getGroupLabel = (group: CalendarGroup): string => ({
            congregation: 'Congregation gathering',
            holiday: 'Jewish holiday or festival',
            'candle-lighting': 'Shabbat candle lighting',
            observance: 'Jewish observance',
        })[group];

        const setOptionalText = (element: HTMLElement, value: unknown, prefix = '') => {
            const text = typeof value === 'string' ? value.trim() : '';
            element.textContent = text ? `${prefix}${text}` : '';
            element.hidden = !text;
        };

        const appendHebrewMetadata = (element: HTMLElement, event: CalendarEvent): boolean => {
            const hebrewName = stripRepeatedHebrewYear(
                event.extendedProps.hebrew,
                event.extendedProps.hebrewDate,
            );
            const hebrewDate = formatHebrewCalendarDate(event.extendedProps.hebrewDate);
            element.replaceChildren();

            if (hebrewName) {
                const name = document.createElement('span');
                name.className = 'kehilat-calendar-event-hebrew-name';
                name.lang = 'he';
                name.dir = 'rtl';
                name.textContent = hebrewName;
                element.append(name);
            }

            if (hebrewName && hebrewDate) {
                const separator = document.createElement('span');
                separator.className = 'kehilat-calendar-event-hebrew-separator';
                separator.textContent = '·';
                element.append(separator);
            }

            if (hebrewDate) {
                const date = document.createElement('span');
                date.className = 'kehilat-calendar-event-hebrew-date';
                date.textContent = hebrewDate;
                element.append(date);
            }

            return Boolean(hebrewName || hebrewDate);
        };

        const setEventDateAndTime = (element: HTMLElement, event: CalendarEvent) => {
            const calendarDate = event.extendedProps.calendarDate || event.start?.slice(0, 10) || '';
            const eventTime = formatEventTime(event);
            element.replaceChildren();

            if (calendarDate && isoDatePattern.test(calendarDate)) {
                const date = document.createElement('span');
                date.className = 'kehilat-calendar-gregorian-date';
                date.textContent = formatDate(calendarDate, {
                    weekday: 'long',
                    month: 'long',
                    day: 'numeric',
                    year: 'numeric',
                });
                element.append(date, ` · ${eventTime}`);
                return;
            }

            element.textContent = eventTime;
        };

        const closeDetails = (restoreFocus: boolean) => {
            detailsElement.hidden = true;
            lastEventTrigger?.setAttribute('aria-expanded', 'false');
            if (restoreFocus) lastEventTrigger?.focus();
            lastEventTrigger = null;
        };

        const showEventDetails = (event: CalendarEvent, trigger: HTMLButtonElement) => {
            lastEventTrigger?.setAttribute('aria-expanded', 'false');
            lastEventTrigger = trigger;
            trigger.setAttribute('aria-expanded', 'true');

            detailsTitle.textContent = stripRepeatedHebrewYear(
                event.title,
                event.extendedProps.hebrewDate,
            );
            setEventDateAndTime(detailsTime, event);
            detailsHebrew.hidden = !appendHebrewMetadata(detailsHebrew, event);
            setOptionalText(detailsDescription, event.extendedProps.description);
            setOptionalText(detailsLocation, event.extendedProps.location, 'Location: ');

            detailsElement.hidden = false;
            detailsElement.scrollIntoView({
                block: 'nearest',
                behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
            });
            detailsClose.focus({ preventScroll: true });
        };

        const createEventItem = (event: CalendarEvent): HTMLLIElement => {
            const item = document.createElement('li');
            item.className = 'kehilat-calendar-event-item';

            const button = document.createElement('button');
            button.type = 'button';
            button.className = `kehilat-calendar-event-button kehilat-calendar-event-button--${event.extendedProps.group}`;
            button.setAttribute('aria-controls', 'kehilat-calendar-event-details');
            button.setAttribute('aria-expanded', 'false');

            const type = document.createElement('span');
            type.className = 'kehilat-calendar-event-type';
            type.textContent = getGroupLabel(event.extendedProps.group);

            const title = document.createElement('strong');
            title.className = 'kehilat-calendar-event-title';
            title.textContent = stripRepeatedHebrewYear(
                event.title,
                event.extendedProps.hebrewDate,
            );

            const time = document.createElement('span');
            time.className = 'kehilat-calendar-event-time';
            time.textContent = formatEventTime(event);

            button.append(type, title, time);
            if (event.extendedProps.hebrew || event.extendedProps.hebrewDate) {
                const hebrew = document.createElement('span');
                hebrew.className = 'kehilat-calendar-event-hebrew';
                if (appendHebrewMetadata(hebrew, event)) button.append(hebrew);
            }
            button.addEventListener('click', () => showEventDetails(event, button));
            item.append(button);
            return item;
        };

        const createDateCard = (group: DateGroup, index: number): HTMLElement => {
            const card = document.createElement('article');
            card.className = 'kehilat-calendar-date-card';
            const headingId = `kehilat-calendar-date-${group.date}-${index}`;
            card.setAttribute('aria-labelledby', headingId);
            card.setAttribute('aria-posinset', String(index + 1));
            card.setAttribute('aria-setsize', String(dateGroups.length));

            const header = document.createElement('header');
            header.className = 'kehilat-calendar-date-header';

            const weekday = document.createElement('p');
            weekday.className = 'kehilat-calendar-date-weekday';
            weekday.textContent = formatDate(group.date, { weekday: 'long' });

            const heading = document.createElement('h3');
            heading.id = headingId;
            heading.className = 'kehilat-calendar-date-heading';
            const date = document.createElement('time');
            date.className = 'kehilat-calendar-gregorian-date';
            date.dateTime = group.date;
            date.textContent = formatDate(group.date, { month: 'long', day: 'numeric', year: 'numeric' });
            heading.append(date);
            header.append(weekday, heading);

            const eventList = document.createElement('ul');
            eventList.className = 'kehilat-calendar-event-list';
            group.events.forEach((event) => eventList.append(createEventItem(event)));
            card.append(header, eventList);
            return card;
        };

        const renderDateGroups = () => {
            closeDetails(false);
            calendarElement.replaceChildren();
            const visibleGroups = dateGroups.slice(0, visibleDateLimit);
            visibleGroups.forEach((group, index) => calendarElement.append(createDateCard(group, index)));

            emptyElement.hidden = dateGroups.length > 0;
            const remainingCount = Math.max(0, dateGroups.length - visibleGroups.length);
            actionsElement.hidden = dateGroups.length <= defaultDateLimit;
            showMoreButton.hidden = remainingCount === 0;
            showMoreButton.textContent = remainingCount > 0
                ? `Show ${Math.min(defaultDateLimit, remainingCount)} more ${remainingCount === 1 ? 'date' : 'dates'}`
                : 'Show more dates';
            showFewerButton.hidden = visibleDateLimit <= defaultDateLimit;
        };

        const groupEventsByDate = (events: CalendarEvent[]): DateGroup[] => {
            const grouped = new Map<string, CalendarEvent[]>();
            events.forEach((event) => {
                const date = event.extendedProps?.calendarDate || event.start?.slice(0, 10) || '';
                if (!isoDatePattern.test(date)) return;
                const existingEvents = grouped.get(date) || [];
                existingEvents.push(event);
                grouped.set(date, existingEvents);
            });

            return [...grouped.entries()]
                .sort(([firstDate], [secondDate]) => firstDate.localeCompare(secondDate))
                .map(([date, groupedEvents]) => ({
                    date,
                    events: groupedEvents.sort((first, second) => {
                        const firstTime = first.allDay ? '00:00' : first.start?.slice(11, 16) || '23:59';
                        const secondTime = second.allDay ? '00:00' : second.start?.slice(11, 16) || '23:59';
                        return firstTime.localeCompare(secondTime) || first.title.localeCompare(second.title);
                    }),
                }));
        };

        const loadEvents = async () => {
            activeRequest?.abort();
            activeRequest = new AbortController();
            const requestController = activeRequest;
            const query = new URLSearchParams({
                congregation: '1',
                holidays: '1',
                candleLighting: '1',
                observances: '1',
            });
            const start = getBusinessDate();
            query.set('start', start);
            query.set('end', addDateDays(start, maximumRequestDays));

            calendarRoot.classList.add('is-loading');
            calendarRoot.setAttribute('aria-busy', 'true');
            statusElement.textContent = 'Loading upcoming dates…';
            try {
                const response = await fetch(`/api/calendar/events?${query.toString()}`, {
                    cache: 'no-store',
                    headers: { Accept: 'application/json' },
                    signal: requestController.signal,
                });
                const payload = await response.json() as CalendarPayload;
                if (!response.ok || !payload.success || !Array.isArray(payload.events)) {
                    throw new Error(payload.error || 'Upcoming dates could not be loaded');
                }

                dateGroups = groupEventsByDate(payload.events);
                visibleDateLimit = defaultDateLimit;
                statusElement.textContent = payload.meta?.warning || '';
                renderDateGroups();
            } catch (error) {
                if (requestController.signal.aborted) return;
                dateGroups = [];
                renderDateGroups();
                statusElement.textContent = error instanceof Error
                    ? `${error.message}. Please try again shortly.`
                    : 'Upcoming dates are temporarily unavailable. Please try again shortly.';
            } finally {
                if (activeRequest === requestController) {
                    activeRequest = null;
                    calendarRoot.classList.remove('is-loading');
                    calendarRoot.setAttribute('aria-busy', 'false');
                }
            }
        };

        showMoreButton.addEventListener('click', () => {
            const previouslyVisible = visibleDateLimit;
            visibleDateLimit = Math.min(dateGroups.length, visibleDateLimit + defaultDateLimit);
            renderDateGroups();
            calendarElement
                .querySelector<HTMLButtonElement>(`.kehilat-calendar-date-card:nth-child(${previouslyVisible + 1}) .kehilat-calendar-event-button`)
                ?.focus();
        });
        showFewerButton.addEventListener('click', () => {
            visibleDateLimit = defaultDateLimit;
            renderDateGroups();
            calendarElement.scrollIntoView({ block: 'start', behavior: 'smooth' });
            showMoreButton.focus({ preventScroll: true });
        });
        detailsClose.addEventListener('click', () => closeDetails(true));
        const handleCalendarLayoutChange = () => {
            const previousDefault = defaultDateLimit;
            defaultDateLimit = getDefaultDateLimit();
            visibleDateLimit = visibleDateLimit <= previousDefault
                ? defaultDateLimit
                : Math.max(defaultDateLimit, visibleDateLimit);
            renderDateGroups();
        };
        mobileLayoutQuery.addEventListener('change', handleCalendarLayoutChange);
        desktopLayoutQuery.addEventListener('change', handleCalendarLayoutChange);
        window.addEventListener('oht:calendar-events-changed', loadEvents);

        loadEvents();
    }
</script>
