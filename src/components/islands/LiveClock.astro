---
// Shows the next Shabbat's dates alongside the Mincha service time.
---
<div class="sidebar-widget live-clock-widget" aria-labelledby="sidebar-date-time-title">
    <div class="widget-header" data-editable="sidebar-date-time-header" role="heading" aria-level="3">
        <span id="sidebar-date-time-title" data-editable="sidebar-date-time-title">Next Shabbat</span>
    </div>
    <div class="widget-content">
        <div class="clock-stack">
            <div class="clock-panel">
                <div class="clock-label" id="sidebar-hebrew-date-label">Hebrew Date</div>
                <div
                    class="clock-hebrew-date"
                    id="sidebar-hebrew-date"
                    aria-labelledby="sidebar-hebrew-date-label"
                    aria-live="polite"
                    aria-busy="true"
                >Loading...</div>
            </div>
            <div class="clock-panel clock-panel-date">
                <div class="clock-label" id="sidebar-gregorian-date-label">Gregorian Date</div>
                <time
                    class="clock-gregorian-date"
                    id="sidebar-gregorian-date"
                    aria-labelledby="sidebar-gregorian-date-label"
                ></time>
            </div>
            <div class="clock-panel clock-panel-service">
                <div class="clock-label" id="sidebar-mincha-service-label">Mincha Service</div>
                <time
                    class="clock-service-time"
                    datetime="14:30"
                    aria-labelledby="sidebar-mincha-service-label"
                >2:30 p.m.</time>
            </div>
        </div>
    </div>
</div>

<style>
    .live-clock-widget .widget-content {
        background: transparent;
    }

    .clock-stack {
        display: flex;
        flex-direction: column;
        gap: 0;
        border-top: 1px solid var(--home-line, rgba(13, 51, 91, 0.16));
    }

    .clock-panel {
        display: grid;
        grid-template-columns: minmax(140px, auto) minmax(0, 1fr);
        align-items: start;
        gap: 12px;
        padding: 0.72rem 0;
        border-bottom: 1px solid var(--home-line, rgba(13, 51, 91, 0.16));
        background: transparent;
    }

    .clock-panel + .clock-panel {
        padding-top: 0.72rem;
    }

    .clock-panel:last-child {
        border-bottom-color: var(--home-line, rgba(13, 51, 91, 0.16));
    }

    .clock-label {
        display: block;
        margin-bottom: 0;
        color: var(--home-blue-800, #123f72);
        font-family: inherit;
        font-size: 0.85rem;
        font-weight: 700;
        letter-spacing: 0;
        text-transform: none;
        line-height: 1.4;
    }

    .clock-hebrew-date {
        color: var(--home-blue-900, #0b2f5b);
        font-family: var(--font-display);
        font-size: 1rem;
        font-weight: 700;
        line-height: 1.4;
        text-align: right;
        justify-self: stretch;
        min-width: 0;
        width: 100%;
        max-width: none;
        word-break: normal;
        overflow-wrap: normal;
    }

    .clock-gregorian-date {
        color: var(--home-ink, #172236);
        font-family: inherit;
        font-size: 0.94rem;
        font-weight: 600;
        line-height: 1.4;
        text-align: right;
        justify-self: stretch;
        min-width: 0;
        width: 100%;
        max-width: none;
        word-break: normal;
        overflow-wrap: normal;
    }

    .clock-panel-date {
        grid-template-columns: minmax(110px, auto) minmax(0, 1fr);
    }

    .clock-panel-date .clock-gregorian-date {
        font-size: 0.94rem;
    }

    .clock-service-time {
        color: var(--home-blue-900, #0b2f5b);
        font-family: inherit;
        font-size: 0.94rem;
        font-weight: 700;
        letter-spacing: 0;
        display: flex;
        align-items: baseline;
        justify-content: flex-end;
        gap: 4px;
        font-variant-numeric: tabular-nums;
        line-height: 1.4;
        text-align: right;
        justify-self: stretch;
        min-width: 0;
        width: 100%;
        max-width: none;
        white-space: nowrap;
    }

    @media (max-width: 768px) {
        .clock-panel {
            grid-template-columns: minmax(120px, auto) minmax(0, 1fr);
            gap: 10px;
        }

        .clock-panel-date {
            grid-template-columns: minmax(92px, auto) minmax(0, 1fr);
        }
    }
</style>

<script>
    import { getUpcomingShabbatDate } from '../../lib/parashah';

    const PACIFIC_TIME_ZONE = 'America/Los_Angeles';

    const getRecord = (value: unknown): Record<string, unknown> | null => {
        return value && typeof value === 'object' && !Array.isArray(value)
            ? value as Record<string, unknown>
            : null;
    };

    const getInteger = (value: unknown): number | null => {
        const number = typeof value === 'number' ? value : Number(value);
        return Number.isInteger(number) ? number : null;
    };

    const formatHebrewDate = (payload: unknown): string | null => {
        const data = getRecord(payload);
        const day = getInteger(data?.hd);
        const year = getInteger(data?.hy);
        const month = typeof data?.hm === 'string' ? data.hm.trim() : '';

        return day && year && month ? `${day} ${month} ${year}` : null;
    };

    const parseCalendarDate = (date: string): Date | null => {
        const match = date.match(/^(\d{4})-(\d{2})-(\d{2})$/);
        if (!match) return null;

        const parsed = new Date(Date.UTC(
            Number(match[1]),
            Number(match[2]) - 1,
            Number(match[3]),
            12
        ));
        return Number.isNaN(parsed.getTime()) ? null : parsed;
    };

    const loadUpcomingShabbatDates = async () => {
        const hebrewDateElement = document.getElementById('sidebar-hebrew-date');
        const gregorianDateElement = document.getElementById('sidebar-gregorian-date');
        if (!hebrewDateElement || !(gregorianDateElement instanceof HTMLTimeElement)) return;

        let shabbatDate: string;
        try {
            shabbatDate = getUpcomingShabbatDate(new Date(), PACIFIC_TIME_ZONE, {
                strictlyFollowing: true
            });
        } catch (error) {
            console.error('Could not determine the next Shabbat date:', error);
            hebrewDateElement.textContent = 'Hebrew date unavailable';
            hebrewDateElement.setAttribute('aria-busy', 'false');
            gregorianDateElement.textContent = 'Date unavailable';
            return;
        }

        const shabbatCalendarDate = parseCalendarDate(shabbatDate);
        if (!shabbatCalendarDate) {
            hebrewDateElement.textContent = 'Hebrew date unavailable';
            hebrewDateElement.setAttribute('aria-busy', 'false');
            gregorianDateElement.textContent = 'Date unavailable';
            return;
        }

        gregorianDateElement.dateTime = shabbatDate;
        gregorianDateElement.textContent = new Intl.DateTimeFormat('en-US', {
            timeZone: 'UTC',
            weekday: 'long',
            month: 'long',
            day: 'numeric',
            year: 'numeric'
        }).format(shabbatCalendarDate);

        const [year, month, day] = shabbatDate.split('-');
        const params = new URLSearchParams({
            cfg: 'json',
            gy: year,
            gm: month,
            gd: day,
            g2h: '1',
            lg: 'en'
        });

        try {
            const response = await fetch(`https://www.hebcal.com/converter?${params.toString()}`);
            if (!response.ok) {
                throw new Error(`Hebcal converter returned ${response.status}`);
            }

            const hebrewDate = formatHebrewDate(await response.json());
            if (!hebrewDate) {
                throw new Error('Hebcal converter returned an incomplete Hebrew date');
            }

            hebrewDateElement.textContent = hebrewDate;
            hebrewDateElement.setAttribute(
                'aria-label',
                `Hebrew date for the next Shabbat: ${hebrewDate}`
            );
        } catch (error) {
            console.error('Could not load the Hebrew date for the next Shabbat:', error);
            hebrewDateElement.textContent = 'Hebrew date unavailable';
            hebrewDateElement.setAttribute(
                'aria-label',
                'Hebrew date for the next Shabbat is currently unavailable'
            );
        } finally {
            hebrewDateElement.setAttribute('aria-busy', 'false');
        }
    };

    loadUpcomingShabbatDates();
</script>
