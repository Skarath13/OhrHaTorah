---
// Hostage Memorial - Prayer for Israel
import { IconFlag } from '@tabler/icons-astro';
---
<div class="hostage-info">
    <a href="https://news.kehila.org/" target="_blank" rel="noopener noreferrer" class="hostage-link">
        <div class="hostage-counter">
            <div class="hostage-header">
                <span class="hostage-text"><IconFlag class="hostage-flag" size={20} stroke={1.8} aria-hidden="true" />PRAY FOR ISRAEL</span>
                <span class="hostage-subtext">PRAY FOR HEALING & PEACE</span>
            </div>
            <div class="hostage-memorial">
                <div class="memorial-stat">
                    <span class="memorial-number">251</span>
                    <span class="memorial-label">TAKEN</span>
                </div>
                <div class="memorial-stat">
                    <span class="memorial-number">20</span>
                    <span class="memorial-label">FREED</span>
                </div>
                <div class="memorial-stat">
                    <span class="memorial-number">3</span>
                    <span class="memorial-label">REMAIN</span>
                </div>
            </div>
            <div class="hostage-footer">
                <span class="bring-them-home">AM YISRAEL CHAI<span class="sr-only"> (opens in a new tab)</span></span>
            </div>
        </div>
    </a>
</div>
