---
// Weekly Parashah Card - fetches Torah readings from Hebcal API
---
<div class="feature-card">
    <div class="card-header" role="heading" aria-level="3">
        <span id="parashah-header" data-editable="parashah-card-title">Weekly Parashah</span>
    </div>
    <div class="card-body">
        <div class="parashah-info">
            <span class="parashah-label" data-editable="parashah-label-text">Parashah:</span>
            <span id="parashah-name">Loading...</span>
        </div>

        <!-- Reading Cycle Toggle -->
        <div class="reading-cycle-toggle" role="tablist" aria-label="Torah reading cycle">
            <button class="cycle-btn active" id="annual-cycle-tab" type="button" role="tab" aria-selected="true" aria-controls="annual-readings" data-cycle="annual" disabled>
                Full annual reading
            </button>
            <button class="cycle-btn" id="triennial-cycle-tab" type="button" role="tab" aria-selected="false" aria-controls="triennial-readings" data-cycle="triennial" disabled hidden>
                Triennial reading
            </button>
        </div>

        <!-- Triennial Year Info -->
        <div id="triennial-year-info" class="triennial-note" hidden>
            <span class="triennial-movement">Official triennial cycle · Year <span id="triennial-year">1</span> of 3</span>
        </div>

        <!-- Annual Readings -->
        <div id="annual-readings" class="reading-section" role="tabpanel" aria-labelledby="annual-cycle-tab">
            <div class="parashah-info">
                <div class="reading-row">
                    <span class="reading-label" data-editable="torah-label-text">Torah:</span>
                </div>
                <div class="reading-text" id="torah-reading">Loading...</div>
            </div>
            <div class="parashah-info">
                <div class="reading-row">
                    <span class="reading-label" data-editable="haftarah-label-text">Haftarah:</span>
                </div>
                <div class="reading-text" id="haftarah-reading">Loading...</div>
            </div>
        </div>

        <!-- Triennial Readings -->
        <div id="triennial-readings" class="reading-section" role="tabpanel" aria-labelledby="triennial-cycle-tab" hidden>
            <div class="parashah-info">
                <div class="reading-row">
                    <span class="reading-label">Torah:</span>
                </div>
                <div class="reading-text" id="triennial-torah-reading">Loading...</div>
            </div>
            <div class="parashah-info">
                <div class="reading-row">
                    <span class="reading-label">Haftarah:</span>
                </div>
                <div class="reading-text" id="triennial-haftarah-reading">Loading...</div>
            </div>
        </div>

        <!-- Brit Chadashah -->
        <div class="parashah-info brit-chadashah-section">
            <div class="reading-row">
                <span class="reading-label" data-editable="brit-label-text">Brit Chadashah:</span>
            </div>
            <div class="reading-text" id="brit-reading" data-brit-editable="true" data-brit-key="">Loading...</div>
            <p class="brit-reading-source" id="brit-reading-source"></p>
        </div>

        <div class="loader" id="parashah-loader" style="display: none;"></div>
        <p class="reading-source" id="parashah-status" aria-live="polite">
            Loading the verified weekly readings…
        </p>
    </div>
</div>

<style>
    .feature-card {
        color: var(--home-ink, #172236);
    }

    .parashah-info {
        border-bottom-color: var(--home-line, rgba(13, 51, 91, 0.16));
    }

    .parashah-label,
    .reading-label,
    #parashah-name {
        color: var(--home-blue-900, #0b2f5b);
    }

    #parashah-name,
    .reading-label {
        font-weight: 700;
    }

    .reading-cycle-toggle {
        gap: 0;
        padding: 0;
        border: 0;
        border-bottom: 1px solid var(--home-line, rgba(13, 51, 91, 0.16));
        border-radius: 0;
        background: transparent;
    }

    .cycle-btn {
        border: 0;
        border-bottom: 2px solid transparent;
        border-radius: 0;
        background: transparent;
        box-shadow: none;
        color: var(--home-muted, #596476);
        font-weight: 700;
        transition: background-color 180ms ease, border-color 180ms ease, color 180ms ease;
    }

    .cycle-btn:hover {
        border-bottom-color: var(--home-gold-300, #e6c978);
        background: rgba(11, 47, 91, 0.06);
        box-shadow: none;
        color: var(--home-blue-900, #0b2f5b);
    }

    .cycle-btn.active,
    .cycle-btn.active:hover {
        border-bottom-color: var(--home-gold-500, #d0a33d);
        background: transparent;
        box-shadow: none;
        color: var(--home-blue-900, #0b2f5b);
    }

    .cycle-btn:focus-visible {
        outline: 3px solid var(--home-gold-300, #e6c978);
        outline-offset: 2px;
    }

    .cycle-btn:disabled {
        cursor: wait;
        opacity: 0.62;
    }

    .cycle-btn[hidden],
    .reading-section[hidden],
    .triennial-note[hidden] {
        display: none !important;
    }

    .triennial-note {
        border: 1px solid var(--home-line, rgba(13, 51, 91, 0.16));
        border-left: 3px solid var(--home-gold-500, #d0a33d);
        border-radius: 2px;
        background: var(--home-cream-100, #f8f3e8);
        color: var(--home-ink, #172236);
    }

    .triennial-movement {
        color: var(--home-blue-800, #123f72);
    }

    .reading-section .reading-text,
    .parashah-info:has(.reading-text) .reading-text {
        width: calc(100% - 16px);
        margin-left: 16px;
        border-left: 3px solid var(--home-gold-500, #d0a33d);
        border-radius: 0 2px 2px 0;
        background: var(--home-cream-100, #f8f3e8);
        box-shadow: none;
        color: var(--home-ink, #172236);
    }

    .reading-section .parashah-info:last-child {
        border-bottom-color: var(--home-line, rgba(13, 51, 91, 0.16));
    }

    .loader {
        border-color: rgba(13, 51, 91, 0.16);
        border-top-color: var(--home-gold-500, #d0a33d);
    }

    .reading-source {
        margin: 0.8rem 0 0;
        color: var(--home-muted, #596476);
        font-size: 0.75rem;
        line-height: 1.45;
    }

    .reading-source a {
        color: var(--home-blue-800, #123f72);
        font-weight: 700;
        text-underline-offset: 0.16em;
    }

    .brit-reading-source {
        margin: 0.45rem 0 0 1rem;
        color: var(--home-muted, #596476);
        font-size: 0.7rem;
        line-height: 1.4;
    }

    .brit-reading-source a {
        color: var(--home-blue-800, #123f72);
        font-weight: 700;
        text-underline-offset: 0.16em;
    }

    :global(body.admin-edit-mode) [data-brit-editable]:hover {
        outline-color: var(--home-gold-500, #d0a33d);
        background-color: rgba(230, 201, 120, 0.16);
    }

    :global(body.admin-edit-mode) [data-brit-editable].actively-editing {
        outline-color: var(--home-blue-800, #123f72) !important;
        background-color: var(--home-cream-100, #f8f3e8) !important;
    }

    @media (max-width: 420px) {
        .reading-section .reading-text,
        .parashah-info:has(.reading-text) .reading-text {
            width: calc(100% - 8px);
            margin-left: 8px;
        }
    }
</style>

<script>
    import {
        getPreferredBritReading
    } from '../../lib/britChadashah';
    import {
        formatParashahDate,
        getBritOverrideKey,
        getUpcomingShabbatDate,
        type ParashahBundle,
        type ParashahData
    } from '../../lib/parashah';

    const PARASHAH_CACHE_KEY = 'oht_parashah_cache_v4';
    const PARASHAH_CACHE_VERSION = 4;
    const PARASHAH_CACHE_MAX_AGE_MS = 8 * 24 * 60 * 60 * 1000;

    const fetchJson = async (url: string, timeoutMs = 6000): Promise<unknown> => {
        let lastError: unknown;

        for (let attempt = 0; attempt < 1; attempt += 1) {
            const controller = new AbortController();
            const timeoutId = window.setTimeout(() => controller.abort(), timeoutMs);

            try {
                const response = await fetch(url, {
                    signal: controller.signal,
                    headers: { Accept: 'application/json' }
                });
                if (!response.ok) throw new Error(`Request failed: ${response.status}`);
                return await response.json();
            } catch (error) {
                lastError = error;
            } finally {
                window.clearTimeout(timeoutId);
            }
        }

        throw lastError instanceof Error ? lastError : new Error('Request failed');
    };

    const readCachedBundle = (expectedDate: string): ParashahBundle | null => {
        try {
            const stored = localStorage.getItem(PARASHAH_CACHE_KEY);
            if (!stored) return null;
            const cached = JSON.parse(stored);
            if (
                cached?.version !== PARASHAH_CACHE_VERSION
                || cached?.date !== expectedDate
                || !cached?.bundle?.annual?.name
                || !cached?.cachedAt
                || Date.now() - Date.parse(cached.cachedAt) > PARASHAH_CACHE_MAX_AGE_MS
            ) return null;
            return cached.bundle as ParashahBundle;
        } catch {
            return null;
        }
    };

    const cacheBundle = (bundle: ParashahBundle) => {
        if (!bundle.annual.date) return;
        try {
            localStorage.setItem(PARASHAH_CACHE_KEY, JSON.stringify({
                version: PARASHAH_CACHE_VERSION,
                date: bundle.annual.date,
                cachedAt: new Date().toISOString(),
                bundle
            }));
        } catch {
            // Storage can be unavailable in private browsing; live data still works.
        }
    };

    const tryReadingsAPI = async (expectedDate: string): Promise<ParashahBundle> => {
        const result = await fetchJson(`/api/readings?date=${encodeURIComponent(expectedDate)}`) as any;
        if (!result?.success || !result?.data?.annual?.name) {
            throw new Error(result?.error || 'No verified weekly Torah reading was returned');
        }
        return result.data as ParashahBundle;
    };

    // Auto-fit text to prevent overflow
    const autoFitText = (element: HTMLElement, minFontSize = 12) => {
        const parent = element.parentElement;
        if (!parent) return;

        let fontSize = parseFloat(getComputedStyle(element).fontSize);
        element.style.fontSize = '';

        // Check if text overflows
        while (element.scrollWidth > parent.clientWidth && fontSize > minFontSize) {
            fontSize -= 0.5;
            element.style.fontSize = `${fontSize}px`;
        }
    };

    const updateParashahUI = async (annualData: ParashahData, triennialData: ParashahData | null) => {
        document.getElementById('parashah-name')!.textContent = annualData.name;
        document.getElementById('torah-reading')!.textContent = annualData.torah;
        document.getElementById('haftarah-reading')!.textContent = annualData.haftarah;

        const headerEl = document.getElementById('parashah-header');
        if (headerEl && annualData.date) {
            headerEl.textContent = `Weekly Parashah - ${formatParashahDate(annualData.date)}`;
            // Auto-fit header text after render
            requestAnimationFrame(() => autoFitText(headerEl, 13));
        }

        // Use the congregation's explicit source policy: FFOZ first, MJRC second,
        // then fail transparently rather than switching to an unverified table.
        const scheduledBritReading = getPreferredBritReading(
            annualData.name,
            annualData.hebrewYear
        );
        const britReading = scheduledBritReading?.reading;

        const readingDate = annualData.date || getUpcomingShabbatDate();
        const britKey = getBritOverrideKey(readingDate);
        const britOriginalStorageKey = `oht_brit_original:${readingDate}`;
        const britOverrideStorageKey = `oht_brit_override:${readingDate}`;

        // Store the schedule-backed value separately from this Shabbat's override.
        const defaultBritReading = britReading || 'See weekly bulletin';
        try {
            localStorage.setItem(britOriginalStorageKey, defaultBritReading);
        } catch {
            // Storage is optional; the rendered weekly reading remains available.
        }

        // Check for override - first try API, fall back to localStorage
        let britOverride: string | null = null;
        try {
            britOverride = localStorage.getItem(britOverrideStorageKey);
        } catch {
            // Continue with the schedule-backed default.
        }
        try {
            const overrideResult = await fetchJson(`/api/content/${encodeURIComponent(britKey)}`, 3000) as any;
            if (overrideResult.success && overrideResult.data?.value) {
                britOverride = overrideResult.data.value;
                try {
                    localStorage.setItem(britOverrideStorageKey, britOverride);
                } catch {
                    // The API value can still render without local storage.
                }
            }
        } catch {
            // API not available, use localStorage fallback
        }

        const britEl = document.getElementById('brit-reading')!;
        britEl.dataset.britKey = britKey;
        britEl.dataset.britDate = readingDate;
        britEl.dataset.britOriginal = defaultBritReading;
        const finalBritReading = britOverride || defaultBritReading;

        const britSource = document.getElementById('brit-reading-source');
        if (britSource) {
            if (britOverride) {
                britSource.textContent = 'Rabbi-approved reading for this Shabbat.';
            } else if (scheduledBritReading?.source === 'ffoz') {
                const sourceLink = document.createElement('a');
                sourceLink.href = scheduledBritReading.sourceUrl;
                sourceLink.target = '_blank';
                sourceLink.rel = 'noopener noreferrer';
                sourceLink.textContent = 'First Fruits of Zion';
                britSource.replaceChildren('Suggested Gospel · ', sourceLink, ' · UMJC-endorsed calendar.');
            } else if (scheduledBritReading?.source === 'mjrc') {
                const sourceLink = document.createElement('a');
                sourceLink.href = scheduledBritReading.sourceUrl;
                sourceLink.target = '_blank';
                sourceLink.rel = 'noopener noreferrer';
                sourceLink.textContent = 'Chayyei Yeshua';
                britSource.replaceChildren(`MJRC fallback · Year ${scheduledBritReading.cycleYear} · `, sourceLink, '.');
            } else {
                britSource.textContent = 'No FFOZ or MJRC reading is scheduled; see the weekly bulletin.';
            }
        }

        // Format Brit Chadashah - split by semicolon, each reference on its own line
        const refs = finalBritReading.split(';').map((r: string) => r.trim()).filter((r: string) => r);
        britEl.classList.toggle('multi-ref', refs.length > 1);
        britEl.replaceChildren(...refs.map((ref: string) => {
            const reference = document.createElement('span');
            reference.className = 'scripture-ref';
            reference.textContent = ref;
            return reference;
        }));

        // Triennial
        const triennialYearInfo = document.getElementById('triennial-year-info');
        const triennialButton = document.querySelector<HTMLButtonElement>('[data-cycle="triennial"]');
        if (triennialData?.year) {
            document.getElementById('triennial-torah-reading')!.textContent = triennialData.torah;
            document.getElementById('triennial-haftarah-reading')!.textContent = triennialData.haftarah;
            document.getElementById('triennial-year')!.textContent = String(triennialData.year);
            if (triennialYearInfo) triennialYearInfo.dataset.yearReady = 'true';
            if (triennialButton) {
                triennialButton.textContent = `Triennial · Year ${triennialData.year} of 3`;
                triennialButton.hidden = false;
                triennialButton.disabled = false;
            }
        } else {
            document.getElementById('triennial-torah-reading')!.textContent = 'See weekly bulletin';
            document.getElementById('triennial-haftarah-reading')!.textContent = 'See weekly bulletin';
            if (triennialYearInfo) {
                triennialYearInfo.dataset.yearReady = 'false';
                triennialYearInfo.hidden = true;
            }
            if (triennialButton) {
                triennialButton.hidden = true;
                triennialButton.disabled = true;
            }
        }
    };

    const updateReadingStatus = (mode: 'live' | 'cached' | 'unavailable') => {
        const status = document.getElementById('parashah-status');
        if (!status) return;

        if (mode === 'unavailable') {
            status.textContent = 'Verified readings are temporarily unavailable. Please confirm with the weekly bulletin.';
            return;
        }

        const prefix = mode === 'cached' ? 'Saved exact-date reading' : 'Exact-date readings';
        const sourceLink = document.createElement('a');
        sourceLink.href = 'https://www.hebcal.com/home/4277/leyning-torah-reading-api';
        sourceLink.target = '_blank';
        sourceLink.rel = 'noopener noreferrer';
        sourceLink.textContent = 'Hebcal';
        status.replaceChildren(`${prefix} via `, sourceLink, '.');
    };

    // Initialize triennial toggle
    const toggleButtons = document.querySelectorAll<HTMLButtonElement>('.cycle-btn');
    const selectCycle = (cycle: 'annual' | 'triennial') => {
        const annualSection = document.getElementById('annual-readings');
        const triennialSection = document.getElementById('triennial-readings');
        const triennialYearInfo = document.getElementById('triennial-year-info');

        toggleButtons.forEach((button) => {
            const selected = button.dataset.cycle === cycle;
            button.classList.toggle('active', selected);
            button.setAttribute('aria-selected', String(selected));
        });

        if (annualSection) annualSection.hidden = cycle !== 'annual';
        if (triennialSection) triennialSection.hidden = cycle !== 'triennial';
        if (triennialYearInfo) {
            triennialYearInfo.hidden = cycle !== 'triennial'
                || triennialYearInfo.dataset.yearReady !== 'true';
        }
    };

    toggleButtons.forEach(button => {
        button.addEventListener('click', () => {
            const cycle = button.dataset.cycle;
            if (cycle === 'annual' || cycle === 'triennial') selectCycle(cycle);
        });
    });

    // Load data
    (async () => {
        const loader = document.getElementById('parashah-loader');
        if (loader) loader.style.display = 'block';
        const cardBody = loader?.parentElement;
        if (cardBody) cardBody.setAttribute('aria-busy', 'true');
        const expectedDate = getUpcomingShabbatDate();

        try {
            const bundle = await tryReadingsAPI(expectedDate);
            cacheBundle(bundle);
            await updateParashahUI(bundle.annual, bundle.triennial);
            updateReadingStatus('live');
        } catch (readingsError) {
            const cachedBundle = readCachedBundle(expectedDate);
            if (cachedBundle) {
                await updateParashahUI(cachedBundle.annual, cachedBundle.triennial);
                updateReadingStatus('cached');
                return;
            }

            console.error('Weekly reading source failed', readingsError);
            await updateParashahUI({
                name: 'This Shabbat',
                torah: 'See weekly bulletin',
                haftarah: 'See weekly bulletin',
                date: expectedDate,
                source: 'Unavailable'
            }, null);
            updateReadingStatus('unavailable');
        } finally {
            const annualButton = document.querySelector<HTMLButtonElement>('[data-cycle="annual"]');
            if (annualButton) annualButton.disabled = false;
            selectCycle('annual');
            if (cardBody) cardBody.setAttribute('aria-busy', 'false');
            if (loader) loader.style.display = 'none';
        }
    })();
</script>
